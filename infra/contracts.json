{
  "_comment": "Single source of truth for all cross-cutting values. Read by validate-contracts, bootstraps, and runtime scripts. Edit THIS file — the manifest installs it to VMs.",
  "version": 2,
  "vertex": {
    "location": "us-central1",
    "anthropicLocation": "us-east5",
    "models": {
      "cortex": "vertex-anthropic/claude-opus-4-6",
      "cortexFallback": "vertex-google/gemini-2.5-pro",
      "subagent": "vertex-google/gemini-2.5-flash"
    }
  },
  "agents": {
    "defaultId": "cortex",
    "subagentIds": ["temporal-research", "temporal-memory", "prefrontal", "motor", "cerebellum"]
  },
  "gateway": {
    "port": 18789,
    "timeoutSeconds": 180,
    "bind": "loopback"
  },
  "env": {
    "GOOGLE_GENAI_USE_VERTEXAI": "True",
    "GCE_METADATA_HOST": "metadata.google.internal"
  },
  "versioning": {
    "_comment": "Canonical commit format: v{YYYY}.{MM}.{DD}.{index}.{subindex}: description. This is the FOREVER format. The extractVersion() regex in app/src/app/api/upgrade/route.ts MUST match this. A temporary vX.Y.Z format was used during v5.0-v5.3 and is supported for back-compat only.",
    "commitFormat": "v{YYYY}.{MM}.{DD}.{index}.{subindex}: description",
    "canonicalRegex": "^(v\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+\\.\\d+)",
    "backcompatRegex": "^(v\\d+\\.\\d+\\.\\d+)"
  },
  "dispatch": {
    "model": "gemini-2.5-flash",
    "poll_interval_ms": 3000,
    "max_iterations": 12,
    "gateway_timeout_ms": 300000,
    "stale_cleanup_hours": 24,
    "archive_age_days": 7,
    "archive_interval_ms": 3600000,
    "context_token_budget": 400000,
    "needs_input_timeout_hours": 72
  },
  "ears": {
    "firestore_poll_ms": 3000,
    "gchat_poll_ms": 5000,
    "dedup_window_ms": 300000,
    "cooldown_ms": 2000,
    "gchat_context_messages": 5,
    "preprocess": {
      "enabled": true,
      "model": "gemini-2.5-flash",
      "maxTokens": 2000,
      "temperature": 0.0
    }
  },
  "mouth": {
    "llm_enabled": true,
    "model": "gemini-2.5-flash",
    "maxTokens": 2000,
    "temperature": 0.1,
    "fallback": "deliver_raw",
    "source": "jsonl",
    "status_updates": {
      "enabled": true,
      "schedule_ms": [10000, 300000, 600000, 1800000, 7200000]
    }
  },
  "projects": {
    "context_max_tokens": 2000,
    "promotion_auto": false,
    "archive_completed_after_days": 30
  }
}
