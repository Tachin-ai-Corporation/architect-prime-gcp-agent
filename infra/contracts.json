{
  "_comment": "Single source of truth for all cross-cutting values. Read by validate-contracts, bootstraps, and runtime scripts. Edit THIS file — the manifest installs it to VMs.",
  "version": 2,
  "vertex": {
    "location": "us-central1",
    "anthropicLocation": "us-east5",
    "models": {
      "cortex": "vertex-anthropic/claude-opus-4-6",
      "cortexFallback": "vertex-google/gemini-2.5-pro",
      "subagent": "vertex-google/gemini-2.5-flash"
    },
    "anthropic_prompt_caching": true
  },
  "agents": {
    "defaultId": "cortex",
    "subagentIds": ["temporal-research", "temporal-memory", "prefrontal", "motor", "cerebellum"]
  },
  "gateway": {
    "port": 18789,
    "timeoutSeconds": 180,
    "bind": "loopback",
    "forward_gen_params": true
  },
  "env": {
    "GOOGLE_GENAI_USE_VERTEXAI": "True",
    "GCE_METADATA_HOST": "metadata.google.internal"
  },
  "versioning": {
    "_comment": "Canonical commit format: v{YYYY}.{MM}.{DD}.{index}.{subindex}: description. This is the FOREVER format. The extractVersion() regex in app/src/app/api/upgrade/route.ts MUST match this. A temporary vX.Y.Z format was used during v5.0-v5.3 and is supported for back-compat only.",
    "commitFormat": "v{YYYY}.{MM}.{DD}.{index}.{subindex}: description",
    "canonicalRegex": "^(v\\d{4}\\.\\d{2}\\.\\d{2}\\.\\d+\\.\\d+)",
    "backcompatRegex": "^(v\\d+\\.\\d+\\.\\d+)"
  },
  "dispatch": {
    "model": "gemini-2.5-flash",
    "poll_interval_ms": 3000,
    "max_iterations": 50,
    "gateway_timeout_ms": 300000,
    "stale_cleanup_hours": 24,
    "archive_age_days": 7,
    "archive_interval_ms": 3600000,
    "context_token_budget": 400000,
    "needs_input_timeout_hours": 72,
    "step_ledger_enabled": true,
    "checkpoint_resume_enabled": true,
    "claim_stale_ms": 600000,
    "evidence_floor_exclude_skills": [
      "fleet-fire", "fleet-hire", "fleet-upgrade", "fleet-verify",
      "fleet-status", "fleet-deploy"
    ],
    "max_delegations_per_checkpoint": 4,
    "delegation_dedup_window_hours": 24,
    "result_preview_chars": 700,
    "context_slice_chars": 500,
    "synth_verification_enabled": true,
    "synth_verify_min_chars": 400,
    "criteria_pinning_enabled": true,
    "goal_state_enabled": true,
    "goal_check_required": true
  },
  "ears": {
    "firestore_poll_ms": 3000,
    "gchat_poll_ms": 5000,
    "dedup_window_ms": 300000,
    "cooldown_ms": 2000,
    "gchat_context_messages": 5,
    "max_pages_per_poll": 5,
    "new_space_seed": "now",
    "mention_match": "annotation",
    "preprocess": {
      "enabled": true,
      "model": "gemini-2.5-flash",
      "maxTokens": 2000,
      "temperature": 0.0
    }
  },
  "mouth": {
    "llm_enabled": true,
    "model": "gemini-2.5-flash",
    "maxTokens": 2000,
    "temperature": 0.1,
    "fallback": "deliver_raw",
    "source": "jsonl",
    "dashboard_visibility_mirror": true,
    "status_updates": {
      "enabled": true,
      "schedule_ms": [10000, 300000, 600000, 1800000, 7200000]
    }
  },
  "chat": {
    "reply_in_thread": true
  },
  "projects": {
    "context_max_tokens": 2000,
    "promotion_auto": false,
    "archive_completed_after_days": 30
  },
  "utility": {
    "model": "gemini-2.5-flash",
    "location": "us-central1",
    "maxTokens": {
      "summarize": 1024,
      "title": 60,
      "schema": 8192,
      "notification": 2048
    },
    "temperature": {
      "summarize": 0.3,
      "title": 0.3,
      "schema": 0.1,
      "notification": 0.2
    },
    "context_budgets": {
      "agent_step": 8000,
      "cortex_step": 4000,
      "dispatch_success": 4000,
      "dispatch_failure": 3000
    },
    "timeout_ms": 30000,
    "enforce_schema_timeout_ms": 15000,
    "enforce_schema_max_attempts": 2,
    "disable_thinking": true
  },
  "workspaces": {
    "_comment": "Canonical workspace directories the daemon reads from. Manifests MUST target these paths.",
    "cortex": "workspace",
    "motor": "workspace-motor",
    "cerebellum": "workspace-cerebellum",
    "prefrontal": "workspace-prefrontal",
    "temporal-research": "workspace-temporal-research",
    "temporal-memory": "workspace-temporal-memory"
  },
  "git": {
    "_comment": "Tenant-internal git artifact substrate. Single bucket, per-repo prefixes. ADC via metadata SA token.",
    "bucket": "${TENANT}-agent-git",
    "prefix": "git/",
    "defaultBranch": "main",
    "maxPushRetries": 5,
    "gcBundleThreshold": 25
  },
  "github": {
    "owner": "YOUR_GITHUB_ORG",
    "repo": "architect-prime-gcp-agent",
    "tokenSecret": "github-token"
  }
}
