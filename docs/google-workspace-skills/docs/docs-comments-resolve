#!/usr/bin/env bash
# docs-comments-resolve — Resolve (mark as done) a comment on a Google Doc
# Brain agent: cerebellum (REVIEW)
# Usage: docs-comments-resolve --doc DOC_ID --comment COMMENT_ID [--message "Fixed in latest revision"]
set -euo pipefail
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
WS_TOKEN="${OC_HOST_ROOT}/.openclaw/skills/workspace/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[docs-comments-resolve] [ERROR] $*" >&2; exit 1; }
DOC_ID="" COMMENT_ID="" MESSAGE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;; --comment) COMMENT_ID="$2"; shift 2 ;;
    --message) MESSAGE="$2"; shift 2 ;; *) die "Unknown: $1" ;; esac
done
[[ -n "$DOC_ID" && -n "$COMMENT_ID" ]] || die "Need --doc and --comment"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
# Add a reply with action=resolve
BODY='{"content":"Resolved","action":"resolve"}'
[[ -n "$MESSAGE" ]] && BODY=$(python3 -c "import json,sys; print(json.dumps({'content':sys.argv[1],'action':'resolve'}))" "$MESSAGE")
curl -sf -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" "${DRIVE_API}/files/${DOC_ID}/comments/${COMMENT_ID}/replies?fields=id,content,action" \
  | python3 -c "import json,sys; r=json.load(sys.stdin); print(json.dumps({'status':'resolved','commentId':'$COMMENT_ID','replyId':r.get('id','')}, indent=2))"
