#!/usr/bin/env bash
# contacts-list — List Google Contacts
# Brain agent: temporal-memory (READ)
# Usage: contacts-list [--max 20]
set -euo pipefail
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
WS_TOKEN="${OC_HOST_ROOT}/.openclaw/skills/workspace/ws-token"
PEOPLE_API="https://people.googleapis.com/v1"
die() { echo "[contacts-list] [ERROR] $*" >&2; exit 1; }
MAX=20
while [[ $# -gt 0 ]]; do
  case "$1" in --max) MAX="$2"; shift 2 ;; *) die "Unknown: $1" ;; esac
done
TOKEN="$("$WS_TOKEN" --scope contacts)" || die "Auth failed"
curl -sf -H "Authorization: Bearer ${TOKEN}" \
  "${PEOPLE_API}/people/me/connections?pageSize=${MAX}&personFields=names,emailAddresses,phoneNumbers,organizations" \
  | python3 -c "
import json, sys; data = json.load(sys.stdin)
contacts = []
for p in data.get('connections',[]):
    n=p.get('names',[{}]); e=p.get('emailAddresses',[]); ph=p.get('phoneNumbers',[]); o=p.get('organizations',[])
    contacts.append({'name':n[0].get('displayName','') if n else '','email':e[0].get('value','') if e else '','phone':ph[0].get('value','') if ph else '','org':o[0].get('name','') if o else ''})
print(json.dumps({'contacts':contacts,'count':len(contacts)}, indent=2))
"
