#!/usr/bin/env bash
# drive-move — Move a file to a different folder
# Brain agent: motor (WRITE)
# Usage: drive-move --file FILE_ID --to FOLDER_ID
set -euo pipefail
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
WS_TOKEN="${OC_HOST_ROOT}/.openclaw/skills/workspace/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[drive-move] [ERROR] $*" >&2; exit 1; }
FILE_ID="" DEST=""
while [[ $# -gt 0 ]]; do
  case "$1" in --file) FILE_ID="$2"; shift 2 ;; --to) DEST="$2"; shift 2 ;; *) die "Unknown: $1" ;; esac
done
[[ -n "$FILE_ID" && -n "$DEST" ]] || die "Need --file and --to"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
# Get current parents
PARENTS=$(curl -sf -H "Authorization: Bearer ${TOKEN}" "${DRIVE_API}/files/${FILE_ID}?fields=parents" \
  | python3 -c "import json,sys; print(','.join(json.load(sys.stdin).get('parents',[])))")
curl -sf -X PATCH -H "Authorization: Bearer ${TOKEN}" \
  "${DRIVE_API}/files/${FILE_ID}?addParents=${DEST}&removeParents=${PARENTS}&fields=id,name,parents" \
  | python3 -c "import json,sys; f=json.load(sys.stdin); print(json.dumps({'status':'moved','id':f.get('id',''),'name':f.get('name',''),'parents':f.get('parents',[])}, indent=2))"
