#!/usr/bin/env bash
# calendar-create — Create a calendar event
# Brain agent: motor (WRITE)
# Usage: calendar-create --summary "Meeting" --from 2026-04-25T10:00:00Z --to 2026-04-25T11:00:00Z [--description "Agenda"] [--location "Room 1"]
set -euo pipefail
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
WS_TOKEN="${OC_HOST_ROOT}/.openclaw/skills/workspace/ws-token"
CAL_API="https://www.googleapis.com/calendar/v3"
die() { echo "[calendar-create] [ERROR] $*" >&2; exit 1; }
CAL_ID="primary" SUMMARY="" FROM="" TO="" DESC="" LOC=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --summary) SUMMARY="$2"; shift 2 ;; --from) FROM="$2"; shift 2 ;;
    --to) TO="$2"; shift 2 ;; --description) DESC="$2"; shift 2 ;;
    --location) LOC="$2"; shift 2 ;; --calendar) CAL_ID="$2"; shift 2 ;;
    *) die "Unknown: $1" ;; esac
done
[[ -n "$SUMMARY" && -n "$FROM" && -n "$TO" ]] || die "Need --summary, --from, --to"
TOKEN="$("$WS_TOKEN" --scope calendar)" || die "Auth failed"
BODY=$(python3 -c "
import json, sys
e = {'summary':sys.argv[1],'start':{'dateTime':sys.argv[2]},'end':{'dateTime':sys.argv[3]}}
if sys.argv[4]: e['description'] = sys.argv[4]
if sys.argv[5]: e['location'] = sys.argv[5]
print(json.dumps(e))
" "$SUMMARY" "$FROM" "$TO" "$DESC" "$LOC")
curl -sf -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" "${CAL_API}/calendars/${CAL_ID}/events" \
  | python3 -c "
import json, sys; e = json.load(sys.stdin)
print(json.dumps({'status':'created','id':e.get('id',''),'summary':e.get('summary',''),'link':e.get('htmlLink','')}, indent=2))
"
