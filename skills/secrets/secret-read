#!/usr/bin/env bash
# secret-read — Read a secret value from GCP Secret Manager to STDOUT only.
# Uses the VM's metadata service-account token. NEVER logs the value.
# Usage: secret-read --name <secret-id> [--version latest]
set -euo pipefail
die() { echo "[secret-read] [ERROR] $*" >&2; exit 1; }

NAME=""; VERSION="latest"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --name)    NAME="$2"; shift 2 ;;
    --version) VERSION="$2"; shift 2 ;;
    --help|-h) echo "Usage: secret-read --name <secret-id> [--version latest]"; exit 0 ;;
    *) die "Unknown arg: $1" ;;
  esac
done
[[ -n "$NAME" ]] || die "--name <secret-id> required"

PROJECT="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || true)"
[[ -n "$PROJECT" ]] || die "Cannot resolve GCP project from metadata"
TOKEN="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' 2>/dev/null | python3 -c 'import sys,json; print(json.load(sys.stdin)["access_token"])' 2>/dev/null || true)"
[[ -n "$TOKEN" ]] || die "Cannot obtain metadata access token"

HTTP_TMP="$(mktemp)"; trap 'rm -f "$HTTP_TMP"' EXIT
CODE="$(curl -s -o "$HTTP_TMP" -w '%{http_code}' -H "Authorization: Bearer ${TOKEN}" \
  "https://secretmanager.googleapis.com/v1/projects/${PROJECT}/secrets/${NAME}/versions/${VERSION}:access")"
if [[ "$CODE" == "403" ]]; then
  die "Access denied to secret '${NAME}'. Grant roles/secretmanager.secretAccessor on it to this VM's service account."
fi
if [[ "$CODE" == "404" ]]; then
  die "Secret '${NAME}' (version ${VERSION}) not found in project ${PROJECT}."
fi
[[ "$CODE" == "200" ]] || die "Secret Manager returned HTTP ${CODE}"

# Decode the base64 payload straight to stdout — never through a shell var/log.
python3 -c 'import sys,json,base64; d=json.load(open(sys.argv[1])); sys.stdout.write(base64.b64decode(d["payload"]["data"]).decode("utf-8"))' "$HTTP_TMP"
