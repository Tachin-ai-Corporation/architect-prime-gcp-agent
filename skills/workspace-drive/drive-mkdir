#!/usr/bin/env bash
# drive-mkdir — Create a folder in Google Drive
# Brain agent: motor (WRITE)
# Usage: drive-mkdir --name "Project Files" [--parent FOLDER_ID]
set -euo pipefail
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[drive-mkdir] [ERROR] $*" >&2; exit 1; }
NAME="" PARENT=""
while [[ $# -gt 0 ]]; do
  case "$1" in --name) NAME="$2"; shift 2 ;; --parent) PARENT="$2"; shift 2 ;;
    *) if [[ -z "$NAME" && "$1" != -* ]]; then NAME="$1"; shift
       else die "Unknown: $1"; fi ;; esac
done
[[ -n "$NAME" ]] || die "Need --name"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
QUERY="name='${NAME}' and mimeType='application/vnd.google-apps.folder' and trashed=false"
if [[ -n "$PARENT" ]]; then
  QUERY="name='${NAME}' and '${PARENT}' in parents and mimeType='application/vnd.google-apps.folder' and trashed=false"
fi
ENC_Q=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$QUERY")
SEARCH_URL="${DRIVE_API}/files?q=${ENC_Q}&pageSize=1&supportsAllDrives=true&includeItemsFromAllDrives=true&fields=files(id,name,webViewLink)"

# 1. Pre-search for existing folder
HTTP_CODE=$(curl -s -o $__DT/drive-search.json -w '%{http_code}' -H "Authorization: Bearer ${TOKEN}" "$SEARCH_URL")
if [[ "$HTTP_CODE" == "200" ]]; then
  EXISTING_ID=$(jq -r '.files[0].id // empty' $__DT/drive-search.json 2>/dev/null || true)
  if [[ -n "$EXISTING_ID" ]]; then
    jq -n --arg id "$EXISTING_ID" \
          --arg name "$(jq -r '.files[0].name // empty' $__DT/drive-search.json 2>/dev/null)" \
          --arg link "$(jq -r '.files[0].webViewLink // empty' $__DT/drive-search.json 2>/dev/null)" \
          '{status: "existing", id: $id, name: $name, link: $link}'
    exit 0
  fi
fi

# 2. Create new folder
BODY="{\"name\":\"${NAME}\",\"mimeType\":\"application/vnd.google-apps.folder\"}"
if [[ -n "$PARENT" ]]; then
  BODY="{\"name\":\"${NAME}\",\"mimeType\":\"application/vnd.google-apps.folder\",\"parents\":[\"${PARENT}\"]}"
fi
HTTP_CODE=$(curl -s -o $__DT/drive-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" "${DRIVE_API}/files?supportsAllDrives=true&fields=id,name,webViewLink")

if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "404" ]]; then
  echo "{\"status\":\"access_denied\",\"parent\":\"${PARENT:-root}\",\"message\":\"I don't have access to create a folder here. Please share the parent folder with ${AGENT_USER_EMAIL:-unknown}\",\"agentEmail\":\"${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
if [[ "$HTTP_CODE" != "200" ]]; then
  die "Drive API returned HTTP ${HTTP_CODE}"
fi

NEW_ID=$(jq -r '.id // empty' $__DT/drive-response.json 2>/dev/null || true)
if [[ -z "$NEW_ID" ]]; then
  die "Failed to parse new folder ID"
fi

# 3. Race condition guard: Re-search and pick earliest
DEDUP_URL="${DRIVE_API}/files?q=${ENC_Q}&pageSize=5&supportsAllDrives=true&includeItemsFromAllDrives=true&orderBy=createdTime&fields=files(id,name,webViewLink)"
HTTP_CODE=$(curl -s -o $__DT/drive-dedup.json -w '%{http_code}' -H "Authorization: Bearer ${TOKEN}" "$DEDUP_URL")
if [[ "$HTTP_CODE" == "200" ]]; then
  WINNER_ID=$(jq -r '.files[0].id // empty' $__DT/drive-dedup.json 2>/dev/null || true)
  if [[ -n "$WINNER_ID" && "$WINNER_ID" != "$NEW_ID" ]]; then
    # Trash our duplicate
    curl -sf -X PATCH -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" -d '{"trashed":true}' "${DRIVE_API}/files/${NEW_ID}?supportsAllDrives=true" >/dev/null 2>&1 || true
    # Return winner
    jq -n --arg id "$WINNER_ID" \
          --arg name "$(jq -r '.files[0].name // empty' $__DT/drive-dedup.json 2>/dev/null)" \
          --arg link "$(jq -r '.files[0].webViewLink // empty' $__DT/drive-dedup.json 2>/dev/null)" \
          '{status: "existing", id: $id, name: $name, link: $link}'
    exit 0
  fi
fi

# 4. We won the race, return ours
jq -n --arg id "$NEW_ID" \
      --arg name "$(jq -r '.name // empty' $__DT/drive-response.json 2>/dev/null)" \
      --arg link "$(jq -r '.webViewLink // empty' $__DT/drive-response.json 2>/dev/null)" \
      '{status: "created", id: $id, name: $name, link: $link}'
