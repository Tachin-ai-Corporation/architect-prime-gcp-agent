#!/usr/bin/env bash
# drive-move — Move a file to a different folder
# Brain agent: motor (WRITE)
# Usage: drive-move --file FILE_ID --to FOLDER_ID
set -euo pipefail
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
WS_TOKEN="${OC_HOST_ROOT}/.openclaw/bin/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[drive-move] [ERROR] $*" >&2; exit 1; }
FILE_ID="" DEST=""
while [[ $# -gt 0 ]]; do
  case "$1" in --file) FILE_ID="$2"; shift 2 ;; --to) DEST="$2"; shift 2 ;; *) die "Unknown: $1" ;; esac
done
[[ -n "$FILE_ID" && -n "$DEST" ]] || die "Need --file and --to"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
# Get current parents
HTTP_CODE=$(curl -s -o /tmp/drive-meta.json -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" "${DRIVE_API}/files/${FILE_ID}?fields=parents")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "404" ]]; then
  echo "{\"status\":\"access_denied\",\"fileId\":\"${FILE_ID}\",\"message\":\"I don't have access to this file. Please share it with ${AGENT_USER_EMAIL:-unknown} with editor access\",\"agentEmail\":\"${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
PARENTS=$(python3 -c "import json; print(','.join(json.load(open('/tmp/drive-meta.json')).get('parents',[])))")
HTTP_CODE=$(curl -s -o /tmp/drive-response.json -w '%{http_code}' \
  -X PATCH -H "Authorization: Bearer ${TOKEN}" \
  "${DRIVE_API}/files/${FILE_ID}?addParents=${DEST}&removeParents=${PARENTS}&fields=id,name,parents")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "404" ]]; then
  echo "{\"status\":\"access_denied\",\"fileId\":\"${FILE_ID}\",\"destination\":\"${DEST}\",\"message\":\"I don't have permission to move this file. Please share both the file and destination folder with ${AGENT_USER_EMAIL:-unknown}\",\"agentEmail\":\"${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
if [[ "$HTTP_CODE" != "200" ]]; then
  die "Drive API returned HTTP ${HTTP_CODE}"
fi
python3 -c "import json; f=json.load(open('/tmp/drive-response.json')); print(json.dumps({'status':'moved','id':f.get('id',''),'name':f.get('name',''),'parents':f.get('parents',[])}, indent=2))"
