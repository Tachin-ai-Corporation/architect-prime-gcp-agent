#!/usr/bin/env bash
# drive-upload — Upload a file to Google Drive
# Brain agent: motor (WRITE)
# Usage: drive-upload --file /path/to/file.pdf [--name "Report.pdf"] [--folder FOLDER_ID]
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
UPLOAD_API="https://www.googleapis.com/upload/drive/v3"
die() { echo "[drive-upload] [ERROR] $*" >&2; exit 1; }
FILE="" NAME="" FOLDER=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --file) FILE="$2"; shift 2 ;; --name) NAME="$2"; shift 2 ;;
    --folder) FOLDER="$2"; shift 2 ;; *) die "Unknown: $1" ;; esac
done
[[ -n "$FILE" && -f "$FILE" ]] || die "Need --file <path> to an existing file"
[[ -n "$NAME" ]] || NAME="$(basename "$FILE")"
MIME="$(file --mime-type -b "$FILE" 2>/dev/null || echo "application/octet-stream")"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
META="{\"name\":\"${NAME}\"}"
[[ -n "$FOLDER" ]] && META="{\"name\":\"${NAME}\",\"parents\":[\"${FOLDER}\"]}"
HTTP_CODE=$(curl -s -o /tmp/drive-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" \
  -F "metadata=${META};type=application/json" \
  -F "file=@${FILE};type=${MIME}" \
  "${UPLOAD_API}/files?uploadType=multipart&supportsAllDrives=true&fields=id,name,webViewLink,webContentLink")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "404" ]]; then
  echo "{\"status\":\"access_denied\",\"folder\":\"${FOLDER:-root}\",\"message\":\"I don't have access to upload to this folder. Please share it with ${AGENT_USER_EMAIL:-unknown}\",\"agentEmail\":\"${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
if [[ "$HTTP_CODE" != "200" ]]; then
  die "Drive API returned HTTP ${HTTP_CODE}"
fi
python3 -c "
import json; f = json.load(open('/tmp/drive-response.json'))
print(json.dumps({'status':'uploaded','id':f.get('id',''),'name':f.get('name',''),'webViewLink':f.get('webViewLink',''),'webContentLink':f.get('webContentLink','')}, indent=2))
"
