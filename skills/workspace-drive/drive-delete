#!/usr/bin/env bash
# drive-delete — Trash a file in Google Drive
# Brain agent: motor (WRITE)
# Usage: drive-delete --file FILE_ID
set -euo pipefail
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[drive-delete] [ERROR] $*" >&2; exit 1; }
FILE_ID=""
while [[ $# -gt 0 ]]; do
  case "$1" in --file) FILE_ID="$2"; shift 2 ;;
    *) if [[ -z "$FILE_ID" && "$1" != -* ]]; then FILE_ID="$1"; shift
       else die "Unknown: $1"; fi ;; esac
done
[[ -n "$FILE_ID" ]] || die "Need --file <file_id>"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
HTTP_CODE=$(curl -s -o $__DT/drive-response.json -w '%{http_code}' \
  -X PATCH -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d '{"trashed":true}' "${DRIVE_API}/files/${FILE_ID}?supportsAllDrives=true")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "404" ]]; then
  echo "{\"status\":\"access_denied\",\"fileId\":\"${FILE_ID}\",\"message\":\"I don't have access to delete this file. Please share it with ${AGENT_USER_EMAIL:-unknown} with editor access\",\"agentEmail\":\"${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
if [[ "$HTTP_CODE" != "200" ]]; then
  die "Drive API returned HTTP ${HTTP_CODE}"
fi
echo "{\"status\":\"trashed\",\"id\":\"${FILE_ID}\"}"
