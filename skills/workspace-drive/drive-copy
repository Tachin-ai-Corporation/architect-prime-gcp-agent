#!/usr/bin/env bash
# drive-copy — Copy a file in Google Drive
# Brain agent: motor (WRITE)
# Usage: drive-copy --file FILE_ID [--title "New Title"] [--folder FOLDER_ID]
set -euo pipefail
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[drive-copy] [ERROR] $*" >&2; exit 1; }

FILE_ID="" TITLE="" FOLDER_ID=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --file) FILE_ID="$2"; shift 2 ;;
    --title) TITLE="$2"; shift 2 ;;
    --folder) FOLDER_ID="$2"; shift 2 ;;
    *) if [[ -z "$FILE_ID" && "$1" != -* ]]; then FILE_ID="$1"; shift
       else die "Unknown arg: $1"; fi ;;
  esac
done

[[ -n "$FILE_ID" ]] || die "Need --file"
# ---- Guard: --file is a Drive id, never a name or a local path ----
# Copying a template is the step most likely to be handed a filename instead of an
# id, and a wrong copy multiplies (three people, three wrong documents).
case "$FILE_ID" in
  */*|*\\*|*[[:space:]]*|*.pdf|*.PDF|*.doc|*.docx|*.txt|*.md|*.json|*.csv|*.xlsx|*.pptx|*.png|*.jpg|*.jpeg|*.tif|*.tiff|*.html)
    die "--file got '${FILE_ID}', which looks like a filename or local path, not a Drive file ID (an opaque token — no extension, no spaces). Resolve the id first: drive-ls <FOLDER_ID> and copy the exact 'id' of the row whose 'name' matches the request. If the file is LOCAL, upload it with drive-upload and copy the returned id." ;;
esac
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"

BODY="{}"
if [[ -n "$TITLE" || -n "$FOLDER_ID" ]]; then
  BODY=$(python3 -c "
import json, sys
data = {}
if sys.argv[1]: data['name'] = sys.argv[1]
if sys.argv[2]: data['parents'] = [sys.argv[2]]
print(json.dumps(data))
" "$TITLE" "$FOLDER_ID")
fi

HTTP_CODE=$(curl -s -o $__DT/drive-copy-resp.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" "${DRIVE_API}/files/${FILE_ID}/copy?supportsAllDrives=true")

if [[ "$HTTP_CODE" != "200" ]]; then
  die "Drive API returned HTTP ${HTTP_CODE}: $(cat $__DT/drive-copy-resp.json)"
fi

python3 -c "
import json
p = json.load(open('$__DT/drive-copy-resp.json'))
print(json.dumps({
    'status': 'copied',
    'fileId': p.get('id', ''),
    'name': p.get('name', ''),
    'mimeType': p.get('mimeType', '')
}, indent=2))
"
