#!/usr/bin/env bash
# drive-ls — List files in Google Drive
# Brain agent: temporal-memory (READ)
# Usage: drive-ls [--folder FOLDER_ID] [--max 20]
set -euo pipefail
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[drive-ls] [ERROR] $*" >&2; exit 1; }
FOLDER="" MAX=20
while [[ $# -gt 0 ]]; do
  case "$1" in
    --folder) FOLDER="$2"; shift 2 ;; --max) MAX="$2"; shift 2 ;;
    *) if [[ -z "$FOLDER" && "$1" != -* ]]; then FOLDER="$1"; shift
       else die "Unknown: $1"; fi ;; esac
done
# ---- Guard: the argument is a folder ID, not a folder name or local path ----
# A Drive id is an opaque token: no slashes, no spaces, no extension.
if [[ -n "$FOLDER" ]]; then
  case "$FOLDER" in
    */*|*\\*|*[[:space:]]*|*.*)
      die "'${FOLDER}' looks like a folder NAME or a local path, not a Drive folder ID (an opaque token — no spaces, no dots, no slashes). Resolve it first: drive-search --query \"name contains 'PART_OF_NAME' and mimeType = 'application/vnd.google-apps.folder'\" and use the returned id." ;;
  esac
fi
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
QUERY="trashed=false"
[[ -n "$FOLDER" ]] && QUERY="'${FOLDER}' in parents and trashed=false"
ENC_Q=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$QUERY")
HTTP_CODE=$(curl -s -o $__DT/drive-response.json -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" \
  "${DRIVE_API}/files?q=${ENC_Q}&pageSize=${MAX}&supportsAllDrives=true&includeItemsFromAllDrives=true&fields=files(id,name,mimeType,modifiedTime,size,webViewLink)&orderBy=modifiedTime%20desc")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "404" ]]; then
  echo "{\"status\":\"access_denied\",\"folderId\":\"${FOLDER:-root}\",\"message\":\"I don't have access to this folder. Please share it with ${AGENT_USER_EMAIL:-unknown}\",\"agentEmail\":\"${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
if [[ "$HTTP_CODE" != "200" ]]; then
  die "Drive API returned HTTP ${HTTP_CODE}"
fi
python3 -c "
import json, os, sys; data = json.load(open('$__DT/drive-response.json'))
GTYPE = {'document':'doc','spreadsheet':'sheet','presentation':'slides','folder':'folder','form':'form','drawing':'drawing'}
def short_type(m):
    if m == 'application/pdf': return 'pdf'
    if m.startswith('application/vnd.google-apps.'):
        return GTYPE.get(m.rsplit('.',1)[-1], m.rsplit('.',1)[-1])
    return m
files = [{'id':f['id'],'name':f['name'],'type':short_type(f.get('mimeType','')),'modified':f.get('modifiedTime',''),'link':f.get('webViewLink','')} for f in data.get('files',[])]
# Lookalike names are the trap this listing exists to defuse: a folder of
# MASTER_..._Internal_Royalty / MASTER_..._Partner / MASTER_..._Fixed had its FIRST
# row copied three times. Surface the shared prefix and, more importantly, the part
# that actually distinguishes the rows.
def lookalikes(names):
    s = sorted(names)
    if len(s) < 2: return None
    groups, cur = [], [s[0]]
    for prev, nxt in zip(s, s[1:]):
        if len(os.path.commonprefix([prev, nxt])) >= 12: cur.append(nxt)
        else: groups.append(cur); cur = [nxt]
    groups.append(cur)
    g = max(groups, key=len)
    if len(g) < 2: return None
    pre = os.path.commonprefix(g)
    return {'sharedPrefix': pre, 'differBy': [n[len(pre):] for n in g],
            'note': str(len(g)) + ' names here share that prefix, so the prefix identifies nothing - the difference does. Rows are ordered by modification time, so the first row is not the answer. Match the distinguishing token to the request, state which name you chose, then act on that row id (copy it verbatim - never retype an id).'}
out = {'files': files, 'count': len(files)}
la = lookalikes([f['name'] for f in files])
if la: out['lookalikes'] = la
print(json.dumps(out, indent=2))
"
