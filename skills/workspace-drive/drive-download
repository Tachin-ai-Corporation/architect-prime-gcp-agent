#!/usr/bin/env bash
# drive-download — Download a file from Google Drive
# Brain agent: temporal-memory (READ)
# Usage: drive-download --file FILE_ID [--output /path/to/save]
# For Google Docs/Sheets/Slides, exports as PDF by default. Use --mime to override.
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[drive-download] [ERROR] $*" >&2; exit 1; }
FILE_ID="" OUTPUT="" EXPORT_MIME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --file) FILE_ID="$2"; shift 2 ;; --output) OUTPUT="$2"; shift 2 ;;
    --mime) EXPORT_MIME="$2"; shift 2 ;; *) die "Unknown: $1" ;; esac
done
[[ -n "$FILE_ID" ]] || die "Need --file <file_id>"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
# Get file metadata to determine type
HTTP_CODE=$(curl -s -o /tmp/drive-meta.json -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" "${DRIVE_API}/files/${FILE_ID}?supportsAllDrives=true&fields=name,mimeType")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "404" ]]; then
  echo "{\"status\":\"access_denied\",\"fileId\":\"${FILE_ID}\",\"message\":\"I don't have access to this file. Please share it with ${AGENT_USER_EMAIL:-unknown}\",\"agentEmail\":\"${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
if [[ "$HTTP_CODE" != "200" ]]; then
  die "Drive API returned HTTP ${HTTP_CODE} getting file metadata"
fi
NAME=$(python3 -c "import json; print(json.load(open('/tmp/drive-meta.json')).get('name','file'))")
MIME=$(python3 -c "import json; print(json.load(open('/tmp/drive-meta.json')).get('mimeType',''))")
[[ -n "$OUTPUT" ]] || OUTPUT="/tmp/${NAME}"
# Google Workspace types need export, regular files use direct download
if echo "$MIME" | grep -q "google-apps"; then
  [[ -n "$EXPORT_MIME" ]] || EXPORT_MIME="application/pdf"
  ENC_MIME=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$EXPORT_MIME")
  curl -sf -H "Authorization: Bearer ${TOKEN}" \
    "${DRIVE_API}/files/${FILE_ID}/export?mimeType=${ENC_MIME}&supportsAllDrives=true" -o "$OUTPUT"
else
  curl -sf -H "Authorization: Bearer ${TOKEN}" \
    "${DRIVE_API}/files/${FILE_ID}?alt=media&supportsAllDrives=true" -o "$OUTPUT"
fi
echo "{\"status\":\"downloaded\",\"path\":\"${OUTPUT}\",\"name\":\"${NAME}\",\"mimeType\":\"${MIME}\"}"
