#!/usr/bin/env bash
# work-publish — Publish artifacts to the standard Drive folder hierarchy
# Brain agent: motor (WRITE)
#
# Usage:
#   work-publish <file> [--project <project-id>] [--subfolder <name>]
#   work-publish <file> --project your-website-project              → {project}/MM-DD/<file>
#   work-publish <file> --project your-website-project --subfolder assets → {project}/assets/<file>
#   work-publish <file>                                        → {prime}/{agent}/MM-DD/<file>
#
# Reads artifacts_root_folder_id from Firestore config/settings.
# Creates folders idempotently (drive-mkdir returns existing on conflict).
# Outputs JSON with status, fileId, folderId, url, path.
set -euo pipefail

CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
UPLOAD_API="https://www.googleapis.com/upload/drive/v3"
die() { echo "[work-publish] [ERROR] $*" >&2; exit 1; }
log() { echo "[work-publish] $*" >&2; }

# ---- Args ----
FILE="" PROJECT="" SUBFOLDER=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project)   PROJECT="$2"; shift 2 ;;
    --subfolder) SUBFOLDER="$2"; shift 2 ;;
    --file)      FILE="$2"; shift 2 ;;
    *)
      if [[ -z "$FILE" && "$1" != -* ]]; then FILE="$1"; shift
      else die "Unknown: $1"; fi ;;
  esac
done
[[ -n "$FILE" && -f "$FILE" ]] || die "Need <file> path to an existing file"

# ---- Auth ----
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"

# ---- Resolve artifacts root from Firestore ----
GCP_PROJECT="${GCP_PROJECT:-$(curl -sf -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || echo '')}"
[[ -n "$GCP_PROJECT" ]] || die "Cannot determine GCP project"

GCE_TOKEN="$(curl -sf -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
  | python3 -c 'import sys,json; print(json.load(sys.stdin)["access_token"])')" || die "GCE auth failed"

FS_BASE="https://firestore.googleapis.com/v1/projects/${GCP_PROJECT}/databases/(default)/documents"
ROOT_FOLDER_ID="$(curl -sf -H "Authorization: Bearer ${GCE_TOKEN}" \
  "${FS_BASE}/config/settings" \
  | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("fields",{}).get("artifacts_root_folder_id",{}).get("stringValue",""))' 2>/dev/null || echo '')"
[[ -n "$ROOT_FOLDER_ID" ]] || die "No artifacts_root_folder_id configured in dashboard Settings"

# ---- Resolve agent identity ----
AGENT_ID="${AGENT_ID:-$(hostname -s | sed 's/^fleet-//')}"
PRIME_ID="${PRIME_ID:-$(python3 -c "
import json,sys
try:
  d = json.load(open('${CORE_DIR}/config/contracts.json'))
  print(d.get('primeId', ''))
except: print('')
" 2>/dev/null || echo '')}"
[[ -z "$PRIME_ID" ]] && PRIME_ID="$(curl -sf -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime-id' 2>/dev/null || echo 'unknown')"

# ---- Date subfolder (UTC) ----
DATE_FOLDER="$(date -u +'%m-%d')"

# ---- Helper: idempotent folder resolve/create ----
# Returns folder ID. Creates if not exists; returns existing if found.
# Handles race conditions from concurrent calls by re-searching after create.
ensure_folder() {
  local NAME="$1" PARENT="$2"
  local CMD=("${CORE_DIR}/bin/drive-mkdir" "--name" "$NAME")
  [[ -n "$PARENT" ]] && CMD+=("--parent" "$PARENT")
  
  # drive-mkdir now natively handles deduplication and returns JSON
  "${CMD[@]}" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('id',''))" 2>/dev/null || echo ""
}

# ---- Build folder path ----
TARGET_PARENT=""
FOLDER_PATH=""

if [[ -n "$PROJECT" ]]; then
  # --- Project mode: {root}/{project-name}/{MM-DD|subfolder}/ ---

  # Resolve project name from Firestore
  PROJ_NAME="$(curl -sf -H "Authorization: Bearer ${GCE_TOKEN}" \
    "${FS_BASE}/projects/${PROJECT}" \
    | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d.get("fields",{}).get("name",{}).get("stringValue",""))' 2>/dev/null || echo '')"
  [[ -z "$PROJ_NAME" ]] && PROJ_NAME="$PROJECT"
  # Sanitize
  PROJ_NAME="${PROJ_NAME//[\"\']/}"

  # Check if project already has a drive_folder_id
  PROJ_FOLDER="$(curl -sf -H "Authorization: Bearer ${GCE_TOKEN}" \
    "${FS_BASE}/projects/${PROJECT}" \
    | python3 -c "
import sys,json
d = json.load(sys.stdin)
f = d.get('fields',{})
# Check top-level drive_folder_id
fid = f.get('drive_folder_id',{}).get('stringValue','')
if fid: print(fid); sys.exit()
# Check context.drive_folder.ref
ctx = f.get('context',{}).get('mapValue',{}).get('fields',{})
df = ctx.get('drive_folder',{}).get('mapValue',{}).get('fields',{})
ref = df.get('ref',{}).get('stringValue','')
if ref: print(ref)
" 2>/dev/null || echo '')"

  if [[ -z "$PROJ_FOLDER" ]]; then
    # Create project folder under root
    log "Creating project folder: ${PROJ_NAME}"
    PROJ_FOLDER="$(ensure_folder "$PROJ_NAME" "$ROOT_FOLDER_ID")"
    [[ -n "$PROJ_FOLDER" ]] || die "Failed to create project folder"
  fi

  # Create date or custom subfolder
  SUB="${SUBFOLDER:-$DATE_FOLDER}"
  log "Ensuring subfolder: ${SUB}"
  TARGET_PARENT="$(ensure_folder "$SUB" "$PROJ_FOLDER")"
  FOLDER_PATH="${PROJ_NAME}/${SUB}"
else
  # --- Agent mode: {root}/{prime}/{agent}/{MM-DD|subfolder}/ ---
  log "Agent mode: ${PRIME_ID}/${AGENT_ID}"

  PRIME_FOLDER="$(ensure_folder "$PRIME_ID" "$ROOT_FOLDER_ID")"
  [[ -n "$PRIME_FOLDER" ]] || die "Failed to create prime folder"

  AGENT_FOLDER="$(ensure_folder "$AGENT_ID" "$PRIME_FOLDER")"
  [[ -n "$AGENT_FOLDER" ]] || die "Failed to create agent folder"

  SUB="${SUBFOLDER:-$DATE_FOLDER}"
  TARGET_PARENT="$(ensure_folder "$SUB" "$AGENT_FOLDER")"
  FOLDER_PATH="${PRIME_ID}/${AGENT_ID}/${SUB}"
fi

[[ -n "$TARGET_PARENT" ]] || die "Failed to resolve target folder"

# ---- Upload file ----
FILE_NAME="$(basename "$FILE")"
MIME="$(file --mime-type -b "$FILE" 2>/dev/null || echo 'application/octet-stream')"
META="{\"name\":\"${FILE_NAME}\",\"parents\":[\"${TARGET_PARENT}\"]}"

HTTP_CODE=$(curl -s -o /tmp/wp-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" \
  -F "metadata=${META};type=application/json" \
  -F "file=@${FILE};type=${MIME}" \
  "${UPLOAD_API}/files?uploadType=multipart&supportsAllDrives=true&fields=id,name,webViewLink,webContentLink")

if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "404" ]]; then
  echo "{\"status\":\"access_denied\",\"folder\":\"${TARGET_PARENT}\",\"path\":\"${FOLDER_PATH}\",\"message\":\"I don't have access to upload here. Please share the folder with ${AGENT_USER_EMAIL:-unknown}\",\"agentEmail\":\"${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
if [[ "$HTTP_CODE" != "200" ]]; then
  die "Drive API returned HTTP ${HTTP_CODE}"
fi

python3 -c "
import json
f = json.load(open('/tmp/wp-response.json'))
print(json.dumps({
  'status': 'published',
  'fileId': f.get('id', ''),
  'fileName': f.get('name', ''),
  'folderId': '${TARGET_PARENT}',
  'folderPath': '${FOLDER_PATH}',
  'webViewLink': f.get('webViewLink', ''),
  'webContentLink': f.get('webContentLink', ''),
}, indent=2))
"
