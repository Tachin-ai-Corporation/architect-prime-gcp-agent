#!/usr/bin/env bash
# docs-format-page — Set page-level formatting: margins, headers, footers, orientation
# Brain agent: motor (WRITE)
# Usage: docs-format-page --doc DOC_ID [--margins "1in"] [--header "text"] [--footer "text"] [--orientation portrait|landscape]
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DOCS_API="https://docs.googleapis.com/v1/documents"
die() { echo "[docs-format-page] [ERROR] $*" >&2; exit 1; }
DOC_ID="" MARGINS="" HEADER_TEXT="" FOOTER_TEXT="" ORIENTATION=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --margins) MARGINS="$2"; shift 2 ;;
    --header) HEADER_TEXT="$2"; shift 2 ;;
    --footer) FOOTER_TEXT="$2"; shift 2 ;;
    --orientation) ORIENTATION="$2"; shift 2 ;;
    --help|-h) echo "Usage: docs-format-page --doc <doc_id> [--margins <size>] [--header <text>] [--footer <text>] [--orientation portrait|landscape]"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" ]] || die "Need --doc"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

python3 -c "
import urllib.request, urllib.error, json, sys

doc_id = sys.argv[1]
margins = sys.argv[2]
header_text = sys.argv[3]
footer_text = sys.argv[4]
orientation = sys.argv[5]
token = sys.argv[6]
email = sys.argv[7]

def api(url, method='GET', data=None):
    headers = {'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'}
    req = urllib.request.Request(url, headers=headers, method=method,
                                 data=json.dumps(data).encode() if data else None)
    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            print(json.dumps({'status': 'access_denied', 'message': f'Access denied for {email or \"unknown\"}'}))
            sys.exit(0)
        sys.stderr.write(f'API error: {e.code} {e.read().decode(\"utf-8\")}\\n')
        sys.exit(1)

# Parse a margin value to POINTS (Docs API magnitudes are in points; unit PT).
def parse_margin(val):
    val = val.strip().lower()
    if val.endswith('in'):
        return float(val[:-2]) * 72.0
    elif val.endswith('cm'):
        return float(val[:-2]) * 28.3465
    elif val.endswith('pt'):
        return float(val[:-2])
    else:
        return float(val) * 72.0  # bare number = inches

batch = f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate'

# Fetch current doc for orientation base + header/footer idempotency.
doc = api(f'https://docs.googleapis.com/v1/documents/{doc_id}')
doc_style_current = doc.get('documentStyle', {})
existing_header_id = doc_style_current.get('defaultHeaderId')
existing_footer_id = doc_style_current.get('defaultFooterId')

requests = []

# 1. Document style (margins + orientation).
doc_style = {}
doc_fields = []

if margins:
    m = parse_margin(margins)
    doc_style['marginTop'] = {'magnitude': m, 'unit': 'PT'}
    doc_style['marginBottom'] = {'magnitude': m, 'unit': 'PT'}
    doc_style['marginLeft'] = {'magnitude': m, 'unit': 'PT'}
    doc_style['marginRight'] = {'magnitude': m, 'unit': 'PT'}
    doc_fields.extend(['marginTop', 'marginBottom', 'marginLeft', 'marginRight'])

if orientation:
    ps = doc_style_current.get('pageSize', {})
    w = ps.get('width', {}).get('magnitude', 612)
    h = ps.get('height', {}).get('magnitude', 792)
    wu = ps.get('width', {}).get('unit', 'PT')
    hu = ps.get('height', {}).get('unit', 'PT')
    cur_landscape = w > h
    want_landscape = (orientation == 'landscape')
    # Swap width/height only if the current orientation differs (idempotent).
    if cur_landscape != want_landscape:
        doc_style['pageSize'] = {
            'width': {'magnitude': h, 'unit': hu},
            'height': {'magnitude': w, 'unit': wu}
        }
        doc_fields.append('pageSize')

if doc_fields:
    requests.append({
        'updateDocumentStyle': {
            'documentStyle': doc_style,
            'fields': ','.join(doc_fields)
        }
    })

# 2. Create header/footer only if a DEFAULT one does not already exist (idempotent).
if header_text and not existing_header_id:
    requests.append({'createHeader': {'type': 'DEFAULT'}})
if footer_text and not existing_footer_id:
    requests.append({'createFooter': {'type': 'DEFAULT'}})

header_id = existing_header_id
footer_id = existing_footer_id

if requests:
    result = api(batch, 'POST', {'requests': requests})
    for rep in result.get('replies', []):
        if 'createHeader' in rep:
            header_id = rep['createHeader'].get('headerId')
        if 'createFooter' in rep:
            footer_id = rep['createFooter'].get('footerId')

STYLE = {
    'fontSize': {'magnitude': 9, 'unit': 'PT'},
    'foregroundColor': {'color': {'rgbColor': {'red': 0.4, 'green': 0.4, 'blue': 0.4}}}
}

# Populate a header/footer segment idempotently: clear existing content, then insert.
def populate_segment(seg_kind, seg_id, text):
    d = api(f'https://docs.googleapis.com/v1/documents/{doc_id}')
    seg = d.get(seg_kind, {}).get(seg_id, {})
    content = seg.get('content', [])
    seg_end = content[-1].get('endIndex', 1) if content else 1
    reqs = []
    if seg_end > 1:
        reqs.append({'deleteContentRange': {'range': {'segmentId': seg_id, 'startIndex': 0, 'endIndex': seg_end - 1}}})
    reqs.append({'insertText': {'location': {'segmentId': seg_id, 'index': 0}, 'text': text}})
    reqs.append({'updateTextStyle': {
        'range': {'segmentId': seg_id, 'startIndex': 0, 'endIndex': len(text)},
        'textStyle': STYLE,
        'fields': 'fontSize,foregroundColor'
    }})
    api(batch, 'POST', {'requests': reqs})

if header_text and header_id:
    populate_segment('headers', header_id, header_text)

if footer_text and footer_id:
    populate_segment('footers', footer_id, footer_text)

applied = []
if margins: applied.append('margins')
if header_text: applied.append('header')
if footer_text: applied.append('footer')
if orientation: applied.append(f'orientation:{orientation}')

print(json.dumps({
    'status': 'formatted',
    'docId': doc_id,
    'applied': applied,
    'link': f'https://docs.google.com/document/d/{doc_id}'
}, indent=2))
" "$DOC_ID" "$MARGINS" "$HEADER_TEXT" "$FOOTER_TEXT" "$ORIENTATION" "$TOKEN" "${AGENT_USER_EMAIL:-}"
