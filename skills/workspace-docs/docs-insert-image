#!/usr/bin/env bash
# docs-insert-image — Insert an inline image from a public URL at a unique anchor
# Brain agent: motor (WRITE)
# Usage: docs-insert-image --doc DOC_ID --anchor "phrase" --url IMAGE_URL
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-insert-image] [ERROR] $*" >&2; exit 1; }
DOC_ID="" ANCHOR="" URL=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --anchor) ANCHOR="$2"; shift 2 ;;
    --url) URL="$2"; shift 2 ;;
    --help|-h) echo "Usage: docs-insert-image --doc <doc_id> --anchor <phrase> --url <image_url>"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" && -n "$ANCHOR" && -n "$URL" ]] || die "Need --doc, --anchor, and --url"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

export DOCSLIB_DIR="${CORE_DIR}/bin"
python3 -c "
import urllib.request, urllib.error, json, sys, os
sys.path.insert(0, os.environ['DOCSLIB_DIR'])
from _docslib import extract_text_and_map

doc_id = sys.argv[1]
anchor = sys.argv[2]
img_url = sys.argv[3]
token = sys.argv[4]
email = sys.argv[5]

# Constraint 1: URL length must be under 2KB
if len(img_url) > 2048:
    sys.stderr.write(f'Validation failed: Image URL length ({len(img_url)}) exceeds 2 KB limit.\\n')
    sys.exit(1)

# Constraint 2: Format must be PNG, JPEG/JPG, or GIF
ext = img_url.split('?')[0].split('.')[-1].lower()
valid_exts = ['png', 'jpg', 'jpeg', 'gif']
is_valid_ext = ext in valid_exts

# Constraint 3 (advisory, NON-FATAL): best-effort HEAD for size/format guidance.
# Many CDNs 403/405 a HEAD request, so failures here never block the insert —
# Google's server-side fetch during batchUpdate is the authoritative validator.
content_type = ''
try:
    req = urllib.request.Request(img_url, method='HEAD')
    with urllib.request.urlopen(req, timeout=5) as r:
        content_length = int(r.headers.get('Content-Length', 0) or 0)
        content_type = r.headers.get('Content-Type', '').lower()
        if content_length and content_length > 50 * 1024 * 1024:
            sys.stderr.write(f'[warn] Image size ({content_length} bytes) exceeds the 50 MB Docs limit; Google may reject it.\\n')
except Exception:
    # HEAD blocked (403/405), timed out, or network error — fall back to extension/Content-Type.
    pass

# Format guidance (advisory, non-fatal): warn if neither extension nor content-type looks like an image.
is_valid_type = any(t in content_type for t in ['image/png', 'image/jpeg', 'image/gif'])
if not is_valid_ext and not is_valid_type:
    sys.stderr.write(f'[warn] URL extension \".{ext}\" and content-type \"{content_type or \"unknown\"}\" are not clearly PNG/JPEG/GIF; Google will validate on fetch.\\n')

def api_call(url, method='GET', headers=None, data=None):
    if headers is None:
        headers = {}
    headers['Authorization'] = f'Bearer {token}'
    req = urllib.request.Request(url, headers=headers, method=method, data=data)
    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            print(json.dumps({
                'status': 'access_denied',
                'message': f'Docs access denied for {email or \"unknown\"}'
            }))
            sys.exit(0)
        sys.stderr.write(f'API error {method} {url}: {e.code} {e.read().decode(\"utf-8\")}\\n')
        sys.exit(1)


doc = api_call(f'https://docs.googleapis.com/v1/documents/{doc_id}?suggestionsViewMode=SUGGESTIONS_INLINE')
body_content = doc.get('body', {}).get('content', [])
plain_text, index_map = extract_text_and_map(body_content)

occurrences = []
start = 0
while True:
    pos = plain_text.find(anchor, start)
    if pos == -1:
        break
    occurrences.append(pos)
    start = pos + 1

if not occurrences:
    sys.stderr.write(f'Anchor not found: \"{anchor}\"\\n')
    sys.exit(1)
if len(occurrences) > 1:
    sys.stderr.write(f'Anchor not unique: found {len(occurrences)} occurrences of \"{anchor}\"\\n')
    sys.exit(1)

c_start = occurrences[0]
last_char_idx = c_start + len(anchor) - 1
insert_idx = index_map[last_char_idx] + 1

# Execute insertInlineImage
req_body = {
    'requests': [
        {
            'insertInlineImage': {
                'uri': img_url,
                'location': {'index': insert_idx}
            }
        }
    ]
}

api_call(
    f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate',
    method='POST',
    headers={'Content-Type': 'application/json'},
    data=json.dumps(req_body).encode('utf-8')
)

print(json.dumps({
    'status': 'image_inserted',
    'docId': doc_id,
    'anchor': anchor,
    'index': insert_idx,
    'url': img_url
}, indent=2))
" "$DOC_ID" "$ANCHOR" "$URL" "$TOKEN" "${AGENT_USER_EMAIL:-}"
