#!/usr/bin/env bash
# docs-export-docx — Export a Google Doc to local .docx file format
# Brain agent: motor (WRITE)
# Usage: docs-export-docx --doc DOC_ID --out OUTPUT_FILE.docx
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-export-docx] [ERROR] $*" >&2; exit 1; }
DOC_ID="" OUT_FILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --out) OUT_FILE="$2"; shift 2 ;;
    --help|-h) echo "Usage: docs-export-docx --doc <doc_id> --out <output_file>"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" && -n "$OUT_FILE" ]] || die "Need --doc and --out"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

python3 -c "
import urllib.request, urllib.error, json, sys

doc_id = sys.argv[1]
out_file = sys.argv[2]
token = sys.argv[3]
email = sys.argv[4]

url = f'https://www.googleapis.com/drive/v3/files/{doc_id}/export?mimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document'
req = urllib.request.Request(url, headers={'Authorization': f'Bearer {token}'})

try:
    with urllib.request.urlopen(req) as response:
        content = response.read()
        with open(out_file, 'wb') as f:
            f.write(content)
    print(json.dumps({
        'status': 'exported',
        'docId': doc_id,
        'out': out_file,
        'bytes': len(content)
    }, indent=2))
except urllib.error.HTTPError as e:
    body = e.read().decode('utf-8', 'replace')
    low = body.lower()
    # files.export caps at 10MB; that surfaces as a 403 whose body mentions size,
    # distinct from an auth 403.
    if e.code == 403 and ('too large' in low or 'exportsizelimitexceeded' in low or 'export size' in low):
        print(json.dumps({
            'status': 'export_too_large',
            'docId': doc_id,
            'message': 'Document exceeds the 10MB files.export size limit'
        }))
        sys.exit(0)
    if e.code in [401, 403]:
        print(json.dumps({
            'status': 'access_denied',
            'message': f'Docs export denied for {email or \"unknown\"}'
        }))
        sys.exit(0)
    sys.stderr.write(f'Export failed: {e.code} {body}\\n')
    sys.exit(1)
" "$DOC_ID" "$OUT_FILE" "$TOKEN" "${AGENT_USER_EMAIL:-}"
