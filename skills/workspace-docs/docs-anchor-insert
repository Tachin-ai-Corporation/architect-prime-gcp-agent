#!/usr/bin/env bash
# docs-anchor-insert — Insert text immediately before or after a unique anchor phrase
# Brain agent: motor (WRITE)
# Usage: docs-anchor-insert --doc DOC_ID --anchor "phrase" --text "inserted text" --position before|after
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-anchor-insert] [ERROR] $*" >&2; exit 1; }
DOC_ID="" ANCHOR="" TEXT="" POSITION="after"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --anchor) ANCHOR="$2"; shift 2 ;;
    --text) TEXT="$2"; shift 2 ;;
    --position) POSITION="$2"; shift 2 ;;
    --help|-h) echo "Usage: docs-anchor-insert --doc <doc_id> --anchor <anchor_phrase> --text <text> [--position before|after]"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" && -n "$ANCHOR" && -n "$TEXT" ]] || die "Need --doc, --anchor, and --text"
[[ "$POSITION" == "before" || "$POSITION" == "after" ]] || die "--position must be 'before' or 'after'"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

# Read structured data via python
python3 -c "
import urllib.request, urllib.error, json, sys

doc_id = sys.argv[1]
anchor = sys.argv[2]
text_to_insert = sys.argv[3]
position = sys.argv[4]
token = sys.argv[5]
email = sys.argv[6]

def api_call(url, method='GET', headers=None, data=None):
    if headers is None:
        headers = {}
    headers['Authorization'] = f'Bearer {token}'
    req = urllib.request.Request(url, headers=headers, method=method, data=data)
    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            print(json.dumps({
                'status': 'access_denied',
                'message': f'Docs access denied for {email or \"unknown\"}'
            }))
            sys.exit(0)
        sys.stderr.write(f'API error {method} {url}: {e.code} {e.read().decode(\"utf-8\")}\\n')
        sys.exit(1)

def extract_text_and_map(elements):
    text = ''
    index_map = []
    for elem in elements:
        if 'paragraph' in elem:
            for run_elem in elem['paragraph'].get('elements', []):
                if 'textRun' in run_elem:
                    tr = run_elem['textRun']
                    content = tr.get('content', '')
                    start = tr.get('startIndex', 0)
                    for i, char in enumerate(content):
                        text += char
                        index_map.append(start + i)
        elif 'table' in elem:
            for row in elem['table'].get('tableRows', []):
                for cell in row.get('tableCells', []):
                    sub_text, sub_map = extract_text_and_map(cell.get('content', []))
                    text += sub_text
                    index_map.extend(sub_map)
        elif 'tableOfContents' in elem:
            sub_text, sub_map = extract_text_and_map(elem['tableOfContents'].get('content', []))
            text += sub_text
            index_map.extend(sub_map)
    return text, index_map

# NOTE: do NOT pass includeTabsContent=true — that flag empties the legacy
# doc['body'], so extract_text_and_map would see no text and every anchor would
# report 'not found'. Omitting it populates body from the first tab (matches docs-cat).
doc = api_call(f'https://docs.googleapis.com/v1/documents/{doc_id}?suggestionsViewMode=SUGGESTIONS_INLINE')
body_content = doc.get('body', {}).get('content', [])
plain_text, index_map = extract_text_and_map(body_content)

# Search for the anchor phrase
occurrences = []
start = 0
while True:
    pos = plain_text.find(anchor, start)
    if pos == -1:
        break
    occurrences.append(pos)
    start = pos + 1

if not occurrences:
    sys.stderr.write(f'Anchor not found: \"{anchor}\"\\n')
    sys.exit(1)
if len(occurrences) > 1:
    sys.stderr.write(f'Anchor not unique: found {len(occurrences)} occurrences of \"{anchor}\"\\n')
    sys.exit(1)

c_start = occurrences[0]
if position == 'before':
    insert_idx = index_map[c_start]
else:
    # Insert after the last character of the anchor phrase
    last_char_idx = c_start + len(anchor) - 1
    insert_idx = index_map[last_char_idx] + 1
    # Boundary guard: the body owns a trailing newline, so the highest legal
    # insertion index is doc_end-1. If the anchor's last char sits at a
    # paragraph/structure boundary (end of body), the +1 can point past the last
    # valid index and 400 the batchUpdate — clamp to the paragraph/body end.
    doc_end = body_content[-1].get('endIndex', 1) if body_content else 1
    if insert_idx > doc_end - 1:
        insert_idx = doc_end - 1

# Execute insert
req_body = {
    'requests': [
        {
            'insertText': {
                'location': {'index': insert_idx},
                'text': text_to_insert
            }
        }
    ]
}

api_call(
    f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate',
    method='POST',
    headers={'Content-Type': 'application/json'},
    data=json.dumps(req_body).encode('utf-8')
)

print(json.dumps({
    'status': 'inserted',
    'docId': doc_id,
    'anchor': anchor,
    'index': insert_idx,
    'position': position
}, indent=2))
" "$DOC_ID" "$ANCHOR" "$TEXT" "$POSITION" "$TOKEN" "${AGENT_USER_EMAIL:-}"
