#!/usr/bin/env bash
# docs-suggest - Suggest an edit in-place (highlighted yellow)
# Brain agent: motor (WRITE)
# Usage: docs-suggest --doc <doc> [--tab <tab>] --find <text> --replace <text> [--reason <reason>]
# Or:    docs-suggest --doc <doc> [--tab <tab>] --file <json_file>
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DOCS_API="https://docs.googleapis.com/v1/documents"
die() { echo "[docs-suggest] [ERROR] $*" >&2; exit 1; }

DOC_ID="" TARGET_TAB="" FIND="" REPLACE="" REASON="No reason provided" SUGG_FILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --tab) TARGET_TAB="$2"; shift 2 ;;
    --find) FIND="$2"; shift 2 ;;
    --replace) REPLACE="$2"; shift 2 ;;
    --reason) REASON="$2"; shift 2 ;;
    --file) SUGG_FILE="$2"; shift 2 ;;
    *) die "Unknown arg: $1" ;;
  esac
done

if [[ -n "$SUGG_FILE" ]]; then
  [[ -f "$SUGG_FILE" ]] || die "File not found: $SUGG_FILE"
  export SUGG_FILE
else
  [[ -n "$FIND" ]] || die "Missing --find or --file"
  export FIND REPLACE REASON
fi

[[ -n "$DOC_ID" ]] || die "Missing --doc"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

export DOC_ID TARGET_TAB

rm -f /tmp/docs-suggest-body.json /tmp/docs-suggest-result.json

HTTP_CODE=$(curl -s -o /tmp/docs-suggest-read.json -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" "${DOCS_API}/${DOC_ID}?includeTabsContent=true")
[[ "$HTTP_CODE" == "200" ]] || die "Failed to read doc, HTTP $HTTP_CODE"

python3 -c "
import json, sys, os

doc = json.load(open('/tmp/docs-suggest-read.json'))
target_tab_id = os.environ.get('TARGET_TAB', '')

sugg_file = os.environ.get('SUGG_FILE', '')
if sugg_file:
    with open(sugg_file) as f:
        edits = json.load(f)
else:
    edits = [{'find': os.environ.get('FIND', ''), 'replace': os.environ.get('REPLACE', ''), 'reason': os.environ.get('REASON', '')}]

def find_tab(tabs, target_id):
    for t in tabs:
        if not target_id or t.get('tabProperties', {}).get('tabId') == target_id:
            return t
        found = find_tab(t.get('childTabs', []), target_id)
        if found: return found
    return None

tabs = doc.get('tabs', [])
if not tabs:
    # Older documents without tabs have body at the root
    content = doc.get('body', {}).get('content', [])
    target_tab_id = ''
else:
    tab = find_tab(tabs, target_tab_id) if target_tab_id else tabs[0]
    if not tab:
        print('error:Tab not found', file=sys.stderr)
        sys.exit(1)
    target_tab_id = tab.get('tabProperties', {}).get('tabId', '')
    content = tab.get('documentTab', {}).get('body', {}).get('content', [])

full_text = ''
body_start_index = 1

for elem in content:
    if 'paragraph' in elem:
        para = elem['paragraph']
        para_text = ''.join([run.get('textRun', {}).get('content', '') for run in para.get('elements', [])])
        full_text += para_text

body_text = full_text[body_start_index-1:]

matched_edits = []
not_found_edits = []

# To handle multiple occurrences, we consume the string so we don't match the same instance twice
last_search_idx = 0

for edit in edits:
    find_text = edit.get('find', '')
    if not find_text: continue
    
    # Simple search from the beginning of body
    match_offset = body_text.find(find_text)
    
    if match_offset == -1:
        not_found_edits.append(edit)
    else:
        # Avoid duplicate matches on identical strings by obfuscating the found part in our search buffer
        # A bit hacky but prevents mapping 5 identical finds to the same index
        match_start = body_start_index + match_offset
        matched_edits.append({
            'edit': edit,
            'match_start': match_start,
            'match_end': match_start + len(find_text)
        })
        # blank it out in our local buffer so next search doesn't hit it
        body_text = body_text[:match_offset] + (' ' * len(find_text)) + body_text[match_offset+len(find_text):]

# Sort descending by match_start so bottom-up replacements don't shift indices
matched_edits.sort(key=lambda x: x['match_start'], reverse=True)

body_requests = []
applied_changes = []
change_count = 0

for item in matched_edits:
    edit = item['edit']
    match_start = item['match_start']
    match_end = item['match_end']
    find_text = edit.get('find', '')
    replace_text = edit.get('replace', '')
    reason = edit.get('reason', 'No reason provided')
    
    change_count += 1
    next_change_id = change_count
    
    body_requests.extend([
        {
            'deleteContentRange': {
                'range': {'startIndex': match_start, 'endIndex': match_end, 'tabId': target_tab_id} if target_tab_id else {'startIndex': match_start, 'endIndex': match_end}
            }
        },
        {
            'insertText': {
                'location': {'index': match_start, 'tabId': target_tab_id} if target_tab_id else {'index': match_start},
                'text': replace_text
            }
        },
        {
            'updateTextStyle': {
                'range': {'startIndex': match_start, 'endIndex': match_start + len(replace_text), 'tabId': target_tab_id} if target_tab_id else {'startIndex': match_start, 'endIndex': match_start + len(replace_text)},
                'textStyle': {'backgroundColor': {'color': {'rgbColor': {'red': 1.0, 'green': 1.0, 'blue': 0.0}}}},
                'fields': 'backgroundColor'
            }
        }
    ])
    
    applied_changes.append({
        'changeId': next_change_id,
        'find': find_text,
        'replace': replace_text
    })

if not body_requests:
    print(json.dumps({'status': 'no_changes_applied', 'not_found': not_found_edits}))
    sys.exit(0)

with open('/tmp/docs-suggest-body.json', 'w') as f:
    json.dump({'requests': body_requests}, f)

with open('/tmp/docs-suggest-result.json', 'w') as f:
    json.dump({
        'status': 'suggested',
        'docId': os.environ.get('DOC_ID', ''),
        'applied': applied_changes,
        'not_found': not_found_edits
    }, f, indent=2)
" || die "Failed to parse for suggestion"

if [[ ! -f /tmp/docs-suggest-body.json ]]; then
    exit 0
fi

BODY_REQ=$(cat /tmp/docs-suggest-body.json)
HTTP_CODE=$(curl -s -o /tmp/docs-suggest-body-resp.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "${BODY_REQ}" "${DOCS_API}/${DOC_ID}:batchUpdate")
[[ "$HTTP_CODE" == "200" ]] || die "Failed to apply body edit, HTTP $HTTP_CODE"

cat /tmp/docs-suggest-result.json
