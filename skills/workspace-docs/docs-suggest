#!/usr/bin/env bash
# docs-suggest - Suggest an edit in-place (highlighted yellow)
# Brain agent: motor (WRITE)
# Usage: docs-suggest --doc <doc> [--tab <tab>] --find <text> --replace <text> [--reason <reason>]
# Or:    docs-suggest --doc <doc> [--tab <tab>] --file <json_file>
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DOCS_API="https://docs.googleapis.com/v1/documents"
die() { echo "[docs-suggest] [ERROR] $*" >&2; exit 1; }

DOC_ID="" TARGET_TAB="" FIND="" REPLACE="" REASON="No reason provided" SUGG_FILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --tab) TARGET_TAB="$2"; shift 2 ;;
    --find) FIND="$2"; shift 2 ;;
    --replace) REPLACE="$2"; shift 2 ;;
    --reason) REASON="$2"; shift 2 ;;
    --file) SUGG_FILE="$2"; shift 2 ;;
    *) die "Unknown arg: $1" ;;
  esac
done

if [[ -n "$SUGG_FILE" ]]; then
  [[ -f "$SUGG_FILE" ]] || die "File not found: $SUGG_FILE"
  export SUGG_FILE
else
  [[ -n "$FIND" ]] || die "Missing --find or --file"
  export FIND REPLACE REASON
fi

[[ -n "$DOC_ID" ]] || die "Missing --doc"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

export DOC_ID TARGET_TAB

READ_JSON="$(mktemp)"
BODY_JSON="$(mktemp)"
RESULT_JSON="$(mktemp)"
RESP_JSON="$(mktemp)"
trap 'rm -f "$READ_JSON" "$BODY_JSON" "$RESULT_JSON" "$RESP_JSON"' EXIT
export READ_JSON BODY_JSON RESULT_JSON

HTTP_CODE=$(curl -s -o "$READ_JSON" -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" "${DOCS_API}/${DOC_ID}?includeTabsContent=true")
[[ "$HTTP_CODE" == "200" ]] || die "Failed to read doc, HTTP $HTTP_CODE"

python3 -c "
import json, sys, os

doc = json.load(open(os.environ['READ_JSON']))
target_tab_id = os.environ.get('TARGET_TAB', '')

sugg_file = os.environ.get('SUGG_FILE', '')
if sugg_file:
    with open(sugg_file) as f:
        edits = json.load(f)
else:
    edits = [{'find': os.environ.get('FIND', ''), 'replace': os.environ.get('REPLACE', ''), 'reason': os.environ.get('REASON', '')}]

def find_tab(tabs, target_id):
    for t in tabs:
        if not target_id or t.get('tabProperties', {}).get('tabId') == target_id:
            return t
        found = find_tab(t.get('childTabs', []), target_id)
        if found: return found
    return None

tabs = doc.get('tabs', [])
if not tabs:
    # Older documents without tabs have body at the root
    content = doc.get('body', {}).get('content', [])
    target_tab_id = ''
else:
    tab = find_tab(tabs, target_tab_id) if target_tab_id else tabs[0]
    if not tab:
        print('error:Tab not found', file=sys.stderr)
        sys.exit(1)
    target_tab_id = tab.get('tabProperties', {}).get('tabId', '')
    content = tab.get('documentTab', {}).get('body', {}).get('content', [])

# Canonical text/index mapper (shared verbatim with the other Lane-B scripts):
# recurses tables + TOC and maps each char to its TRUE API startIndex.
def extract_text_and_map(elements):
    text = ''
    index_map = []
    for elem in elements:
        if 'paragraph' in elem:
            for run_elem in elem['paragraph'].get('elements', []):
                if 'textRun' in run_elem:
                    tr = run_elem['textRun']
                    content = tr.get('content', '')
                    start = run_elem.get('startIndex', 0)
                    for i, char in enumerate(content):
                        text += char
                        index_map.append(start + i)
        elif 'table' in elem:
            for row in elem['table'].get('tableRows', []):
                for cell in row.get('tableCells', []):
                    sub_text, sub_map = extract_text_and_map(cell.get('content', []))
                    text += sub_text
                    index_map.extend(sub_map)
        elif 'tableOfContents' in elem:
            sub_text, sub_map = extract_text_and_map(elem['tableOfContents'].get('content', []))
            text += sub_text
            index_map.extend(sub_map)
    return text, index_map

body_text, index_map = extract_text_and_map(content)

# Mutable search buffer, same length as body_text so offsets stay aligned with index_map.
# Each match is blanked with equal-length spaces so identical strings map to distinct
# instances, while the offset we feed into index_map still refers to the ORIGINAL char
# positions (spaces preserve length -> preserve alignment).
search_text = body_text

matched_edits = []
not_found_edits = []

for edit in edits:
    find_text = edit.get('find', '')
    if not find_text: continue

    # Search the mutable buffer; off is an offset into the ORIGINAL char stream.
    off = search_text.find(find_text)

    if off == -1:
        not_found_edits.append(edit)
    else:
        # True API indices come from index_map, never from arithmetic on a hardcoded base.
        match_start = index_map[off]
        match_end = index_map[off + len(find_text) - 1] + 1
        matched_edits.append({
            'edit': edit,
            'match_start': match_start,
            'match_end': match_end
        })
        # Blank the found span (equal length) so the next search skips this instance
        # without disturbing offset->index_map alignment.
        search_text = search_text[:off] + (' ' * len(find_text)) + search_text[off+len(find_text):]

# Sort descending by match_start so bottom-up replacements don't shift indices
matched_edits.sort(key=lambda x: x['match_start'], reverse=True)

body_requests = []
applied_changes = []
change_count = 0

for item in matched_edits:
    edit = item['edit']
    match_start = item['match_start']
    match_end = item['match_end']
    find_text = edit.get('find', '')
    replace_text = edit.get('replace', '')
    reason = edit.get('reason', 'No reason provided')

    change_count += 1
    next_change_id = change_count

    del_range = {'startIndex': match_start, 'endIndex': match_end}
    if target_tab_id:
        del_range['tabId'] = target_tab_id
    body_requests.append({'deleteContentRange': {'range': del_range}})

    # Empty-replace guard: a pure redaction is delete-only. insertText with empty text
    # and updateTextStyle over an empty range both 400, so skip them when replace is blank.
    if replace_text != '':
        ins_loc = {'index': match_start}
        if target_tab_id:
            ins_loc['tabId'] = target_tab_id
        body_requests.append({
            'insertText': {'location': ins_loc, 'text': replace_text}
        })

        style_range = {'startIndex': match_start, 'endIndex': match_start + len(replace_text)}
        if target_tab_id:
            style_range['tabId'] = target_tab_id
        body_requests.append({
            'updateTextStyle': {
                'range': style_range,
                'textStyle': {'backgroundColor': {'color': {'rgbColor': {'red': 1.0, 'green': 1.0, 'blue': 0.0}}}},
                'fields': 'backgroundColor'
            }
        })

    applied_changes.append({
        'changeId': next_change_id,
        'find': find_text,
        'replace': replace_text
    })

if not body_requests:
    print(json.dumps({'status': 'no_changes_applied', 'not_found': not_found_edits}))
    sys.exit(0)

with open(os.environ['BODY_JSON'], 'w') as f:
    json.dump({'requests': body_requests}, f)

with open(os.environ['RESULT_JSON'], 'w') as f:
    json.dump({
        'status': 'suggested',
        'docId': os.environ.get('DOC_ID', ''),
        'applied': applied_changes,
        'not_found': not_found_edits
    }, f, indent=2)
" || die "Failed to parse for suggestion"

if [[ ! -s "$BODY_JSON" ]]; then
    exit 0
fi

BODY_REQ=$(cat "$BODY_JSON")
HTTP_CODE=$(curl -s -o "$RESP_JSON" -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "${BODY_REQ}" "${DOCS_API}/${DOC_ID}:batchUpdate")
[[ "$HTTP_CODE" == "200" ]] || die "Failed to apply body edit, HTTP $HTTP_CODE"

cat "$RESULT_JSON"
