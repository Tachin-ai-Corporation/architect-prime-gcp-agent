#!/usr/bin/env bash
# docs-style — Apply styling or heading levels to an anchor phrase or text range
# Brain agent: motor (WRITE)
# Usage: docs-style --doc DOC_ID (--anchor "phrase" | --start START_IDX --end END_IDX) --style "HEADING_1|bold|italic|align=CENTER|color=#FF0000|font=Montserrat|size=14"
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-style] [ERROR] $*" >&2; exit 1; }
DOC_ID="" ANCHOR="" START_IDX="" END_IDX="" STYLE_DESC=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --anchor) ANCHOR="$2"; shift 2 ;;
    --start) START_IDX="$2"; shift 2 ;;
    --end) END_IDX="$2"; shift 2 ;;
    --style) STYLE_DESC="$2"; shift 2 ;;
    --help|-h) echo "Usage: docs-style --doc <doc_id> (--anchor <phrase> | --start <start> --end <end>) --style <style>"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" && -n "$STYLE_DESC" ]] || die "Need --doc and --style"
[[ -n "$ANCHOR" || (-n "$START_IDX" && -n "$END_IDX") ]] || die "Need either --anchor or --start and --end"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

export DOCSLIB_DIR="${CORE_DIR}/bin"
python3 -c "
import urllib.request, urllib.error, json, sys, os
sys.path.insert(0, os.environ['DOCSLIB_DIR'])
from _docslib import extract_text_and_map

doc_id = sys.argv[1]
anchor = sys.argv[2]
start_idx_str = sys.argv[3]
end_idx_str = sys.argv[4]
style_desc = sys.argv[5]
token = sys.argv[6]
email = sys.argv[7]

def api_call(url, method='GET', headers=None, data=None):
    if headers is None:
        headers = {}
    headers['Authorization'] = f'Bearer {token}'
    req = urllib.request.Request(url, headers=headers, method=method, data=data)
    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            print(json.dumps({
                'status': 'access_denied',
                'message': f'Docs access denied for {email or \"unknown\"}'
            }))
            sys.exit(0)
        sys.stderr.write(f'API error {method} {url}: {e.code} {e.read().decode(\"utf-8\")}\\n')
        sys.exit(1)

def parse_hex(val):
    h = val.strip().lstrip('#')
    if len(h) == 3:
        h = ''.join(c * 2 for c in h)
    if len(h) != 6 or any(c not in '0123456789abcdefABCDEF' for c in h):
        return None
    return {'color': {'rgbColor': {
        'red': int(h[0:2], 16) / 255.0,
        'green': int(h[2:4], 16) / 255.0,
        'blue': int(h[4:6], 16) / 255.0
    }}}


# 1. Resolve range
if anchor:
    doc = api_call(f'https://docs.googleapis.com/v1/documents/{doc_id}?suggestionsViewMode=SUGGESTIONS_INLINE')
    body_content = doc.get('body', {}).get('content', [])
    plain_text, index_map = extract_text_and_map(body_content)

    occurrences = []
    start = 0
    while True:
        pos = plain_text.find(anchor, start)
        if pos == -1:
            break
        occurrences.append(pos)
        start = pos + 1

    if not occurrences:
        sys.stderr.write(f'Anchor not found: \"{anchor}\"\\n')
        sys.exit(1)
    if len(occurrences) > 1:
        sys.stderr.write(f'Anchor not unique: found {len(occurrences)} occurrences of \"{anchor}\"\\n')
        sys.exit(1)

    c_start = occurrences[0]
    start_idx = index_map[c_start]
    end_idx = index_map[c_start + len(anchor) - 1] + 1
else:
    start_idx = int(start_idx_str)
    end_idx = int(end_idx_str)

# 2. Parse style — comma-separated tokens
text_style = {}
p_style = {}

parts = [p.strip() for p in style_desc.split(',')]
for part in parts:
    if part == 'bold':
        text_style['bold'] = True
    elif part == 'italic':
        text_style['italic'] = True
    elif part == 'underline':
        text_style['underline'] = True
    elif part == 'strikethrough':
        text_style['strikethrough'] = True
    elif part.startswith('color='):
        c = parse_hex(part.split('=', 1)[1])
        if not c:
            sys.stderr.write(f'Invalid hex color: \"{part}\" (use #RRGGBB or #RGB)\\n')
            sys.exit(1)
        text_style['foregroundColor'] = c
    elif part.startswith('font='):
        font_name = part.split('=', 1)[1].strip()
        text_style['weightedFontFamily'] = {'fontFamily': font_name, 'weight': 400}
    elif part.startswith('size='):
        size_str = part.split('=', 1)[1].strip().rstrip('pt')
        try:
            text_style['fontSize'] = {'magnitude': float(size_str), 'unit': 'PT'}
        except ValueError:
            sys.stderr.write(f'Invalid size: \"{part}\" (use size=14 or size=14pt)\\n')
            sys.exit(1)
    elif part.startswith('highlight='):
        c = parse_hex(part.split('=', 1)[1])
        if not c:
            sys.stderr.write(f'Invalid highlight color: \"{part}\" (use #RRGGBB or #RGB)\\n')
            sys.exit(1)
        text_style['backgroundColor'] = c
    elif part.startswith('align='):
        align_val = part.split('=', 1)[1].strip().upper()
        align_map = {
            'LEFT': 'START', 'START': 'START',
            'RIGHT': 'END', 'END': 'END',
            'CENTER': 'CENTER', 'JUSTIFIED': 'JUSTIFIED'
        }
        if align_val not in align_map:
            sys.stderr.write(f'Invalid alignment: \"{align_val}\" (use START/LEFT, CENTER, END/RIGHT, or JUSTIFIED)\\n')
            sys.exit(1)
        p_style['alignment'] = align_map[align_val]
    elif part.startswith('lineSpacing='):
        try:
            p_style['lineSpacing'] = float(part.split('=', 1)[1].strip())
        except ValueError:
            sys.stderr.write(f'Invalid lineSpacing: \"{part}\" (use 100=single, 115=1.15x, 150=1.5x, 200=double)\\n')
            sys.exit(1)
    elif part.startswith('spaceAbove='):
        try:
            pts = float(part.split('=', 1)[1].strip().rstrip('pt'))
            p_style['spaceAbove'] = {'magnitude': pts, 'unit': 'PT'}
        except ValueError:
            sys.stderr.write(f'Invalid spaceAbove: \"{part}\" (use points, e.g. spaceAbove=6)\\n')
            sys.exit(1)
    elif part.startswith('spaceBelow='):
        try:
            pts = float(part.split('=', 1)[1].strip().rstrip('pt'))
            p_style['spaceBelow'] = {'magnitude': pts, 'unit': 'PT'}
        except ValueError:
            sys.stderr.write(f'Invalid spaceBelow: \"{part}\" (use points, e.g. spaceBelow=6)\\n')
            sys.exit(1)
    elif part.startswith('indent='):
        try:
            pts = float(part.split('=', 1)[1].strip().rstrip('pt'))
            p_style['indentStart'] = {'magnitude': pts, 'unit': 'PT'}
        except ValueError:
            sys.stderr.write(f'Invalid indent: \"{part}\" (use points, e.g. indent=36)\\n')
            sys.exit(1)
    elif part.startswith('shade='):
        c = parse_hex(part.split('=', 1)[1])
        if not c:
            sys.stderr.write(f'Invalid shade color: \"{part}\" (use #RRGGBB or #RGB)\\n')
            sys.exit(1)
        p_style['shading'] = {'backgroundColor': c}
    elif part in ['HEADING_1', 'HEADING_2', 'HEADING_3', 'HEADING_4', 'HEADING_5', 'HEADING_6', 'TITLE', 'SUBTITLE', 'NORMAL_TEXT']:
        p_style['namedStyleType'] = part
    else:
        sys.stderr.write(f'Unknown style token: \"{part}\"\\n')
        sys.exit(1)

requests = []
if text_style:
    requests.append({
        'updateTextStyle': {
            'range': {
                'startIndex': start_idx,
                'endIndex': end_idx
            },
            'textStyle': text_style,
            'fields': ','.join(text_style.keys())
        }
    })
if p_style:
    requests.append({
        'updateParagraphStyle': {
            'range': {
                'startIndex': start_idx,
                'endIndex': end_idx
            },
            'paragraphStyle': p_style,
            'fields': ','.join(p_style.keys())
        }
    })

if not requests:
    sys.stderr.write(f'No recognized style tokens in \"{style_desc}\" — nothing to apply.\\n')
    sys.exit(1)

api_call(
    f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate',
    method='POST',
    headers={'Content-Type': 'application/json'},
    data=json.dumps({'requests': requests}).encode('utf-8')
)

print(json.dumps({
    'status': 'styled',
    'docId': doc_id,
    'range': {'startIndex': start_idx, 'endIndex': end_idx},
    'style': style_desc
}, indent=2))
" "$DOC_ID" "$ANCHOR" "$START_IDX" "$END_IDX" "$STYLE_DESC" "$TOKEN" "${AGENT_USER_EMAIL:-}"
