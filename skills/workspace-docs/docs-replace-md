#!/usr/bin/env bash
# docs-replace-md — Replace the body of a Google Doc with formatted Markdown
# Brain agent: motor (WRITE)
# Usage: docs-replace-md --doc DOC_ID (--file FILE_PATH | --text "markdown text")
#
# In-place Drive media update: PATCHes the doc with Content-Type text/markdown and
# lets Drive natively re-convert. Preserves the doc ID, URL, and sharing, and keeps
# tables/images/lists/TOC intact (unlike a hand-rolled element copy).
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-replace-md] [ERROR] $*" >&2; exit 1; }
DOC_ID="" FILE_PATH="" TEXT="" TEXT_SET=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --file) FILE_PATH="$2"; shift 2 ;;
    --text) TEXT="$2"; TEXT_SET=true; shift 2 ;;
    --help|-h) echo "Usage: docs-replace-md --doc <doc_id> (--file <file_path> | --text <text>)"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" ]] || die "Need --doc"
[[ -n "$FILE_PATH" || "$TEXT_SET" == "true" ]] || die "Need --file or --text"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"

# Resolve the markdown source to a file path so we can stream it (avoids ARG_MAX).
TMP_MD=""
if [[ -n "$FILE_PATH" ]]; then
  [[ -f "$FILE_PATH" ]] || die "File not found: $FILE_PATH"
  SRC="$FILE_PATH"
else
  TMP_MD="$(mktemp)"
  printf '%s' "$TEXT" > "$TMP_MD"
  SRC="$TMP_MD"
fi

RESP="$(mktemp)"
trap 'rm -f "$RESP" ${TMP_MD:+"$TMP_MD"}' EXIT

# In-place media update — Drive re-converts the markdown back into the existing Doc.
HTTP_CODE=$(curl -s -o "$RESP" -w '%{http_code}' -X PATCH \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: text/markdown" \
  --data-binary "@${SRC}" \
  "https://www.googleapis.com/upload/drive/v3/files/${DOC_ID}?uploadType=media&supportsAllDrives=true")

if [[ "$HTTP_CODE" == "401" || "$HTTP_CODE" == "403" ]]; then
  echo "{\"status\":\"access_denied\",\"message\":\"Docs access denied for ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Media update failed with HTTP ${HTTP_CODE}: $(cat "$RESP")"

python3 -c "
import json, sys
doc_id = sys.argv[1]
print(json.dumps({
    'status': 'replaced',
    'docId': doc_id,
    'mode': 'replace_md',
    'link': 'https://docs.google.com/document/d/' + doc_id
}, indent=2))
" "$DOC_ID"
