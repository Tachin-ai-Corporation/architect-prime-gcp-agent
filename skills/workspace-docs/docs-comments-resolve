#!/usr/bin/env bash
# docs-comments-resolve — Resolve/close a review comment thread on a Google Doc
# Brain agent: motor (WRITE)
# Usage: docs-comments-resolve --doc DOC_ID --comment-id CID [--content "Approved"]
# NOTE: Posts a Drive reply with action=resolve, which closes the comment thread.
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[docs-comments-resolve] [ERROR] $*" >&2; exit 1; }
DOC_ID="" COMMENT_ID="" CONTENT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --comment-id) COMMENT_ID="$2"; shift 2 ;;
    --content) CONTENT="$2"; shift 2 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" && -n "$COMMENT_ID" ]] || die "Need --doc and --comment-id"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
# A resolve reply requires a non-empty request; include a note only when given.
BODY=$(python3 -c "
import json, sys
b = {'action':'resolve'}
if sys.argv[1]:
    b['content'] = sys.argv[1]
print(json.dumps(b))
" "$CONTENT")
RESP="$(mktemp)"; trap 'rm -f "$RESP"' EXIT
HTTP_CODE=$(curl -s -o "$RESP" -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" \
  "${DRIVE_API}/files/${DOC_ID}/comments/${COMMENT_ID}/replies?fields=id,action,content,createdTime")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"message\":\"Comments access denied. Share doc with ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
if [[ "$HTTP_CODE" == "404" ]]; then
  echo "{\"status\":\"not_found\",\"commentId\":\"${COMMENT_ID}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Drive API returned HTTP ${HTTP_CODE}"
python3 -c "
import json, sys
r = json.load(open(sys.argv[1]))
print(json.dumps({'status':'resolved','commentId':sys.argv[2],'replyId':r.get('id','')}, indent=2))
" "$RESP" "$COMMENT_ID"
