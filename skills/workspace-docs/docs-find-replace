#!/usr/bin/env bash
# docs-find-replace — Find and replace text in a Google Doc
# Brain agent: motor (WRITE)
# Usage: docs-find-replace --doc DOC_ID --find "old text" --replace "new text" [--match-case]
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DOCS_API="https://docs.googleapis.com/v1/documents"
die() { echo "[docs-find-replace] [ERROR] $*" >&2; exit 1; }
DOC_ID="" FIND="" REPLACE="" MATCH_CASE=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;; --find) FIND="$2"; shift 2 ;;
    --replace) REPLACE="$2"; shift 2 ;; --match-case) MATCH_CASE=true; shift ;;
    *) die "Unknown: $1" ;; esac
done
[[ -n "$DOC_ID" && -n "$FIND" ]] || die "Need --doc and --find"
# Interpret \n and \t in --replace so callers get real line breaks, not literal backslashes.
REPLACE="${REPLACE//'\n'/$'\n'}"; REPLACE="${REPLACE//'\t'/$'\t'}"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"
BODY=$(python3 -c "
import json, sys
req = {'replaceAllText':{'containsText':{'text':sys.argv[1],'matchCase':sys.argv[3]=='true'},'replaceText':sys.argv[2]}}
print(json.dumps({'requests':[req]}))
" "$FIND" "$REPLACE" "$MATCH_CASE")
RESP="$(mktemp)"; trap 'rm -f "$RESP"' EXIT
HTTP_CODE=$(curl -s -o "$RESP" -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" "${DOCS_API}/${DOC_ID}:batchUpdate")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"message\":\"Doc access denied. Share with ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Docs API returned HTTP ${HTTP_CODE}"
# Pass RESP path, DOC_ID and FIND via argv so a FIND containing a quote or $(...)
# cannot break this block or inject shell — mirrors the safe argv pass above.
python3 -c "
import json, sys
resp_file, doc_id, find = sys.argv[1], sys.argv[2], sys.argv[3]
data = json.load(open(resp_file))
replies = data.get('replies',[{}])
count = replies[0].get('replaceAllText',{}).get('occurrencesChanged',0) if replies else 0
out = {'status':'replaced','docId':doc_id,'find':find,'occurrences':count,'applied':count>0}
if count == 0:
    out['note'] = 'Target not found: already applied by a prior run, or never present. Confirm the NEW text is in the doc before treating this edit as done.'
print(json.dumps(out, indent=2))
" "$RESP" "$DOC_ID" "$FIND"
