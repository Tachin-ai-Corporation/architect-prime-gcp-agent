#!/usr/bin/env bash
# docs-tab-clone - Clone a tab's text content into a new suggestion tab
# Brain agent: motor (WRITE)
# Usage: docs-tab-clone --doc <doc_id> --source-tab <tab_id> [--title "Custom Title"]
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DOCS_API="https://docs.googleapis.com/v1/documents"
die() { echo "[docs-tab-clone] [ERROR] $*" >&2; exit 1; }

DOC_ID="" SOURCE_TAB="" TITLE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --source-tab) SOURCE_TAB="$2"; shift 2 ;;
    --title) TITLE="$2"; shift 2 ;;
    *) die "Unknown arg: $1" ;;
  esac
done

[[ -n "$DOC_ID" && -n "$SOURCE_TAB" ]] || die "Need --doc and --source-tab"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

# Export vars so python can read them securely from environment
export DOC_ID SOURCE_TAB TITLE

HTTP_CODE=$(curl -s -o /tmp/docs-clone-source.json -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" "${DOCS_API}/${DOC_ID}?includeTabsContent=true")
[[ "$HTTP_CODE" == "200" ]] || die "Failed to read doc, HTTP $HTTP_CODE"

python3 -c "
import json, sys, os

doc = json.load(open('/tmp/docs-clone-source.json'))
source_tab_id = os.environ.get('SOURCE_TAB', '')
custom_title = os.environ.get('TITLE', '')

def find_tab(tabs, target_id):
    for t in tabs:
        if t.get('tabProperties', {}).get('tabId') == target_id:
            return t
        found = find_tab(t.get('childTabs', []), target_id)
        if found: return found
    return None

source_tab = find_tab(doc.get('tabs', []), source_tab_id)
if not source_tab:
    print('error:Source tab not found', file=sys.stderr)
    sys.exit(1)

source_title = source_tab.get('tabProperties', {}).get('title', 'Unknown')
pencil_emoji = '\u270f\ufe0f'
em_dash = '\u2014'
new_title = custom_title if custom_title else f'{pencil_emoji} Edits {em_dash} {source_title}'

text_parts = []
headings = []

header_text = '================================\n* REVIEW: suggested changes\nAll changes will be applied. Check any to REJECT.\n================================\n\n================================\n\n'
current_index = 1 + len(header_text)

content = source_tab.get('documentTab', {}).get('body', {}).get('content', [])
for elem in content:
    if 'paragraph' in elem:
        para = elem['paragraph']
        style = para.get('paragraphStyle', {}).get('namedStyleType')
        is_heading = style in ['TITLE', 'SUBTITLE'] or style.startswith('HEADING_')
        
        para_text = ''
        for run in para.get('elements', []):
            tc = run.get('textRun', {}).get('content', '')
            if tc: para_text += tc
            
        if para_text:
            text_parts.append(para_text)
            para_len = len(para_text)
            if is_heading:
                headings.append({
                    'startIndex': current_index,
                    'endIndex': current_index + para_len - 1,
                    'styleType': style
                })
            current_index += para_len

with open('/tmp/docs-clone-data.json', 'w') as f:
    json.dump({
        'newTitle': new_title,
        'sourceTitle': source_title,
        'text': header_text + ''.join(text_parts),
        'headings': headings
    }, f)
" || die "Failed to parse source tab"

NEW_TITLE=$(python3 -c "import json; print(json.load(open('/tmp/docs-clone-data.json'))['newTitle'])")
SOURCE_TITLE=$(python3 -c "import json; print(json.load(open('/tmp/docs-clone-data.json'))['sourceTitle'])")

CREATE_REQ=$(python3 -c "
import json
title = json.load(open('/tmp/docs-clone-data.json'))['newTitle']
print(json.dumps({'requests':[{'addDocumentTab':{'tabProperties':{'title':title}}}]}))
")
HTTP_CODE=$(curl -s -o /tmp/docs-clone-create.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "${CREATE_REQ}" "${DOCS_API}/${DOC_ID}:batchUpdate")
[[ "$HTTP_CODE" == "200" ]] || die "Failed to create tab, HTTP $HTTP_CODE"

NEW_TAB_ID=$(python3 -c "import json; print(json.load(open('/tmp/docs-clone-create.json')).get('replies',[{}])[0].get('addDocumentTab',{}).get('tabId',''))")
[[ -n "$NEW_TAB_ID" ]] || die "Failed to get new tab ID"

export NEW_TAB_ID

python3 -c "
import json, os
data = json.load(open('/tmp/docs-clone-data.json'))
new_tab_id = os.environ.get('NEW_TAB_ID', '')
text = data['text']
headings = data['headings']

requests = []
if text:
    requests.append({
        'insertText': {
            'location': {'index': 1, 'tabId': new_tab_id},
            'text': text
        }
    })

for h in headings:
    requests.append({
        'updateParagraphStyle': {
            'range': {'startIndex': h['startIndex'], 'endIndex': h['endIndex'], 'tabId': new_tab_id},
            'paragraphStyle': {'namedStyleType': h['styleType']},
            'fields': 'namedStyleType'
        }
    })

with open('/tmp/docs-clone-update.json', 'w') as f:
    json.dump({'requests': requests}, f)
"
UPDATE_REQ=$(cat /tmp/docs-clone-update.json)
if [[ "$UPDATE_REQ" != '{"requests": []}' ]]; then
  HTTP_CODE=$(curl -s -o /tmp/docs-clone-update-resp.json -w '%{http_code}' \
    -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
    -d "${UPDATE_REQ}" "${DOCS_API}/${DOC_ID}:batchUpdate")
  [[ "$HTTP_CODE" == "200" ]] || die "Failed to insert text/headings, HTTP $HTTP_CODE"
fi

python3 -c "
import json, os, sys
print(json.dumps({
    'status': 'cloned',
    'docId': os.environ.get('DOC_ID', ''),
    'sourceTabId': os.environ.get('SOURCE_TAB', ''),
    'sourceTabTitle': sys.argv[1],
    'suggestionTabId': os.environ.get('NEW_TAB_ID', ''),
    'suggestionTabTitle': sys.argv[2]
}, indent=2))
" "$SOURCE_TITLE" "$NEW_TITLE"
