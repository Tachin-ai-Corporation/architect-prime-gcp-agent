#!/usr/bin/env bash
# docs-section-delete — Delete a contiguous region of a Google Doc: from a
# unique anchor phrase to the end of the document, or an explicit index range.
# Brain agent: motor (WRITE)
#
# This is the primitive that was missing when finalizing redlined agreements:
# docs-find-replace can only swap known strings, and rebuilding the whole body
# from docs-cat text is brittle. To strip a trailing section (e.g. a
# "[LEGAL REVIEW REDLINES]" block) and leave the rest untouched, anchor on the
# section's heading and delete to the end.
#
# Usage:
#   docs-section-delete --doc DOC_ID --from-anchor "[LEGAL REVIEW REDLINES]"
#       Delete from the anchor (inclusive) to the end of the document.
#   docs-section-delete --doc DOC_ID --from-anchor "PHRASE" --keep-anchor
#       Delete everything AFTER the anchor, keeping the anchor line itself.
#   docs-section-delete --doc DOC_ID --start 1240 --end 2380
#       Delete an explicit index range. --start/--end are RAW Docs API indices
#       sourced from docs-get — NOT docs-cat --meta plaintext offsets. The two
#       index models diverge on any doc containing a table/image, so feeding a
#       --meta offset here deletes the wrong range. An --end past EOF is clamped
#       to the document's last valid index.
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-section-delete] [ERROR] $*" >&2; exit 1; }

DOC_ID="" ANCHOR="" KEEP_ANCHOR=false START_IDX="" END_IDX=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc)         DOC_ID="$2"; shift 2 ;;
    --from-anchor) ANCHOR="$2"; shift 2 ;;
    --keep-anchor) KEEP_ANCHOR=true; shift ;;
    --start)       START_IDX="$2"; shift 2 ;;
    --end)         END_IDX="$2"; shift 2 ;;
    --help|-h)     echo "Usage: docs-section-delete --doc <id> (--from-anchor \"phrase\" [--keep-anchor] | --start N --end N)"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" ]] || die "Need --doc"
if [[ -z "$ANCHOR" && ( -z "$START_IDX" || -z "$END_IDX" ) ]]; then
  die "Provide --from-anchor \"phrase\", or both --start and --end"
fi
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

python3 -c "
import urllib.request, urllib.error, json, sys

doc_id, anchor, keep_anchor, start_arg, end_arg, token, email = sys.argv[1:8]
keep_anchor = (keep_anchor == 'true')

def api_call(url, method='GET', headers=None, data=None):
    headers = dict(headers or {}); headers['Authorization'] = f'Bearer {token}'
    req = urllib.request.Request(url, headers=headers, method=method, data=data)
    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            print(json.dumps({'status':'access_denied','message':f'Docs access denied for {email or \"unknown\"}'}))
            sys.exit(0)
        sys.stderr.write(f'API error {method} {url}: {e.code} {e.read().decode(\"utf-8\")}\n'); sys.exit(1)

def extract_text_and_map(elements):
    text, index_map = '', []
    for elem in elements:
        if 'paragraph' in elem:
            for run_elem in elem['paragraph'].get('elements', []):
                tr = run_elem.get('textRun')
                if tr:
                    content = tr.get('content', ''); start = run_elem.get('startIndex', 0)
                    for i, ch in enumerate(content):
                        text += ch; index_map.append(start + i)
        elif 'table' in elem:
            for row in elem['table'].get('tableRows', []):
                for cell in row.get('tableCells', []):
                    t, m = extract_text_and_map(cell.get('content', [])); text += t; index_map.extend(m)
        elif 'tableOfContents' in elem:
            t, m = extract_text_and_map(elem['tableOfContents'].get('content', [])); text += t; index_map.extend(m)
    return text, index_map

doc = api_call(f'https://docs.googleapis.com/v1/documents/{doc_id}')
content = doc.get('body', {}).get('content', [])
# Document end index (last structural element's endIndex). A trailing newline is
# owned by the body; deleteContentRange must stop at end_of_body-1.
doc_end = content[-1].get('endIndex', 1) if content else 1
del_end = doc_end - 1

if anchor:
    plain, index_map = extract_text_and_map(content)
    occ, s = [], 0
    while True:
        p = plain.find(anchor, s)
        if p == -1: break
        occ.append(p); s = p + 1
    if not occ:
        sys.stderr.write(f'Anchor not found: \"{anchor}\"\n'); sys.exit(1)
    if len(occ) > 1:
        sys.stderr.write(f'Anchor not unique: {len(occ)} occurrences of \"{anchor}\"\n'); sys.exit(1)
    c0 = occ[0]
    if keep_anchor:
        # delete AFTER the anchor's last char
        del_start = index_map[c0 + len(anchor) - 1] + 1
    else:
        del_start = index_map[c0]
else:
    del_start = int(start_arg)
    # Clamp an explicit --end past EOF: deleteContentRange 400s if endIndex
    # exceeds the body's last valid index (doc_end-1).
    del_end = min(int(end_arg), doc_end - 1)

if del_start < 1: del_start = 1
if del_end <= del_start:
    print(json.dumps({'status':'noop','docId':doc_id,'reason':'empty or inverted range',
                      'start':del_start,'end':del_end})); sys.exit(0)

api_call(f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate',
         method='POST', headers={'Content-Type':'application/json'},
         data=json.dumps({'requests':[{'deleteContentRange':{'range':{'startIndex':del_start,'endIndex':del_end}}}]}).encode('utf-8'))

print(json.dumps({'status':'deleted','docId':doc_id,'start':del_start,'end':del_end,
                  'chars_deleted':del_end-del_start,'anchor':anchor or None,'kept_anchor':keep_anchor}, indent=2))
" "$DOC_ID" "$ANCHOR" "$KEEP_ANCHOR" "${START_IDX:-0}" "${END_IDX:-0}" "$TOKEN" "${AGENT_USER_EMAIL:-}"
