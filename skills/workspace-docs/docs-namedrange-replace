#!/usr/bin/env bash
# docs-namedrange-replace — Replace the content of a named range
# Brain agent: motor (WRITE)
# Usage: docs-namedrange-replace --doc DOC_ID --name RANGE_NAME --text "new content"
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-namedrange-replace] [ERROR] $*" >&2; exit 1; }
DOC_ID="" NAME="" TEXT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --name) NAME="$2"; shift 2 ;;
    --text) TEXT="$2"; shift 2 ;;
    --help|-h) echo "Usage: docs-namedrange-replace --doc <doc_id> --name <range_name> --text <text>"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" && -n "$NAME" && -n "$TEXT" ]] || die "Need --doc, --name, and --text"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

python3 -c "
import urllib.request, urllib.error, json, sys

doc_id = sys.argv[1]
name = sys.argv[2]
text = sys.argv[3]
token = sys.argv[4]
email = sys.argv[5]

req_body = {
    'requests': [
        {
            'replaceNamedRangeContent': {
                'namedRangeName': name,
                'text': text
            }
        }
    ]
}

url = f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate'
req = urllib.request.Request(
    url,
    data=json.dumps(req_body).encode('utf-8'),
    headers={
        'Authorization': f'Bearer {token}',
        'Content-Type': 'application/json'
    },
    method='POST'
)

try:
    with urllib.request.urlopen(req) as response:
        resp = json.loads(response.read().decode('utf-8'))
        replies = resp.get('replies', [{}])
        # Find occurrences changed
        count = 0
        if replies and 'replaceNamedRangeContent' in replies[0]:
            count = replies[0]['replaceNamedRangeContent'].get('occurrencesChanged', 0)
        print(json.dumps({
            'status': 'namedrange_replaced',
            'docId': doc_id,
            'name': name,
            'occurrencesChanged': count
        }, indent=2))
except urllib.error.HTTPError as e:
    if e.code in [401, 403]:
        print(json.dumps({
            'status': 'access_denied',
            'message': f'Docs access denied for {email or \"unknown\"}'
        }))
        sys.exit(0)
    sys.stderr.write(f'Named range replace failed: {e.code} {e.read().decode(\"utf-8\")}\\n')
    sys.exit(1)
" "$DOC_ID" "$NAME" "$TEXT" "$TOKEN" "${AGENT_USER_EMAIL:-}"
