#!/usr/bin/env bash
# docs-namedrange-replace — Replace the content of a named range
# Brain agent: motor (WRITE)
# Usage: docs-namedrange-replace --doc DOC_ID --name RANGE_NAME --text "new content"
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-namedrange-replace] [ERROR] $*" >&2; exit 1; }
DOC_ID="" NAME="" TEXT="" HAVE_TEXT=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --name) NAME="$2"; shift 2 ;;
    --text) TEXT="$2"; HAVE_TEXT=1; shift 2 ;;
    --help|-h) echo "Usage: docs-namedrange-replace --doc <doc_id> --name <range_name> --text <text>"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" && -n "$NAME" ]] || die "Need --doc and --name"
[[ "$HAVE_TEXT" == "1" ]] || die "Need --text (may be empty, e.g. --text \"\", to clear the range)"
# Interpret \n and \t in --text so callers get real line breaks, not literal backslashes.
TEXT="${TEXT//'\n'/$'\n'}"; TEXT="${TEXT//'\t'/$'\t'}"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

python3 -c "
import urllib.request, urllib.error, json, sys

doc_id = sys.argv[1]
name = sys.argv[2]
text = sys.argv[3]
token = sys.argv[4]
email = sys.argv[5]

def api_call(url, method='GET', headers=None, data=None):
    if headers is None:
        headers = {}
    headers['Authorization'] = f'Bearer {token}'
    req = urllib.request.Request(url, headers=headers, method=method, data=data)
    try:
        with urllib.request.urlopen(req) as r:
            body = r.read().decode('utf-8')
            return json.loads(body) if body else {}
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            print(json.dumps({
                'status': 'access_denied',
                'message': f'Docs access denied for {email or \"unknown\"}'
            }))
            sys.exit(0)
        sys.stderr.write(f'API error {method} {url}: {e.code} {e.read().decode(\"utf-8\")}\\n')
        sys.exit(1)

# 1. Pre-GET the doc's named ranges. No includeTabsContent so namedRanges
#    populates from the first tab (the flag empties the legacy namedRanges map).
doc = api_call(f'https://docs.googleapis.com/v1/documents/{doc_id}?suggestionsViewMode=SUGGESTIONS_INLINE')
named = doc.get('namedRanges', {})
if name not in named:
    available = ', '.join(sorted(named.keys())) or '(none)'
    sys.stderr.write(f'Named range not found: \"{name}\". Available named ranges: {available}\\n')
    sys.exit(1)

fragments = len(named.get(name, {}).get('namedRanges', []))

# 2. Replace the range content. An empty --text clears the range.
req_body = {
    'requests': [
        {
            'replaceNamedRangeContent': {
                'namedRangeName': name,
                'text': text
            }
        }
    ]
}
api_call(
    f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate',
    method='POST',
    headers={'Content-Type': 'application/json'},
    data=json.dumps(req_body).encode('utf-8')
)

# 3. replaceNamedRangeContent returns no reply body, so success is derived from
#    the named range existing and the batchUpdate returning 2xx (not a parsed count).
print(json.dumps({
    'status': 'namedrange_replaced',
    'docId': doc_id,
    'name': name,
    'rangesMatched': fragments,
    'cleared': text == ''
}, indent=2))
" "$DOC_ID" "$NAME" "$TEXT" "$TOKEN" "${AGENT_USER_EMAIL:-}"
