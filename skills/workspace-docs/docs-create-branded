#!/usr/bin/env bash
# docs-create-branded — Create a professionally formatted Google Doc from structured JSON content
# Brain agent: motor (WRITE)
# Usage: docs-create-branded --title "Report Title" --content content.json --folder FOLDER_ID [--brand-doc BRAND_DOC_ID] [--subtitle "Subtitle text"]
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-create-branded] [ERROR] $*" >&2; exit 1; }
TITLE="" CONTENT_FILE="" FOLDER="" BRAND_DOC="" SUBTITLE="" HEADER_TEXT="" FOOTER_TEXT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --title) TITLE="$2"; shift 2 ;;
    --content) CONTENT_FILE="$2"; shift 2 ;;
    --folder) FOLDER="$2"; shift 2 ;;
    --brand-doc) BRAND_DOC="$2"; shift 2 ;;
    --subtitle) SUBTITLE="$2"; shift 2 ;;
    --header) HEADER_TEXT="$2"; shift 2 ;;
    --footer) FOOTER_TEXT="$2"; shift 2 ;;
    --help|-h) cat <<'USAGE'
Usage: docs-create-branded --title "Title" --content sections.json --folder FOLDER_ID [options]

Creates a professionally formatted Google Doc from structured JSON content.
The tool handles ALL HTML/CSS generation internally using brand guide values.

Options:
  --title       Document title (required)
  --content     Path to a JSON file with document sections (required)
  --folder      Google Drive folder ID to place the doc in (required)
  --brand-doc   Google Doc ID of a brand guide to read (optional; uses defaults if omitted)
  --subtitle    Subtitle text line (optional)
  --header      Running page header text (optional; default: none)
  --footer      Running page footer text (optional; default: "Confidential")

Content JSON format:
[
  {"type": "callout", "content": "Executive summary text here."},
  {"type": "heading", "level": 2, "text": "Section Title"},
  {"type": "paragraph", "text": "Body paragraph text. Use **bold** for emphasis."},
  {"type": "table", "headers": ["Col A", "Col B"], "rows": [["val1", "val2"]]},
  {"type": "bullets", "items": ["First point", "Second point"]},
  {"type": "numbered", "items": ["Step one", "Step two"]},
  {"type": "divider"},
  {"type": "footer", "text": "Disclaimer or footer note."}
]
USAGE
      exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$TITLE" ]] || die "Need --title"
[[ -n "$CONTENT_FILE" ]] || die "Need --content (path to JSON sections file)"
[[ -f "$CONTENT_FILE" ]] || die "Content file not found: $CONTENT_FILE"
[[ -n "$FOLDER" ]] || die "Need --folder"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

export DOCSLIB_DIR="${CORE_DIR}/bin"
export DOC_TITLE="$TITLE"
export CONTENT_FILE="$CONTENT_FILE"
export DOC_FOLDER="$FOLDER"
export BRAND_DOC="$BRAND_DOC"
export DOC_SUBTITLE="$SUBTITLE"
export HEADER_TEXT="$HEADER_TEXT"
export FOOTER_TEXT="${FOOTER_TEXT:-Confidential}"
export WS_TOKEN_VAL="$TOKEN"
export CORE_DIR
python3 << 'PYEOF'
import urllib.request, urllib.error, json, sys, os, html as html_mod, tempfile

title = os.environ.get('DOC_TITLE', '')
content_file = os.environ.get('CONTENT_FILE', '')
folder = os.environ.get('DOC_FOLDER', '')
brand_doc = os.environ.get('BRAND_DOC', '')
subtitle = os.environ.get('DOC_SUBTITLE', '')
header_text = os.environ.get('HEADER_TEXT', '')
footer_text = os.environ.get('FOOTER_TEXT', 'Confidential')
token = os.environ.get('WS_TOKEN_VAL', '')
email = os.environ.get('AGENT_USER_EMAIL', '')

# Default brand values
brand = {
    'primary': '#1B2A4A', 'secondary': '#3D5A80', 'accent': '#E07A5F',
    'body_color': '#2D3748', 'muted': '#718096', 'surface': '#F7F8FA',
    'callout_bg': '#F0F4F8', 'white': '#FFFFFF', 'border': '#E2E8F0',
    'heading_font': 'Montserrat', 'body_font': 'Open Sans',
    'title_size': '22pt', 'h2_size': '16pt', 'h3_size': '13pt',
    'body_size': '11pt', 'table_header_size': '10pt', 'table_cell_size': '10pt',
    'caption_size': '9pt'
}

def api_call(url, method='GET', headers=None, data=None):
    if headers is None:
        headers = {}
    headers['Authorization'] = f'Bearer {token}'
    req = urllib.request.Request(url, headers=headers, method=method, data=data)
    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            print(json.dumps({'status': 'access_denied', 'message': f'Access denied for {email}'}))
            sys.exit(0)
        sys.stderr.write(f'API error {method} {url}: {e.code} {e.read().decode("utf-8")}\n')
        sys.exit(1)

# Read brand guide if specified
if brand_doc:
    try:
        sys.path.insert(0, os.environ.get('DOCSLIB_DIR', '.'))
        from _docslib import extract_text_and_map
        doc = api_call(f'https://docs.googleapis.com/v1/documents/{brand_doc}')
        body_content = doc.get('body', {}).get('content', [])
        plain, _ = extract_text_and_map(body_content)
        key_map = {
            'primary': 'primary', 'secondary': 'secondary', 'accent': 'accent',
            'body text': 'body_color', 'muted': 'muted', 'surface': 'surface',
            'callout bg': 'callout_bg', 'heading font': 'heading_font',
            'body font': 'body_font', 'title size': 'title_size',
            'heading 1 size': 'h2_size', 'heading 2 size': 'h2_size',
            'heading 3 size': 'h3_size', 'body size': 'body_size',
        }
        for line in plain.split('\n'):
            if ':' not in line or line.startswith('#'):
                continue
            k, v = line.split(':', 1)
            k_lower = k.strip().lower()
            v = v.strip()
            if not v:
                continue
            # Match hex colors
            for brand_key, brand_field in key_map.items():
                if brand_key in k_lower and v.startswith('#'):
                    brand[brand_field] = v
                    break
                elif brand_key in k_lower:
                    brand[brand_field] = v
                    break
    except Exception as e:
        sys.stderr.write(f'Brand guide read warning: {e} — using defaults\n')

# Load content sections
with open(content_file, 'r', encoding='utf-8') as f:
    sections = json.load(f)

def esc(text):
    return html_mod.escape(str(text))

def rich_markup(text):
    import re
    t = esc(text)
    t = re.sub(r'\{\{accent:(.+?)\}\}', rf'<span style="color: {b["accent"]}; font-weight: 600">\1</span>', t)
    t = re.sub(r'\{\{muted:(.+?)\}\}', rf'<span style="color: {b["muted"]}">\1</span>', t)
    t = re.sub(r'\*\*(.+?)\*\*', r'<strong>\1</strong>', t)
    return t

# Build HTML
b = brand
heading_import = b["heading_font"].replace(' ', '+')
body_import = b["body_font"].replace(' ', '+')
css = f"""<html><head>
<link href="https://fonts.googleapis.com/css2?family={heading_import}:wght@400;600;700&family={body_import}:wght@400;600;700&display=swap" rel="stylesheet">
<style>
body {{ font-family: '{b["body_font"]}', sans-serif; font-size: {b["body_size"]}; color: {b["body_color"]}; line-height: 1.4; }}
h1 {{ font-family: '{b["heading_font"]}', sans-serif; font-size: {b["title_size"]}; color: {b["primary"]}; border-bottom: 2px solid {b["primary"]}; padding-bottom: 4pt; margin-bottom: 12pt; }}
h2 {{ font-family: '{b["heading_font"]}', sans-serif; font-size: {b["h2_size"]}; color: {b["secondary"]}; margin-top: 18pt; margin-bottom: 8pt; }}
h3 {{ font-family: '{b["heading_font"]}', sans-serif; font-size: {b["h3_size"]}; color: {b["secondary"]}; margin-top: 14pt; margin-bottom: 6pt; }}
table {{ border-collapse: collapse; width: 100%; margin: 12pt 0; }}
th {{ background-color: {b["primary"]}; color: {b["white"]}; font-family: '{b["heading_font"]}', sans-serif; font-size: {b["table_header_size"]}; font-weight: 600; text-align: left; padding: 8pt 12pt; }}
td {{ padding: 8pt 12pt; border-bottom: 1px solid {b["border"]}; font-size: {b["table_cell_size"]}; }}
tr:nth-child(even) td {{ background-color: {b["surface"]}; }}
.accent {{ color: {b["accent"]}; font-weight: 600; }}
.callout {{ background-color: {b["callout_bg"]}; border-left: 4px solid {b["secondary"]}; padding: 10pt 14pt; margin: 12pt 0; font-size: 10pt; }}
.divider {{ border: none; border-top: 2px solid {b["primary"]}; margin: 18pt 0; }}
.subtitle {{ font-family: '{b["body_font"]}', sans-serif; font-size: 13pt; color: {b["secondary"]}; margin-top: -8pt; margin-bottom: 16pt; }}
.muted {{ font-size: {b["caption_size"]}; color: {b["muted"]}; }}
</style></head><body>
"""

body_html = f'<h1>{esc(title)}</h1>\n'
if subtitle:
    body_html += f'<p class="subtitle">{esc(subtitle)}</p>\n'

for sec in sections:
    t = sec.get('type', '')
    if t == 'callout':
        body_html += f'<div class="callout">{rich_markup(sec.get("content", ""))}</div>\n'
    elif t == 'heading':
        lvl = min(max(sec.get('level', 2), 1), 6)
        body_html += f'<h{lvl}>{esc(sec.get("text", ""))}</h{lvl}>\n'
    elif t == 'paragraph':
        body_html += f'<p>{rich_markup(sec.get("text", ""))}</p>\n'
    elif t == 'table':
        headers = sec.get('headers', [])
        rows = sec.get('rows', [])
        body_html += '<table>\n<tr>' + ''.join(f'<th>{esc(h)}</th>' for h in headers) + '</tr>\n'
        for row in rows:
            body_html += '<tr>' + ''.join(f'<td>{rich_markup(c)}</td>' for c in row) + '</tr>\n'
        body_html += '</table>\n'
    elif t == 'bullets':
        body_html += '<ul>\n'
        for item in sec.get('items', []):
            body_html += f'<li>{rich_markup(item)}</li>\n'
        body_html += '</ul>\n'
    elif t == 'numbered':
        body_html += '<ol>\n'
        for item in sec.get('items', []):
            body_html += f'<li>{rich_markup(item)}</li>\n'
        body_html += '</ol>\n'
    elif t == 'divider':
        body_html += '<hr class="divider">\n'
    elif t == 'footer':
        body_html += f'<p class="muted">{esc(sec.get("text", ""))}</p>\n'
    else:
        sys.stderr.write(f'Unknown section type: {t}\n')

full_html = css + body_html + '</body></html>'

# Write HTML to temp file
html_path = tempfile.mktemp(suffix='.html')
with open(html_path, 'w', encoding='utf-8') as f:
    f.write(full_html)

# Create the doc via Drive multipart upload
metadata = {'name': title, 'mimeType': 'application/vnd.google-apps.document'}
if folder:
    metadata['parents'] = [folder]

boundary = 'boundary_branded_doc_create'
body_parts = [
    f'--{boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n{json.dumps(metadata)}\r\n',
    f'--{boundary}\r\nContent-Type: text/html; charset=UTF-8\r\n\r\n{full_html}\r\n',
    f'--{boundary}--\r\n'
]
body_data = ''.join(body_parts).encode('utf-8')

url = 'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&supportsAllDrives=true'
req = urllib.request.Request(
    url, data=body_data,
    headers={
        'Authorization': f'Bearer {token}',
        'Content-Type': f'multipart/related; boundary={boundary}'
    },
    method='POST'
)

try:
    with urllib.request.urlopen(req) as response:
        resp = json.loads(response.read().decode('utf-8'))
        doc_id = resp.get('id')
except urllib.error.HTTPError as e:
    if e.code in [401, 403]:
        print(json.dumps({'status': 'access_denied', 'message': f'Create denied for {email}'}))
        sys.exit(0)
    sys.stderr.write(f'Upload failed: {e.code} {e.read().decode("utf-8")}\n')
    sys.exit(1)
finally:
    os.unlink(html_path)

# Apply page formatting if docs-format-page exists
format_page = os.path.join(os.environ.get('CORE_DIR', '/opt/corekit'), 'bin', 'docs-format-page')
fmt_ok = False
if os.path.isfile(format_page):
    import subprocess
    fmt_cmd = [format_page, '--doc', doc_id, '--margins', '1in']
    if footer_text:
        fmt_cmd.extend(['--footer', footer_text])
    if header_text:
        fmt_cmd.extend(['--header', header_text])
    try:
        r = subprocess.run(fmt_cmd, capture_output=True, timeout=30)
        fmt_ok = r.returncode == 0
        if not fmt_ok:
            sys.stderr.write(f'Page format error: exit {r.returncode} {r.stderr.decode("utf-8","replace")}\n')
    except Exception as e:
        sys.stderr.write(f'Page format warning: {e}\n')

# Post-process: apply exact brand styles via Docs API batchUpdate.
# HTML import is lossy — Google Docs does not preserve CSS font sizes, colors,
# or font families exactly. This step corrects them to the brand-guide values.
postfix_count = 0
try:
    doc = api_call(f'https://docs.googleapis.com/v1/documents/{doc_id}')
    body_content = doc.get('body', {}).get('content', [])

    def hex_to_color(hex_str):
        h = hex_str.lstrip('#')
        return {'color': {'rgbColor': {
            'red': int(h[0:2], 16) / 255.0,
            'green': int(h[2:4], 16) / 255.0,
            'blue': int(h[4:6], 16) / 255.0
        }}}

    def pt(s):
        return float(str(s).rstrip('pt'))

    heading_text = {
        'weightedFontFamily': {'fontFamily': b['heading_font'], 'weight': 700},
        'bold': True
    }
    style_map = {
        'HEADING_1': {
            'text': {**heading_text,
                'fontSize': {'magnitude': pt(b['title_size']), 'unit': 'PT'},
                'foregroundColor': hex_to_color(b['primary'])},
            'para': {'spaceBelow': {'magnitude': 12, 'unit': 'PT'}}
        },
        'HEADING_2': {
            'text': {**heading_text, 'weightedFontFamily': {'fontFamily': b['heading_font'], 'weight': 600},
                'fontSize': {'magnitude': pt(b['h2_size']), 'unit': 'PT'},
                'foregroundColor': hex_to_color(b['secondary'])},
            'para': {'spaceAbove': {'magnitude': 18, 'unit': 'PT'}, 'spaceBelow': {'magnitude': 8, 'unit': 'PT'}}
        },
        'HEADING_3': {
            'text': {**heading_text, 'weightedFontFamily': {'fontFamily': b['heading_font'], 'weight': 600},
                'fontSize': {'magnitude': pt(b['h3_size']), 'unit': 'PT'},
                'foregroundColor': hex_to_color(b['secondary'])},
            'para': {'spaceAbove': {'magnitude': 14, 'unit': 'PT'}, 'spaceBelow': {'magnitude': 6, 'unit': 'PT'}}
        },
        'NORMAL_TEXT': {
            'text': {
                'weightedFontFamily': {'fontFamily': b['body_font'], 'weight': 400},
                'fontSize': {'magnitude': pt(b['body_size']), 'unit': 'PT'},
                'foregroundColor': hex_to_color(b['body_color'])},
            'para': {'lineSpacing': 140}
        }
    }

    requests = []

    # Set document-wide named style definitions via updateNamedStyle.
    # updateTextStyle is silently ignored for paragraphs governed by named styles
    # (HEADING_1, HEADING_2, etc.) — only updateNamedStyle changes their appearance.
    fields_base = 'named_style_type,text_style.weighted_font_family,text_style.bold,text_style.font_size,text_style.foreground_color'
    for named_type, s in style_map.items():
        para_fields = []
        for k in s.get('para', {}):
            snake = ''.join('_' + c.lower() if c.isupper() else c for c in k).lstrip('_')
            para_fields.append('paragraph_style.' + snake)
        mask = fields_base + (',' + ','.join(para_fields) if para_fields else '')
        requests.append({'updateNamedStyle': {
            'namedStyle': {
                'namedStyleType': named_type,
                'textStyle': s['text'],
                'paragraphStyle': s.get('para', {})
            },
            'fields': mask
        }})

    # Table header text and backgrounds — updateTextStyle works for table cells
    def collect_table_styles(content_list):
        for elem in content_list:
            tbl = elem.get('table')
            if not tbl:
                continue
            tbl_start = elem.get('startIndex', 0)
            first_row = tbl.get('tableRows', [None])[0]
            if not first_row:
                continue
            for ci, cell in enumerate(first_row.get('tableCells', [])):
                requests.append({'updateTableCellStyle': {
                    'tableRange': {
                        'tableCellLocation': {
                            'tableStartLocation': {'index': tbl_start},
                            'rowIndex': 0, 'columnIndex': ci},
                        'rowSpan': 1, 'columnSpan': 1},
                    'tableCellStyle': {'backgroundColor': hex_to_color(b['primary'])},
                    'fields': 'backgroundColor'}})
                for ce in cell.get('content', []):
                    p = ce.get('paragraph')
                    if p:
                        si, ei = ce.get('startIndex', 0), ce.get('endIndex', 0)
                        if si < ei:
                            requests.append({'updateTextStyle': {
                                'range': {'startIndex': si, 'endIndex': ei},
                                'textStyle': {
                                    'weightedFontFamily': {'fontFamily': b['heading_font'], 'weight': 600},
                                    'fontSize': {'magnitude': pt(b['table_header_size']), 'unit': 'PT'},
                                    'foregroundColor': hex_to_color(b['white']),
                                    'bold': True},
                                'fields': 'weightedFontFamily,fontSize,foregroundColor,bold'}})

    collect_table_styles(body_content)

    if requests:
        api_call(
            f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate',
            method='POST',
            headers={'Content-Type': 'application/json'},
            data=json.dumps({'requests': requests}).encode('utf-8')
        )
        postfix_count = len(requests)
except Exception as e:
    sys.stderr.write(f'Post-process styling warning: {e}\n')

# Readback verification: re-read the doc's named styles from the API and confirm they match
brand_verified = {}
try:
    verify_doc = api_call(
        f'https://docs.googleapis.com/v1/documents/{doc_id}',
        headers={}
    )
    for ns in verify_doc.get('namedStyles', {}).get('styles', []):
        nst = ns.get('namedStyleType', '')
        if nst not in style_map:
            continue
        ts = ns.get('textStyle', {})
        ff = ts.get('weightedFontFamily', {})
        fs = ts.get('fontSize', {})
        actual_font = ff.get('fontFamily', '')
        actual_weight = ff.get('weight', 0)
        actual_size = fs.get('magnitude', 0)
        actual_bold = ts.get('bold', False)
        expected = style_map[nst]
        exp_font = expected['text']['weightedFontFamily']['fontFamily']
        exp_weight = expected['text']['weightedFontFamily']['weight']
        exp_size = expected['text']['fontSize']['magnitude']
        exp_bold = expected['text'].get('bold', False)
        ok = (actual_font == exp_font and actual_weight == exp_weight
              and abs(actual_size - exp_size) < 0.1 and actual_bold == exp_bold)
        brand_verified[nst] = f'{actual_font}/{actual_weight} {actual_size}pt bold={actual_bold} {"PASS" if ok else "FAIL"}'
except Exception as e:
    brand_verified = {'error': str(e)}

all_pass = all('PASS' in v for v in brand_verified.values()) if brand_verified else False

# Count section types for evidence
from collections import Counter
type_counts = Counter(s.get('type', 'unknown') for s in sections)

print(json.dumps({
    'status': 'created',
    'docId': doc_id,
    'title': title,
    'link': f'https://docs.google.com/document/d/{doc_id}',
    'source': 'branded-html+updateNamedStyle',
    'brand': 'custom' if brand_doc else 'default',
    'sections': len(sections),
    'section_types': dict(type_counts),
    'postfix_styles_applied': postfix_count,
    'brand_verification': brand_verified,
    'brand_all_pass': all_pass,
    'brand_fonts': {'headings': b['heading_font'], 'body': b['body_font']},
    'table_header_styled': True,
    'page_formatting': {
        'margins': '1in (all sides)',
        'header': header_text or '(none)',
        'footer': footer_text,
        'applied_via': 'docs-format-page',
        'success': fmt_ok
    }
}, indent=2))
PYEOF
