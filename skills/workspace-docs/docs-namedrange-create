#!/usr/bin/env bash
# docs-namedrange-create — Create a named range around an anchor or indices range
# Brain agent: motor (WRITE)
# Usage: docs-namedrange-create --doc DOC_ID --name RANGE_NAME (--anchor "phrase" | --start START_IDX --end END_IDX)
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
die() { echo "[docs-namedrange-create] [ERROR] $*" >&2; exit 1; }
DOC_ID="" NAME="" ANCHOR="" START_IDX="" END_IDX=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;;
    --name) NAME="$2"; shift 2 ;;
    --anchor) ANCHOR="$2"; shift 2 ;;
    --start) START_IDX="$2"; shift 2 ;;
    --end) END_IDX="$2"; shift 2 ;;
    --help|-h) echo "Usage: docs-namedrange-create --doc <doc_id> --name <range_name> (--anchor <phrase> | --start <start> --end <end>)"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DOC_ID" && -n "$NAME" ]] || die "Need --doc and --name"
[[ -n "$ANCHOR" || (-n "$START_IDX" && -n "$END_IDX") ]] || die "Need either --anchor or --start and --end"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

python3 -c "
import urllib.request, urllib.error, json, sys

doc_id = sys.argv[1]
name = sys.argv[2]
anchor = sys.argv[3]
start_idx_str = sys.argv[4]
end_idx_str = sys.argv[5]
token = sys.argv[6]
email = sys.argv[7]

def api_call(url, method='GET', headers=None, data=None):
    if headers is None:
        headers = {}
    headers['Authorization'] = f'Bearer {token}'
    req = urllib.request.Request(url, headers=headers, method=method, data=data)
    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            print(json.dumps({
                'status': 'access_denied',
                'message': f'Docs access denied for {email or \"unknown\"}'
            }))
            sys.exit(0)
        sys.stderr.write(f'API error {method} {url}: {e.code} {e.read().decode(\"utf-8\")}\\n')
        sys.exit(1)

def extract_text_and_map(elements):
    text = ''
    index_map = []
    for elem in elements:
        if 'paragraph' in elem:
            for run_elem in elem['paragraph'].get('elements', []):
                if 'textRun' in run_elem:
                    tr = run_elem['textRun']
                    content = tr.get('content', '')
                    start = tr.get('startIndex', 0)
                    for i, char in enumerate(content):
                        text += char
                        index_map.append(start + i)
        elif 'table' in elem:
            for row in elem['table'].get('tableRows', []):
                for cell in row.get('tableCells', []):
                    sub_text, sub_map = extract_text_and_map(cell.get('content', []))
                    text += sub_text
                    index_map.extend(sub_map)
        elif 'tableOfContents' in elem:
            sub_text, sub_map = extract_text_and_map(elem['tableOfContents'].get('content', []))
            text += sub_text
            index_map.extend(sub_map)
    return text, index_map

if anchor:
    doc = api_call(f'https://docs.googleapis.com/v1/documents/{doc_id}?suggestionsViewMode=SUGGESTIONS_INLINE')
    body_content = doc.get('body', {}).get('content', [])
    plain_text, index_map = extract_text_and_map(body_content)
    
    occurrences = []
    start = 0
    while True:
        pos = plain_text.find(anchor, start)
        if pos == -1:
            break
        occurrences.append(pos)
        start = pos + 1
        
    if not occurrences:
        sys.stderr.write(f'Anchor not found: \"{anchor}\"\\n')
        sys.exit(1)
    if len(occurrences) > 1:
        sys.stderr.write(f'Anchor not unique: found {len(occurrences)} occurrences of \"{anchor}\"\\n')
        sys.exit(1)
        
    c_start = occurrences[0]
    start_idx = index_map[c_start]
    end_idx = index_map[c_start + len(anchor) - 1] + 1
else:
    start_idx = int(start_idx_str)
    end_idx = int(end_idx_str)

# Execute createNamedRange
req_body = {
    'requests': [
        {
            'createNamedRange': {
                'name': name,
                'range': {
                    'startIndex': start_idx,
                    'endIndex': end_idx
                }
            }
        }
    ]
}

resp = api_call(
    f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate',
    method='POST',
    headers={'Content-Type': 'application/json'},
    data=json.dumps(req_body).encode('utf-8')
)

nr_id = resp.get('replies', [{}])[0].get('createNamedRange', {}).get('namedRangeId', '')

print(json.dumps({
    'status': 'namedrange_created',
    'docId': doc_id,
    'name': name,
    'namedRangeId': nr_id,
    'range': {'startIndex': start_idx, 'endIndex': end_idx}
}, indent=2))
" "$DOC_ID" "$NAME" "$ANCHOR" "$START_IDX" "$END_IDX" "$TOKEN" "${AGENT_USER_EMAIL:-}"
