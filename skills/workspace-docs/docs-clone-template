#!/usr/bin/env bash
# docs-clone-template — Clone a Google Doc template and optionally fill placeholders
# Brain agent: motor (WRITE)
# Usage: docs-clone-template --template DOC_ID --title "New Title" [--folder FOLDER_ID] [--replacements FILE]
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
DOCS_API="https://docs.googleapis.com/v1/documents"
die() { echo "[docs-clone-template] [ERROR] $*" >&2; exit 1; }
TEMPLATE="" TITLE="" FOLDER="" REPLACEMENTS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --template) TEMPLATE="$2"; shift 2 ;;
    --title) TITLE="$2"; shift 2 ;;
    --folder) FOLDER="$2"; shift 2 ;;
    --replacements) REPLACEMENTS="$2"; shift 2 ;;
    --help|-h) echo "Usage: docs-clone-template --template <doc_id> --title <title> [--folder <folder_id>] [--replacements <json_file>]"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$TEMPLATE" && -n "$TITLE" ]] || die "Need --template and --title"
# --template is a Doc ID, never a path or a filename you saw in a search result.
TEMPLATE_LC="$(printf '%s' "$TEMPLATE" | tr 'A-Z' 'a-z')"
if [[ "$TEMPLATE" == */* || "$TEMPLATE" == *'\'* || "$TEMPLATE_LC" =~ \.(pdf|docx|doc|txt|md|json|csv|html|htm|rtf|odt|xlsx|pptx)$ ]]; then
  { echo "[docs-clone-template] [ERROR] --template '${TEMPLATE}' is a local path/filename, not a Google Doc ID."
    echo "  Find the id:   drive-ls <folderId>   or   drive-search --query \"name contains '<fragment of the real filename>'\""
    echo "  Copy the id from that output verbatim — never retype or edit characters of an id."
  } >&2
  exit 1
fi
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"

python3 -c "
import urllib.request, urllib.error, json, sys

template_id = sys.argv[1]
title = sys.argv[2]
folder = sys.argv[3]
replacements_file = sys.argv[4]
token = sys.argv[5]
email = sys.argv[6]

def api(url, method='GET', data=None):
    headers = {'Authorization': f'Bearer {token}', 'Content-Type': 'application/json'}
    req = urllib.request.Request(url, headers=headers, method=method,
                                 data=json.dumps(data).encode() if data else None)
    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            print(json.dumps({'status': 'access_denied', 'message': f'Access denied for {email or \"unknown\"}'}))
            sys.exit(0)
        sys.stderr.write(f'API error: {e.code} {e.read().decode(\"utf-8\")}\\n')
        sys.exit(1)

# 1. Copy the template
copy_meta = {'name': title}
if folder:
    copy_meta['parents'] = [folder]
copy_url = f'https://www.googleapis.com/drive/v3/files/{template_id}/copy?supportsAllDrives=true'
result = api(copy_url, 'POST', copy_meta)
new_id = result['id']

# 2. Fill placeholders if a replacements file was provided.
# The copy already succeeded, so a fill error must NEVER hard-exit and orphan the
# clone: we always fall through to print the created-doc JSON below.
replacements_applied = 0
replacements_failed = False
fill_report = []
zero_match = []

if replacements_file:
    try:
        with open(replacements_file, 'r') as f:
            pairs = json.loads(f.read())
    except Exception as e:
        sys.stderr.write(f'Failed to read replacements file: {e}\\n')
        pairs = []
        replacements_failed = True

    # Accept BOTH documented shapes: the placeholder mapping
    # {'[Advisor Name]': 'Jane'} and a list of {'find','replace'} objects. The mapping is
    # what the SKILL documents and what callers write; taking only the list form meant a
    # correct replacements file skipped the entire fill and the clone shipped with its
    # placeholders intact.
    if isinstance(pairs, dict):
        pairs = [{'find': k, 'replace': '' if v is None else str(v)} for k, v in pairs.items()]

    valid_pairs = []
    for i, pair in enumerate(pairs):
        if not isinstance(pair, dict) or 'find' not in pair or 'replace' not in pair:
            sys.stderr.write(f'Replacement {i} is missing find/replace; skipping fill\\n')
            replacements_failed = True
            valid_pairs = []
            break
        valid_pairs.append(pair)

    if valid_pairs:
        requests = [{
            'replaceAllText': {
                'containsText': {'text': p['find'], 'matchCase': True},
                'replaceText': p['replace']
            }
        } for p in valid_pairs]

        # Get a docs-scoped token for the batchUpdate fill.
        import subprocess
        try:
            docs_token = subprocess.check_output(
                [sys.argv[7], '--scope', 'docs'], text=True
            ).strip() if len(sys.argv) > 7 and sys.argv[7] else token
        except Exception:
            docs_token = token

        docs_url = f'https://docs.googleapis.com/v1/documents/{new_id}:batchUpdate'
        req2 = urllib.request.Request(
            docs_url,
            headers={'Authorization': f'Bearer {docs_token}', 'Content-Type': 'application/json'},
            method='POST',
            data=json.dumps({'requests': requests}).encode()
        )
        try:
            with urllib.request.urlopen(req2) as r2:
                fill_resp = json.loads(r2.read().decode('utf-8'))
            # Report per placeholder. A total-only count hides the case that matters: every
            # find-string missed, so the copy still says [Advisor Name] everywhere.
            for i, rep in enumerate(fill_resp.get('replies', [])):
                occ = rep.get('replaceAllText', {}).get('occurrencesChanged', 0)
                replacements_applied += occ
                find = valid_pairs[i]['find'] if i < len(valid_pairs) else ''
                fill_report.append({'find': find, 'occurrences': occ, 'applied': occ > 0})
                if occ == 0:
                    zero_match.append(find)
        except urllib.error.HTTPError as e:
            if e.code in [401, 403]:
                print(json.dumps({'status': 'access_denied', 'message': f'Access denied for {email or \"unknown\"}'}))
                sys.exit(0)
            sys.stderr.write(f'Fill error: {e.code} {e.read().decode(\"utf-8\")}\\n')
            replacements_failed = True
        except Exception as e:
            sys.stderr.write(f'Fill error: {e}\\n')
            replacements_failed = True

result_out = {
    'status': 'created',
    'docId': new_id,
    'title': title,
    'templateId': template_id,
    'link': f'https://docs.google.com/document/d/{new_id}',
    'replacements_applied': replacements_applied,
    'replacements_failed': replacements_failed
}
if fill_report:
    result_out['replacements'] = fill_report
if zero_match:
    result_out['zero_match_finds'] = zero_match
    result_out['note'] = (f'{len(zero_match)} of {len(fill_report)} placeholder(s) matched NOTHING in the copy '
                          '(zero_match_finds) — the template does not contain those tokens as written. '
                          'Rebuild your find-strings from clone_text_preview below (or docs-cat the clone). '
                          'Re-running the same replacements changes nothing.')
    # Auto-read the clone's text when replacements failed, so the motor can see the
    # actual placeholder format and self-correct without a separate docs-cat call.
    try:
        docs_read_token = docs_token if 'docs_token' in dir() else token
        doc_url = f'https://docs.googleapis.com/v1/documents/{new_id}'
        req3 = urllib.request.Request(doc_url, headers={
            'Authorization': f'Bearer {docs_read_token}',
            'Content-Type': 'application/json'
        })
        with urllib.request.urlopen(req3) as r3:
            doc_data = json.loads(r3.read().decode('utf-8'))
        # Extract plain text from body content
        text_parts = []
        for elem in doc_data.get('body', {}).get('content', []):
            para = elem.get('paragraph', {})
            for pe in para.get('elements', []):
                tr = pe.get('textRun', {})
                if tr.get('content'):
                    text_parts.append(tr['content'])
        clone_text = ''.join(text_parts).strip()
        result_out['clone_text_preview'] = clone_text[:2000]
    except Exception:
        pass  # best-effort — don't fail the clone output over a preview read
print(json.dumps(result_out, indent=2))
" "$TEMPLATE" "$TITLE" "$FOLDER" "$REPLACEMENTS" "$TOKEN" "${AGENT_USER_EMAIL:-}" "$WS_TOKEN"
