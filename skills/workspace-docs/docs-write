#!/usr/bin/env bash
# docs-write — Replace or append body text in a Google Doc
# Brain agent: motor (WRITE)
# Usage: docs-write --doc DOC_ID (--text "New content" | --file FILE_PATH) [--append | --overwrite] [--markdown]
# Without --append, --overwrite must be explicitly provided.
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DOCS_API="https://docs.googleapis.com/v1/documents"
die() { echo "[docs-write] [ERROR] $*" >&2; exit 1; }
DOC_ID="" TEXT="" FILE="" APPEND=false OVERWRITE=false MD=false
while [[ $# -gt 0 ]]; do
  case "$1" in 
    --doc) DOC_ID="$2"; shift 2 ;; 
    --text) TEXT="$2"; shift 2 ;; 
    --file) FILE="$2"; shift 2 ;; 
    --append) APPEND=true; shift ;; 
    --overwrite) OVERWRITE=true; shift ;;
    --markdown) MD=true; shift ;;
    --help|-h) echo "Usage: docs-write --doc <doc_id> (--text <text> | --file <file>) [--append | --overwrite] [--markdown]"; exit 0 ;;
    *) die "Unknown: $1" ;; 
  esac
done
[[ -n "$DOC_ID" && (-n "$TEXT" || -n "$FILE") ]] || die "Need --doc and either --text or --file"

if [[ "$APPEND" == "false" && "$OVERWRITE" == "false" ]]; then
  die "Safety Check: Whole-document overwrite requires the explicit '--overwrite' flag."
fi

TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"

if [[ -n "$FILE" ]]; then
  [[ -f "$FILE" ]] || die "File not found: $FILE"
  TEXT=$(cat "$FILE")
fi

# Delegate to docs-replace-md if we are replacing whole document with markdown
if [[ "$MD" == "true" && "$APPEND" == "false" ]]; then
  exec "${CORE_DIR}/bin/docs-replace-md" --doc "$DOC_ID" --text "$TEXT"
fi

# We must retrieve END_IDX for appending or for clearing old content.
END_IDX=$(curl -sf -H "Authorization: Bearer ${TOKEN}" "${DOCS_API}/${DOC_ID}" \
  | python3 -c "
import json, sys
doc = json.load(sys.stdin)
content = doc.get('body',{}).get('content',[])
if content: print(content[-1].get('endIndex',1)-1)
else: print(1)
")

INSERT_IDX=1

if [[ "$APPEND" == "false" ]]; then
  if [[ "$END_IDX" -gt 1 ]]; then
    BODY=$(python3 -c "import json; print(json.dumps({'requests':[{'deleteContentRange':{'range':{'startIndex':1,'endIndex':$END_IDX}}}]}))")
    curl -sf -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
      -d "$BODY" "${DOCS_API}/${DOC_ID}:batchUpdate" > /dev/null
  fi
else
  INSERT_IDX=$END_IDX
fi

# If appending markdown, use copy-body logic at INSERT_IDX
if [[ "$MD" == "true" ]]; then
  python3 -c "
import urllib.request, urllib.error, json, sys, time

doc_id = sys.argv[1]
markdown_content = sys.argv[2]
token = sys.argv[3]
insert_index = int(sys.argv[4])
email = sys.argv[5]

def api_call(url, method='GET', headers=None, data=None):
    if headers is None:
        headers = {}
    headers['Authorization'] = f'Bearer {token}'
    req = urllib.request.Request(url, headers=headers, method=method, data=data)
    try:
        with urllib.request.urlopen(req) as r:
            return json.loads(r.read().decode('utf-8'))
    except urllib.error.HTTPError as e:
        if e.code in [401, 403]:
            print(json.dumps({
                'status': 'access_denied',
                'message': f'Docs access denied for {email or \"unknown\"}'
            }))
            sys.exit(0)
        sys.stderr.write(f'API error {method} {url}: {e.code} {e.read().decode(\"utf-8\")}\\n')
        sys.exit(1)

# Create a temporary Doc
temp_title = f'temp_append_md_{int(time.time())}'
metadata = {
    'name': temp_title,
    'mimeType': 'application/vnd.google-apps.document'
}
boundary = 'boundary_append_md_multipart'
body_parts = [
    f'--{boundary}\\r\\nContent-Type: application/json; charset=UTF-8\\r\\n\\r\\n{json.dumps(metadata)}\\r\\n',
    f'--{boundary}\\r\\nContent-Type: text/markdown; charset=UTF-8\\r\\n\\r\\n{markdown_content}\\r\\n',
    f'--{boundary}--\\r\\n'
]
body_data = ''.join(body_parts).encode('utf-8')

upload_url = 'https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&supportsAllDrives=true'
headers = {'Content-Type': f'multipart/related; boundary={boundary}'}
temp_doc_info = api_call(upload_url, method='POST', headers=headers, data=body_data)
temp_id = temp_doc_info.get('id')

if not temp_id:
    sys.stderr.write('Failed to create temporary converted Doc\\n')
    sys.exit(1)

try:
    temp_doc = api_call(f'https://docs.googleapis.com/v1/documents/{temp_id}')
    temp_content = temp_doc.get('body', {}).get('content', [])
    lists_map = temp_doc.get('lists', {})
    
    requests = []
    
    # We copy body in reverse order starting at insert_index
    for element in reversed(temp_content):
        if 'paragraph' in element:
            p = element['paragraph']
            elements = p.get('elements', [])
            p_style = p.get('paragraphStyle', {})
            bullet = p.get('bullet', {})
            
            total_len = 0
            for run_elem in reversed(elements):
                if 'textRun' in run_elem:
                    tr = run_elem['textRun']
                    text = tr.get('content', '')
                    style = tr.get('textStyle', {})
                    if not text:
                        continue
                        
                    # Insert text
                    requests.append({
                        'insertText': {
                            'location': {'index': insert_index},
                            'text': text
                        }
                    })
                    
                    # Apply text style
                    text_len = len(text)
                    text_style = {}
                    for key in ['bold', 'italic', 'underline', 'strikethrough', 'fontSize', 'weightedFontFamily', 'link']:
                        if key in style:
                            text_style[key] = style[key]
                    if 'foregroundColor' in style:
                        text_style['foregroundColor'] = style['foregroundColor']
                        
                    if text_style:
                        requests.append({
                            'updateTextStyle': {
                                'range': {
                                    'startIndex': insert_index,
                                    'endIndex': insert_index + text_len
                                },
                                'textStyle': text_style,
                                'fields': ','.join(text_style.keys())
                            }
                        })
                    total_len += text_len
                    
            if total_len > 0:
                # Apply paragraph style
                p_style_req = {}
                for key in ['namedStyleType', 'alignment', 'lineSpacing', 'spaceBefore', 'spaceAfter', 'keepWithNext', 'keepTogether']:
                    if key in p_style:
                        p_style_req[key] = p_style[key]
                if p_style_req:
                    requests.append({
                        'updateParagraphStyle': {
                            'range': {
                                'startIndex': insert_index,
                                'endIndex': insert_index + total_len
                            },
                            'paragraphStyle': p_style_req,
                            'fields': ','.join(p_style_req.keys())
                        }
                    })
                    
                # Apply bullets
                if bullet:
                    list_id = bullet.get('listId', '')
                    is_numbered = False
                    if list_id in lists_map:
                        nesting_levels = lists_map[list_id].get('listProperties', {}).get('nestingLevels', [])
                        if nesting_levels:
                            glyph_type = nesting_levels[0].get('glyphType', '')
                            if glyph_type and glyph_type != 'GLYPH_TYPE_UNSPECIFIED':
                                is_numbered = True
                    preset = 'NUMBERED_DECIMAL_NESTED' if is_numbered else 'BULLET_DISC_CIRCLE_SQUARE'
                    requests.append({
                        'createBullet': {
                            'range': {
                                'startIndex': insert_index,
                                'endIndex': insert_index + total_len
                            },
                            'bulletPreset': preset
                        }
                    })
                    
    if requests:
        api_call(
            f'https://docs.googleapis.com/v1/documents/{doc_id}:batchUpdate',
            method='POST',
            headers={'Content-Type': 'application/json'},
            data=json.dumps({'requests': requests}).encode('utf-8')
        )
        
    print(json.dumps({
        'status': 'written',
        'docId': doc_id,
        'mode': 'append_md',
        'chars': len(markdown_content)
    }, indent=2))
    
finally:
    delete_url = f'https://www.googleapis.com/drive/v3/files/{temp_id}'
    try:
        req_del = urllib.request.Request(delete_url, headers={'Authorization': f'Bearer {token}'}, method='DELETE')
        with urllib.request.urlopen(req_del) as _:
            pass
    except Exception:
        pass
" "$DOC_ID" "$TEXT" "$TOKEN" "$INSERT_IDX" "${AGENT_USER_EMAIL:-}"
  exit 0
fi

# Plain text insertion
BODY=$(python3 -c "
import json, sys
print(json.dumps({'requests':[{'insertText':{'location':{'index':int(sys.argv[1])},'text':sys.argv[2]}}]}))
" "$INSERT_IDX" "$TEXT")

curl -sf -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" "${DOCS_API}/${DOC_ID}:batchUpdate" > /dev/null

echo "{\"status\":\"written\",\"docId\":\"${DOC_ID}\",\"mode\":\"$([ "$APPEND" == "true" ] && echo append || echo replace)\",\"chars\":${#TEXT}}"

