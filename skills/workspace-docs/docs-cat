#!/usr/bin/env bash
# docs-cat — Read a Google Doc's text: full body, metadata/outline, ranged window, or targeted search
# Brain agent: temporal-memory (READ)
# Usage: docs-cat <doc_id> [--meta] [--find "TEXT" [--context N]] [--offset N] [--limit N] [--max-chars N] [--out FILE]
#   (no flags)      full plain-text body (JSON: docId, title, text, chars)
#   --meta          title, total chars, heading outline with char offsets — no body text
#   --fingerprint   structural formatting signature (paragraph styles, tables + dims,
#                   image count, distinct text styles/fonts) — no body text. Capture
#                   before and after an edit and diff to prove formatting was preserved.
#   --find "TEXT"   case-insensitive substring search; returns every match (max 20)
#                   with its char offset and an excerpt of surrounding context
#   --context N     chars of context on each side of a --find match (default 800)
#   --offset N      start reading at char offset N (combine with --limit)
#   --limit N       return at most N chars from --offset
#   --max-chars N   cap a full read at N chars (adds next_offset for continuation)
#   --out FILE      write the COMPLETE plain text to FILE in one call; prints a
#                   {written, chars} summary. THE way to read a large doc fully:
#                   the text lands on disk (no output cap), then grep/sed it locally.
# Large docs: downstream tool output is capped (~8K chars per step), so a full
# read of a big doc gets cut off mid-body. For full content use --out FILE; for
# a section use --meta first, then --find or --offset/--limit windows.
# <doc_id> is an ID, never a path: a local filename is rejected before any API call,
# and a 404 is reported with its three causes (wrong id / not a Doc / no access).
# Never alter characters of an id and retry — re-resolve it from drive-ls or drive-search.
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
DOCS_API="https://docs.googleapis.com/v1/documents"
die() { echo "[docs-cat] [ERROR] $*" >&2; exit 1; }
DOC_ID="${1:-}"; [[ -n "$DOC_ID" ]] || die "Usage: docs-cat <doc_id> [--json] [--meta] [--find TEXT [--context N]] [--offset N --limit N] [--max-chars N]"
shift || true

# An ID is not a path. A local filename can never be a Doc ID, so reject it HERE —
# before the API turns the mistake into an opaque 404 that hides the real reason.
DOC_ID_LC="$(printf '%s' "$DOC_ID" | tr 'A-Z' 'a-z')"
if [[ "$DOC_ID" == */* || "$DOC_ID" == *'\'* || "$DOC_ID_LC" =~ \.(pdf|docx|doc|txt|md|json|csv|html|htm|rtf|odt|xlsx|pptx)$ ]]; then
  { echo "[docs-cat] [ERROR] '${DOC_ID}' is a local path/filename, not a Google Doc ID."
    echo "  Every docs-* tool takes the Doc ID only — the token between /d/ and /edit in the doc's URL."
    echo "  Find the id:   drive-ls <folderId>   or   drive-search --query \"name contains '<fragment of the real filename>'\""
    echo "  Not a Doc yet: drive-to-doc --file <driveFileId>   — then read the docId it returns."
  } >&2
  exit 1
fi

# Default output is PLAIN TEXT — the body, ready to pipe/grep. Pass --json for
# the structured {docId,title,text,chars} wrapper. (Structured modes --meta and
# --find always emit JSON since they carry offsets/matches.) This default flip
# fixes the failure mode where motor piped docs-cat's JSON into grep/head and
# got nothing usable.
META=0; FIND_TEXT=""; CONTEXT=800; OFFSET=0; LIMIT=0; MAX_CHARS=0; JSON=0; HAS_WINDOW=0; OUT_FILE=""; FINGERPRINT=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --meta) META=1; shift ;;
    --fingerprint) FINGERPRINT=1; shift ;;
    --find) FIND_TEXT="${2:-}"; [[ -n "$FIND_TEXT" ]] || die "--find requires a search string"; shift 2 ;;
    --context) CONTEXT="${2:-800}"; shift 2 ;;
    --offset) OFFSET="${2:-0}"; HAS_WINDOW=1; shift 2 ;;
    --limit) LIMIT="${2:-0}"; HAS_WINDOW=1; shift 2 ;;
    --max-chars) MAX_CHARS="${2:-0}"; HAS_WINDOW=1; shift 2 ;;
    --out) OUT_FILE="${2:-}"; [[ -n "$OUT_FILE" ]] || die "--out requires a file path"; shift 2 ;;
    *) die "Unknown flag: $1" ;;
  esac
done
# Self-limit a bare full read: with no window/meta/find/out flags, default MAX_CHARS
# to ~6000 so the plain read emits a next_offset continuation hint instead of
# being silently cut by the ~8K harness output cap.
if [[ "$HAS_WINDOW" == "0" && "$META" == "0" && "$FINGERPRINT" == "0" && -z "$FIND_TEXT" && -z "$OUT_FILE" ]]; then MAX_CHARS=6000; fi
export DC_META="$META" DC_FIND="$FIND_TEXT" DC_CONTEXT="$CONTEXT" \
       DC_OFFSET="$OFFSET" DC_LIMIT="$LIMIT" DC_MAX_CHARS="$MAX_CHARS" DC_DOC_ID="$DOC_ID" DC_JSON="$JSON" \
       DC_OUT="$OUT_FILE" DC_FINGERPRINT="$FINGERPRINT"

# Shared renderer: reads the doc content and applies the selected view.
# arg1 = 'api' (Docs API JSON, outline available) | 'text' (plain text, DC_TITLE env)
RENDER=$(cat << 'PYEOF'
import json, os, sys
kind, path = sys.argv[1], sys.argv[2]
if kind == 'api':
    doc = json.load(open(path))
    doc_id = doc.get('documentId', '')
    title = doc.get('title', '')
    parts, outline = [], []

    def walk(content, pos):
        # Recurse structural elements — paragraphs, tables (cell content is
        # invisible to a paragraph-only reader), and tables of contents.
        for elem in content:
            para = elem.get('paragraph')
            if para:
                ptext = ''.join(r.get('textRun', {}).get('content', '') for r in para.get('elements', []))
                style = (para.get('paragraphStyle') or {}).get('namedStyleType', '')
                if ptext.strip() and (style.startswith('HEADING') or style in ('TITLE', 'SUBTITLE')):
                    outline.append({'offset': pos, 'style': style, 'text': ptext.strip()[:200]})
                parts.append(ptext)
                pos += len(ptext)
                continue
            table = elem.get('table')
            if table:
                for row in table.get('tableRows', []):
                    for cell in row.get('tableCells', []):
                        pos = walk(cell.get('content', []), pos)
                continue
            toc = elem.get('tableOfContents')
            if toc:
                pos = walk(toc.get('content', []), pos)
        return pos

    def walk_tabs(tabs, pos):
        # Modern docs carry all content under doc['tabs']; doc['body'] is only
        # populated for the first tab (or legacy docs). Iterate every tab so
        # tab 2+ isn't invisible. Tab boundaries are recorded in the OUTLINE as a
        # 'TAB' entry, NEVER injected into the body text: a synthetic
        # "===== Tab =====" line in the returned text is a landmine — if that text
        # is ever written back it lands in the document body (exactly how a
        # finalized doc got a stray tab marker). Body text stays pure content.
        for tab in tabs:
            props = tab.get('tabProperties', {})
            ttitle = props.get('title', 'Untitled Tab')
            outline.append({'offset': pos, 'style': 'TAB', 'text': ttitle})
            dtab = tab.get('documentTab', {})
            pos = walk(dtab.get('body', {}).get('content', []), pos)
            pos = walk_tabs(tab.get('childTabs', []), pos)
        return pos

    def compute_fingerprint(d):
        # Deterministic structural signature of the doc's FORMATTING — the thing a
        # plain-text round-trip destroys. Capture before + after an edit and diff:
        # tables 1->0, headings collapsing to none, or the font set collapsing to a
        # single default all mean formatting was flattened. No body text is emitted.
        styles, tables, fonts = {}, [], {}
        def sig(ts):
            if not ts:
                return None
            fam = (ts.get('weightedFontFamily') or {}).get('fontFamily', '')
            sz = (ts.get('fontSize') or {}).get('magnitude', '')
            col = ((ts.get('foregroundColor') or {}).get('color') or {}).get('rgbColor')
            rgb = '-'
            if col is not None:
                rgb = '%s,%s,%s' % (round(col.get('red', 0), 3), round(col.get('green', 0), 3), round(col.get('blue', 0), 3))
            flags = ''.join(f for f, k in (('B', 'bold'), ('I', 'italic'), ('U', 'underline')) if ts.get(k))
            return 'fam=%s sz=%s rgb=%s %s' % (fam or '-', sz or '-', rgb, flags or '-')
        def walk_fp(content):
            for elem in content:
                para = elem.get('paragraph')
                if para:
                    st = (para.get('paragraphStyle') or {}).get('namedStyleType', 'NORMAL_TEXT')
                    styles[st] = styles.get(st, 0) + 1
                    for r in para.get('elements', []):
                        tr = r.get('textRun')
                        if tr:
                            s = sig(tr.get('textStyle'))
                            if s:
                                fonts[s] = fonts.get(s, 0) + len(tr.get('content', ''))
                    continue
                table = elem.get('table')
                if table:
                    rows = table.get('tableRows', [])
                    ncols = len(rows[0].get('tableCells', [])) if rows else 0
                    tables.append('%dx%d' % (len(rows), ncols))
                    for row in rows:
                        for cell in row.get('tableCells', []):
                            walk_fp(cell.get('content', []))
                    continue
                toc = elem.get('tableOfContents')
                if toc:
                    walk_fp(toc.get('content', []))
        dtabs = d.get('tabs')
        if dtabs:
            def walk_tabs_fp(ts):
                for t in ts:
                    walk_fp(t.get('documentTab', {}).get('body', {}).get('content', []))
                    walk_tabs_fp(t.get('childTabs', []))
            walk_tabs_fp(dtabs)
        else:
            walk_fp(d.get('body', {}).get('content', []))
        return {
            'paragraphs_by_style': dict(sorted(styles.items())),
            'tables': {'count': len(tables), 'dims': tables},
            'images': len(d.get('inlineObjects', {})) + len(d.get('positionedObjects', {})),
            'distinct_text_styles': dict(sorted(fonts.items())),
            'text_style_count': len(fonts),
        }

    fp = compute_fingerprint(doc) if os.environ.get('DC_FINGERPRINT') == '1' else None
    tabs = doc.get('tabs')
    if tabs:
        walk_tabs(tabs, 0)
    else:
        walk(doc.get('body', {}).get('content', []), 0)
    text = ''.join(parts)
else:
    text = open(path, encoding='utf-8', errors='replace').read()
    doc_id = os.environ.get('DC_DOC_ID', '')
    title = os.environ.get('DC_TITLE', 'Untitled Doc')
    outline = None
    fp = None

env = os.environ
total = len(text)
out = {'docId': doc_id, 'title': title, 'chars': total}
find = env.get('DC_FIND', '')
out_file = env.get('DC_OUT', '')
if env.get('DC_FINGERPRINT') == '1':
    if fp is None:
        out['note'] = 'fingerprint unavailable (Drive export fallback — no document structure available)'
    else:
        out['fingerprint'] = fp
    print(json.dumps(out, indent=2))
    sys.exit(0)
if out_file:
    # Full-content materialization: the COMPLETE text lands on disk in one call
    # (immune to the harness output cap), and the caller gets a verifiable char
    # count to check against --meta before deriving edits.
    with open(out_file, 'w', encoding='utf-8') as fh:
        fh.write(text)
    out['written'] = out_file
    out['note'] = ('READ/PLAN ONLY — complete document text written to file; verify chars, '
                   'then grep/sed it locally. Do NOT write this text back to a Doc: it carries '
                   'no formatting, so a replace from it flattens the document. Edit the live '
                   'Doc in place with the surgical verbs instead.')
    print(json.dumps(out, indent=2))
    sys.exit(0)
if env.get('DC_META') == '1':
    out['outline'] = outline if outline is not None else []
    if outline is None:
        out['note'] = 'outline unavailable (Drive export fallback)'
elif find:
    ctx = max(int(env.get('DC_CONTEXT') or 800), 50)
    hay, needle = text.lower(), find.lower()
    matches, start = [], 0
    while len(matches) < 20:
        i = hay.find(needle, start)
        if i < 0:
            break
        a, b = max(0, i - ctx), min(total, i + len(needle) + ctx)
        matches.append({'offset': i, 'excerpt': text[a:b]})
        start = i + len(needle)
    out['find'] = find
    out['match_count'] = len(matches)
    out['matches'] = matches
    if len(matches) == 20:
        out['note'] = 'first 20 matches shown — narrow the search string for more specific hits'
else:
    off = max(int(env.get('DC_OFFSET') or 0), 0)
    lim = int(env.get('DC_LIMIT') or 0)
    maxc = int(env.get('DC_MAX_CHARS') or 0)
    if lim <= 0 and maxc > 0:
        lim = maxc
    end = min(total, off + lim) if lim > 0 else total
    slice_text = text[off:end]
    truncated = end < total
    if env.get('DC_JSON') == '1':
        out['text'] = slice_text
        out['offset'] = off
        out['returned'] = end - off
        if truncated:
            out['truncated'] = True
            out['next_offset'] = end
        print(json.dumps(out, indent=2))
    else:
        # Plain text to stdout; pagination hint to stderr so stdout stays pure.
        sys.stdout.write(slice_text)
        if not slice_text.endswith('\n'):
            sys.stdout.write('\n')
        if truncated:
            sys.stderr.write(f"[docs-cat] returned {end-off} chars from offset {off}; "
                             f"{total-end} more remain — continue with --offset {end}\n")
    sys.exit(0)
print(json.dumps(out, indent=2))
PYEOF
)

TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"
TMP_RESP=$(mktemp)
trap 'rm -f "$TMP_RESP"' EXIT
HTTP_CODE=$(curl -s -o "$TMP_RESP" -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" \
  "${DOCS_API}/${DOC_ID}?includeTabsContent=true&suggestionsViewMode=SUGGESTIONS_INLINE")

# Check if the Docs API is disabled or returned an error that we can bypass using Drive export fallback
IS_DISABLED=0
if [[ "$HTTP_CODE" != "200" ]]; then
  if grep -q "SERVICE_DISABLED" "$TMP_RESP" 2>/dev/null; then
    IS_DISABLED=1
  fi
fi

if [[ "$IS_DISABLED" == "1" ]]; then
  DRIVE_API="https://www.googleapis.com/drive/v3"
  # Fallback to Drive API export
  DRIVE_TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
  # Fetch title
  TITLE_RESP=$(curl -s -H "Authorization: Bearer ${DRIVE_TOKEN}" "${DRIVE_API}/files/${DOC_ID}?fields=name")
  DC_TITLE=$(python3 -c "import json,sys; print(json.loads(sys.stdin.read()).get('name','Untitled Doc'))" <<< "$TITLE_RESP")
  export DC_TITLE
  # Fetch text to a temp file (no shell injection through content)
  TMP_TEXT=$(mktemp)
  trap 'rm -f "$TMP_RESP" "$TMP_TEXT"' EXIT
  curl -s -H "Authorization: Bearer ${DRIVE_TOKEN}" \
    "${DRIVE_API}/files/${DOC_ID}/export?mimeType=text/plain" > "$TMP_TEXT"
  python3 -c "$RENDER" text "$TMP_TEXT"
  exit 0
fi

if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"docId\":\"${DOC_ID}\",\"message\":\"Doc access denied. Share with ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
# A bare "404" once made an agent MUTATE ONE CHARACTER of the id and retry. A 404 has
# exactly three causes and they need three different recoveries — name all three.
if [[ "$HTTP_CODE" == "404" ]]; then
  { echo "[docs-cat] [ERROR] Docs API returned HTTP 404 — no readable Google Doc at id ${DOC_ID}. Three causes, three fixes:"
    echo "  (a) the id is wrong or was invented -> re-resolve it: drive-ls <containingFolderId>, or"
    echo "      drive-search --query \"name contains '<fragment of the real filename>'\"; copy the id verbatim from that output."
    echo "      An id is NEVER almost-right — do not change a character and retry."
    echo "  (b) the file exists but is NOT a native Google Doc (PDF/.docx/Sheet) -> the Docs API cannot read it:"
    echo "      drive-to-doc --file ${DOC_ID}   then docs-cat the docId that returns."
    echo "  (c) no permission on the file -> share it with ${AGENT_USER_EMAIL:-the agent service account} and report the block; retrying will not help."
  } >&2
  exit 1
fi
[[ "$HTTP_CODE" == "200" ]] || die "Docs API returned HTTP ${HTTP_CODE}"
python3 -c "$RENDER" api "$TMP_RESP"
