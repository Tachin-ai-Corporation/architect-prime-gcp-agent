#!/usr/bin/env bash
# gmail-draft-send — Send an existing Gmail draft
# Brain agent: motor (WRITE)
# Usage: gmail-draft-send <draft_id>
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
GMAIL_API="https://gmail.googleapis.com/gmail/v1/users/me"
die() { echo "[gmail-draft-send] [ERROR] $*" >&2; exit 1; }
DRAFT_ID="${1:-}"; [[ -n "$DRAFT_ID" ]] || die "Usage: gmail-draft-send <draft_id>"
TOKEN="$("$WS_TOKEN" --scope gmail)" || die "Auth failed"
HTTP_CODE=$(curl -s -o /tmp/gmail-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "{\"id\":\"${DRAFT_ID}\"}" "${GMAIL_API}/drafts/send")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"message\":\"Gmail draft send denied for ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Gmail draft send failed with HTTP ${HTTP_CODE}"
python3 -c "
import json; m = json.load(open('/tmp/gmail-response.json'))
print(json.dumps({'status':'sent','messageId':m.get('id',''),'threadId':m.get('threadId','')}, indent=2))
"
