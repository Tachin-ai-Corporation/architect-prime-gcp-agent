#!/usr/bin/env bash
# gmail-draft-create — Create a Gmail draft
# Brain agent: motor (WRITE)
# Usage: gmail-draft-create --to <addr> --subject <subj> --body <text>
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
GMAIL_API="https://gmail.googleapis.com/gmail/v1/users/me"
die() { echo "[gmail-draft-create] [ERROR] $*" >&2; exit 1; }
TO="" SUBJECT="" BODY="" BODY_HTML=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --to) TO="$2"; shift 2 ;; --subject) SUBJECT="$2"; shift 2 ;;
    --body) BODY="$2"; shift 2 ;; --body-html) BODY_HTML="$2"; shift 2 ;;
    *) die "Unknown: $1" ;; esac
done
[[ -n "$TO" && -n "$SUBJECT" ]] || die "Need --to and --subject"
TOKEN="$("$WS_TOKEN" --scope gmail)" || die "Auth failed"
RAW=$(python3 -c "
import base64, sys
to, subj, body, html = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
if html:
    msg = f'To: {to}\nSubject: {subj}\nContent-Type: text/html; charset=utf-8\n\n{html}'
else:
    msg = f'To: {to}\nSubject: {subj}\nContent-Type: text/plain; charset=utf-8\n\n{body}'
print(base64.urlsafe_b64encode(msg.encode()).decode())
" "$TO" "$SUBJECT" "$BODY" "$BODY_HTML")
HTTP_CODE=$(curl -s -o /tmp/gmail-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "{\"message\":{\"raw\":\"${RAW}\"}}" "${GMAIL_API}/drafts")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"message\":\"Gmail draft creation denied for ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Gmail draft create failed with HTTP ${HTTP_CODE}"
python3 -c "
import json; d = json.load(open('/tmp/gmail-response.json'))
print(json.dumps({'status':'draft_created','draftId':d.get('id',''),'messageId':d.get('message',{}).get('id','')}, indent=2))
"
