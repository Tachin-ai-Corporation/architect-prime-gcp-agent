#!/usr/bin/env bash
# gmail-send — Send an email via Gmail API
# Brain agent: motor (WRITE)
# Usage: gmail-send --to <addr> --subject <subj> --body <text>
#        gmail-send --to <addr> --subject <subj> --body-html "<h1>Report</h1>"
#        gmail-send --to "a@x.com,b@x.com" --cc c@x.com --subject "Team" --body "Hi all"
#        gmail-send --to <addr> --subject "Re: Thread" --body "Reply" --reply-to MSG_ID
set -euo pipefail
if [[ -f "${HOME}/.openclaw/bin/ws-token" ]]; then
  OC_HOST_ROOT="${OC_HOST_ROOT:-${HOME}}"
else
  OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
fi
WS_TOKEN="${OC_HOST_ROOT}/.openclaw/bin/ws-token"
GMAIL_API="https://gmail.googleapis.com/gmail/v1/users/me"
die() { echo "[gmail-send] [ERROR] $*" >&2; exit 1; }
TO="" SUBJECT="" BODY="" BODY_HTML="" CC="" BCC="" REPLY_TO=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --to) TO="$2"; shift 2 ;; --subject) SUBJECT="$2"; shift 2 ;;
    --body) BODY="$2"; shift 2 ;; --body-html) BODY_HTML="$2"; shift 2 ;;
    --cc) CC="$2"; shift 2 ;; --bcc) BCC="$2"; shift 2 ;;
    --reply-to) REPLY_TO="$2"; shift 2 ;; *) die "Unknown arg: $1" ;;
  esac
done
[[ -n "$TO" ]] || die "No recipient. Use --to <email>"
[[ -n "$SUBJECT" ]] || die "No subject. Use --subject <text>"
TOKEN="$("$WS_TOKEN" --scope gmail)" || die "Auth failed"
# Build RFC 2822 message and base64url encode
MESSAGE="$(python3 -c "
import base64, sys
to, subject, body, body_html, cc, bcc = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5], sys.argv[6]
headers = f'To: {to}\nSubject: {subject}\n'
if cc: headers += f'Cc: {cc}\n'
if bcc: headers += f'Bcc: {bcc}\n'
if body_html:
    headers += 'Content-Type: text/html; charset=utf-8\n'
    raw = headers + '\n' + body_html
else:
    headers += 'Content-Type: text/plain; charset=utf-8\n'
    raw = headers + '\n' + body
print(base64.urlsafe_b64encode(raw.encode('utf-8')).decode('ascii'))
" "$TO" "$SUBJECT" "$BODY" "$BODY_HTML" "$CC" "$BCC")" || die "Failed to encode message"
# Build request body
if [[ -n "$REPLY_TO" ]]; then
  THREAD_ID="$(curl -sf -H "Authorization: Bearer ${TOKEN}" \
    "${GMAIL_API}/messages/${REPLY_TO}?format=minimal" \
    | python3 -c "import json,sys; print(json.load(sys.stdin).get('threadId',''))" 2>/dev/null)"
  REQUEST_BODY="{\"raw\":\"${MESSAGE}\",\"threadId\":\"${THREAD_ID}\"}"
else
  REQUEST_BODY="{\"raw\":\"${MESSAGE}\"}"
fi
HTTP_CODE=$(curl -s -o /tmp/gmail-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$REQUEST_BODY" "${GMAIL_API}/messages/send")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"message\":\"Gmail send denied for ${AGENT_USER_EMAIL:-unknown}. Verify DWD scopes.\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Gmail send failed with HTTP ${HTTP_CODE}"
python3 -c "
import json; data = json.load(open('/tmp/gmail-response.json'))
print(json.dumps({'status':'sent','messageId':data.get('id',''),'threadId':data.get('threadId',''),'labelIds':data.get('labelIds',[])}, indent=2))
"
