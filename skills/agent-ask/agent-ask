#!/usr/bin/env bash
# ============================================================
# agent-ask — Conversational Q&A using Vertex AI Gemini
#
# The fundamental agent skill. Every agent gets this.
# Provides real-time conversational ability with Google Search
# grounding for current information.
#
# This skill is READ-ONLY — it answers questions, explains
# concepts, and provides guidance. It does NOT perform
# infrastructure operations or modify state.
#
# For fleet operations, use fleet-hire, fleet-fire, etc.
# Those are separate skills invoked by the brain via exec.
#
# Usage:
#   agent-ask "What is the latest GKE pricing?"
#   echo "question" | agent-ask --stdin
#
# Environment:
#   AGENT_ID     — Agent identifier (default: prime)
#   CORE_DIR     — CoreKit host root (default: /opt/corekit)
#   GEMINI_MODEL — Model to use (default: from contracts.json or gemini-2.5-flash)
#   REGION       — GCP region (default: from contracts.json or global)
# ============================================================
set -euo pipefail

# ---- CONFIG ----
AGENT_ID="${AGENT_ID:-prime}"
CORE_DIR="${CORE_DIR:-/opt/corekit}"

# Read defaults from contracts.json if available
CONTRACTS_FILE="${CORE_DIR}/corekit/contracts.json"
DEFAULT_MODEL="gemini-2.5-flash"
DEFAULT_REGION="global"
if [[ -f "$CONTRACTS_FILE" ]]; then
  DEFAULT_MODEL="$(python3 -c "import json; print(json.load(open('$CONTRACTS_FILE')).get('vertex',{}).get('subagentModel','gemini-2.5-flash'))" 2>/dev/null || echo "gemini-2.5-flash")"
  DEFAULT_REGION="$(python3 -c "import json; print(json.load(open('$CONTRACTS_FILE')).get('vertex',{}).get('location','global'))" 2>/dev/null || echo "global")"
fi

GEMINI_MODEL="${GEMINI_MODEL:-$DEFAULT_MODEL}"
REGION="${REGION:-$DEFAULT_REGION}"
MAX_OUTPUT_TOKENS="${MAX_OUTPUT_TOKENS:-4096}"
TEMPERATURE="${TEMPERATURE:-0.7}"

BUILD_PROMPT="${CORE_DIR}/bin/build-system-prompt"
CHAT_CONFIG="${CORE_DIR}/corekit/chat-config.json"

# ---- HELPERS ----
die() { echo "[agent-ask] [ERROR] $*" >&2; exit 1; }
log() { echo "[agent-ask] $*" >&2; }

# ---- Get access token ----
get_token() {
  curl -s -f \
    -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
    | grep -o '"access_token":"[^"]*"' | sed 's/"access_token":"\([^"]*\)"/\1/'
}

# ---- Get project ID ----
get_project() {
  curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || echo ""
}

# ---- Parse question ----
QUESTION=""
case "${1:-}" in
  --stdin)
    QUESTION="$(cat)"
    ;;
  --help|-h)
    echo "Usage: agent-ask <question>"
    echo "       echo 'question' | agent-ask --stdin"
    exit 0
    ;;
  "")
    die "No question provided. Usage: agent-ask <question>"
    ;;
  *)
    QUESTION="$1"
    ;;
esac

[[ -n "$QUESTION" ]] || die "Empty question"

# ---- Build system prompt ----
SYSTEM_PROMPT=""
if [[ -x "$BUILD_PROMPT" ]]; then
  SYSTEM_PROMPT="$(AGENT_ID="$AGENT_ID" CORE_DIR="$CORE_DIR" "$BUILD_PROMPT" 2>/dev/null || true)"
fi
if [[ -z "$SYSTEM_PROMPT" ]]; then
  SYSTEM_PROMPT="You are ${AGENT_ID}, an AI assistant. Answer questions accurately and concisely."
fi

# ---- Get credentials ----
TOKEN="$(get_token)" || die "Failed to get access token"
PROJECT_ID="$(get_project)" || die "Failed to get project ID"

[[ -n "$TOKEN" ]] || die "Empty access token"
[[ -n "$PROJECT_ID" ]] || die "Empty project ID"

# Fleet agents may use a different project for Gemini
GEMINI_PROJECT="${PROJECT_ID}"
if [[ -f "$CHAT_CONFIG" ]]; then
  GP="$(python3 -c "
import json
try:
    cfg = json.load(open('$CHAT_CONFIG'))
    print(cfg.get('geminiProject', ''))
except: pass
" 2>/dev/null || true)"
  [[ -n "$GP" ]] && GEMINI_PROJECT="$GP"
fi

# ---- Build API URL ----
if [[ "$REGION" == "global" ]]; then
  API_URL="https://aiplatform.googleapis.com/v1/projects/${GEMINI_PROJECT}/locations/global/publishers/google/models/${GEMINI_MODEL}:generateContent"
else
  API_URL="https://${REGION}-aiplatform.googleapis.com/v1/projects/${GEMINI_PROJECT}/locations/${REGION}/publishers/google/models/${GEMINI_MODEL}:generateContent"
fi

# Google Search grounding for current information
REQUEST_BODY="$(python3 -c "
import json, sys

system_prompt = sys.stdin.read()
question = '''$(printf '%s' "$QUESTION" | sed "s/'/'\\\\''/g")'''

body = {
    'contents': [{
        'role': 'user',
        'parts': [{'text': question}]
    }],
    'systemInstruction': {
        'parts': [{'text': system_prompt}]
    },
    'generationConfig': {
        'maxOutputTokens': $MAX_OUTPUT_TOKENS,
        'temperature': $TEMPERATURE
    },
    'tools': [{'google_search': {}}]
}
print(json.dumps(body))
" <<< "$SYSTEM_PROMPT")" || die "Failed to build request body"

# ---- Call Vertex AI ----
call_gemini() {
  local req_body="$1"
  local resp
  resp="$(curl -s -w "\n%{http_code}" \
    -X POST \
    -H "Authorization: Bearer ${TOKEN}" \
    -H "Content-Type: application/json" \
    -d "$req_body" \
    "$API_URL" 2>/dev/null)"

  local http_code body
  http_code="$(echo "$resp" | tail -1)"
  body="$(echo "$resp" | sed '$d')"

  if [[ "$http_code" != "200" ]]; then
    log "Vertex AI returned HTTP ${http_code}"
    log "Response: ${body:0:500}"
    die "Vertex AI API error (HTTP ${http_code})"
  fi
  echo "$body"
}

RESPONSE_BODY="$(call_gemini "$REQUEST_BODY")"

# ---- Extract answer text ----
ANSWER="$(echo "$RESPONSE_BODY" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    candidates = data.get('candidates', [])
    if candidates:
        parts = candidates[0].get('content', {}).get('parts', [])
        texts = [p['text'] for p in parts if 'text' in p]
        print(''.join(texts))
    else:
        print('No response generated.')
except Exception as e:
    print(f'Error parsing response: {e}')
" 2>/dev/null)" || ANSWER="Error parsing AI response."

# ---- Output ----
# Truncate to ~3800 chars to stay within Chat's 4096 limit
if [[ ${#ANSWER} -gt 3800 ]]; then
  ANSWER="${ANSWER:0:3800}..."
fi

echo "$ANSWER"
