#!/usr/bin/env bash
# slides-create — Create a new Google Slides presentation
# Brain agent: motor (WRITE)
# Usage: slides-create --title "My Deck" [--folder FOLDER_ID]
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
SLIDES_API="https://slides.googleapis.com/v1/presentations"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[slides-create] [ERROR] $*" >&2; exit 1; }
# Per-run scratch dir. A fixed /tmp/<name>.json is owned by whoever runs the
# tool first: every later run by a different user fails `curl -o` with exit 23,
# and `set -e` kills the script before die() can say so — a silent, permanent
# break with no diagnostic. It also makes two concurrent runs read each
# other's response. The docs/ tools already did this; these were left behind.
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT
TITLE="" FOLDER=""
while [[ $# -gt 0 ]]; do
  case "$1" in --title) TITLE="$2"; shift 2 ;; --folder) FOLDER="$2"; shift 2 ;; *) die "Unknown: $1" ;; esac
done
[[ -n "$TITLE" ]] || die "Need --title"
TOKEN="$("$WS_TOKEN" --scope slides)" || die "Auth failed"
HTTP_CODE=$(curl -s -o ${__DT}/slides-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "{\"title\":\"${TITLE}\"}" "$SLIDES_API")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"message\":\"Slides create denied for ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Slides create failed with HTTP ${HTTP_CODE}"
PRES_ID=$(python3 -c "import json; print(json.load(open('${__DT}/slides-response.json'))['presentationId'])")
if [[ -n "$FOLDER" ]]; then
  curl -sf -X PATCH -H "Authorization: Bearer ${TOKEN}" \
    "${DRIVE_API}/files/${PRES_ID}?addParents=${FOLDER}&removeParents=root" > /dev/null 2>&1
fi
python3 -c "
import json; d = json.load(open('${__DT}/slides-response.json'))
print(json.dumps({'status':'created','presentationId':d['presentationId'],'title':d['title'],'link':'https://docs.google.com/presentation/d/'+d['presentationId']}, indent=2))
"
