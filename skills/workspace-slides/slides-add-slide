#!/usr/bin/env bash
# slides-add-slide — Add a new slide to a Google Slides presentation
# Brain agent: motor (WRITE)
# Usage: slides-add-slide <presentation_id> [--layout LAYOUT_TYPE] [--index INSERT_INDEX]
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
SLIDES_API="https://slides.googleapis.com/v1/presentations"
die() { echo "[slides-add-slide] [ERROR] $*" >&2; exit 1; }
PRES_ID="" LAYOUT="BLANK" INDEX=""
while [[ $# -gt 0 ]]; do
  case "$1" in --layout) LAYOUT="$2"; shift 2 ;; --index) INDEX="$2"; shift 2 ;; -*) die "Unknown: $1" ;; *) PRES_ID="$1"; shift ;; esac
done
[[ -n "$PRES_ID" ]] || die "Need <presentation_id>"
TOKEN="$("$WS_TOKEN" --scope slides)" || die "Auth failed"
BODY=$(python3 -c "
import json, sys
layout = sys.argv[1]
index = sys.argv[2]
req = {'createSlide': {'slideLayoutReference': {'predefinedLayout': layout}}}
if index:
    req['createSlide']['insertionIndex'] = int(index)
print(json.dumps({'requests': [req]}))
" "$LAYOUT" "$INDEX")
HTTP_CODE=$(curl -s -o /tmp/slides-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" "${SLIDES_API}/${PRES_ID}:batchUpdate")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"presentationId\":\"${PRES_ID}\",\"message\":\"Slides add-slide denied for ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Slides add-slide failed with HTTP ${HTTP_CODE}"
python3 -c "
import json; r = json.load(open('/tmp/slides-response.json'))
replies = r.get('replies', [{}])
slide_id = replies[0].get('createSlide', {}).get('objectId', '')
print(json.dumps({'status': 'created', 'slideId': slide_id}, indent=2))
"
