#!/usr/bin/env bash
# slides-update — Batch update a Google Slides presentation
# Brain agent: motor (WRITE)
# Usage: slides-update <presentation_id> --requests '<JSON array of request objects>'
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
SLIDES_API="https://slides.googleapis.com/v1/presentations"
die() { echo "[slides-update] [ERROR] $*" >&2; exit 1; }
# Per-run scratch dir. A fixed /tmp/<name>.json is owned by whoever runs the
# tool first: every later run by a different user fails `curl -o` with exit 23,
# and `set -e` kills the script before die() can say so — a silent, permanent
# break with no diagnostic. It also makes two concurrent runs read each
# other's response. The docs/ tools already did this; these were left behind.
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT
PRES_ID="" REQUESTS=""
while [[ $# -gt 0 ]]; do
  case "$1" in --requests) REQUESTS="$2"; shift 2 ;; -*) die "Unknown: $1" ;; *) PRES_ID="$1"; shift ;; esac
done
[[ -n "$PRES_ID" ]] || die "Need <presentation_id>"
[[ -n "$REQUESTS" ]] || die "Need --requests '<JSON array>'"
TOKEN="$("$WS_TOKEN" --scope slides)" || die "Auth failed"
BODY=$(python3 -c "import json,sys; print(json.dumps({'requests':json.loads(sys.argv[1])}))" "$REQUESTS")
HTTP_CODE=$(curl -s -o ${__DT}/slides-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" "${SLIDES_API}/${PRES_ID}:batchUpdate")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"presentationId\":\"${PRES_ID}\",\"message\":\"Slides update denied for ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Slides batchUpdate failed with HTTP ${HTTP_CODE}"
python3 -c "
import json; r = json.load(open('${__DT}/slides-response.json'))
print(json.dumps(r, indent=2))
"
