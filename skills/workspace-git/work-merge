#!/usr/bin/env bash
# work-merge — Merge source branch into target in the ether
# Brain agent: motor (WRITE)
#
# Usage:
#   work-merge <repoId> <sourceBranch> [--target <branch>] [--policy auto|gated] [--actor <id>]
#
# Output: JSON { status, sha }
set -euo pipefail

CORE_DIR="${CORE_DIR:-/opt/corekit}"
GIT_STORE="${CORE_DIR}/platform/persistence/git-store.mjs"
die() { echo "[work-merge] [ERROR] $*" >&2; exit 1; }
log() { echo "[work-merge] $*" >&2; }

# ---- Args ----
REPO_ID="" SOURCE="" TARGET="main" POLICY="auto" ACTOR=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --target) TARGET="$2"; shift 2 ;;
    --policy) POLICY="$2"; shift 2 ;;
    --actor)  ACTOR="$2"; shift 2 ;;
    --help|-h) echo "Usage: work-merge <repoId> <sourceBranch> [--target <branch>] [--policy auto|gated] [--actor <id>]"; exit 0 ;;
    *)
      if [[ -z "$REPO_ID" && "$1" != -* ]]; then REPO_ID="$1"; shift
      elif [[ -z "$SOURCE" && "$1" != -* ]]; then SOURCE="$1"; shift
      else die "Unknown: $1"; fi ;;
  esac
done
[[ -n "$REPO_ID" ]] || die "Need <repoId>"
[[ -n "$SOURCE" ]] || die "Need <sourceBranch>"
[[ -n "$ACTOR" ]] || ACTOR="${AGENT_ID:-motor}"

log "Merging repo=${REPO_ID} source=${SOURCE} target=${TARGET} policy=${POLICY} actor=${ACTOR}"
node "$GIT_STORE" merge "$REPO_ID" "$SOURCE" "$TARGET" "$POLICY" "$ACTOR"
