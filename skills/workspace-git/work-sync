#!/usr/bin/env bash
# work-sync — Push local commits to the ether (GCS+Firestore)
# Brain agent: motor (WRITE)
#
# Handles non-fast-forward with automatic fetch+rebase+retry.
#
# Usage:
#   work-sync <repoId> [--branch <branch>] [--dir <path>] [--actor <id>]
#
# Output: JSON { status, sha, attempts }
set -euo pipefail

CORE_DIR="${CORE_DIR:-/opt/corekit}"
GIT_STORE="${CORE_DIR}/platform/persistence/git-store.mjs"
die() { echo "[work-sync] [ERROR] $*" >&2; exit 1; }
log() { echo "[work-sync] $*" >&2; }

# ---- Args ----
REPO_ID="" BRANCH="" DIR="" ACTOR=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --branch) BRANCH="$2"; shift 2 ;;
    --dir)    DIR="$2"; shift 2 ;;
    --actor)  ACTOR="$2"; shift 2 ;;
    --help|-h) echo "Usage: work-sync <repoId> [--branch <branch>] [--dir <path>] [--actor <id>]"; exit 0 ;;
    *)
      if [[ -z "$REPO_ID" && "$1" != -* ]]; then REPO_ID="$1"; shift
      else die "Unknown: $1"; fi ;;
  esac
done
[[ -n "$REPO_ID" ]] || die "Need <repoId>"

# Defaults
[[ -n "$DIR" ]] || DIR="."
[[ -n "$BRANCH" ]] || BRANCH="$(cd "$DIR" && git rev-parse --abbrev-ref HEAD)"
[[ -n "$ACTOR" ]] || ACTOR="${AGENT_ID:-motor}"

log "Syncing repo=${REPO_ID} branch=${BRANCH} dir=${DIR} actor=${ACTOR}"
node "$GIT_STORE" push "$REPO_ID" "$BRANCH" "$DIR" "$ACTOR"
