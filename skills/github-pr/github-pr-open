#!/usr/bin/env bash
# github-pr-open - Push the current branch of a clone to GitHub and open a
# DRAFT pull request. Human-gated by construction: PRs are ALWAYS draft and
# this tool NEVER merges (a PR to the public template is destructive_or_public,
# B-28). Authenticates via the Secret Manager GitHub token; token is never
# logged or persisted.
#
# Usage:
#   github-pr-open --dir <clone> --branch <b> --title "<t>" --body-file <f> [--base main] [--repo owner/name] [--secret id] [--ready]
# --ready opens a normal (non-draft) PR; omit for draft (default, recommended).
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
die() { echo "[github-pr-open] [ERROR] $*" >&2; exit 1; }
log() { echo "[github-pr-open] $*" >&2; }

DIR=""; BRANCH=""; TITLE=""; BODY_FILE=""; BASE="main"; REPO=""
SECRET="aps-secret-github-token"; DRAFT="true"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dir)       DIR="$2"; shift 2 ;;
    --branch)    BRANCH="$2"; shift 2 ;;
    --title)     TITLE="$2"; shift 2 ;;
    --body-file) BODY_FILE="$2"; shift 2 ;;
    --base)      BASE="$2"; shift 2 ;;
    --repo)      REPO="$2"; shift 2 ;;
    --secret)    SECRET="$2"; shift 2 ;;
    --ready)     DRAFT="false"; shift ;;
    --help|-h)   echo "Usage: github-pr-open --dir <clone> --branch <b> --title <t> --body-file <f> [--base main] [--ready]"; exit 0 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DIR" && -d "$DIR/.git" ]] || die "--dir must be a git clone"
[[ -n "$BRANCH" ]] || die "--branch required"
[[ -n "$TITLE" ]] || die "--title required"
[[ -n "$BODY_FILE" && -f "$BODY_FILE" ]] || die "--body-file must be an existing file"

# Resolve owner/repo from the clone origin when not supplied.
if [[ -z "$REPO" ]]; then
  ORIGIN=$(git -C "$DIR" remote get-url origin 2>/dev/null || true)
  ORIGIN="${ORIGIN%.git}"
  ORIGIN="${ORIGIN#*github.com/}"
  ORIGIN="${ORIGIN#*github.com:}"
  REPO="$ORIGIN"
fi
[[ "$REPO" == */* ]] || die "Could not resolve owner/repo"
OWNER="${REPO%%/*}"; NAME="${REPO##*/}"

# Guard: refuse to open an empty PR (no commits vs base).
git -C "$DIR" rev-parse --verify "$BRANCH" >/dev/null 2>&1 || die "branch does not exist in the clone"
AHEAD=$(git -C "$DIR" rev-list --count "origin/${BASE}..${BRANCH}" 2>/dev/null || echo 0)
[[ "$AHEAD" -ge 1 ]] || die "branch has no commits ahead of origin/${BASE} - nothing to PR"

SECRET_READ="${CORE_DIR}/bin/secret-read"; [[ -x "$SECRET_READ" ]] || SECRET_READ="secret-read"
TOKEN=$("$SECRET_READ" --name "$SECRET") || die "Could not read GitHub token"
[[ -n "$TOKEN" ]] || die "GitHub token empty"

# Push the branch (token injected only for this command, not persisted).
log "Pushing ${BRANCH} to ${OWNER}/${NAME}"
PUSH_URL="https://x-access-token:${TOKEN}@github.com/${OWNER}/${NAME}.git"
git -C "$DIR" push --quiet "$PUSH_URL" "${BRANCH}:refs/heads/${BRANCH}" 2>/dev/null \
  || die "git push failed (branch protection or token scope)"

# Build the PR request body.
REQ_TMP=$(mktemp); RESP_TMP=$(mktemp)
trap 'rm -f "$REQ_TMP" "$RESP_TMP"' EXIT
python3 - "$BODY_FILE" "$TITLE" "$BRANCH" "$BASE" "$DRAFT" > "$REQ_TMP" <<'PYEOF'
import json, sys
body = open(sys.argv[1], encoding="utf-8").read()
print(json.dumps({"title": sys.argv[2], "head": sys.argv[3], "base": sys.argv[4],
                  "body": body, "draft": sys.argv[5] == "true"}))
PYEOF

API="https://api.github.com/repos/${OWNER}/${NAME}/pulls"
CODE=$(curl -s -o "$RESP_TMP" -w '%{http_code}' -X POST \
  -H "Authorization: Bearer ${TOKEN}" -H "Accept: application/vnd.github+json" \
  "$API" --data-binary "@${REQ_TMP}")

if [[ "$CODE" == "422" ]]; then
  # 422 often = a PR already exists for this head. Surface the existing one.
  EXIST=$(curl -s -H "Authorization: Bearer ${TOKEN}" -H "Accept: application/vnd.github+json" \
    "${API}?head=${OWNER}:${BRANCH}&state=open" \
    | python3 -c 'import sys,json; d=json.load(sys.stdin); print(d[0]["html_url"] if d else "")' 2>/dev/null || echo "")
  if [[ -n "$EXIST" ]]; then
    echo "{\"status\":\"exists\",\"url\":\"${EXIST}\",\"branch\":\"${BRANCH}\"}"
    exit 0
  fi
  ERRTXT=$(head -c 300 "$RESP_TMP")
  die "PR create returned 422: ${ERRTXT}"
fi
if [[ "$CODE" != "201" ]]; then
  ERRTXT=$(head -c 300 "$RESP_TMP")
  die "PR create returned HTTP ${CODE}: ${ERRTXT}"
fi

python3 - "$RESP_TMP" <<'PYEOF'
import sys, json
d = json.load(open(sys.argv[1]))
print(json.dumps({"status": "pr_opened", "draft": d.get("draft"), "number": d.get("number"),
                  "url": d.get("html_url"), "branch": d.get("head", {}).get("ref"),
                  "base": d.get("base", {}).get("ref")}, indent=2))
PYEOF
