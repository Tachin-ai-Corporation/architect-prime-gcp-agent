#!/usr/bin/env bash
# calendar-delete — Delete a calendar event
# Brain agent: motor (WRITE)
# Usage: calendar-delete --event EVENT_ID [--calendar primary]
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
CAL_API="https://www.googleapis.com/calendar/v3"
die() { echo "[calendar-delete] [ERROR] $*" >&2; exit 1; }
CAL_ID="primary" EVENT_ID=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --event) EVENT_ID="$2"; shift 2 ;; --calendar) CAL_ID="$2"; shift 2 ;;
    *) die "Unknown: $1" ;; esac
done
[[ -n "$EVENT_ID" ]] || die "Need --event <event_id>"
TOKEN="$("$WS_TOKEN" --scope calendar)" || die "Auth failed"
HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" -X DELETE \
  -H "Authorization: Bearer ${TOKEN}" \
  "${CAL_API}/calendars/${CAL_ID}/events/${EVENT_ID}")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"message\":\"Calendar access denied for ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
if [[ "$HTTP_CODE" == "204" || "$HTTP_CODE" == "200" ]]; then
  echo "{\"status\":\"deleted\",\"eventId\":\"${EVENT_ID}\"}"
else
  die "Delete failed with HTTP ${HTTP_CODE}"
fi
