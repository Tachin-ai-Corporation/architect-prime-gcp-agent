#!/usr/bin/env bash
# sheets-batch-update — Apply several targeted cell updates in ONE call.
# This is the RECOMMENDED way to write. Each update carries its own A1 range and
# its values; nothing else in the sheet is touched, so all formatting, merges,
# formulas, and conditional formatting in untouched cells are preserved. Because
# the ranges travel in the request BODY (not the URL), tab names containing
# spaces or slashes need only the normal single-quote wrapping — no URL encoding.
#
# --data is a JSON array of {"range": A1, "values": [[...]]} objects.
#
# STRONGLY PREFERRED: pass --tab "<Tab Name>" and use BARE A1 spans in the ranges
# (no tab prefix, no quotes). The tool prepends the correctly-quoted tab to each.
# This keeps --data free of single quotes, so it survives shell quoting — the JSON
# has only double quotes and wraps cleanly in a single-quoted argument:
#   sheets-batch-update --sheet ID --tab "Tracker w/ Pri" \
#     --data '[{"range":"F26","values":[["Completed"]]},{"range":"F5","values":[["Yellow"]]}]'
# Do NOT put a quoted tab name INSIDE --data (e.g. "'"'"'Tab'"'"'!F5") — the embedded
# single quotes are near-impossible to escape correctly on a shell command line.
# For updates spanning MULTIPLE tabs, omit --tab and give each entry a full range;
# then use --data-file to avoid the quoting trap:
#   sheets-batch-update --sheet ID --data-file ${__DT}/updates.json
# Add --raw to store values verbatim (default USER_ENTERED lets Sheets parse dates/numbers/formulas).
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
SHEETS_API="https://sheets.googleapis.com/v4/spreadsheets"
die() { echo "[sheets-batch-update] [ERROR] $*" >&2; exit 1; }
# Per-run scratch dir. A fixed /tmp/<name>.json is owned by whoever runs the
# tool first: every later run by a different user fails `curl -o` with exit 23,
# and `set -e` kills the script before die() can say so — a silent, permanent
# break with no diagnostic. It also makes two concurrent runs read each
# other's response. The docs/ tools already did this; these were left behind.
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT
SHEET_ID="" DATA="" DATA_FILE="" INPUT="USER_ENTERED" TAB=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --sheet) SHEET_ID="$2"; shift 2 ;;
    --tab) TAB="$2"; shift 2 ;;
    --data) DATA="$2"; shift 2 ;;
    --data-file) DATA_FILE="$2"; shift 2 ;;
    --raw) INPUT="RAW"; shift ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$DATA_FILE" ]] && DATA="$(cat "$DATA_FILE")"
[[ -n "$SHEET_ID" && -n "$DATA" ]] || die "Need --sheet and --data (or --data-file): a JSON array of {range,values}"
TOKEN="$("$WS_TOKEN" --scope sheets)" || die "Auth failed"
# Validate + assemble the body in one pass. If --tab is given, prepend the
# single-quoted (apostrophe-doubled) tab to every entry range that has no '!'.
python3 -c "
import json,sys
data, input_opt, tab = json.loads(sys.argv[1]), sys.argv[2], sys.argv[3]
assert isinstance(data,list) and data, 'must be a non-empty JSON array'
if tab:
    q = \"'\" + tab.replace(\"'\", \"''\") + \"'\"
for e in data:
    assert 'range' in e and 'values' in e, \"each entry needs 'range' and 'values'\"
    if tab and '!' not in e['range']:
        e['range'] = q + '!' + e['range']
print(json.dumps({'valueInputOption':input_opt,'data':data}))
" "$DATA" "$INPUT" "$TAB" > ${__DT}/sheets-batch-body.json \
  || die "--data must be a non-empty JSON array of objects each with 'range' and 'values'"
HTTP_CODE=$(curl -s -o ${__DT}/sheets-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  --data @${__DT}/sheets-batch-body.json \
  "${SHEETS_API}/${SHEET_ID}/values:batchUpdate")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"sheet\":\"${SHEET_ID}\",\"message\":\"Sheets access denied. Share with ${AGENT_USER_EMAIL:-the agent Workspace email}.\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Sheets API returned HTTP ${HTTP_CODE} (body in ${__DT}/sheets-response.json)"
python3 -c "
import json
d=json.load(open('${__DT}/sheets-response.json'))
resp=d.get('responses',[])
print(json.dumps({
  'status':'updated',
  'totalUpdatedCells': d.get('totalUpdatedCells',0),
  'totalUpdatedRows': d.get('totalUpdatedRows',0),
  'ranges':[r.get('updatedRange','') for r in resp],
}, indent=2))
"
