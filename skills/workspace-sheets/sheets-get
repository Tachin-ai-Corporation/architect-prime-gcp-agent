#!/usr/bin/env bash
# sheets-get — Read a cell range from a Google Sheet
# Brain agent: temporal-memory (READ)
# Usage: sheets-get --sheet SHEET_ID --range "Sheet1!A1:D10"
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
SHEETS_API="https://sheets.googleapis.com/v4/spreadsheets"
die() { echo "[sheets-get] [ERROR] $*" >&2; exit 1; }
# Per-run scratch dir. A fixed /tmp/<name>.json is owned by whoever runs the
# tool first: every later run by a different user fails `curl -o` with exit 23,
# and `set -e` kills the script before die() can say so — a silent, permanent
# break with no diagnostic. It also makes two concurrent runs read each
# other's response. The docs/ tools already did this; these were left behind.
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT
SHEET_ID="" RANGE="" TAB=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --sheet) SHEET_ID="$2"; shift 2 ;; --range) RANGE="$2"; shift 2 ;;
    --tab) TAB="$2"; shift 2 ;;
    *) die "Unknown: $1" ;; esac
done
# --tab wraps the (verbatim) tab name in the required single quotes and prepends
# it, so the caller never has to quote a name containing spaces or a slash.
if [[ -n "$TAB" ]]; then
  [[ -n "$RANGE" ]] || die "With --tab, give --range as the A1 span only (e.g. --tab 'Q3 Plan' --range A1:D10)"
  TAB_ESC="${TAB//\'/\'\'}"   # A1 escapes an internal single-quote by doubling it
  RANGE="'${TAB_ESC}'!${RANGE}"
fi
[[ -n "$SHEET_ID" && -n "$RANGE" ]] || die "Need --sheet and (--range or --tab + --range)"
TOKEN="$("$WS_TOKEN" --scope sheets)" || die "Auth failed"
# safe='' so a slash in a tab name (e.g. 'Tracker w/ Pri') is encoded, not left
# to split the URL path into a 400.
ENC_RANGE=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$RANGE")
HTTP_CODE=$(curl -s -o ${__DT}/sheets-response.json -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" \
  "${SHEETS_API}/${SHEET_ID}/values/${ENC_RANGE}")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"sheet\":\"${SHEET_ID}\",\"message\":\"Sheets access denied. Share with ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Sheets API returned HTTP ${HTTP_CODE}"
python3 -c "
import json
data = json.load(open('${__DT}/sheets-response.json'))
vals = data.get('values',[])
print(json.dumps({'range':data.get('range',''),'rows':len(vals),'values':vals}, indent=2))
"
