#!/usr/bin/env bash
# sheets-append — Append rows to a Google Sheet
# Brain agent: motor (WRITE)
# Usage: sheets-append --sheet SHEET_ID --range "Sheet1!A:C" --values '[["Alice","PM","2026"]]'
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
SHEETS_API="https://sheets.googleapis.com/v4/spreadsheets"
die() { echo "[sheets-append] [ERROR] $*" >&2; exit 1; }
SHEET_ID="" RANGE="" VALUES="" TAB=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --sheet) SHEET_ID="$2"; shift 2 ;; --range) RANGE="$2"; shift 2 ;;
    --tab) TAB="$2"; shift 2 ;;
    --values) VALUES="$2"; shift 2 ;; *) die "Unknown: $1" ;; esac
done
# --tab wraps the (verbatim) tab name in the required single quotes and prepends
# it. For append, --range is the table's column span, e.g. --tab 'Tasks' --range A:N.
if [[ -n "$TAB" ]]; then
  [[ -n "$RANGE" ]] || die "With --tab, give --range as the column span (e.g. --tab 'Tasks' --range A:N)"
  TAB_ESC="${TAB//\'/\'\'}"
  RANGE="'${TAB_ESC}'!${RANGE}"
fi
[[ -n "$SHEET_ID" && -n "$RANGE" && -n "$VALUES" ]] || die "Need --sheet, --range (or --tab + --range), --values"
TOKEN="$("$WS_TOKEN" --scope sheets)" || die "Auth failed"
# safe='' so a slash in a tab name is encoded, not left to split the URL → 400.
ENC_RANGE=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$RANGE")
HTTP_CODE=$(curl -s -o /tmp/sheets-response.json -w '%{http_code}' \
  -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "{\"values\":${VALUES}}" \
  "${SHEETS_API}/${SHEET_ID}/values/${ENC_RANGE}:append?valueInputOption=USER_ENTERED&insertDataOption=INSERT_ROWS")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"sheet\":\"${SHEET_ID}\",\"message\":\"Sheets access denied. Share with ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Sheets API returned HTTP ${HTTP_CODE}"
python3 -c "
import json
data = json.load(open('/tmp/sheets-response.json'))
u = data.get('updates',{})
print(json.dumps({'status':'appended','range':u.get('updatedRange',''),'rows':u.get('updatedRows',0),'cells':u.get('updatedCells',0)}, indent=2))
"
