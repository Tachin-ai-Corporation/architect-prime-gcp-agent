#!/usr/bin/env bash
# sheets-create — Create a Google Sheet
# Brain agent: motor (WRITE)
# Usage: sheets-create --title "Ops Tracker" [--tab "Q3"] [--folder FOLDER_ID]
#
# This skill could read, update, batch-update, insert into and append to a
# spreadsheet, and could not make one. A live assistant mission asked for a new
# tracker, tried `sheets-create`, then `sheets create`, then `drive-create`, then
# read this skill's own SKILL.md, and correctly concluded the capability was
# absent. Every guess it made was reasonable; the tool simply was not there.
#
# `--name` is accepted as an alias for `--title` because that is what the motor
# reached for first. A tool that rejects the obvious synonym for its only
# required argument spends an agent's turn teaching it the vocabulary.
set -euo pipefail
CORE_DIR="${CORE_DIR:-/opt/corekit}"
WS_TOKEN="${CORE_DIR}/bin/ws-token"
SHEETS_API="https://sheets.googleapis.com/v4/spreadsheets"
DRIVE_API="https://www.googleapis.com/drive/v3/files"
die() { echo "[sheets-create] [ERROR] $*" >&2; exit 1; }

TITLE="" TAB="" FOLDER=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --title|--name) TITLE="$2"; shift 2 ;;
    --tab) TAB="$2"; shift 2 ;;
    --folder|--parent) FOLDER="$2"; shift 2 ;;
    *) die "Unknown: $1" ;;
  esac
done
[[ -n "$TITLE" ]] || die "Need --title (the spreadsheet name)"

TOKEN="$("$WS_TOKEN" --scope sheets)" || die "Auth failed"
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT

# ---- Idempotent (C-18): the same call twice yields one spreadsheet ----
# Re-running a mission step must not litter Drive with duplicates named alike,
# and a re-plan re-runs steps as a matter of course. Scoped to the folder when
# one is given, so two projects may each own a "Tracker".
Q="name='${TITLE//\'/\\\'}' and mimeType='application/vnd.google-apps.spreadsheet' and trashed=false"
[[ -n "$FOLDER" ]] && Q="${Q} and '${FOLDER}' in parents"
ENC_Q=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=''))" "$Q")
HTTP_CODE=$(curl -s -o "$__DT/find.json" -w '%{http_code}' -H "Authorization: Bearer ${TOKEN}" \
  "${DRIVE_API}?q=${ENC_Q}&fields=files(id,name,webViewLink)&pageSize=1")
if [[ "$HTTP_CODE" == "200" ]]; then
  EXISTING=$(python3 -c "
import json,sys
f=json.load(open('$__DT/find.json')).get('files',[])
print(json.dumps({'status':'exists','spreadsheetId':f[0]['id'],'title':f[0].get('name',''),'url':f[0].get('webViewLink','')}) if f else '')
")
  if [[ -n "$EXISTING" ]]; then echo "$EXISTING"; exit 0; fi
fi

# ---- Create ----
BODY=$(python3 -c "
import json,sys
title, tab = sys.argv[1], sys.argv[2]
body = {'properties': {'title': title}}
if tab:
    body['sheets'] = [{'properties': {'title': tab}}]
print(json.dumps(body))
" "$TITLE" "$TAB")

HTTP_CODE=$(curl -s -o "$__DT/create.json" -w '%{http_code}' -X POST \
  -H "Authorization: Bearer ${TOKEN}" -H 'Content-Type: application/json' \
  -d "$BODY" "${SHEETS_API}")
if [[ "$HTTP_CODE" == "403" || "$HTTP_CODE" == "401" ]]; then
  echo "{\"status\":\"access_denied\",\"message\":\"Sheets create denied for ${AGENT_USER_EMAIL:-unknown}\"}"
  exit 0
fi
[[ "$HTTP_CODE" == "200" ]] || die "Sheets API returned HTTP ${HTTP_CODE} on create: $(head -c 300 "$__DT/create.json")"

SHEET_ID=$(python3 -c "import json;print(json.load(open('$__DT/create.json')).get('spreadsheetId',''))")
[[ -n "$SHEET_ID" ]] || die "create returned no spreadsheetId"

# ---- Optionally file it ----
# Sheets create always lands in My Drive root; a folder is a second, Drive-side
# call. Reported separately: a spreadsheet that exists but is in the wrong place
# is a different outcome from one that was never made, and the caller can tell.
FOLDER_STATUS="root"
if [[ -n "$FOLDER" ]]; then
  HTTP_CODE=$(curl -s -o "$__DT/move.json" -w '%{http_code}' -X PATCH \
    -H "Authorization: Bearer ${TOKEN}" -H 'Content-Type: application/json' \
    "${DRIVE_API}/${SHEET_ID}?addParents=${FOLDER}&removeParents=root&fields=id")
  if [[ "$HTTP_CODE" == "200" ]]; then FOLDER_STATUS="$FOLDER"; else FOLDER_STATUS="root (move to ${FOLDER} failed HTTP ${HTTP_CODE})"; fi
fi

python3 -c "
import json,sys
print(json.dumps({
  'status':'created',
  'spreadsheetId': sys.argv[1],
  'title': sys.argv[2],
  'tab': sys.argv[3] or 'Sheet1',
  'folder': sys.argv[4],
  'url': 'https://docs.google.com/spreadsheets/d/' + sys.argv[1],
}, indent=2))
" "$SHEET_ID" "$TITLE" "$TAB" "$FOLDER_STATUS"
