[Unit]
Description=Agent Ears — Deterministic Input Processing
After=network-online.target agent-neural-gateway.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/corekit/bin/start-agent-ears
Restart=always
RestartSec=3
StandardOutput=append:/var/log/agent-ears.log
StandardError=append:/var/log/agent-ears.log
Environment=CORE_DIR=/opt/corekit

[Install]
WantedBy=multi-user.target
