[Unit]
Description=Agent Introspect — Filesystem Introspection Service
After=network-online.target agent-neural-gateway.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/corekit/bin/start-agent-introspect
Restart=always
RestartSec=5
StandardOutput=append:/var/log/agent-introspect.log
StandardError=append:/var/log/agent-introspect.log
Environment=CORE_DIR=/opt/corekit

[Install]
WantedBy=multi-user.target
