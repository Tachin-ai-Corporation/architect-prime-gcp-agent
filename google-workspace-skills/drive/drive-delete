#!/usr/bin/env bash
# drive-delete — Trash a file in Google Drive
# Brain agent: motor (WRITE)
# Usage: drive-delete --file FILE_ID
set -euo pipefail
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
WS_TOKEN="${OC_HOST_ROOT}/.openclaw/skills/workspace/ws-token"
DRIVE_API="https://www.googleapis.com/drive/v3"
die() { echo "[drive-delete] [ERROR] $*" >&2; exit 1; }
FILE_ID=""
while [[ $# -gt 0 ]]; do
  case "$1" in --file) FILE_ID="$2"; shift 2 ;; *) die "Unknown: $1" ;; esac
done
[[ -n "$FILE_ID" ]] || die "Need --file <file_id>"
TOKEN="$("$WS_TOKEN" --scope drive)" || die "Auth failed"
curl -sf -X PATCH -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d '{"trashed":true}' "${DRIVE_API}/files/${FILE_ID}" \
  | python3 -c "import json,sys; print(json.dumps({'status':'trashed','id':'$FILE_ID'}, indent=2))"
