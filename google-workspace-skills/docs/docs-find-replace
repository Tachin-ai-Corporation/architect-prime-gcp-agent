#!/usr/bin/env bash
# docs-find-replace — Find and replace text in a Google Doc
# Brain agent: motor (WRITE)
# Usage: docs-find-replace --doc DOC_ID --find "old text" --replace "new text" [--match-case]
set -euo pipefail
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
WS_TOKEN="${OC_HOST_ROOT}/.openclaw/skills/workspace/ws-token"
DOCS_API="https://docs.googleapis.com/v1/documents"
die() { echo "[docs-find-replace] [ERROR] $*" >&2; exit 1; }
DOC_ID="" FIND="" REPLACE="" MATCH_CASE=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --doc) DOC_ID="$2"; shift 2 ;; --find) FIND="$2"; shift 2 ;;
    --replace) REPLACE="$2"; shift 2 ;; --match-case) MATCH_CASE=true; shift ;;
    *) die "Unknown: $1" ;; esac
done
[[ -n "$DOC_ID" && -n "$FIND" ]] || die "Need --doc and --find"
TOKEN="$("$WS_TOKEN" --scope docs)" || die "Auth failed"
BODY=$(python3 -c "
import json, sys
req = {'replaceAllText':{'containsText':{'text':sys.argv[1],'matchCase':sys.argv[3]=='true'},'replaceText':sys.argv[2]}}
print(json.dumps({'requests':[req]}))
" "$FIND" "$REPLACE" "$MATCH_CASE")
curl -sf -X POST -H "Authorization: Bearer ${TOKEN}" -H "Content-Type: application/json" \
  -d "$BODY" "${DOCS_API}/${DOC_ID}:batchUpdate" \
  | python3 -c "
import json, sys; data = json.load(sys.stdin)
replies = data.get('replies',[{}])
count = replies[0].get('replaceAllText',{}).get('occurrencesChanged',0) if replies else 0
print(json.dumps({'status':'replaced','docId':'$DOC_ID','find':'$FIND','occurrences':count}, indent=2))
"
