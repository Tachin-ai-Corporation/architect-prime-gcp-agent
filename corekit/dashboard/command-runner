#!/usr/bin/env bash
# ============================================================
# command-runner — Deterministic command execution daemon
#
# Polls Firestore primes/{id}/commands/ for pending commands
# and executes them on the HOST OS (not inside the container).
#
# This is the single execution path for all fleet/upgrade
# operations — both dashboard buttons and chat (via web-search)
# write commands here.
#
# Supported commands:
#   fleet_deploy     — Deploy a new fleet agent
#   fleet_teardown   — Decommission a fleet agent
#   fleet_upgrade    — Upgrade a fleet agent's CoreKit
#   upgrade_corekit  — Upgrade Prime's CoreKit + restart gateway
#   gateway_restart  — Restart the brain gateway service
#
# Runs as a systemd service on the Prime VM host.
#
# Environment (from VM metadata or systemd unit):
#   GCP_PROJECT_ID  — Firestore project
#   PRIME_ID        — Prime instance ID
#   CORE_DIR        — CoreKit installation directory (default: /opt/corekit)
# ============================================================
set -euo pipefail
# Per-run scratch dir. A fixed /tmp/<name>.json is owned by whoever runs the
# tool first: every later run by a different user fails `curl -o` with exit 23,
# and `set -e` kills the script before die() can say so — a silent, permanent
# break with no diagnostic. It also makes two concurrent runs read each
# other's response. The docs/ tools already did this; these were left behind.
__DT="$(mktemp -d)"; trap 'rm -rf "$__DT"' EXIT

# ---- CONFIG ----
CORE_DIR="${CORE_DIR:-/opt/corekit}"
GCP_PROJECT_ID="${GCP_PROJECT_ID:?GCP_PROJECT_ID required}"
PRIME_ID="${PRIME_ID:?PRIME_ID required}"
POLL_INTERVAL="${POLL_INTERVAL:-5}"
FLEET_BIN="${CORE_DIR}/bin"
FIRESTORE_URL="https://firestore.googleapis.com/v1/projects/${GCP_PROJECT_ID}/databases/(default)/documents"

# GH_OWNER/GH_REPO — prefer env (if the systemd unit set them), else resolve from GCE
# metadata (the same attributes the bootstrap reads), else empty. Under `set -u` a bare
# ${owner:-$GH_OWNER} in the handlers aborts the whole runner with "unbound variable"
# when the env lacks GH_OWNER AND a command omits owner/repo — resolving here (and using
# the ${GH_OWNER:-} guard below) makes the fleet_upgrade/upgrade_corekit path robust to
# commands that don't pass owner/repo (e.g. dashboard buttons that rely on VM identity).
_meta() { curl -sf --max-time 2 -H 'Metadata-Flavor: Google' "http://metadata.google.internal/computeMetadata/v1/instance/attributes/$1" 2>/dev/null || true; }
GH_OWNER="${GH_OWNER:-$(_meta gh_owner)}"
GH_REPO="${GH_REPO:-$(_meta gh_repo)}"

# ---- LOGGING ----
log()  { echo "[$(date -Iseconds)] [command-runner] $*"; }
warn() { echo "[$(date -Iseconds)] [command-runner] WARN: $*" >&2; }

# ---- AUTH ----
get_token() {
  curl -sH "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
    | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])"
}

# ---- FIRESTORE HELPERS ----

# Poll for pending commands
poll_commands() {
  local token="$1"
  local query_body
  query_body=$(cat <<'QUERY'
{
  "structuredQuery": {
    "from": [{"collectionId": "commands"}],
    "where": {
      "fieldFilter": {
        "field": {"fieldPath": "status"},
        "op": "EQUAL",
        "value": {"stringValue": "pending"}
      }
    },
    "limit": 1
  }
}
QUERY
)
  curl -s -X POST \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d "$query_body" \
    "${FIRESTORE_URL}/primes/${PRIME_ID}:runQuery" 2>/dev/null
}

# Update a command document
update_command() {
  local token="$1"
  local cmd_path="$2"       # full Firestore document path
  local status="$3"
  local result="${4:-}"
  local error="${5:-}"

  local fields
  fields="{\"status\":{\"stringValue\":\"${status}\"},\"updatedAt\":{\"stringValue\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}}"

  if [[ -n "$result" ]]; then
    # Escape for JSON
    local escaped_result
    escaped_result=$(python3 -c "import json,sys; print(json.dumps(sys.stdin.read().strip()))" <<< "$result")
    fields="{\"status\":{\"stringValue\":\"${status}\"},\"updatedAt\":{\"stringValue\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"},\"result\":{\"stringValue\":${escaped_result}}}"
  fi

  if [[ -n "$error" ]]; then
    local escaped_error
    escaped_error=$(python3 -c "import json,sys; print(json.dumps(sys.stdin.read().strip()))" <<< "$error")
    fields="{\"status\":{\"stringValue\":\"${status}\"},\"updatedAt\":{\"stringValue\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"},\"error\":{\"stringValue\":${escaped_error}}}"
  fi

  local mask="updateMask.fieldPaths=status&updateMask.fieldPaths=updatedAt"
  [[ -n "$result" ]] && mask="${mask}&updateMask.fieldPaths=result"
  [[ -n "$error" ]] && mask="${mask}&updateMask.fieldPaths=error"

  curl -s -X PATCH \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d "{\"fields\":${fields}}" \
    "https://firestore.googleapis.com/v1/${cmd_path}?${mask}" > /dev/null 2>&1
}

# ---- COMMAND HANDLERS ----

handle_fleet_deploy() {
  local args_json="$1"
  local name specialty email

  name=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('name',''))")
  specialty=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('specialty',''))")
  email=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('email',''))")

  if [[ -z "$name" || -z "$specialty" ]]; then
    echo "ERROR: name and specialty are required"
    return 1
  fi

  # Compute email if not provided
  if [[ -z "$email" ]]; then
    echo "ERROR: email is required (configure Agent Email Domain in Dashboard → Setup)"
    return 1
  fi

  log "Executing: fleet-deploy --name ${name} --specialty ${specialty} --agent-email ${email}"
  "${FLEET_BIN}/fleet-deploy" --name "$name" --specialty "$specialty" --agent-email "$email" 2>&1
}

handle_fleet_teardown() {
  local args_json="$1"
  local name

  name=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('name',''))")

  if [[ -z "$name" ]]; then
    echo "ERROR: name is required"
    return 1
  fi

  log "Executing: fleet-teardown --name ${name}"
  "${FLEET_BIN}/fleet-teardown" --name "$name" 2>&1
}

handle_fleet_upgrade() {
  local args_json="$1"
  local name ref owner repo

  name=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('name',''))")
  ref=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('ref','main'))")
  owner=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('owner',''))")
  repo=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('repo',''))")

  if [[ -z "$name" ]]; then
    echo "ERROR: name is required"
    return 1
  fi

  log "Executing: fleet-upgrade --name ${name} --ref ${ref}"
  GH_OWNER="${owner:-${GH_OWNER:-}}" GH_REPO="${repo:-${GH_REPO:-}}" "${FLEET_BIN}/fleet-upgrade" --name "$name" --ref "$ref" 2>&1
}

handle_upgrade_corekit() {
  local args_json="$1"
  local ref owner repo

  ref=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('ref','main'))")
  owner=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('owner',''))")
  repo=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('repo',''))")

  log "Executing: upgrade-corekit --apply ${ref}"
  GH_OWNER="${owner:-${GH_OWNER:-}}" GH_REPO="${repo:-${GH_REPO:-}}" CORE_DIR="$CORE_DIR" "${FLEET_BIN}/upgrade-corekit" --apply "$ref" 2>&1
  local ck_exit=$?

  if [[ $ck_exit -eq 0 ]]; then
    log "CoreKit upgraded."

    # Update coreRef in Firestore immediately (don't wait for heartbeat)
    local upd_token
    upd_token="$(get_token 2>/dev/null)" || true
    if [[ -n "$upd_token" ]]; then
      local core_ref="$ref"
      local state_file="${CORE_DIR}/corekit/STATE.json"
      if [[ -f "$state_file" ]]; then
        core_ref="$(python3 -c "import json; print(json.load(open('$state_file')).get('coreRef','$ref'))" 2>/dev/null || echo "$ref")"
      fi
      curl -s -X PATCH \
        -H "Authorization: Bearer $upd_token" \
        -H "Content-Type: application/json" \
        -d "{\"fields\":{\"coreRef\":{\"stringValue\":\"${core_ref}\"}}}" \
        "${FIRESTORE_URL}/primes/${PRIME_ID}?updateMask.fieldPaths=coreRef" > /dev/null 2>&1 || true
      log "Updated coreRef in Firestore: ${core_ref}"
    fi
  fi
  return $ck_exit
}

handle_gateway_restart() {
  log "Executing: systemctl restart agent-neural-gateway"
  systemctl restart agent-neural-gateway 2>&1
  log "Gateway restarted."
}

handle_discover_models() {
  log "Executing: discover-models --probe-only"
  local result_file="${__DT}/discover-models-result.json"
  local stderr_file="${__DT}/discover-models-stderr.log"

  # Run discovery, capture JSON to file (not bash variable — avoids corruption with large output)
  GCP_PROJECT_ID="$GCP_PROJECT_ID" CORE_DIR="$CORE_DIR" \
    "${FLEET_BIN}/discover-models" --probe-only > "$result_file" 2>"$stderr_file" || true

  if [[ ! -s "$result_file" ]]; then
    log "ERROR: discover-models produced no output. stderr: $(cat "$stderr_file" 2>/dev/null)"
    echo "ERROR: discover-models returned no output"
    return 1
  fi

  # Validate JSON
  if ! python3 -c "import json; json.load(open('$result_file'))" 2>/dev/null; then
    log "ERROR: discover-models produced invalid JSON"
    echo "ERROR: invalid JSON from discover-models"
    return 1
  fi

  # Cache full model catalog in Firestore for the dashboard
  local token
  token="$(get_token 2>/dev/null)" || true
  if [[ -n "$token" ]]; then
    local settings_path="primes/${PRIME_ID}/config/settings"
    local scanned_at
    scanned_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    # Build Firestore update from the result file
    local update_body
    update_body=$(python3 -c "
import json, sys

data = json.load(open('$result_file'))
models = data.get('models', [])
current = data.get('currentModel', '')

# Build Firestore arrayValue for modelCatalog
model_values = []
for m in models:
    fields = {}
    for k in ['id','name','tier','provider','status','brainModelId','description','cost']:
        if k in m and m[k] is not None:
            fields[k] = {'stringValue': str(m[k])}
    if 'httpCode' in m:
        fields['httpCode'] = {'integerValue': str(m['httpCode'])}
    model_values.append({'mapValue': {'fields': fields}})

status_fields = {}
for m in models:
    status_fields[m['id']] = {'stringValue': m.get('status', 'unknown')}

result = {
    'fields': {
        'modelCatalog': {'arrayValue': {'values': model_values}},
        'modelStatuses': {'mapValue': {'fields': status_fields}},
        'modelScannedAt': {'stringValue': '$scanned_at'},
        'defaultModel': {'stringValue': current},
    }
}
print(json.dumps(result))
" 2>/dev/null) || true

    if [[ -n "$update_body" ]]; then
      curl -s -X PATCH \
        -H "Authorization: Bearer $token" \
        -H "Content-Type: application/json" \
        -d "$update_body" \
        "${FIRESTORE_URL}/${settings_path}?updateMask.fieldPaths=modelCatalog&updateMask.fieldPaths=modelStatuses&updateMask.fieldPaths=modelScannedAt&updateMask.fieldPaths=defaultModel" > /dev/null 2>&1 || true
      log "Model catalog cached in Firestore ($(python3 -c "import json; print(len(json.load(open('$result_file')).get('models',[])))" 2>/dev/null || echo '?') models)"
    fi
  fi

  # Return the JSON result as the command result (clean, no log noise)
  cat "$result_file"
}

handle_set_model() {
  local args_json="$1"
  local model_id assignments

  model_id=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('modelId',''))")
  assignments=$(echo "$args_json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('assignments',''))")

  if [[ -z "$model_id" ]]; then
    echo "ERROR: modelId is required"
    return 1
  fi

  local dm_exit=0

  if [[ -n "$assignments" && "$assignments" != "" ]]; then
    # Full assignments mode — write to temp file, use --set-config
    local config_file="${__DT}/model-assignments.json"
    echo "$assignments" > "$config_file"
    log "Executing: discover-models --set-config ${config_file}"
    GCP_PROJECT_ID="$GCP_PROJECT_ID" CORE_DIR="$CORE_DIR" "${FLEET_BIN}/discover-models" --set-config "$config_file" 2>&1
    dm_exit=$?
    rm -f "$config_file"
  else
    # Simple mode — just set default model
    log "Executing: discover-models --set ${model_id} --apply"
    GCP_PROJECT_ID="$GCP_PROJECT_ID" CORE_DIR="$CORE_DIR" "${FLEET_BIN}/discover-models" --set "$model_id" --apply 2>&1
    dm_exit=$?
  fi

  if [[ $dm_exit -eq 0 ]]; then
    log "Restarting gateway..."
    systemctl restart agent-neural-gateway 2>&1
    log "Model updated. Gateway restarted."
  fi
  return $dm_exit
}

# ---- PARSE COMMAND FROM FIRESTORE RESPONSE ----

parse_command() {
  local response="$1"

  python3 -c "
import json, sys

data = json.load(sys.stdin)
if not isinstance(data, list):
    data = [data]

for item in data:
    doc = item.get('document')
    if not doc:
        continue
    fields = doc.get('fields', {})
    status = fields.get('status', {}).get('stringValue', '')
    if status != 'pending':
        continue
    cmd_type = fields.get('type', {}).get('stringValue', '')
    args_raw = fields.get('args', {})

    # Parse args — could be a mapValue or stringValue
    args = {}
    if 'mapValue' in args_raw:
        for k, v in args_raw['mapValue'].get('fields', {}).items():
            args[k] = v.get('stringValue', '')
    elif 'stringValue' in args_raw:
        try:
            args = json.loads(args_raw['stringValue'])
        except:
            pass

    doc_path = doc.get('name', '')
    print(json.dumps({'type': cmd_type, 'args': args, 'path': doc_path}))
    break  # Only process one command at a time
" <<< "$response" 2>/dev/null
}

# ---- MAIN LOOP ----

log "Starting command-runner for Prime: ${PRIME_ID}"
log "Project: ${GCP_PROJECT_ID}"
log "Fleet bin: ${FLEET_BIN}"
log "Poll interval: ${POLL_INTERVAL}s"

while true; do
  TOKEN="$(get_token 2>/dev/null)" || { warn "Failed to get token"; sleep "$POLL_INTERVAL"; continue; }

  RESPONSE="$(poll_commands "$TOKEN" 2>/dev/null)" || { sleep "$POLL_INTERVAL"; continue; }

  CMD_JSON="$(parse_command "$RESPONSE")" || true

  if [[ -z "$CMD_JSON" ]]; then
    sleep "$POLL_INTERVAL"
    continue
  fi

  CMD_TYPE=$(echo "$CMD_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin)['type'])")
  CMD_ARGS=$(echo "$CMD_JSON" | python3 -c "import json,sys; print(json.dumps(json.load(sys.stdin)['args']))")
  CMD_PATH=$(echo "$CMD_JSON" | python3 -c "import json,sys; print(json.load(sys.stdin)['path'])")

  log "Picked up command: type=${CMD_TYPE} path=${CMD_PATH}"

  # Mark as running
  update_command "$TOKEN" "$CMD_PATH" "running"

  # Execute
  RESULT=""
  CMD_EXIT=0
  case "$CMD_TYPE" in
    fleet_deploy)
      RESULT="$(handle_fleet_deploy "$CMD_ARGS" 2>&1)" || CMD_EXIT=$?
      ;;
    fleet_teardown)
      RESULT="$(handle_fleet_teardown "$CMD_ARGS" 2>&1)" || CMD_EXIT=$?
      ;;
    fleet_upgrade)
      RESULT="$(handle_fleet_upgrade "$CMD_ARGS" 2>&1)" || CMD_EXIT=$?
      ;;
    upgrade_corekit)
      RESULT="$(handle_upgrade_corekit "$CMD_ARGS" 2>&1)" || CMD_EXIT=$?
      ;;
    gateway_restart)
      RESULT="$(handle_gateway_restart 2>&1)" || CMD_EXIT=$?
      ;;
    discover_models)
      RESULT="$(handle_discover_models 2>&1)" || CMD_EXIT=$?
      ;;
    set_model)
      RESULT="$(handle_set_model "$CMD_ARGS" 2>&1)" || CMD_EXIT=$?
      ;;
    *)
      RESULT="Unknown command type: ${CMD_TYPE}"
      CMD_EXIT=1
      ;;
  esac

  # Refresh token (command may have taken a while)
  TOKEN="$(get_token 2>/dev/null)" || true

  # Mark as complete or failed
  if [[ $CMD_EXIT -eq 0 ]]; then
    log "Command completed: ${CMD_TYPE}"
    update_command "$TOKEN" "$CMD_PATH" "complete" "$RESULT"
  else
    log "Command failed: ${CMD_TYPE} (exit=${CMD_EXIT})"
    update_command "$TOKEN" "$CMD_PATH" "failed" "" "$RESULT"
  fi

  # Small delay before next poll
  sleep 2
done
