#!/bin/bash
# start-agent-ears — Wrapper to launch agent-ears.mjs inside Docker
# Reads chat-config.json for agent-specific values.
# Auto-detects CHANNEL from role config if not set via env.

OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
CONFIG="${OC_HOST_ROOT}/.openclaw/corekit/chat-config.json"

# Auto-detect CHANNEL and identity from role config if not set via env
PRIME_CFG="${OC_HOST_ROOT}/.openclaw/corekit/prime-config.json"
if [ -f "$PRIME_CFG" ]; then
  [ -z "$CHANNEL" ] && CHANNEL="dashboard"
  [ -z "$GCP_PROJECT_ID" ] && GCP_PROJECT_ID="$(python3 -c "import json; print(json.load(open('$PRIME_CFG')).get('projectId',''))" 2>/dev/null)"
  [ -z "$PRIME_ID" ] && PRIME_ID="$(python3 -c "import json; print(json.load(open('$PRIME_CFG')).get('primeId',''))" 2>/dev/null)"
  [ -z "$AGENT_ID" ] && AGENT_ID="prime"
elif [ -f "$CONFIG" ]; then
  [ -z "$CHANNEL" ] && CHANNEL="gchat"
else
  [ -z "$CHANNEL" ] && CHANNEL="dashboard"  # safe default
fi

# Read GCP_PROJECT_ID from metadata if still missing
if [ -z "$GCP_PROJECT_ID" ]; then
  GCP_PROJECT_ID="$(curl -sf -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null)" || true
fi

# Read config values
if [ -f "$CONFIG" ]; then
  AGENT_MENTION="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('agentMention',''))" 2>/dev/null)"
  [ -z "$AGENT_USER_EMAIL" ] && AGENT_USER_EMAIL="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('agentUserEmail',''))" 2>/dev/null)"
  [ -z "$DWD_SIGNER_SA" ] && DWD_SIGNER_SA="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('dwdSignerSa',''))" 2>/dev/null)"
fi

# Fallback: read PRIME_ID from Docker container env (fleet-bootstrap sets it)
if [ -z "$PRIME_ID" ]; then
  PRIME_ID="$(docker exec openclaw-gateway printenv PRIME_ID 2>/dev/null)" || true
fi

# Fallback: derive AGENT_ID from VM hostname (fleet-stan → stan)
if [ -z "$AGENT_ID" ] || [ "$AGENT_ID" = "agent" ]; then
  VM_NAME="$(hostname 2>/dev/null)"
  if [[ "$VM_NAME" == fleet-* ]]; then
    AGENT_ID="${VM_NAME#fleet-}"
  fi
fi

# Kill any orphan agent-ears processes inside the container.
# Same pattern as agent-mouth — prevent duplicate poll loops after restarts.
docker exec openclaw-gateway pkill -f 'agent-ears.mjs' 2>/dev/null || true
sleep 1

# Pre-create in-container log files so the node user can write to them.
# The daemon appends to these for structured JSON logging alongside stderr.
docker exec openclaw-gateway sh -c 'touch /var/log/agent-ears.log /var/log/agent-ears-preprocess.log && chown node:node /var/log/agent-ears.log /var/log/agent-ears-preprocess.log' 2>/dev/null || true

exec stdbuf -oL docker exec \
  -e CHANNEL="${CHANNEL:-gchat}" \
  -e GCP_PROJECT_ID="${GCP_PROJECT_ID}" \
  -e AGENT_ID="${AGENT_ID:-agent}" \
  -e AGENT_USER_EMAIL="${AGENT_USER_EMAIL}" \
  -e AGENT_MENTION="${AGENT_MENTION}" \
  -e DWD_SIGNER_SA="${DWD_SIGNER_SA}" \
  -e PRIME_ID="${PRIME_ID:-}" \
  openclaw-gateway node /home/node/.openclaw/bin/agent-ears.mjs
