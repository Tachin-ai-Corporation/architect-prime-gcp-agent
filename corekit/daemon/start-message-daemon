#!/bin/bash
# start-message-daemon — Wrapper to launch message-daemon.mjs inside Docker
# Needed because systemd Environment= can't handle spaces in AGENT_MENTION.
# Reads chat-config.json for agent-specific values.
# Auto-detects CHANNEL from role config if not set via env.

OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
CONFIG="${OC_HOST_ROOT}/.openclaw/corekit/chat-config.json"

# Auto-detect CHANNEL if not explicitly set
if [ -z "$CHANNEL" ]; then
  PRIME_CFG="${OC_HOST_ROOT}/.openclaw/corekit/prime-config.json"
  if [ -f "$PRIME_CFG" ]; then
    CHANNEL="dashboard"
  elif [ -f "$CONFIG" ]; then
    CHANNEL="gchat"
  else
    CHANNEL="dashboard"  # safe default
  fi
fi

# Read config values
if [ -f "$CONFIG" ]; then
  AGENT_MENTION="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('agentMention',''))" 2>/dev/null)"
  [ -z "$AGENT_USER_EMAIL" ] && AGENT_USER_EMAIL="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('agentUserEmail',''))" 2>/dev/null)"
  [ -z "$DWD_SIGNER_SA" ] && DWD_SIGNER_SA="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('dwdSignerSa',''))" 2>/dev/null)"
fi

exec docker exec \
  -e CHANNEL="${CHANNEL:-gchat}" \
  -e GCP_PROJECT_ID="${GCP_PROJECT_ID}" \
  -e AGENT_ID="${AGENT_ID:-agent}" \
  -e AGENT_USER_EMAIL="${AGENT_USER_EMAIL}" \
  -e AGENT_MENTION="${AGENT_MENTION}" \
  -e DWD_SIGNER_SA="${DWD_SIGNER_SA}" \
  -e PRIME_ID="${PRIME_ID:-}" \
  -e POLL_INTERVAL="${POLL_INTERVAL:-}" \
  openclaw-gateway node /home/node/.openclaw/bin/message-daemon.mjs
