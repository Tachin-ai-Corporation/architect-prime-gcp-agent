[Unit]
Description=Agent Mouth — Output Classification and Delivery
After=network-online.target agent-neural-gateway.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/corekit/bin/start-agent-mouth
Restart=always
RestartSec=3
StandardOutput=append:/var/log/agent-mouth.log
StandardError=append:/var/log/agent-mouth.log
Environment=CORE_DIR=/opt/corekit

[Install]
WantedBy=multi-user.target
