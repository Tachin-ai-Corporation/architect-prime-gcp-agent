[Unit]
Description=Agent Mouth — Output Classification and Delivery
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/openclaw/.openclaw/bin/start-agent-mouth
Restart=always
RestartSec=3
StandardOutput=append:/var/log/agent-mouth.log
StandardError=append:/var/log/agent-mouth.log
Environment=OC_HOST_ROOT=/opt/openclaw

[Install]
WantedBy=multi-user.target
