#!/bin/bash
# start-agent-mouth — Wrapper to launch agent-mouth.mjs inside Docker
# Reads chat-config.json for agent-specific values.
# Auto-detects CHANNEL from role config if not set via env.

OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
CONFIG="${OC_HOST_ROOT}/.openclaw/corekit/chat-config.json"

# Auto-detect CHANNEL and identity from role config if not set via env
PRIME_CFG="${OC_HOST_ROOT}/.openclaw/corekit/prime-config.json"
if [ -f "$PRIME_CFG" ]; then
  [ -z "$CHANNEL" ] && CHANNEL="dashboard"
  [ -z "$GCP_PROJECT_ID" ] && GCP_PROJECT_ID="$(python3 -c "import json; print(json.load(open('$PRIME_CFG')).get('projectId',''))" 2>/dev/null)"
  [ -z "$PRIME_ID" ] && PRIME_ID="$(python3 -c "import json; print(json.load(open('$PRIME_CFG')).get('primeId',''))" 2>/dev/null)"
  [ -z "$AGENT_ID" ] && AGENT_ID="prime"
elif [ -f "$CONFIG" ]; then
  [ -z "$CHANNEL" ] && CHANNEL="gchat"
else
  [ -z "$CHANNEL" ] && CHANNEL="dashboard"  # safe default
fi

# Read GCP_PROJECT_ID from metadata if still missing
if [ -z "$GCP_PROJECT_ID" ]; then
  GCP_PROJECT_ID="$(curl -sf -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null)" || true
fi

# Read PRIME_ID from metadata if still missing (fleet agents need this)
if [ -z "$PRIME_ID" ]; then
  PRIME_ID="$(curl -sf -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime_id' 2>/dev/null)" || true
fi

# Read config values
if [ -f "$CONFIG" ]; then
  [ -z "$AGENT_USER_EMAIL" ] && AGENT_USER_EMAIL="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('agentUserEmail',''))" 2>/dev/null)"
  [ -z "$DWD_SIGNER_SA" ] && DWD_SIGNER_SA="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('dwdSignerSa',''))" 2>/dev/null)"
  [ -z "$AGENT_DISPLAY_NAME" ] && AGENT_DISPLAY_NAME="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('agentDisplayName',''))" 2>/dev/null)"
  [ -z "$AGENT_FIRST_NAME" ] && AGENT_FIRST_NAME="$(python3 -c "import json; print(json.load(open('$CONFIG')).get('agentFirstName',''))" 2>/dev/null)"
fi

# Mouth needs GOOGLE_CLOUD_LOCATION for Vertex AI classify call
GOOGLE_CLOUD_LOCATION="${GOOGLE_CLOUD_LOCATION:-global}"

# Kill any orphan agent-mouth processes inside the container.
# When systemd restarts the service, the outer `docker exec` exits but
# the inner node process can survive inside the container. This causes
# two mouth instances polling the same log → double message delivery.
docker exec openclaw-gateway pkill -f 'agent-mouth.mjs' 2>/dev/null || true
sleep 1

exec stdbuf -oL docker exec \
  -e CHANNEL="${CHANNEL:-gchat}" \
  -e GCP_PROJECT_ID="${GCP_PROJECT_ID}" \
  -e AGENT_ID="${AGENT_ID:-agent}" \
  -e AGENT_USER_EMAIL="${AGENT_USER_EMAIL}" \
  -e AGENT_DISPLAY_NAME="${AGENT_DISPLAY_NAME:-}" \
  -e AGENT_FIRST_NAME="${AGENT_FIRST_NAME:-}" \
  -e DWD_SIGNER_SA="${DWD_SIGNER_SA}" \
  -e PRIME_ID="${PRIME_ID:-}" \
  -e GOOGLE_CLOUD_LOCATION="${GOOGLE_CLOUD_LOCATION}" \
  openclaw-gateway node /home/node/.openclaw/bin/agent-mouth.mjs
