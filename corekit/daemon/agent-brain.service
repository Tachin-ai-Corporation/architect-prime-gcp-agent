[Unit]
Description=Agent Brain v3 Orchestration Service
After=network-online.target agent-brain-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=CORE_DIR=/opt/corekit
ExecStart=/opt/corekit/bin/start-agent-brain
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
