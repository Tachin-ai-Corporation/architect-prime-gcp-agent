import json, sys, subprocess, os
from datetime import datetime, timezone

new_project = json.loads('''$NEW_JSON''')

# Validate required fields
required = ['id', 'name', 'description', 'context', 'goal']
missing = [f for f in required if f not in new_project]
if missing:
    print(f'ERROR: Missing required fields: {missing}', file=sys.stderr)
    sys.exit(1)

if not isinstance(new_project.get('context'), dict):
    print('ERROR: context must be a JSON object/map.', file=sys.stderr)
    sys.exit(1)

# Handle --processes
processes_set = '$PROCESSES_SET' == 'true'
processes_raw = '''$PROCESSES'''
if processes_set:
    if processes_raw:
        new_project['standardProcesses'] = [p.strip() for p in processes_raw.split(',') if p.strip()]
    else:
        new_project['standardProcesses'] = []

# Defaults for new Culture of Work fields
new_project.setdefault('owner', os.environ.get('AGENT_USER_EMAIL', ''))
new_project.setdefault('parent_id', None)
new_project.setdefault('depends_on', [])

token = subprocess.check_output(['gcloud', 'auth', 'print-access-token', '--quiet'], stderr=subprocess.DEVNULL).decode().strip()
base = '${FIRESTORE_BASE}'
path = '${COLLECTION_PATH}'

# Helper: extract Firestore value to plain Python
def extract_value(field):
    if 'stringValue' in field:
        return field['stringValue']
    if 'integerValue' in field:
        return int(field['integerValue'])
    if 'booleanValue' in field:
        return field['booleanValue']
    if 'doubleValue' in field:
        return field['doubleValue']
    if 'nullValue' in field:
        return None
    if 'mapValue' in field:
        return {k: extract_value(v) for k, v in field['mapValue'].get('fields', {}).items()}
    if 'arrayValue' in field:
        return [extract_value(v) for v in field['arrayValue'].get('values', [])]
    if 'timestampValue' in field:
        return field['timestampValue']
    return str(field)

# Validate parent_id if provided: must exist, depth <= 4
if new_project.get('parent_id'):
    parent_id = new_project['parent_id']
    depth = 1
    current_parent = parent_id
    while current_parent:
        purl = f'{base}/{path}/{current_parent}'
        pr = subprocess.run(
            ['curl', '-s', '-f', '-X', 'GET', purl, '-H', f'Authorization: Bearer {token}'],
            capture_output=True, text=True
        )
        if pr.returncode != 0:
            print(f'ERROR: parent_id \"{current_parent}\" not found.', file=sys.stderr)
            sys.exit(1)
        depth += 1
        if depth > 4:
            print(f'ERROR: Nesting depth exceeds maximum of 4 levels.', file=sys.stderr)
            sys.exit(1)
        pdata = json.loads(pr.stdout)
        pfields = pdata.get('fields', {})
        pid_field = pfields.get('parent_id')
        current_parent = extract_value(pid_field) if pid_field else None

# Enforce defaults
now = datetime.now(timezone.utc).isoformat()
new_project.setdefault('status', 'active')
prime_id = os.environ.get('PRIME_ID', '')
agent_id = os.environ.get('AGENT_ID', 'agent')
new_project.setdefault('team', [prime_id, agent_id])
new_project.setdefault('created_by', agent_id)
new_project['created_at'] = now
new_project['updated_at'] = now

# Convert plain JSON -> Firestore format
def to_firestore(value):
    if value is None:
        return {'nullValue': None}
    if isinstance(value, bool):
        return {'booleanValue': value}
    if isinstance(value, int):
        return {'integerValue': str(value)}
    if isinstance(value, float):
        return {'doubleValue': value}
    if isinstance(value, str):
        return {'stringValue': value}
    if isinstance(value, list):
        return {'arrayValue': {'values': [to_firestore(v) for v in value]}}
    if isinstance(value, dict):
        return {'mapValue': {'fields': {k: to_firestore(v) for k, v in value.items()}}}
    return {'stringValue': str(value)}

firestore_doc = {'fields': {k: to_firestore(v) for k, v in new_project.items()}}

project_id = new_project['id']
