#!/usr/bin/env bash
# project-manage — CRUD for projects stored in Firestore
# Motor tool: reads/writes primes/{PRIME_ID}/projects/{projectId}
#
# Usage:
#   project-manage list                    # List all projects (id, name, status, description)
#   project-manage get <id>                # Get full project details as JSON
#   project-manage create '<json>'         # Create new project
#   project-manage update '<id>' '<json>'  # Update project (deep merge on context)
#   project-manage archive '<id>'          # Set status to 'archived'
#
# The JSON for create must include: id, name, description, context
# The JSON for update does a deep merge on the context field and shallow merge on others
# Automatically sets created_at and updated_at timestamps; defaults status to 'active'

set -euo pipefail

PRIME_ID="${PRIME_ID:?'PRIME_ID env var is required'}"
GCP_PROJECT_ID="${GCP_PROJECT_ID:?'GCP_PROJECT_ID env var is required'}"

FIRESTORE_BASE="https://firestore.googleapis.com/v1/projects/${GCP_PROJECT_ID}/databases/(default)/documents"
COLLECTION_PATH="primes/${PRIME_ID}/projects"

get_token() {
  gcloud auth print-access-token --quiet 2>/dev/null
}

CMD="${1:-help}"
shift || true

case "$CMD" in
  list)
    python3 -c "
import json, sys, subprocess

token = subprocess.check_output(['gcloud', 'auth', 'print-access-token', '--quiet'], stderr=subprocess.DEVNULL).decode().strip()
base = '${FIRESTORE_BASE}'
path = '${COLLECTION_PATH}'
url = f'{base}/{path}'

result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'GET', url, '-H', f'Authorization: Bearer {token}'],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Failed to list projects: {result.stderr}', file=sys.stderr)
    sys.exit(1)

data = json.loads(result.stdout)
docs = data.get('documents', [])

if not docs:
    print('No projects found.')
    sys.exit(0)

def extract_value(field):
    if 'stringValue' in field:
        return field['stringValue']
    if 'integerValue' in field:
        return int(field['integerValue'])
    if 'booleanValue' in field:
        return field['booleanValue']
    if 'doubleValue' in field:
        return field['doubleValue']
    if 'nullValue' in field:
        return None
    if 'mapValue' in field:
        return {k: extract_value(v) for k, v in field['mapValue'].get('fields', {}).items()}
    if 'arrayValue' in field:
        return [extract_value(v) for v in field['arrayValue'].get('values', [])]
    if 'timestampValue' in field:
        return field['timestampValue']
    return str(field)

for doc in docs:
    fields = doc.get('fields', {})
    pid = extract_value(fields.get('id', {'stringValue': '—'}))
    name = extract_value(fields.get('name', {'stringValue': '—'}))
    status = extract_value(fields.get('status', {'stringValue': '—'}))
    desc = extract_value(fields.get('description', {'stringValue': ''}))
    print(f'  {pid}')
    print(f'    Name:        {name}')
    print(f'    Status:      {status}')
    print(f'    Description: {(desc or \"\")[:120]}')
    print()

print(f'Total: {len(docs)} projects')
"
    ;;

  get)
    TARGET_ID="${1:?'get requires a project id'}"
    python3 -c "
