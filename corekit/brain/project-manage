#!/usr/bin/env bash
# project-manage — CRUD for projects stored in Firestore
# Motor tool: reads/writes projects/{projectId}
#
# Usage:
#   project-manage list                    # List all projects (id, name, status, goal, owner, etc.)
#   project-manage get <id>                # Get full project details as JSON
#   project-manage create '<json>' [--processes <comma-separated-ids>]   # Create new project
#   project-manage update '<id>' '<json>' [--processes <comma-separated-ids>]  # Update project
#   project-manage archive '<id>'          # Set status to 'archived'
#   project-manage pause '<id>'            # Set status to 'paused'
#   project-manage team-add <id> <email> <role> [name] [type]  # Add/update team member (simple)
#   project-manage team-add <id> '<json>'                      # Add/update team member (JSON)
#   project-manage team-remove <id> <email># Remove team member by email
#   project-manage team-list <id>          # List team members in table format
#
# The JSON for create must include: id, name, description, context, goal
# Optional fields: owner (defaults to AGENT_USER_EMAIL), parent_id, depends_on
# The JSON for update does a deep merge on the context field and shallow merge on others
# Supports updating: goal, owner, parent_id, depends_on, status (active|complete|paused|archived)
# Context entries follow the Context Packet schema:
#   { "key": { "kind": "sheet|drive_folder|doc|dataset|url|template|people|convention",
#              "ref": "resource-id", "url": "https://...", "name": "Display Name",
#              "summary": "Description of this resource", "updatedAt": "ISO", "updatedBy": "agent" } }
# Automatically sets created_at and updated_at timestamps; defaults status to 'active'
# Optional: --processes provides comma-separated process IDs stored as standardProcesses array

set -euo pipefail

# Auto-detect PRIME_ID and GCP_PROJECT_ID from config files / metadata if not set
CORE_DIR="${CORE_DIR:-/opt/corekit}"
if [ -z "${GCP_PROJECT_ID:-}" ]; then
  GCP_PROJECT_ID="${GOOGLE_CLOUD_PROJECT:-}"
  [ -z "$GCP_PROJECT_ID" ] && GCP_PROJECT_ID="$(python3 -c "import json; print(json.load(open('${CORE_DIR}/corekit/prime-config.json')).get('projectId',''))" 2>/dev/null)" || true
  [ -z "$GCP_PROJECT_ID" ] && GCP_PROJECT_ID="$(python3 -c "import json; print(json.load(open('${CORE_DIR}/corekit/chat-config.json')).get('projectId',''))" 2>/dev/null)" || true
  [ -z "$GCP_PROJECT_ID" ] && GCP_PROJECT_ID="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null)" || true
fi
if [ -z "${PRIME_ID:-}" ]; then
  PRIME_ID="$(python3 -c "import json; print(json.load(open('${CORE_DIR}/corekit/prime-config.json')).get('primeId',''))" 2>/dev/null)" || true
  [ -z "$PRIME_ID" ] && PRIME_ID="$(python3 -c "import json; print(json.load(open('${CORE_DIR}/corekit/chat-config.json')).get('primeId',''))" 2>/dev/null)" || true
  [ -z "$PRIME_ID" ] && PRIME_ID="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime_id' 2>/dev/null)" || true
fi
[ -z "${PRIME_ID:-}" ] && { echo "ERROR: Cannot determine PRIME_ID from env, config files, or metadata" >&2; exit 1; }
[ -z "${GCP_PROJECT_ID:-}" ] && { echo "ERROR: Cannot determine GCP_PROJECT_ID from env, config files, or metadata" >&2; exit 1; }

FIRESTORE_BASE="https://firestore.googleapis.com/v1/projects/${GCP_PROJECT_ID}/databases/(default)/documents"
COLLECTION_PATH="projects"

get_token() {
  gcloud auth print-access-token --quiet 2>/dev/null
}

CMD="${1:-help}"
shift || true

case "$CMD" in
  list)
    python3 -c "
import json, sys, subprocess

token = subprocess.check_output(['gcloud', 'auth', 'print-access-token', '--quiet'], stderr=subprocess.DEVNULL).decode().strip()
base = '${FIRESTORE_BASE}'
path = '${COLLECTION_PATH}'
url = f'{base}/{path}'

result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'GET', url, '-H', f'Authorization: Bearer {token}'],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Failed to list projects: {result.stderr}', file=sys.stderr)
    sys.exit(1)

data = json.loads(result.stdout)
docs = data.get('documents', [])

if not docs:
    print('No projects found.')
    sys.exit(0)

def extract_value(field):
    if 'stringValue' in field:
        return field['stringValue']
    if 'integerValue' in field:
        return int(field['integerValue'])
    if 'booleanValue' in field:
        return field['booleanValue']
    if 'doubleValue' in field:
        return field['doubleValue']
    if 'nullValue' in field:
        return None
    if 'mapValue' in field:
        return {k: extract_value(v) for k, v in field['mapValue'].get('fields', {}).items()}
    if 'arrayValue' in field:
        return [extract_value(v) for v in field['arrayValue'].get('values', [])]
    if 'timestampValue' in field:
        return field['timestampValue']
    return str(field)

for doc in docs:
    fields = doc.get('fields', {})
    pid = extract_value(fields.get('id', {'stringValue': '—'}))
    name = extract_value(fields.get('name', {'stringValue': '—'}))
    status = extract_value(fields.get('status', {'stringValue': '—'}))
    desc = extract_value(fields.get('description', {'stringValue': ''}))
    goal = extract_value(fields.get('goal', {'stringValue': ''}))
    owner = extract_value(fields.get('owner', {'stringValue': ''}))
    parent_id = extract_value(fields.get('parent_id', {'nullValue': None}))
    depends_on = extract_value(fields.get('depends_on', {'arrayValue': {'values': []}}))
    print(f'  {pid}')
    print(f'    Name:        {name}')
    print(f'    Status:      {status}')
    print(f'    Description: {(desc or chr(32))[:120]}')
    if goal:
        print(f'    Goal:        {str(goal)[:120]}')
    if owner:
        print(f'    Owner:       {owner}')
    if parent_id:
        print(f'    Parent:      {parent_id}')
    if depends_on and isinstance(depends_on, list) and len(depends_on) > 0:
        print(f'    Depends on:  {len(depends_on)} project(s)')
    if 'standardProcesses' in fields:
        procs = extract_value(fields['standardProcesses'])
        if procs:
            print('    Processes:   ' + ', '.join(procs))
    print()

print(f'Total: {len(docs)} projects')
"
    ;;

  get)
    TARGET_ID="${1:?'get requires a project id'}"
    python3 -c "
