result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'PATCH', url,
     '-H', f'Authorization: Bearer {token}',
     '-H', 'Content-Type: application/json',
     '-d', json.dumps(firestore_doc)],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Failed to create project: {result.stderr}', file=sys.stderr)
    sys.exit(1)

nm = new_project.get('name', '')
st = new_project.get('status', '')
ds = new_project.get('description', '')[:120]
gl = new_project.get('goal', '')[:120]
