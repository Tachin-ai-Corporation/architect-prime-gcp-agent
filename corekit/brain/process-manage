#!/usr/bin/env bash
# process-manage — CRUD for processes stored in Firestore
# Motor tool: reads/writes primes/{PRIME_ID}/processes/{processId}
#
# Usage:
#   process-manage list                    # List all processes (id, name, status, version, created_by)
#   process-manage get <id>                # Get full process details as JSON
#   process-manage create '<json>'         # Create new process
#   process-manage update '<id>' '<json>'  # Update process (deep merge on steps, parameters, contextTemplate)
#   process-manage deprecate '<id>'        # Set status to 'deprecated'
#
# The JSON for create must include: id, name, description, steps
# Steps are an array of objects:
#   { "title": "...", "description": "...", "agent": "motor",
#     "type": "standard|delegation|spawn_responsibility|approval_gate",
#     "optional": false, "checkpointBoundary": false, "contextTemplate": {} }
#
# Defaults on create: status='active', version=1, created_at=now, updated_at=now,
#   created_by='system', execution_count=0, visibility='team',
#   parameters={}, contextTemplate={}, changelog=[]
#
# The update command deep merges steps, parameters, and contextTemplate.
# Auto-increments version and appends to changelog.

set -euo pipefail

PRIME_ID="${PRIME_ID:?'PRIME_ID env var is required'}"
GCP_PROJECT_ID="${GCP_PROJECT_ID:?'GCP_PROJECT_ID env var is required'}"

FIRESTORE_BASE="https://firestore.googleapis.com/v1/projects/${GCP_PROJECT_ID}/databases/(default)/documents"
COLLECTION_PATH="primes/${PRIME_ID}/processes"

get_token() {
  gcloud auth print-access-token --quiet 2>/dev/null
}

CMD="${1:-help}"
shift || true

case "$CMD" in
  list)
    python3 -c "
import json, sys, subprocess

token = subprocess.check_output(['gcloud', 'auth', 'print-access-token', '--quiet'], stderr=subprocess.DEVNULL).decode().strip()
base = '${FIRESTORE_BASE}'
path = '${COLLECTION_PATH}'
url = f'{base}/{path}'

result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'GET', url, '-H', f'Authorization: Bearer {token}'],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Failed to list processes: {result.stderr}', file=sys.stderr)
    sys.exit(1)

data = json.loads(result.stdout)
docs = data.get('documents', [])

if not docs:
    print('No processes found.')
    sys.exit(0)

def extract_value(field):
    if 'stringValue' in field:
        return field['stringValue']
    if 'integerValue' in field:
        return int(field['integerValue'])
    if 'booleanValue' in field:
        return field['booleanValue']
    if 'doubleValue' in field:
        return field['doubleValue']
    if 'nullValue' in field:
        return None
    if 'mapValue' in field:
        return {k: extract_value(v) for k, v in field['mapValue'].get('fields', {}).items()}
    if 'arrayValue' in field:
        return [extract_value(v) for v in field['arrayValue'].get('values', [])]
    if 'timestampValue' in field:
        return field['timestampValue']
    return str(field)

for doc in docs:
    fields = doc.get('fields', {})
    pid = extract_value(fields.get('id', {'stringValue': '—'}))
    name = extract_value(fields.get('name', {'stringValue': '—'}))
    status = extract_value(fields.get('status', {'stringValue': '—'}))
    version = extract_value(fields.get('version', {'integerValue': '0'}))
    created_by = extract_value(fields.get('created_by', {'stringValue': '—'}))
    print(f'  {pid}')
    print(f'    Name:       {name}')
    print(f'    Status:     {status}')
    print(f'    Version:    {version}')
    print(f'    Created by: {created_by}')
    print()

print(f'Total: {len(docs)} processes')
"
    ;;

  get)
    TARGET_ID="${1:?'get requires a process id'}"
    python3 -c "
import json, sys, subprocess

token = subprocess.check_output(['gcloud', 'auth', 'print-access-token', '--quiet'], stderr=subprocess.DEVNULL).decode().strip()
base = '${FIRESTORE_BASE}'
path = '${COLLECTION_PATH}'
target_id = '$TARGET_ID'
url = f'{base}/{path}/{target_id}'

result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'GET', url, '-H', f'Authorization: Bearer {token}'],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Process \"{target_id}\" not found or request failed: {result.stderr}', file=sys.stderr)
    sys.exit(1)

data = json.loads(result.stdout)
fields = data.get('fields', {})

def extract_value(field):
    if 'stringValue' in field:
        return field['stringValue']
    if 'integerValue' in field:
        return int(field['integerValue'])
    if 'booleanValue' in field:
        return field['booleanValue']
    if 'doubleValue' in field:
        return field['doubleValue']
    if 'nullValue' in field:
        return None
    if 'mapValue' in field:
        return {k: extract_value(v) for k, v in field['mapValue'].get('fields', {}).items()}
    if 'arrayValue' in field:
        return [extract_value(v) for v in field['arrayValue'].get('values', [])]
    if 'timestampValue' in field:
        return field['timestampValue']
    return str(field)

plain = {k: extract_value(v) for k, v in fields.items()}
print(json.dumps(plain, indent=2))
"
    ;;

  create)
    NEW_JSON_INPUT="${1:?'create requires a JSON string or file path'}"
    if [ -f "$NEW_JSON_INPUT" ]; then
      NEW_JSON_INPUT=$(cat "$NEW_JSON_INPUT")
    fi
    export NEW_JSON_INPUT
    python3 -c "
import json, sys, subprocess, os
from datetime import datetime, timezone

new_process = json.loads(os.environ['NEW_JSON_INPUT'])

# Validate required fields
required = ['id', 'name', 'description', 'steps']
missing = [f for f in required if f not in new_process]
if missing:
    print(f'ERROR: Missing required fields: {missing}', file=sys.stderr)
    sys.exit(1)

if not isinstance(new_process.get('steps'), list):
    print('ERROR: steps must be a JSON array.', file=sys.stderr)
    sys.exit(1)

if len(new_process['steps']) == 0:
    print('ERROR: steps array must contain at least one step.', file=sys.stderr)
    sys.exit(1)

# Validate each step has required fields
for i, step in enumerate(new_process['steps']):
    step_required = ['title', 'description']
    step_missing = [f for f in step_required if f not in step]
    if step_missing:
        print(f'ERROR: Step {i} missing required fields: {step_missing}', file=sys.stderr)
        sys.exit(1)
    # Enforce step defaults
    step.setdefault('agent', 'motor')
    step.setdefault('type', 'standard')
    step.setdefault('optional', False)
    step.setdefault('checkpointBoundary', False)
    step.setdefault('contextTemplate', {})

# Enforce defaults
now = datetime.now(timezone.utc).isoformat()
new_process.setdefault('status', 'active')
new_process.setdefault('version', 1)
new_process['created_at'] = now
new_process['updated_at'] = now
new_process.setdefault('created_by', 'system')
new_process.setdefault('execution_count', 0)
new_process.setdefault('visibility', 'team')
new_process.setdefault('parameters', {})
new_process.setdefault('contextTemplate', {})
new_process.setdefault('changelog', [])

# Convert plain JSON → Firestore format
def to_firestore(value):
    if value is None:
        return {'nullValue': None}
    if isinstance(value, bool):
        return {'booleanValue': value}
    if isinstance(value, int):
        return {'integerValue': str(value)}
    if isinstance(value, float):
        return {'doubleValue': value}
    if isinstance(value, str):
        return {'stringValue': value}
    if isinstance(value, list):
        return {'arrayValue': {'values': [to_firestore(v) for v in value]}}
    if isinstance(value, dict):
        return {'mapValue': {'fields': {k: to_firestore(v) for k, v in value.items()}}}
    return {'stringValue': str(value)}

firestore_doc = {'fields': {k: to_firestore(v) for k, v in new_process.items()}}

token = subprocess.check_output(['gcloud', 'auth', 'print-access-token', '--quiet'], stderr=subprocess.DEVNULL).decode().strip()
base = '${FIRESTORE_BASE}'
path = '${COLLECTION_PATH}'
process_id = new_process['id']
url = f'{base}/{path}/{process_id}'

result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'PATCH', url,
     '-H', f'Authorization: Bearer {token}',
     '-H', 'Content-Type: application/json',
     '-d', json.dumps(firestore_doc)],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Failed to create process: {result.stderr}', file=sys.stderr)
    sys.exit(1)

print(f\"Created process '{process_id}'.\")
print(f'  Name:        {new_process[\"name\"]}')
print(f'  Status:      {new_process[\"status\"]}')
print(f'  Version:     {new_process[\"version\"]}')
print(f'  Steps:       {len(new_process[\"steps\"])}')
print(f'  Description: {new_process[\"description\"][:120]}')
"
    ;;

  update)
    TARGET_ID="${1:?'update requires a process id'}"
    UPDATE_JSON_INPUT="${2:?'update requires a JSON string of partial updates or file path'}"
    if [ -f "$UPDATE_JSON_INPUT" ]; then
      UPDATE_JSON_INPUT=$(cat "$UPDATE_JSON_INPUT")
    fi
    export TARGET_ID UPDATE_JSON_INPUT
    python3 -c "
import json, sys, subprocess, os
from datetime import datetime, timezone

target_id = os.environ['TARGET_ID']
updates = json.loads(os.environ['UPDATE_JSON_INPUT'])

token = subprocess.check_output(['gcloud', 'auth', 'print-access-token', '--quiet'], stderr=subprocess.DEVNULL).decode().strip()
base = '${FIRESTORE_BASE}'
path = '${COLLECTION_PATH}'
url = f'{base}/{path}/{target_id}'

# Fetch existing document
result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'GET', url, '-H', f'Authorization: Bearer {token}'],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Process \"{target_id}\" not found or request failed: {result.stderr}', file=sys.stderr)
    sys.exit(1)

data = json.loads(result.stdout)
fields = data.get('fields', {})

# Extract existing document to plain JSON
def extract_value(field):
    if 'stringValue' in field:
        return field['stringValue']
    if 'integerValue' in field:
        return int(field['integerValue'])
    if 'booleanValue' in field:
        return field['booleanValue']
    if 'doubleValue' in field:
        return field['doubleValue']
    if 'nullValue' in field:
        return None
    if 'mapValue' in field:
        return {k: extract_value(v) for k, v in field['mapValue'].get('fields', {}).items()}
    if 'arrayValue' in field:
        return [extract_value(v) for v in field['arrayValue'].get('values', [])]
    if 'timestampValue' in field:
        return field['timestampValue']
    return str(field)

existing = {k: extract_value(v) for k, v in fields.items()}

# Deep merge steps (replace by index if provided)
if 'steps' in updates:
    existing['steps'] = updates['steps']
    del updates['steps']

# Deep merge parameters
if 'parameters' in updates:
    existing_params = existing.get('parameters', {})
    if not isinstance(existing_params, dict):
        existing_params = {}
    for k, v in updates['parameters'].items():
        existing_params[k] = v
    existing['parameters'] = existing_params
    del updates['parameters']

# Deep merge contextTemplate
if 'contextTemplate' in updates:
    existing_ctx = existing.get('contextTemplate', {})
    if not isinstance(existing_ctx, dict):
        existing_ctx = {}
    for k, v in updates['contextTemplate'].items():
        existing_ctx[k] = v
    existing['contextTemplate'] = existing_ctx
    del updates['contextTemplate']

# Shallow merge rest
for k, v in updates.items():
    if k in ('version', 'changelog', 'updated_at'):
        continue  # managed fields
    existing[k] = v

# Auto-increment version
old_version = existing.get('version', 1)
if isinstance(old_version, str):
    old_version = int(old_version)
new_version = old_version + 1
existing['version'] = new_version

# Update timestamp
now = datetime.now(timezone.utc).isoformat()
existing['updated_at'] = now

# Append changelog entry
changelog = existing.get('changelog', [])
if not isinstance(changelog, list):
    changelog = []
changelog.append({
    'version': new_version,
    'updated_at': now,
    'changes': updates.get('_changelog_message', f'Updated to version {new_version}')
})
existing['changelog'] = changelog

# Remove internal-only key if present
existing.pop('_changelog_message', None)

# Convert back to Firestore format
def to_firestore(value):
    if value is None:
        return {'nullValue': None}
    if isinstance(value, bool):
        return {'booleanValue': value}
    if isinstance(value, int):
        return {'integerValue': str(value)}
    if isinstance(value, float):
        return {'doubleValue': value}
    if isinstance(value, str):
        return {'stringValue': value}
    if isinstance(value, list):
        return {'arrayValue': {'values': [to_firestore(v) for v in value]}}
    if isinstance(value, dict):
        return {'mapValue': {'fields': {k: to_firestore(v) for k, v in value.items()}}}
    return {'stringValue': str(value)}

firestore_doc = {'fields': {k: to_firestore(v) for k, v in existing.items()}}

result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'PATCH', url,
     '-H', f'Authorization: Bearer {token}',
     '-H', 'Content-Type: application/json',
     '-d', json.dumps(firestore_doc)],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Failed to update process: {result.stderr}', file=sys.stderr)
    sys.exit(1)

print(f\"Updated process '{target_id}' to version {new_version}.\")
"
    ;;

  deprecate)
    TARGET_ID="${1:?'deprecate requires a process id'}"
    python3 -c "
import json, sys, subprocess
from datetime import datetime, timezone

target_id = '$TARGET_ID'

token = subprocess.check_output(['gcloud', 'auth', 'print-access-token', '--quiet'], stderr=subprocess.DEVNULL).decode().strip()
base = '${FIRESTORE_BASE}'
path = '${COLLECTION_PATH}'
url = f'{base}/{path}/{target_id}'

# Fetch existing document
result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'GET', url, '-H', f'Authorization: Bearer {token}'],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Process \"{target_id}\" not found or request failed: {result.stderr}', file=sys.stderr)
    sys.exit(1)

data = json.loads(result.stdout)
fields = data.get('fields', {})

# Extract existing document to plain JSON
def extract_value(field):
    if 'stringValue' in field:
        return field['stringValue']
    if 'integerValue' in field:
        return int(field['integerValue'])
    if 'booleanValue' in field:
        return field['booleanValue']
    if 'doubleValue' in field:
        return field['doubleValue']
    if 'nullValue' in field:
        return None
    if 'mapValue' in field:
        return {k: extract_value(v) for k, v in field['mapValue'].get('fields', {}).items()}
    if 'arrayValue' in field:
        return [extract_value(v) for v in field['arrayValue'].get('values', [])]
    if 'timestampValue' in field:
        return field['timestampValue']
    return str(field)

existing = {k: extract_value(v) for k, v in fields.items()}

# Set deprecated
now = datetime.now(timezone.utc).isoformat()
existing['status'] = 'deprecated'
existing['deprecated_at'] = now
existing['updated_at'] = now

# Convert back to Firestore format
def to_firestore(value):
    if value is None:
        return {'nullValue': None}
    if isinstance(value, bool):
        return {'booleanValue': value}
    if isinstance(value, int):
        return {'integerValue': str(value)}
    if isinstance(value, float):
        return {'doubleValue': value}
    if isinstance(value, str):
        return {'stringValue': value}
    if isinstance(value, list):
        return {'arrayValue': {'values': [to_firestore(v) for v in value]}}
    if isinstance(value, dict):
        return {'mapValue': {'fields': {k: to_firestore(v) for k, v in value.items()}}}
    return {'stringValue': str(value)}

firestore_doc = {'fields': {k: to_firestore(v) for k, v in existing.items()}}

result = subprocess.run(
    ['curl', '-s', '-f', '-X', 'PATCH', url,
     '-H', f'Authorization: Bearer {token}',
     '-H', 'Content-Type: application/json',
     '-d', json.dumps(firestore_doc)],
    capture_output=True, text=True
)
if result.returncode != 0:
    print(f'ERROR: Failed to deprecate process: {result.stderr}', file=sys.stderr)
    sys.exit(1)

print(f\"Deprecated process '{target_id}'.\")
"
    ;;

  help|*)
    echo "Usage: process-manage <list|get|create|update|deprecate> [args]"
    echo ""
    echo "Commands:"
    echo "  list                        List all processes (id, name, status, version, created_by)"
    echo "  get '<id>'                  Get full process details as JSON"
    echo "  create '<json>'             Create a new process (full JSON)"
    echo "  update '<id>' '<json>'      Update a process (deep merge on steps, parameters, contextTemplate)"
    echo "  deprecate '<id>'            Set process status to 'deprecated' with timestamp"
    echo ""
    echo "The create JSON MUST include:"
    echo "  id, name, description, steps"
    echo ""
    echo "Defaults on create:"
    echo "  status='active', version=1, created_at=now, updated_at=now,"
    echo "  created_by='system', execution_count=0, visibility='team',"
    echo "  parameters={}, contextTemplate={}, changelog=[]"
    echo ""
    echo "Step schema (each element in steps array):"
    echo '  { "title": "Step title",'
    echo '    "description": "What to do",'
    echo '    "agent": "motor",'
    echo '    "type": "standard|delegation|spawn_responsibility|approval_gate",'
    echo '    "optional": false,'
    echo '    "checkpointBoundary": false,'
    echo '    "contextTemplate": {} }'
    echo ""
    echo "Update behavior:"
    echo "  - Deep merges: steps (replace), parameters, contextTemplate"
    echo "  - Auto-increments version"
    echo "  - Appends to changelog: {version, updated_at, changes}"
    echo "  - Sets updated_at timestamp"
    echo "  - Pass _changelog_message in update JSON to set custom changelog description"
    echo ""
    echo "Process statuses: active, deprecated"
    echo "Step types: standard, delegation, spawn_responsibility, approval_gate"
    ;;
esac
