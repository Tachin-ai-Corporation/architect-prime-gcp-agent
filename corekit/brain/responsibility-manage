#!/usr/bin/env bash
# responsibility-manage — the PATH entry point for authoring an agent's own responsibilities.
# Motor tool: writes the agent's responsibility store (Firestore), never an installed file.
#
# The CLI is an ES module (corekit/brain/responsibility-manage.mjs) whose relative
# imports resolve from corekit/brain/ — the same split as fleet-config: the module
# installs where its imports work, and this launcher is what goes on PATH.
#
# Usage: responsibility-manage [--agent <id>] [--note "<why>"] [--json] <verb> ...
#   list | show <id> | create <json> | update <id> <json> | toggle <id> [on|off]
#   remove <id> | reset <id> | adopt <id> [<json>] | history <id> | revert <id> --to <rev>
# Run with --help for details; the procedure is skills/work-management/SKILL.md.
set -euo pipefail

CORE_ROOT="${CORE_ROOT:-${CORE_DIR:-/opt/corekit}}"
CLI="${CORE_ROOT}/corekit/brain/responsibility-manage.mjs"

if [[ ! -f "$CLI" ]]; then
  echo "[responsibility-manage] ERROR: CLI not installed at ${CLI}" >&2
  exit 1
fi

exec node "$CLI" "$@"
