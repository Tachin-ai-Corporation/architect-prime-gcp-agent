#!/usr/bin/env bash
# assemble-persona — render each organ's soul from its base firmware
#
# A specialty shapes HOW each brain organ thinks within its domain — expertise,
# safety boundaries, dispatch patterns. Those layers live in
# `specialties/<type>/brain/<organ>/SOUL_APPEND.md` and are composed onto the
# organ's base firmware here.
#
# RENDER, never append-in-place. This script used to open the live SOUL.md and
# append to it, which is correct exactly once: a second run appends a second
# copy. That it survived at all was an accident of ordering — an upgrade
# reinstalled SOUL.md from the repo first, so the append always landed on a
# fresh base. Anything that ran it twice between installs (or any other writer
# of SOUL.md) accumulated duplicates silently.
#
# So the inputs and the output are now separate files:
#
#   SOUL.base.md   Foundation's firmware, manifest-installed, never written here
#   SOUL_APPEND.md the specialty layer
#   SOUL.md        the rendered result — truncated and rewritten every run
#
# Running this ten times leaves the same bytes as running it once.
#
# Usage: assemble-persona [agent-type]
set -euo pipefail

AGENT_TYPE="${1:-prime}"
CORE_DIR="${CORE_DIR:-/opt/corekit}"
SPECIALTIES_DIR="${CORE_DIR}/corekit/specialties"

declare -A AGENT_WORKSPACES=(
  [cortex]="${CORE_DIR}/workspace"
  [motor]="${CORE_DIR}/workspace-motor"
  [cerebellum]="${CORE_DIR}/workspace-cerebellum"
  [temporal-research]="${CORE_DIR}/workspace-temporal-research"
  [temporal-memory]="${CORE_DIR}/workspace-temporal-memory"
  [prefrontal]="${CORE_DIR}/workspace-prefrontal"
)

SPEC_BRAIN_DIR="${SPECIALTIES_DIR}/${AGENT_TYPE}/brain"
RENDER_COUNT=0
APPEND_COUNT=0

for sub in cortex motor prefrontal cerebellum temporal-memory temporal-research; do
  WS="${AGENT_WORKSPACES[$sub]:-${CORE_DIR}/workspace-${sub}}"
  BASE="${WS}/SOUL.base.md"
  SOUL="${WS}/SOUL.md"
  APPEND_FILE="${SPEC_BRAIN_DIR}/${sub}/SOUL_APPEND.md"

  # No base means this organ is not installed on this VM (roles differ in which
  # organs they carry). Refusing here is what keeps the render total: we never
  # fall back to composing onto SOUL.md, because that is the bug.
  [[ -f "$BASE" ]] || continue

  TMP="$(mktemp "${SOUL}.XXXXXX")"
  cat "$BASE" > "$TMP"
  if [[ -f "$APPEND_FILE" ]]; then
    printf '\n---\n\n' >> "$TMP"
    cat "$APPEND_FILE" >> "$TMP"
    APPEND_COUNT=$((APPEND_COUNT + 1))
  fi

  # Same directory, so the move is atomic: a reader sees the old soul or the new
  # one, never a half-written file.
  chmod 644 "$TMP"
  mv -f "$TMP" "$SOUL"
  RENDER_COUNT=$((RENDER_COUNT + 1))
done

echo "Organ souls rendered: ${RENDER_COUNT} (${APPEND_COUNT} with a ${AGENT_TYPE} specialty layer)"
echo "Persona assembly complete for: ${AGENT_TYPE}"
