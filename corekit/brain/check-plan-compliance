#!/usr/bin/env bash
# ============================================================
# check-plan-compliance — PostTurn hook for dispatch compliance
#
# HARD GATE: Enforces the prefrontal-first planning requirement.
#
# If cortex dispatched motor/cerebellum/temporal-research this
# turn, PLAN.md MUST exist with:
#   1. PLAN_VALID marker
#   2. PLAN_STATUS: APPROVED marker
#   3. Modified within the last 60 seconds
#
# On violation: writes a structured PLAN_VIOLATION message to
# STDOUT, which OpenClaw injects back into cortex's session
# as feedback for the next turn.
#
# Always exits 0 — feedback is via stdout injection, not exit codes.
# ============================================================

WORKSPACE="${HOME}/.openclaw/workspace"
PLAN_FILE="${WORKSPACE}/PLAN.md"
LOG_TAG="[plan-compliance]"

# ── Check if PLAN.md exists and has required markers ──
PLAN_VALID=false
PLAN_APPROVED=false
PLAN_AGE=999999
if [[ -f "$PLAN_FILE" ]]; then
  PLAN_AGE=$(( $(date +%s) - $(stat -c %Y "$PLAN_FILE" 2>/dev/null || echo 0) ))
  if [[ "$PLAN_AGE" -lt 60 ]] && grep -q '^PLAN_VALID' "$PLAN_FILE" 2>/dev/null; then
    PLAN_VALID=true
  fi
  if grep -q '^PLAN_STATUS: APPROVED' "$PLAN_FILE" 2>/dev/null; then
    PLAN_APPROVED=true
  fi
fi

# ── Check PLAN.md structure ──
STEP_COUNT=0
COMPLETED_STEPS=0
VALIDATION_COUNT=0
if [[ "$PLAN_VALID" == "true" ]]; then
  COMPLETED_STEPS=$(grep -cE '^\s*[0-9]+\.\s+\[x\]' "$PLAN_FILE" 2>/dev/null || echo 0)
  PENDING_STEPS=$(grep -cE '^\s*[0-9]+\.\s+\[ \]' "$PLAN_FILE" 2>/dev/null || echo 0)
  IN_PROGRESS=$(grep -cE '^\s*[0-9]+\.\s+\[/\]' "$PLAN_FILE" 2>/dev/null || echo 0)
  STEP_COUNT=$((COMPLETED_STEPS + PENDING_STEPS + IN_PROGRESS))
  VALIDATION_COUNT=$(grep -cE '→ VALIDATION:' "$PLAN_FILE" 2>/dev/null || echo 0)
fi

# ── Detect if dispatches occurred this turn ──
# Check gateway log for recent sessions_spawn activity (last 3 minutes)
DISPATCHES=0
LOG_FILE="$(ls -t /tmp/openclaw/openclaw-*.log 2>/dev/null | head -1)"
if [[ -f "$LOG_FILE" ]]; then
  RECENT_LINES=$(tail -200 "$LOG_FILE" 2>/dev/null)
  DISPATCHES=$(echo "$RECENT_LINES" | grep -cE 'sessions_spawn|sessions_yield|brain-exec' 2>/dev/null || echo 0)
fi

# ── Determine compliance ──
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "$DISPATCHES" -gt 0 && "$PLAN_VALID" == "false" ]]; then
  # ═══ VIOLATION: dispatches without valid PLAN.md ═══
  echo "${LOG_TAG} ❌ VIOLATION: dispatches without PLAN_VALID (age=${PLAN_AGE}s)" >&2

  # Inject structured feedback into cortex's session via stdout
  cat <<'VIOLATION'

⚠️ PLAN_VIOLATION: You dispatched agents without a valid approved plan.

Before dispatching any agents (motor, cerebellum, temporal-research), you MUST:
1. Spawn prefrontal first to get a DISPATCH_PLAN
2. Write the plan to workspace/PLAN.md with PLAN_VALID and PLAN_STATUS: APPROVED
3. Only THEN spawn the agents listed in the plan

The enforcement chain: prefrontal produces plan → you write PLAN.md → dispatches proceed.
VIOLATION

  # Write telemetry
  if [[ -x "${SCRIPT_DIR}/brain-telemetry-write" ]]; then
    "${SCRIPT_DIR}/brain-telemetry-write" "compliance" "plan-violation" 0 0 0 1 "no_plan_valid" &
  fi

elif [[ "$DISPATCHES" -gt 0 && "$PLAN_VALID" == "true" && "$PLAN_APPROVED" == "false" ]]; then
  # ═══ VIOLATION: plan exists but not approved ═══
  echo "${LOG_TAG} ❌ VIOLATION: PLAN_VALID present but PLAN_STATUS: APPROVED missing" >&2

  # Inject structured feedback
  cat <<'VIOLATION'

⚠️ PLAN_VIOLATION: Your PLAN.md exists but is missing PLAN_STATUS: APPROVED.

After receiving the DISPATCH_PLAN from prefrontal, write it to PLAN.md with both markers:
  PLAN_VALID
  PLAN_STATUS: APPROVED
  timestamp: <ISO timestamp>

Then proceed with dispatches.
VIOLATION

  if [[ -x "${SCRIPT_DIR}/brain-telemetry-write" ]]; then
    "${SCRIPT_DIR}/brain-telemetry-write" "compliance" "plan-violation" 0 0 0 1 "no_approved" &
  fi

elif [[ "$PLAN_VALID" == "true" && "$PLAN_APPROVED" == "true" && "$STEP_COUNT" -gt 0 ]]; then
  # ═══ COMPLIANT ═══
  echo "${LOG_TAG} ✅ PLAN_VALID + APPROVED (${STEP_COUNT} steps, ${COMPLETED_STEPS} done, ${VALIDATION_COUNT} validation rules)" >&2

elif [[ "$PLAN_VALID" == "true" && "$STEP_COUNT" -eq 0 ]]; then
  # Plan exists with PLAN_VALID but no step markers — warn
  echo "${LOG_TAG} ⚠️ PLAN_VALID but no step markers found" >&2

elif [[ "$DISPATCHES" -eq 0 ]]; then
  # No dispatches this turn — compliance check not needed
  # This is normal for simple/identity/short_circuit responses
  :
fi

# Always exit 0 — violations are feedback-injected via stdout, never fatal
exit 0
