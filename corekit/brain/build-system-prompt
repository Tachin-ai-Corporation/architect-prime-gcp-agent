#!/usr/bin/env bash
# ============================================================
# build-system-prompt — Assemble agent system prompt from
#                        identity + skills
#
# Reads workspace files (SOUL.md, IDENTITY.md, MEMORY.md)
# for agent identity, then looks up the agent's skills in
# agent-types.json and appends each skill's SKILL.md.
#
# Used by: agent-ask (assembles the system instruction for
# the standalone Vertex AI LLM call). Note: TOOLS.md is
# generated separately by assemble-tools for OpenClaw agents.
#
# Output: system prompt text on stdout
#
# Environment:
#   AGENT_ID     — Agent identifier (default: prime)
#   OC_HOST_ROOT — OpenClaw host root (default: /opt/openclaw)
# ============================================================
set -euo pipefail

AGENT_ID="${AGENT_ID:-prime}"
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
OC_DIR="${OC_HOST_ROOT}/.openclaw"

if [[ ! -d "$OC_DIR" && -d "${HOME}/.openclaw" ]]; then
  OC_DIR="${HOME}/.openclaw"
fi

# Determine workspace path
if [[ "$AGENT_ID" == "prime" ]]; then
  WORKSPACE="${OC_DIR}/workspace"
else
  WORKSPACE="${OC_DIR}/workspace-fleet"
fi

SKILLS_DIR="${OC_DIR}/skills"
TYPES_FILE="${OC_DIR}/corekit/agent-types.json"

# ---- Helpers ----
read_file() {
  local file="$1"
  local max="${2:-2000}"
  if [[ -f "$file" ]]; then
    head -c "$max" "$file" 2>/dev/null || true
  fi
}

# ---- Read identity files ----
SOUL="$(read_file "${WORKSPACE}/SOUL.md")"
MEMORY="$(read_file "${WORKSPACE}/MEMORY.md")"
IDENTITY="$(read_file "${WORKSPACE}/IDENTITY.md")"

# ---- Resolve agent metadata ----
SPECIALTY=""
SPECIALTY="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/attributes/specialty' 2>/dev/null || true)"

PROJECT_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || echo 'unknown')"

# ---- Determine agent type and resolve skills ----
AGENT_TYPE=""
SKILLS=""

if [[ "$AGENT_ID" == "prime" ]]; then
  # Prime has a fixed skill set — all fleet skills
  AGENT_TYPE="prime"
  SKILLS="agent-ask fleet-hire fleet-fire fleet-status fleet-verify fleet-upgrade"
elif [[ -n "$SPECIALTY" && -f "$TYPES_FILE" ]]; then
  # Fleet agent — look up skills from agent-types.json
  AGENT_TYPE="$SPECIALTY"
  SKILLS="$(python3 -c "
import json, sys
spec = '$SPECIALTY'
types = json.load(open('$TYPES_FILE'))['types']
for t in types:
    if t['id'] == spec:
        print(' '.join(t.get('skills', ['agent-ask'])))
        sys.exit(0)
print('agent-ask')
" 2>/dev/null || echo "agent-ask")"
else
  # Fallback
  SKILLS="agent-ask"
fi

# ---- Assemble skill docs ----
SKILL_DOCS=""
for skill in $SKILLS; do
  SKILL_FILE="${SKILLS_DIR}/${skill}/SKILL.md"
  if [[ -f "$SKILL_FILE" ]]; then
    CONTENT="$(read_file "$SKILL_FILE" 1500)"
    SKILL_DOCS="${SKILL_DOCS}
${CONTENT}

---
"
  fi
done

# ---- Build the prompt ----
cat <<PROMPT
You are ${AGENT_ID}, an AI agent in the Architect Prime system.
${SPECIALTY:+Your specialty: ${SPECIALTY}.}
Project: ${PROJECT_ID}
Current date: $(date -u '+%Y-%m-%d %H:%M UTC')

${SOUL:+${SOUL}

}${IDENTITY:+## Identity
${IDENTITY}

}${MEMORY:+## Memory
${MEMORY}

}${SKILL_DOCS:+## Skills
The following skills are available to you. Use exec to run the commands described.

${SKILL_DOCS}
}## General Instructions
- Keep responses under 2000 characters (Google Chat message limit).
- Use markdown formatting sparingly (bold, bullet points).
- If you don't know something, say so honestly.
- Stay within your role boundaries.
- Be conversational and friendly — you're a colleague, not a CLI.
- When you have enough info to act, run the tool — never describe what you "would" do.
PROMPT
