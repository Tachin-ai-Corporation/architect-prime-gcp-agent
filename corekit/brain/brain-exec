#!/usr/bin/env bash
# ============================================================
# brain-exec — Prefrontal-First Sub-Agent Dispatch
#
# Two modes:
#
# 1. DEFAULT (prefrontal gate):
#    brain-exec <message>
#    Runs temporal-memory → prefrontal → validates plan → returns
#    plan to Cortex. Cortex then calls --plan-exec for each step.
#
# 2. PLAN EXECUTION (skip gate):
#    brain-exec --plan-exec <agent-id> "<task>" [timeout]
#    Executes a single agent from Prefrontal's plan. Used by
#    Cortex to execute each pipeline step.
#
# This script is deterministic. All LLM calls happen inside
# the sub-agents (OpenClaw sessions_spawn), not here.
# ============================================================

OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
CONTRACTS="${OC_HOST_ROOT}/.openclaw/corekit/contracts.json"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKER="${SCRIPT_DIR}/brain-exec-worker"
TELEMETRY_BIN="${SCRIPT_DIR}/brain-telemetry-write"

log() { echo "[brain-exec] $*" >&2; }

# ── Parse mode ────────────────────────────────────────────
if [[ "${1:-}" == "--plan-exec" ]]; then
  # ── MODE: Plan execution (skip prefrontal gate) ──────
  shift
  AGENT_ID="${1:?Usage: brain-exec --plan-exec <agent-id> \"<task>\" [timeout]}"
  TASK="${2:?Usage: brain-exec --plan-exec <agent-id> \"<task>\" [timeout]}"
  TIMEOUT="${3:-150}"

  # Validate agent ID against contracts
  if [[ -f "$CONTRACTS" ]]; then
    VALID=$(python3 -c "
import json, sys
try:
    c = json.load(open('$CONTRACTS'))
    ids = c.get('agents', {}).get('subagentIds', [])
    if '$AGENT_ID' in ids:
        sys.exit(0)
    else:
        print(' '.join(ids))
        sys.exit(1)
except Exception as e:
    print(str(e), file=sys.stderr)
    sys.exit(0)
" 2>/dev/null) || {
      echo "ERROR: Unknown agent '${AGENT_ID}'. Valid agents: ${VALID}"
      [[ -x "$TELEMETRY_BIN" ]] && "$TELEMETRY_BIN" "$AGENT_ID" "$TASK" 0 0 0 1 "unknown_agent" &
      exit 1
    }
  fi

  # Validate: prefrontal and temporal-memory cannot be in plan-exec
  # (they already ran in the gate)
  if [[ "$AGENT_ID" == "prefrontal" || "$AGENT_ID" == "temporal-memory" ]]; then
    echo "ERROR: ${AGENT_ID} cannot be in a pipeline — it already ran in the prefrontal gate."
    exit 1
  fi

  # Validate worker exists
  if [[ ! -x "$WORKER" ]]; then
    echo "ERROR: brain-exec-worker not found at ${WORKER}"
    exit 1
  fi

  # Spawn worker in background
  LOG_DIR="/tmp/brain-exec-logs"
  mkdir -p "$LOG_DIR" 2>/dev/null || true
  LOG_FILE="${LOG_DIR}/${AGENT_ID}-$(date +%s).log"

  nohup "$WORKER" "$AGENT_ID" "$TASK" "$TIMEOUT" > "$LOG_FILE" 2>&1 &
  disown

  TASK_SHORT="${TASK:0:120}"
  echo "✅ Dispatched ${AGENT_ID}: ${TASK_SHORT}"

elif [[ "${1:-}" == "--validate-plan" ]]; then
  # ── MODE: Plan validation (deterministic) ────────────
  shift
  PLAN="${1:?Usage: brain-exec --validate-plan \"<plan text>\"}"

  # Parse the plan
  INTENT=$(echo "$PLAN" | grep -oP '(?<=^intent: ).*' | head -1)
  PIPELINE=$(echo "$PLAN" | grep -oP '(?<=^pipeline: \[).*(?=\])' | head -1)
  SHORT_CIRCUIT=$(echo "$PLAN" | grep -oP '(?<=^short_circuit: ).*' | head -1)
  APPROVAL=$(echo "$PLAN" | grep -oP '(?<=^approval_needed: ).*' | head -1)
  MOTOR_MODE=$(echo "$PLAN" | grep -oP '(?<=^motor_mode: ).*' | head -1)

  ERRORS=""

  # Check: pipeline doesn't contain temporal-memory or prefrontal
  if echo "$PIPELINE" | grep -qE 'temporal-memory|prefrontal'; then
    ERRORS="${ERRORS}\n- Pipeline contains temporal-memory or prefrontal (they already ran)"
  fi

  # Check: pipeline length ≤ 4
  if [[ -n "$PIPELINE" ]]; then
    PIPE_COUNT=$(echo "$PIPELINE" | tr ',' '\n' | wc -l)
    if [[ "$PIPE_COUNT" -gt 4 ]]; then
      ERRORS="${ERRORS}\n- Pipeline too long (${PIPE_COUNT} agents, max 4)"
    fi
  fi

  # Check: motor without cerebellum (for write operations)
  if echo "$PIPELINE" | grep -q 'motor'; then
    if [[ "$MOTOR_MODE" != "read" ]] && ! echo "$PIPELINE" | grep -q 'cerebellum'; then
      ERRORS="${ERRORS}\n- Motor with mode '${MOTOR_MODE}' requires cerebellum for verification"
    fi
  fi

  # Check: cerebellum must be last if present
  if echo "$PIPELINE" | grep -q 'cerebellum'; then
    LAST=$(echo "$PIPELINE" | tr ',' '\n' | tr -d ' ' | tail -1)
    if [[ "$LAST" != "cerebellum" ]]; then
      ERRORS="${ERRORS}\n- Cerebellum must be last in pipeline (found: ${LAST})"
    fi
  fi

  if [[ -n "$ERRORS" ]]; then
    echo "PLAN_INVALID"
    echo -e "Violations:${ERRORS}"
    exit 1
  else
    echo "PLAN_VALID"
    exit 0
  fi

else
  # ── MODE: Display usage ──────────────────────────────
  echo "brain-exec — Prefrontal-First Sub-Agent Dispatch"
  echo ""
  echo "Usage:"
  echo "  brain-exec --plan-exec <agent-id> \"<task>\" [timeout]"
  echo "    Execute a single agent from Prefrontal's dispatch plan."
  echo ""
  echo "  brain-exec --validate-plan \"<plan text>\""
  echo "    Validate a dispatch plan against invariants."
  echo ""
  echo "NOTE: The prefrontal gate (temporal-memory + prefrontal auto-dispatch)"
  echo "is handled by gateway hooks, not by this script."
  exit 0
fi
