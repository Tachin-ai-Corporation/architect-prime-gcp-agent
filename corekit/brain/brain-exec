#!/usr/bin/env bash
# ============================================================
# brain-exec — Wrapper for exec openclaw agent dispatch
#
# 1. Validates agent ID against contracts.json (fail fast)
# 2. Runs the sub-agent via openclaw agent
# 3. Strips gateway warning messages from the output
# 4. Writes dispatch telemetry to Firestore (fire-and-forget)
#
# Usage (from Cortex SOUL.md):
#   exec brain-exec <agent-id> "<task instruction>" [timeout]
#
# Example:
#   exec brain-exec temporal-research "Research: latest AI news"
# ============================================================

AGENT_ID="${1:?Usage: brain-exec <agent-id> \"<task>\"}"
TASK="${2:?Usage: brain-exec <agent-id> \"<task>\"}"
TIMEOUT="${3:-150}"

# ── Locate contracts.json ──────────────────────────────────
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
CONTRACTS="${OC_HOST_ROOT}/.openclaw/corekit/contracts.json"

# ── Validate agent ID against contracts ────────────────────
# Structured dispatch protocol: reject unknown agent IDs before
# launching openclaw agent. Prevents silent failures from typos.
if [[ -f "$CONTRACTS" ]]; then
  VALID=$(python3 -c "
import json, sys
try:
    c = json.load(open('$CONTRACTS'))
    ids = c.get('agents', {}).get('subagentIds', [])
    if '$AGENT_ID' in ids:
        sys.exit(0)
    else:
        print(' '.join(ids))
        sys.exit(1)
except Exception as e:
    print(str(e), file=sys.stderr)
    sys.exit(0)  # Don't block on contract read errors
" 2>/dev/null) || {
    echo "ERROR: Unknown agent '${AGENT_ID}'. Valid agents: ${VALID}"
    # Telemetry: record the rejection (fire-and-forget)
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    "${SCRIPT_DIR}/brain-telemetry-write" "$AGENT_ID" "$TASK" 0 0 0 1 "unknown_agent" &
    exit 1
  }
fi

# ── Status update (dispatching) ────────────────────────────
STATUS_BIN="${OC_HOST_ROOT}/.openclaw/bin/agent-status"
[[ -x "$STATUS_BIN" ]] && "$STATUS_BIN" set dispatching "$AGENT_ID" "$TASK" 2>/dev/null || true

# ── Dispatch ───────────────────────────────────────────────
T_START=$(date +%s%N)

# Run openclaw agent and capture full output
OUTPUT=$(openclaw agent --agent "$AGENT_ID" -m "$TASK" --timeout "$TIMEOUT" 2>&1) || true

T_END=$(date +%s%N)

# Strip known gateway warning lines
CLEAN=$(echo "$OUTPUT" | grep -v \
  -e 'gateway connect failed' \
  -e 'GatewayClientRequestError' \
  -e 'Gateway agent failed' \
  -e 'falling back to embedded' \
  -e 'Gateway target:' \
  -e 'Source: local' \
  -e 'Config: /home' \
  -e 'Bind: loopback' \
  -e '^$' \
  || true)

# If nothing left after stripping, return original
if [[ -z "$CLEAN" ]]; then
  FINAL="$OUTPUT"
else
  FINAL="$CLEAN"
fi

# ── Heartbeat (update TASK.json so health monitor knows we're alive) ──
TASK_FILE="${OC_HOST_ROOT}/.openclaw/workspace/TASK.json"
if [[ -f "$TASK_FILE" ]]; then
  python3 -c "
import json, datetime
try:
    with open('$TASK_FILE', 'r+') as f:
        task = json.load(f)
        task['heartbeat'] = datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')
        task['lastDispatch'] = '$AGENT_ID'
        f.seek(0)
        json.dump(task, f)
        f.truncate()
except:
    pass
" 2>/dev/null || true
fi

# ── Status update (synthesizing — dispatch complete) ──
[[ -x "$STATUS_BIN" ]] && "$STATUS_BIN" set synthesizing "$AGENT_ID" "$TASK" 2>/dev/null || true

# ── Telemetry (fire-and-forget) ────────────────────────────
OUTPUT_BYTES=$(echo "$FINAL" | wc -c)
EXIT_CODE=0
ERROR_TYPE=""

# Detect failure conditions
if [[ "$OUTPUT_BYTES" -le 1 ]]; then
  ERROR_TYPE="empty_response"
  EXIT_CODE=1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"${SCRIPT_DIR}/brain-telemetry-write" \
  "$AGENT_ID" "$TASK" "$T_START" "$T_END" "$OUTPUT_BYTES" "$EXIT_CODE" "$ERROR_TYPE" &

# ── Return output ──────────────────────────────────────────
echo "$FINAL"
