#!/usr/bin/env bash
# ============================================================
# brain-exec — Fire-and-forget sub-agent dispatch
#
# Validates the agent ID, spawns brain-exec-worker in the
# background, and immediately returns a confirmation message.
# The worker independently delivers results via channel-respond.
#
# This design eliminates the Vertex AI model API timeout that
# occurred when Cortex blocked for 4+ minutes waiting for a
# synchronous tool result.
#
# Usage (from Cortex SOUL.md):
#   exec brain-exec <agent-id> "<task instruction>" [timeout]
#
# Returns immediately with:
#   "✅ Dispatched <agent-id>: <task summary>"
# ============================================================

AGENT_ID="${1:?Usage: brain-exec <agent-id> \"<task>\"}"
TASK="${2:?Usage: brain-exec <agent-id> \"<task>\"}"
TIMEOUT="${3:-150}"

# ── Locate scripts ─────────────────────────────────────────
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
CONTRACTS="${OC_HOST_ROOT}/.openclaw/corekit/contracts.json"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKER="${SCRIPT_DIR}/brain-exec-worker"

# ── Validate agent ID against contracts ────────────────────
if [[ -f "$CONTRACTS" ]]; then
  VALID=$(python3 -c "
import json, sys
try:
    c = json.load(open('$CONTRACTS'))
    ids = c.get('agents', {}).get('subagentIds', [])
    if '$AGENT_ID' in ids:
        sys.exit(0)
    else:
        print(' '.join(ids))
        sys.exit(1)
except Exception as e:
    print(str(e), file=sys.stderr)
    sys.exit(0)
" 2>/dev/null) || {
    echo "ERROR: Unknown agent '${AGENT_ID}'. Valid agents: ${VALID}"
    "${SCRIPT_DIR}/brain-telemetry-write" "$AGENT_ID" "$TASK" 0 0 0 1 "unknown_agent" &
    exit 1
  }
fi

# ── Validate worker exists ─────────────────────────────────
if [[ ! -x "$WORKER" ]]; then
  echo "ERROR: brain-exec-worker not found at ${WORKER}"
  exit 1
fi

# ── Spawn worker in background ─────────────────────────────
# nohup + disown ensures the worker survives even if this shell
# (the tool call) is killed. Logs go to a rotating worker log.
LOG_DIR="/tmp/brain-exec-logs"
mkdir -p "$LOG_DIR" 2>/dev/null || true
LOG_FILE="${LOG_DIR}/${AGENT_ID}-$(date +%s).log"

nohup "$WORKER" "$AGENT_ID" "$TASK" "$TIMEOUT" > "$LOG_FILE" 2>&1 &
disown

# ── Return immediately ─────────────────────────────────────
# Cortex sees this response and tells the user what was dispatched.
# The actual result will be delivered by channel-respond when ready.
TASK_SHORT="${TASK:0:120}"
echo "✅ Dispatched ${AGENT_ID}: ${TASK_SHORT}"
