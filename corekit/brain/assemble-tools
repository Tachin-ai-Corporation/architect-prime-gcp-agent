#!/usr/bin/env bash
# ============================================================
# assemble-tools — Build per-agent TOOLS.md from skill packages
#
# Reads skill.json manifests to determine which skills route to
# which brain agent, then generates targeted TOOLS.md files:
#   - motor/cerebellum/temporal-research: full SKILL.md content
#   - cortex/prefrontal: skill INDEX only (name + when_to_use)
#
# Also appends specialty-specific SOUL sections to sub-agent
# workspace SOUL.md files.
#
# Usage: assemble-tools [agent-type]
#   agent-type defaults to "prime"
#
# Environment:
#   CORE_DIR — CoreKit root (default: /opt/corekit)
# ============================================================
set -euo pipefail

AGENT_TYPE="${1:-prime}"
CORE_DIR="${CORE_DIR:-/opt/corekit}"
SKILLS_DIR="${CORE_DIR}/skills"
TYPES_FILE="${CORE_DIR}/corekit/agent-types.json"
SPECIALTIES_DIR="${CORE_DIR}/corekit/specialties"
WORKSPACE="${CORE_DIR}/workspace"
CUSTOM_SKILLS_DIR="${WORKSPACE}/custom-skills"

# Brain agent workspaces
declare -A AGENT_WORKSPACES=(
  [cortex]="${CORE_DIR}/workspace"
  [motor]="${CORE_DIR}/workspace-motor"
  [cerebellum]="${CORE_DIR}/workspace-cerebellum"
  [temporal-research]="${CORE_DIR}/workspace-temporal-research"
  [temporal-memory]="${CORE_DIR}/workspace-temporal-memory"
  [prefrontal]="${CORE_DIR}/workspace-prefrontal"
)

# ---- Determine skill list for this agent type ----
if [[ "$AGENT_TYPE" == "prime" ]]; then
  SKILLS="web-search fleet-hire fleet-fire fleet-status fleet-verify fleet-upgrade memory-consolidate"
elif [[ -f "$TYPES_FILE" ]]; then
  SKILLS="$(python3 -c "
import json, sys
spec = '$AGENT_TYPE'
types = json.load(open('$TYPES_FILE'))['types']
for t in types:
    if t['id'] == spec:
        print(' '.join(t.get('skills', ['web-search'])))
        sys.exit(0)
print('web-search')
" 2>/dev/null || echo "web-search")"
else
  SKILLS="web-search"
fi

# ---- Collect all skill packages with their metadata ----
# Each entry: skill_id|agent_part|skill_dir|when_to_use|name
SKILL_ENTRIES=()

collect_skill() {
  local skill_id="$1"
  local skill_dir="$2"
  local skill_json="${skill_dir}/skill.json"
  local skill_md="${skill_dir}/SKILL.md"

  if [[ ! -f "$skill_md" ]]; then
    return
  fi

  # Read agent_part from skill.json, default to "motor"
  local agent_part="motor"
  local when_to_use=""
  local name="$skill_id"

  if [[ -f "$skill_json" ]]; then
    agent_part="$(python3 -c "
import json
d = json.load(open('$skill_json'))
print(d.get('agent_part', 'motor'))
" 2>/dev/null || echo "motor")"

    when_to_use="$(python3 -c "
import json
d = json.load(open('$skill_json'))
print(d.get('when_to_use', ''))
" 2>/dev/null || echo "")"

    name="$(python3 -c "
import json
d = json.load(open('$skill_json'))
print(d.get('name', '$skill_id'))
" 2>/dev/null || echo "$skill_id")"
  fi

  SKILL_ENTRIES+=("${skill_id}|${agent_part}|${skill_dir}|${when_to_use}|${name}")
}

# Collect standard skills
for skill in $SKILLS; do
  SKILL_FILE_DIR="${SKILLS_DIR}/${skill}"
  if [[ -d "$SKILL_FILE_DIR" ]]; then
    collect_skill "$skill" "$SKILL_FILE_DIR"
  fi
done

# Collect specialty-specific skills
SPEC_SKILLS_DIR="${SPECIALTIES_DIR}/${AGENT_TYPE}/skills"
if [[ -d "$SPEC_SKILLS_DIR" ]]; then
  for skill_dir in "$SPEC_SKILLS_DIR"/*/; do
    if [[ -d "$skill_dir" ]]; then
      skill_id="$(basename "$skill_dir")"
      collect_skill "$skill_id" "$skill_dir"
    fi
  done
fi

# Collect per-agent custom skills (installed ad-hoc)
if [[ -d "$CUSTOM_SKILLS_DIR" ]]; then
  for skill_dir in "$CUSTOM_SKILLS_DIR"/*/; do
    if [[ -d "$skill_dir" ]]; then
      skill_id="$(basename "$skill_dir")"
      collect_skill "$skill_id" "$skill_dir"
    fi
  done
fi

echo "Collected ${#SKILL_ENTRIES[@]} skill packages"

# ---- Phase 1: Generate per-agent TOOLS.md ----
# Execution agents get full SKILL.md content for their skills
# Planning agents get a skill index only

for agent in cortex motor cerebellum temporal-research prefrontal; do
  WS="${AGENT_WORKSPACES[$agent]:-}"
  if [[ -z "$WS" || ! -d "$WS" ]]; then
    continue
  fi

  OUT="${WS}/TOOLS.md"

  if [[ "$agent" == "cortex" || "$agent" == "prefrontal" ]]; then
    # ---- INDEX MODE: name + when_to_use for all skills ----
    {
      echo "# Skill Index — ${AGENT_TYPE}"
      echo ""
      echo "Available skills in this agent's toolkit. Reference these when planning dispatches."
      echo ""
      echo "| Skill | When to Use |"
      echo "|-------|-------------|"

      for entry in "${SKILL_ENTRIES[@]}"; do
        IFS='|' read -r sid spart sdir swhen sname <<< "$entry"
        # Show the target agent so cortex/prefrontal know where to dispatch
        echo "| **${sname}** (${spart}) | ${swhen} |"
      done

      echo ""
      echo "Skills are routed to specific brain agents (shown in parentheses)."
      echo "Dispatch to the correct agent when invoking a skill."
    } > "$OUT"

    echo "  ${agent}: skill index (${#SKILL_ENTRIES[@]} skills)"

  else
    # ---- FULL MODE: complete SKILL.md for matching skills ----
    MATCH_COUNT=0
    {
      echo "# Tools — ${AGENT_TYPE} (${agent})"
      echo ""
      echo "The following skills are available. Use exec to run the commands described."
      echo ""

      for entry in "${SKILL_ENTRIES[@]}"; do
        IFS='|' read -r sid spart sdir swhen sname <<< "$entry"
        if [[ "$spart" == "$agent" ]]; then
          SKILL_MD="${sdir}/SKILL.md"
          if [[ -f "$SKILL_MD" ]]; then
            echo "---"
            echo ""
            cat "$SKILL_MD"
            echo ""
            MATCH_COUNT=$((MATCH_COUNT + 1))
          fi
        fi
      done
    } > "$OUT"

    echo "  ${agent}: ${MATCH_COUNT} skills (full SKILL.md)"
  fi
done

echo "Generated per-agent TOOLS.md files"

# ---- Phase 2: Append specialty SOUL sections to sub-agent workspaces ----
SPEC_BRAIN_DIR="${SPECIALTIES_DIR}/${AGENT_TYPE}/brain"
APPEND_COUNT=0

if [[ -d "$SPEC_BRAIN_DIR" ]]; then
  for sub in cortex motor prefrontal cerebellum temporal-memory temporal-research; do
    APPEND_FILE="${SPEC_BRAIN_DIR}/${sub}/SOUL_APPEND.md"
    SUB_SOUL="${AGENT_WORKSPACES[$sub]:-${CORE_DIR}/workspace-${sub}}/SOUL.md"
    if [[ -f "$APPEND_FILE" && -f "$SUB_SOUL" ]]; then
      echo "" >> "$SUB_SOUL"
      echo "---" >> "$SUB_SOUL"
      echo "" >> "$SUB_SOUL"
      cat "$APPEND_FILE" >> "$SUB_SOUL"
      APPEND_COUNT=$((APPEND_COUNT + 1))
      echo "  Appended ${sub} specialty SOUL from ${APPEND_FILE}"
    fi
  done
fi

echo "Specialty SOUL appends: ${APPEND_COUNT} applied"
echo "Assembly complete for agent type: ${AGENT_TYPE}"
