#!/usr/bin/env bash
# ============================================================
# work-log-read — Query recent fleet work envelopes
#
# Reads completed work envelopes from Firestore and displays
# them for skill discovery analysis. Shows mission details
# including what agents were dispatched, outcomes, and timing.
#
# Usage:
#   work-log-read --hours 24                   # Last 24h, all agents
#   work-log-read --hours 24 --owner stan      # Stan's work only
#   work-log-read --hours 24 --status complete # Completed only
#   work-log-read --hours 48 --type M          # Missions only
#   work-log-read --hours 24 --min-steps 3     # Multi-step only
#   work-log-read --mission w-123...           # Drill ONE mission's M->C->T tree
#   work-log-read --hours 24 --json            # JSON output
#   work-log-read --hours 24 --verbose         # Include result text
#
# Reads from: the top-level work/ collection.
# ============================================================
set -euo pipefail

# ── Parse arguments ────────────────────────────────────────
HOURS=24
OWNER_FILTER=""
STATUS_FILTER=""
TYPE_FILTER=""
MIN_STEPS=0
LIMIT=50
JSON_OUTPUT=false
VERBOSE=false
MISSION_ID=""
SELF=false
RECENT=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --hours)     HOURS="$2";           shift 2 ;;
    --owner)     OWNER_FILTER="$2";    shift 2 ;;
    --self)      SELF=true;            shift ;;
    --recent)    RECENT="$2";          shift 2 ;;
    --status)    STATUS_FILTER="$2";   shift 2 ;;
    --type)      TYPE_FILTER="$2";     shift 2 ;;
    --min-steps) MIN_STEPS="$2";       shift 2 ;;
    --mission)   MISSION_ID="$2";      shift 2 ;;
    --limit)     LIMIT="$2";           shift 2 ;;
    --json)      JSON_OUTPUT=true;     shift ;;
    --verbose)   VERBOSE=true;         shift ;;
    --help|-h)
      cat <<'HELP'
Usage: work-log-read [OPTIONS]

Options:
  --hours N        Look back N hours (default: 24)
  --owner NAME     Filter by agent owner (e.g. stan, anora)
  --self           Filter to MY OWN work (this agent). Use to review or learn
                   from your own recent missions and failures.
  --recent N       Shorthand for "my last N missions" (implies --type M,
                   --limit N, and a 30-day window). Combine with --self.
  --status STATUS  Filter by status (complete, failed, blocked, active, pending)
  --type TYPE      Filter by envelope type (M=mission, C=child, R=responsibility)
  --min-steps N    Only show envelopes with N+ child dispatches (default: 0)
  --mission ID     Drill ONE mission: print its M->C->T tree + step ledger
                   (per-task attempts with their errors — the richest failure
                   detail for diagnosing why a mission failed)
  --limit N        Max results (default: 50)
  --json           Output as JSON array
  --verbose        Include result/instruction text in output
HELP
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# ── --self / --recent convenience resolution ───────────────
# --self scopes to this agent's own work. Owner is stored as a full email but
# matched client-side by substring, so the hostname-derived short name (or the
# AGENT_USER_EMAIL env when present) is a sufficient filter.
if [[ "$SELF" == "true" && -z "$OWNER_FILTER" ]]; then
  if [[ -n "${AGENT_USER_EMAIL:-}" ]]; then
    OWNER_FILTER="$AGENT_USER_EMAIL"
  else
    OWNER_FILTER="$(hostname | sed 's/^prime-//;s/^fleet-//')"
  fi
fi
# --recent N: "my last N missions" — missions only, over a 30-day window.
if [[ -n "$RECENT" ]]; then
  TYPE_FILTER="${TYPE_FILTER:-M}"
  LIMIT="$RECENT"
  [[ "$HOURS" == "24" ]] && HOURS=720
fi

# ── Resolve Prime ID and Project ───────────────────────────
PRIME_ID=$(curl -sf --max-time 2 -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime_id" 2>/dev/null || echo "")
if [[ -z "$PRIME_ID" ]]; then
  PRIME_ID=$(hostname | sed 's/^prime-//' | sed 's/^fleet-//')
fi

PROJECT_ID=$(curl -sf --max-time 2 -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/project/project-id" 2>/dev/null || echo "")
if [[ -z "$PROJECT_ID" ]]; then
  echo "ERROR: Could not resolve PROJECT_ID" >&2
  exit 1
fi

# ── Get access token ───────────────────────────────────────
TOKEN=$(curl -sf --max-time 3 -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])")

# ── Compute cutoff timestamp ──────────────────────────────
CUTOFF=$(python3 -c "
from datetime import datetime, timedelta, timezone
cutoff = datetime.now(timezone.utc) - timedelta(hours=${HOURS})
print(cutoff.strftime('%Y-%m-%dT%H:%M:%S.000Z'))
")

# ── Build Firestore query filters ─────────────────────────
FIRESTORE_BASE="https://firestore.googleapis.com/v1/projects/${PROJECT_ID}/databases/(default)/documents"
PARENT_PATH=""

# ── Mission drill-down: one mission + its full M->C->T tree ───
# Scopes to a SINGLE mission — one GET per envelope in that mission (single- to
# low-double-digit reads) instead of an unbounded --hours window over every agent's
# work (B-4: bounded context; the original tool forced --hours 72 to inspect one
# mission, ballooning an agent's motor budget). Mirrors the children-based tree walk
# in corekit/fleet/fleet-work-read (Prime-only); kept inline to avoid a cross-CLI
# shared-module dependency for a read-only tool — a future refactor could share it (B-18).
if [[ -n "$MISSION_ID" ]]; then
  M_TMP="$(mktemp)"; trap 'rm -f "$M_TMP"' EXIT
  curl -s -o "$M_TMP" --max-time 15 -H "Authorization: Bearer ${TOKEN}" \
    "${FIRESTORE_BASE}/work/${MISSION_ID}"
  python3 - "$M_TMP" "$FIRESTORE_BASE" "$TOKEN" "$JSON_OUTPUT" "$VERBOSE" <<'PYDRILL'
import json, sys, urllib.request
m_file, fs_url, token, json_mode, verbose = sys.argv[1:6]
json_mode = (json_mode == "true"); verbose = (verbose == "true")

def dec(v):
    for k in ("stringValue", "integerValue", "booleanValue", "timestampValue"):
        if k in v: return v[k]
    if "nullValue" in v: return None
    if "arrayValue" in v: return [dec(x) for x in v["arrayValue"].get("values", [])]
    if "mapValue" in v: return {kk: dec(vv) for kk, vv in v["mapValue"].get("fields", {}).items()}
    return v

def fetch(env_id):
    req = urllib.request.Request(f"{fs_url}/work/{env_id}", headers={"Authorization": f"Bearer {token}"})
    try:
        d = json.load(urllib.request.urlopen(req, timeout=15))
    except Exception:
        return None
    return {k: dec(v) for k, v in d.get("fields", {}).items()}

try:
    md = json.load(open(m_file, encoding="utf-8"))
except Exception:
    print("ERROR: could not read mission document", file=sys.stderr); sys.exit(1)
if "fields" not in md:
    print("Mission not found or inaccessible.", file=sys.stderr); sys.exit(1)
mission = {k: dec(v) for k, v in md.get("fields", {}).items()}

nodes = []
def walk(env, depth):
    nodes.append((depth, env))
    for cid in (env.get("children") or []):
        c = fetch(cid)
        if c: walk(c, depth + 1)
        else: nodes.append((depth + 1, {"id": cid, "type": "?", "status": "missing"}))
walk(mission, 0)

if json_mode:
    print(json.dumps([{"depth": d, **e} for d, e in nodes], indent=1, default=str))
    sys.exit(0)

ICON = {"complete": "✅", "archived": "✅", "failed": "❌", "blocked": "🚫", "needs_input": "❓",
        "cancelled": "⊘", "active": "🔄", "waiting": "⏳", "queued": "⏳"}
print(f"\nMISSION {mission.get('id')}  [{mission.get('status')}]  {mission.get('owner') or ''}")
print(f"  {(mission.get('title') or '')[:90]}")
_instr = (mission.get('instruction') or '')[:400]
if _instr: print(f"  instruction: {_instr}")
_err = mission.get('error')
if _err: print(f"  error: {str(_err)[:300]}")
print("  " + "─" * 60)
for d, e in nodes[1:]:
    pad = "    " * d
    code = ICON.get(e.get('status'), '  ')
    print(f"  {pad}[{code}] {e.get('type', '?')} {e.get('intent') or ''} :: {(e.get('title') or '')[:70]}")
    _ee = e.get('error')
    if _ee: print(f"  {pad}      error: {str(_ee)[:200]}")
    if verbose and e.get('output'):
        print(f"  {pad}      output: {str(e.get('output'))[:200].strip()}")

# Step ledger: per-task attempts (status + error + timing) — the richest signal
# for WHY a mission failed. It lives on the mission envelope, not in the C/T tree,
# so it is invisible to a plain tree walk. Surface it (bounded to last 25).
sl = mission.get('step_ledger') or {}
if isinstance(sl, dict) and sl:
    print("\n  STEP LEDGER — per-task attempts (richest failure detail):")
    entries = sorted(sl.items(), key=lambda kv: ((kv[1] or {}).get('timestamp') or ''))
    for _h, rec in entries[-25:]:
        rec = rec or {}
        st = rec.get('status', '?')
        code = ICON.get(st, '  ')
        dur = rec.get('durationMs')
        print(f"    [{code}] {st}  {rec.get('timestamp','')}" + (f"  ({dur}ms)" if dur else ""))
        er = rec.get('error')
        if er:
            print(f"        error: {str(er)[:260]}")

print(f"\n{len(nodes)} node(s) in mission tree.")
PYDRILL
  exit 0
fi

# Always filter by created_at >= cutoff
FILTER_PARTS=()
FILTER_PARTS+=("{\"fieldFilter\":{\"field\":{\"fieldPath\":\"created_at\"},\"op\":\"GREATER_THAN_OR_EQUAL\",\"value\":{\"stringValue\":\"${CUTOFF}\"}}}")

if [[ -n "$OWNER_FILTER" ]]; then
  # Owner filtering is done client-side in Python because Firestore
  # stores owner as full email (e.g. assistant-agent-millie@example.com)
  # but callers pass short names (e.g. millie). Firestore EQUAL can't
  # do substring matching.
  :
fi
if [[ -n "$STATUS_FILTER" ]]; then
  FILTER_PARTS+=("{\"fieldFilter\":{\"field\":{\"fieldPath\":\"status\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"${STATUS_FILTER}\"}}}")
fi
if [[ -n "$TYPE_FILTER" ]]; then
  FILTER_PARTS+=("{\"fieldFilter\":{\"field\":{\"fieldPath\":\"type\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"${TYPE_FILTER}\"}}}")
fi

# Build where clause
if [[ ${#FILTER_PARTS[@]} -eq 1 ]]; then
  WHERE_CLAUSE="\"where\": ${FILTER_PARTS[0]},"
else
  JOINED=$(printf ",%s" "${FILTER_PARTS[@]}")
  JOINED="${JOINED:1}"  # remove leading comma
  WHERE_CLAUSE="\"where\": {\"compositeFilter\":{\"op\":\"AND\",\"filters\":[${JOINED}]}},"
fi

QUERY_BODY=$(cat <<EOF
{
  "structuredQuery": {
    "from": [{"collectionId": "work"}],
    ${WHERE_CLAUSE}
    "orderBy": [{"field": {"fieldPath": "created_at"}, "direction": "DESCENDING"}],
    "limit": ${LIMIT}
  }
}
EOF
)

# ── Execute query ──────────────────────────────────────────
# Stream the response to a temp FILE, never into a shell variable that would
# later be passed as an argv. The full Firestore payload (up to LIMIT
# envelopes, each with multi-KB output/instruction fields) routinely exceeds
# the OS argument-length limit (ARG_MAX) — passing it as argv[1] made this
# tool fail with "Argument list too long" on every large result set.
TMP_RESP="$(mktemp)"
trap 'rm -f "$TMP_RESP"' EXIT
HTTP_CODE=$(curl -s --max-time 15 -o "$TMP_RESP" -w '%{http_code}' \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: application/json" \
  -X POST "${FIRESTORE_BASE}${PARENT_PATH:+/${PARENT_PATH}}:runQuery" \
  -d "${QUERY_BODY}")

if [[ "$HTTP_CODE" != "200" ]]; then
  echo "ERROR: Firestore query returned HTTP ${HTTP_CODE}" >&2
  head -c 500 "$TMP_RESP" >&2; echo >&2
  exit 1
fi

# ── Parse and display ──────────────────────────────────────
# The response arrives as a file PATH (tiny argv), read from disk in Python.
python3 - <<'PYPARSE' "$TMP_RESP" "$JSON_OUTPUT" "$VERBOSE" "$MIN_STEPS" "$OWNER_FILTER"
import json, sys

raw = open(sys.argv[1], encoding="utf-8").read()
json_mode = sys.argv[2] == "true"
verbose = sys.argv[3] == "true"
min_steps = int(sys.argv[4])
owner_filter = sys.argv[5].lower() if len(sys.argv) > 5 and sys.argv[5] else ""

try:
    data = json.loads(raw)
except json.JSONDecodeError:
    print("ERROR: Could not parse Firestore response", file=sys.stderr)
    print(raw[:500], file=sys.stderr)
    sys.exit(1)

if not isinstance(data, list):
    data = [data]

def fv(fields, key, kind="stringValue", default=""):
    """Extract a typed value from Firestore fields."""
    f = fields.get(key, {})
    if kind == "stringValue":
        if "stringValue" in f:
            return f["stringValue"]
        # Handle mapValue (channel addressing stores owner as {fleet_agent, channel, ...})
        if "mapValue" in f:
            mv = f["mapValue"].get("fields", {})
            agent = mv.get("fleet_agent", {}).get("stringValue", "")
            if agent:
                return agent
            # Fallback: return first stringValue in the map
            for v in mv.values():
                if isinstance(v, dict) and "stringValue" in v:
                    return v["stringValue"]
        return default
    elif kind == "integerValue":
        return int(f.get("integerValue", default or 0))
    elif kind == "booleanValue":
        return f.get("booleanValue", default)
    elif kind == "arrayValue":
        arr = f.get("arrayValue", {}).get("values", [])
        return [v.get("stringValue", "") for v in arr]
    return default

# Extract documents
envelopes = []
for entry in data:
    doc = entry.get("document")
    if not doc:
        continue
    fields = doc.get("fields", {})
    name = doc.get("name", "")
    env_id = name.split("/")[-1] if name else "?"

    # Count children from the persisted `children` array — the M->C->T tree is stored
    # there. (child_ids / childCount were read here previously but are written nowhere,
    # so the CHILDREN column was always "—" and --min-steps filtered out everything.)
    child_ids = fv(fields, "children", "arrayValue")
    child_count = len(child_ids)

    # Skip if below min-steps threshold
    if min_steps > 0 and child_count < min_steps:
        continue

    env = {
        "id": env_id,
        "type": fv(fields, "type"),
        "status": fv(fields, "status"),
        "owner": fv(fields, "owner"),
        "title": fv(fields, "title"),
        "instruction": fv(fields, "instruction"),
        "output": fv(fields, "output"),
        "created_at": fv(fields, "created_at"),
        "completed_at": fv(fields, "completed_at"),
        "intent": fv(fields, "intent"),
        "agent": fv(fields, "agent"),
        "source_channel": fv(fields, "source_channel"),
        "childCount": child_count,
        "child_ids": child_ids,
        "process_id": fv(fields, "process_id"),
    }

    # Calculate duration if both timestamps present
    if env["created_at"] and env["completed_at"]:
        try:
            from datetime import datetime
            fmt = "%Y-%m-%dT%H:%M:%S"
            c = env["created_at"][:19]
            d = env["completed_at"][:19]
            dt = datetime.strptime(d, fmt) - datetime.strptime(c, fmt)
            env["durationSec"] = int(dt.total_seconds())
        except Exception:
            env["durationSec"] = None
    else:
        env["durationSec"] = None

    envelopes.append(env)

# Client-side owner filtering (substring match on short name)
# Firestore stores owner as full email (e.g. assistant-agent-millie@example.com)
# but callers pass short names (e.g. millie, stan, prime)
if owner_filter:
    def match_owner(owner_val, filt):
        if not owner_val:
            return False
        ol = owner_val.lower()
        if ol == filt:
            return True
        prefix = ol.split("@")[0]
        if prefix == filt:
            return True
        # Prime variations: "prime" matches "prime-*"
        if ol == "prime" and (filt == "prime" or filt.startswith("prime-")):
            return True
        if (filt == "prime" or filt.startswith("prime-")) and (ol == "prime" or prefix == "prime"):
            return True
        # Segment match: split on - _ . and check if short name is a segment
        segments = prefix.replace("_", "-").replace(".", "-").split("-")
        return filt in segments
    envelopes = [e for e in envelopes if match_owner(e["owner"], owner_filter)]

if not envelopes:
    print("No work envelopes found matching criteria.")
    sys.exit(0)

if json_mode:
    # Trim non-verbose fields for cleaner output
    if not verbose:
        for e in envelopes:
            if e.get("instruction"):
                e["instruction"] = e["instruction"][:200] + ("..." if len(e.get("instruction","")) > 200 else "")
            if e.get("output"):
                e["output"] = e["output"][:300] + ("..." if len(e.get("output","")) > 300 else "")
    print(json.dumps(envelopes, indent=2))
    sys.exit(0)

# ── Table output ──────────────────────────────────────────
status_icons = {
    "complete": "✅",
    "failed": "❌",
    "active": "🔄",
    "pending": "⏳",
    "blocked": "🚫",
    "cancelled": "⊘",
}

print(f"\n{'ID':<35} {'TYPE':<4} {'OWNER':<12} {'STATUS':<10} {'CHILDREN':<9} {'DURATION':<10} TITLE")
print("─" * 120)

for e in envelopes:
    icon = status_icons.get(e["status"], "?")
    dur = f"{e['durationSec']}s" if e["durationSec"] is not None else "—"
    title = (e["title"] or e["instruction"] or "—")[:45]
    owner = e["owner"] or "—"
    children = str(e["childCount"]) if e["childCount"] else "—"
    print(f"{e['id']:<35} {e['type']:<4} {owner:<12} {icon} {e['status']:<7} {children:<9} {dur:<10} {title}")

    if verbose and e.get("output"):
        result_preview = e["output"][:200].replace("\n", " ")
        print(f"   └─ Output: {result_preview}")
    if verbose and e.get("process_id"):
        print(f"   └─ Process: {e['process_id']}")

print(f"\n{len(envelopes)} envelope(s) shown.")

# Summary stats
owners = {}
for e in envelopes:
    o = e["owner"] or "unknown"
    owners[o] = owners.get(o, 0) + 1

if len(owners) > 1:
    parts = [f"{o}: {c}" for o, c in sorted(owners.items(), key=lambda x: -x[1])]
    print(f"By owner: {', '.join(parts)}")
PYPARSE
