#!/usr/bin/env bash
# session-summary — Extract recent completed work from Firestore envelopes
#
# The brain gateway doesn't persist session transcripts to disk,
# so this tool queries Firestore for recently completed Mission envelopes
# to produce a summary of recent agent activity.
#
# Usage:
#   session-summary [--hours 24] [--limit 20]
#
# Output: Plain text summary of recent completed missions, suitable for memory consolidation.

set -euo pipefail

HOURS=24
LIMIT=20

while [[ $# -gt 0 ]]; do
  case "$1" in
    --hours) HOURS="$2"; shift 2 ;;
    --limit) LIMIT="$2"; shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# ── Resolve Prime ID + credentials ────────────────────────────
PRIME_ID=$(curl -sf -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime_id" 2>/dev/null || echo "")
if [[ -z "$PRIME_ID" ]]; then
  PRIME_ID=$(hostname | sed 's/^prime-//' | sed 's/^fleet-//')
fi

PROJECT_ID=$(curl -sf -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/project/project-id" 2>/dev/null || echo "your-gcp-project")

TOKEN=$(curl -sf -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])")

# ── Compute cutoff timestamp ────────────────────────────────────
SINCE_TIMESTAMP=$(date -u -d "-${HOURS} hours" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null \
  || date -u -v-${HOURS}H +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")

if [[ -z "$SINCE_TIMESTAMP" ]]; then
  echo "Warning: could not compute cutoff timestamp" >&2
  echo "No recent sessions found."
  exit 0
fi

# ── Build Firestore query — simple filter, no orderBy (avoids composite index) ──
PARENT="projects/${PROJECT_ID}/databases/(default)/documents/primes/${PRIME_ID}"

QUERY_BODY=$(cat <<EOF
{
  "structuredQuery": {
    "from": [{"collectionId": "work"}],
    "where": {
      "compositeFilter": {
        "op": "AND",
        "filters": [
          {"fieldFilter": {"field": {"fieldPath": "status"}, "op": "EQUAL", "value": {"stringValue": "complete"}}},
          {"fieldFilter": {"field": {"fieldPath": "type"}, "op": "EQUAL", "value": {"stringValue": "M"}}}
        ]
      }
    },
    "limit": ${LIMIT}
  }
}
EOF
)

# ── Execute query ───────────────────────────────────────────────
RESPONSE=$(curl -sf \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: application/json" \
  -X POST "https://firestore.googleapis.com/v1/${PARENT}:runQuery" \
  -d "${QUERY_BODY}" 2>&1)

# ── Format output ───────────────────────────────────────────────
echo "$RESPONSE" | python3 -c '
import json, sys

try:
    results = json.loads(sys.stdin.read())
except:
    print("No recent sessions found.")
    sys.exit(0)

if not isinstance(results, list):
    results = [results]

# Filter by cutoff and sort client-side
cutoff = "'"${SINCE_TIMESTAMP}"'"
filtered = []
for entry in results:
    doc = entry.get("document")
    if not doc:
        continue
    fields = doc.get("fields", {})
    completed = fields.get("completed_at", {}).get("stringValue", "")
    if completed >= cutoff:
        filtered.append(entry)

# Sort by completed_at descending
filtered.sort(
    key=lambda e: e.get("document", {}).get("fields", {}).get("completed_at", {}).get("stringValue", ""),
    reverse=True,
)

count = 0
for entry in filtered:
    doc = entry["document"]
    fields = doc.get("fields", {})
    instruction = fields.get("instruction", {}).get("stringValue", "?")
    output = fields.get("output", {}).get("stringValue", "")
    completed = fields.get("completed_at", {}).get("stringValue", "?")
    title = fields.get("title", {}).get("stringValue", "")

    count += 1
    display = title if title else instruction[:200]
    print(f"--- Mission {count}: {display} ---")
    print(f"  Completed: {completed}")
    if instruction:
        print(f"  Request: {instruction[:300]}")
    if output:
        print(f"  Result: {output[:300]}")
    print()

if count == 0:
    print("No recent completed missions found.")
else:
    print(f"--- {count} completed missions in the last {'"${HOURS}"'} hours ---")
' 2>/dev/null || echo "No recent sessions found."
