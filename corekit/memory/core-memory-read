#!/usr/bin/env bash
# core-memory-read — query Firestore Core Memory entries
# NOTE: --query performs CLIENT-SIDE filtering since Firestore has no substring/full-text operator.
#
# Usage:
#   core-memory-read --category <category> [--query "<search terms>"] [--status active] [--limit 10] [--agent <name>] [--since <duration>]
#
# Categories: architecture, operations, iam, decisions, patterns, errors
#
# Fleet agents auto-detect via AGENT_ID env var (set by fleet-bootstrap).
# Memory path: primes/{primeId}/fleet/{agent}/memory/core
# Prime path:  primes/{primeId}/memory/core
#
# --since: Time window filter. Accepts durations like 7d, 30d, 90d.
#          When specified, only returns entries created within that window.
#          Useful for broad recent scans vs targeted all-time searches.
#
# Examples:
#   core-memory-read --category architecture
#   core-memory-read --category operations --query "fleet bootstrap"
#   core-memory-read --query "DWD"          # search all categories
#   core-memory-read --since 30d --limit 15  # broad recent scan
#   core-memory-read --category decisions --agent stan  # read fleet agent memory

set -euo pipefail

# ── Parse arguments ──────────────────────────────────────────────
CATEGORY=""
QUERY=""
STATUS="active"
LIMIT=10
AGENT=""
SINCE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --category) CATEGORY="$2"; shift 2 ;;
    --query)    QUERY="$2";    shift 2 ;;
    --status)   STATUS="$2";   shift 2 ;;
    --limit)    LIMIT="$2";    shift 2 ;;
    --agent)    AGENT="$2";    shift 2 ;;
    --since)    SINCE="$2";    shift 2 ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
done

# Auto-detect fleet agent context
if [[ -z "$AGENT" && -n "${AGENT_ID:-}" ]]; then
  AGENT="$AGENT_ID"
fi

# ── Resolve Prime ID ────────────────────────────────────────────
PRIME_ID=$(curl -sf -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime_id" 2>/dev/null || echo "")
if [[ -z "$PRIME_ID" ]]; then
  PRIME_ID=$(hostname | sed 's/^prime-//')
fi

PROJECT_ID=$(curl -sf -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/project/project-id" 2>/dev/null || echo "your-gcp-project")

# ── Get access token ────────────────────────────────────────────
TOKEN=$(curl -sf -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])")

# ── Determine PARENT path ───────────────────────────────────────
if [[ -n "$AGENT" ]]; then
  PARENT="projects/${PROJECT_ID}/databases/(default)/documents/primes/${PRIME_ID}/fleet/${AGENT}"
else
  PARENT="projects/${PROJECT_ID}/databases/(default)/documents/primes/${PRIME_ID}"
fi

# ── Compute --since cutoff timestamp ────────────────────────────
SINCE_TIMESTAMP=""
if [[ -n "$SINCE" ]]; then
  # Parse duration: accept Nd (days) format
  DAYS=$(echo "$SINCE" | sed -n 's/^\([0-9]*\)d$/\1/p')
  if [[ -n "$DAYS" ]]; then
    SINCE_TIMESTAMP=$(date -u -d "-${DAYS} days" +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null \
      || date -u -v-${DAYS}d +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "")
  fi
  if [[ -z "$SINCE_TIMESTAMP" ]]; then
    echo "Warning: could not parse --since '${SINCE}', ignoring time filter" >&2
  fi
fi

# Build structured query
# NOTE: Firestore composite queries on subcollections require indexes.
# When --since is specified, use ONLY createdAt as the Firestore filter
# and apply status/category filtering client-side to avoid silent failures.
CLIENT_STATUS_FILTER=""
CLIENT_CATEGORY_FILTER=""
FILTERS=()
if [[ -n "$SINCE_TIMESTAMP" ]]; then
  # Range filter takes priority — demote equality filters to client-side
  FILTERS+=("{\"fieldFilter\":{\"field\":{\"fieldPath\":\"createdAt\"},\"op\":\"GREATER_THAN_OR_EQUAL\",\"value\":{\"stringValue\":\"${SINCE_TIMESTAMP}\"}}}")
  [[ -n "$STATUS" ]] && CLIENT_STATUS_FILTER="$STATUS"
  [[ -n "$CATEGORY" ]] && CLIENT_CATEGORY_FILTER="$CATEGORY"
else
  if [[ -n "$STATUS" ]]; then
    FILTERS+=("{\"fieldFilter\":{\"field\":{\"fieldPath\":\"status\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"${STATUS}\"}}}")
  fi
  if [[ -n "$CATEGORY" ]]; then
    FILTERS+=("{\"fieldFilter\":{\"field\":{\"fieldPath\":\"category\"},\"op\":\"EQUAL\",\"value\":{\"stringValue\":\"${CATEGORY}\"}}}")
  fi
fi

if [[ ${#FILTERS[@]} -eq 0 ]]; then
  WHERE_CLAUSE=""
elif [[ ${#FILTERS[@]} -eq 1 ]]; then
  WHERE_CLAUSE="\"where\": ${FILTERS[0]},"
else
  JOINED=$(IFS=,; echo "${FILTERS[*]}")
  WHERE_CLAUSE="\"where\": {\"compositeFilter\":{\"op\":\"AND\",\"filters\":[${JOINED}]}},"
fi

QUERY_BODY=$(cat <<EOF
{
  "structuredQuery": {
    "from": [{"collectionId": "core_memory"}],
    ${WHERE_CLAUSE}
    "limit": ${LIMIT}
  }
}
EOF
)

# ── Execute query ───────────────────────────────────────────────
RESPONSE=$(curl -sf \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: application/json" \
  -X POST "https://firestore.googleapis.com/v1/${PARENT}:runQuery" \
  -d "${QUERY_BODY}" 2>&1)

echo "$RESPONSE" | QUERY="$QUERY" CLIENT_STATUS="$CLIENT_STATUS_FILTER" CLIENT_CATEGORY="$CLIENT_CATEGORY_FILTER" python3 -c '
import json, sys, os

try:
    results = json.loads(sys.stdin.read())
except:
    print("No results found.")
    sys.exit(0)

if not isinstance(results, list):
    results = [results]

# Client-side status/category filtering (when --since demoted them from Firestore query)
cs_status = os.environ.get("CLIENT_STATUS", "").strip()
cs_category = os.environ.get("CLIENT_CATEGORY", "").strip()
if cs_status or cs_category:
    filtered = []
    for entry in results:
        doc = entry.get("document")
        if not doc:
            continue
        fields = doc.get("fields", {})
        if cs_status and fields.get("status", {}).get("stringValue", "") != cs_status:
            continue
        if cs_category and fields.get("category", {}).get("stringValue", "") != cs_category:
            continue
        filtered.append(entry)
    results = filtered

# Client-side --query filtering (Firestore has no substring/full-text operator)
query_str = os.environ.get("QUERY", "").strip()
query_terms = query_str.lower().split() if query_str else []

def _num(fields, key, default):
    v = fields.get(key, {})
    try:
        return float(v.get("doubleValue", v.get("integerValue", default)))
    except (TypeError, ValueError):
        return default

# TEMPORAL_MEMORY_AUTHORITY_PLAN P5: value-ranked retrieval. Surface the good stuff first —
# rank by importance x confidence x (1 + term-match); recency (createdAt) breaks ties. Missing
# fields fall back to sensible defaults (importance 0.5, confidence 0.9) so pre-weighting
# entries still rank sanely. B-5: memory earns its place by value.
scored = []
for entry in results:
    doc = entry.get("document")
    if not doc:
        continue
    fields = doc.get("fields", {})
    fact = fields.get("fact", {}).get("stringValue", "").lower()
    tags_arr = fields.get("tags", {}).get("arrayValue", {}).get("values", [])
    tags = " ".join(v.get("stringValue", "") for v in tags_arr).lower()
    searchable = fact + " " + tags
    match_count = sum(1 for t in query_terms if t in searchable) if query_terms else 0
    if query_terms and match_count == 0:
        continue  # a query was given but nothing matched — drop
    importance = _num(fields, "importance", 0.5)
    confidence = _num(fields, "confidence", 0.9)
    entry["_match_count"] = match_count
    entry["_score"] = importance * confidence * (1.0 + match_count)
    scored.append(entry)

results = scored
results.sort(
    key=lambda e: (
        e.get("_score", 0.0),
        e.get("document", {}).get("fields", {}).get("createdAt", {}).get("stringValue", ""),
    ),
    reverse=True,
)

count = 0
for entry in results:
    doc = entry.get("document")
    if not doc:
        continue
    fields = doc.get("fields", {})
    fact = fields.get("fact", {}).get("stringValue", "?")
    cat = fields.get("category", {}).get("stringValue", "?")
    confidence = fields.get("confidence", {}).get("doubleValue", "?")
    source = fields.get("source", {}).get("stringValue", "?")
    created = fields.get("createdAt", {}).get("stringValue", "?")
    status = fields.get("status", {}).get("stringValue", "?")
    doc_id = doc.get("name", "").split("/")[-1]

    count += 1
    print(f"[{cat}] ({doc_id}) {fact}")
    print(f"  confidence: {confidence} | source: {source} | status: {status}")
    print(f"  created: {created}")
    print()

if count == 0:
    print("No core memory entries found.")
else:
    print(f"--- {count} entries ---")
' 2>/dev/null || echo "No results found."
