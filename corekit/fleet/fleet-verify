#!/usr/bin/env bash
# ============================================================
# fleet-verify — Verify a fleet agent is responsive via Chat
#
# Usage: fleet-verify --name <agent-name>
#
# Sends a ping to the fleet agent in Chat and waits for a pong
# response. Updates the fleet registry status on success.
# ============================================================
set -euo pipefail

log() { echo "[$(date -Is)] [fleet-verify] $*"; }
warn() { echo "[$(date -Is)] [fleet-verify] [WARN] $*" >&2; }
die() { echo "[$(date -Is)] [fleet-verify] [FATAL] $*" >&2; exit 1; }

AGENT_NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) AGENT_NAME="$2"; shift 2 ;;
    --help|-h) echo "Usage: fleet-verify --name <agent-name>"; exit 0 ;;
    *) die "Unknown arg: $1" ;;
  esac
done

[[ -n "$AGENT_NAME" ]] || die "Missing --name"

OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
REGISTRY_FILE="${OC_HOST_ROOT}/.openclaw/corekit/fleet-registry.json"
CHAT_SEND="${OC_HOST_ROOT}/.openclaw/bin/chat-send"
CHAT_READ="${OC_HOST_ROOT}/.openclaw/bin/chat-read"

# ---- Read agent info from registry ----
[[ -f "$REGISTRY_FILE" ]] || die "Fleet registry not found: $REGISTRY_FILE"

AGENT_EMAIL="$(jq -r --arg name "$AGENT_NAME" '.agents[$name].agentUserEmail // ""' "$REGISTRY_FILE")"
AGENT_SPACE="$(jq -r --arg name "$AGENT_NAME" '.agents[$name].spaceId // ""' "$REGISTRY_FILE")"

[[ -n "$AGENT_EMAIL" ]] || die "Agent '${AGENT_NAME}' not found in registry or missing agentUserEmail"

# Resolve chat space (agent's space, or Prime's)
CHAT_SPACE_ID="${AGENT_SPACE:-}"
if [[ -z "$CHAT_SPACE_ID" ]]; then
  CHAT_SPACE_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/chat_space_id' 2>/dev/null || true)"
fi
[[ -n "$CHAT_SPACE_ID" ]] || die "No Chat space found for agent or in Prime metadata"

export CHAT_SPACE_ID OC_HOST_ROOT

log "Verifying fleet agent: ${AGENT_NAME}"
log "  Agent Email: ${AGENT_EMAIL}"
log "  Chat Space:  ${CHAT_SPACE_ID}"

# ---- Send ping ----
PING_NONCE="$(openssl rand -hex 4)"
PING_MSG="@${AGENT_EMAIL} ping ${PING_NONCE}"
log "Sending: ${PING_MSG}"
"$CHAT_SEND" "$PING_MSG" || die "Failed to send ping — check Prime's DWD config"

# ---- Wait for pong ----
MAX_WAIT=60
POLL_INTERVAL=5
ELAPSED=0
FOUND=false

log "Waiting up to ${MAX_WAIT}s for pong response..."
while [[ $ELAPSED -lt $MAX_WAIT ]]; do
  sleep "$POLL_INTERVAL"
  ELAPSED=$((ELAPSED + POLL_INTERVAL))

  # Read recent messages — look for pong from the agent's user
  MESSAGES="$("$CHAT_READ" --since "$((ELAPSED + 10))" 2>/dev/null || echo '[]')"
  HAS_PONG="$(echo "$MESSAGES" | python3 -c "
import json, sys
msgs = json.load(sys.stdin)
for m in msgs:
    text = (m.get('text','') or '').lower()
    sender = (m.get('sender','') or '').lower()
    if 'pong' in text and '${PING_NONCE}' in text:
        print('yes')
        break
else:
    print('no')
" 2>/dev/null || echo 'no')"

  if [[ "$HAS_PONG" == "yes" ]]; then
    FOUND=true
    break
  fi
  log "  ...waiting (${ELAPSED}s / ${MAX_WAIT}s)"
done

if [[ "$FOUND" == "true" ]]; then
  log "✅ Fleet agent '${AGENT_NAME}' is ALIVE and responding!"

  # Update registry status
  jq --arg name "$AGENT_NAME" --arg ts "$(date -Is)" \
     '.agents[$name].status = "active" | .agents[$name].verifiedAt = $ts | .lastUpdated = $ts' \
    "$REGISTRY_FILE" > "${REGISTRY_FILE}.tmp" && mv "${REGISTRY_FILE}.tmp" "$REGISTRY_FILE"

  echo
  echo "============================================================"
  echo "  ✅ VERIFIED: ${AGENT_NAME} is active"
  echo "============================================================"
else
  warn "❌ Fleet agent '${AGENT_NAME}' did NOT respond within ${MAX_WAIT}s"
  echo
  echo "============================================================"
  echo "  ❌ VERIFICATION FAILED: ${AGENT_NAME}"
  echo "============================================================"
  echo
  echo "  Troubleshooting checklist:"
  echo "  1. Is the Workspace user '${AGENT_EMAIL}' created?"
  echo "  2. Is '${AGENT_EMAIL}' added to Chat space '${CHAT_SPACE_ID}'?"
  echo "  3. Is DWD granted for the SA Client ID? (Admin Console)"
  echo "  4. Is the VM running?"
  echo "     gcloud compute instances describe fleet-${AGENT_NAME} \\"
  echo "       --zone=\$(jq -r '.agents[\"${AGENT_NAME}\"].zone' ${REGISTRY_FILE}) \\"
  echo "       --project=fleet-${AGENT_NAME}"
  echo "  5. Is message-daemon running on the VM?"
  echo "     gcloud compute ssh fleet-${AGENT_NAME} --command='systemctl status message-daemon'"
  echo
  exit 1
fi
