#!/usr/bin/env bash
# ============================================================
# fleet-status — Read and report fleet agent status from Firestore
#
# Usage:
#   fleet-status                     # all agents
#   fleet-status --name <name>       # single agent detail
#   fleet-status --json              # machine-readable JSON output
#
# Reads from Firestore: primes/{primeId}/fleet/*
# Designed to be called by Prime's execution tools so the agent
# can answer questions like "how's anora doing?" with real data.
#
# Runs on Prime's VM. Uses GCE metadata token for Firestore access.
# ============================================================
set -euo pipefail

# ---- Logging ----
log() { echo "[$(date -Is)] [fleet-status] $*" >&2; }
die() { echo "[$(date -Is)] [fleet-status] [FATAL] $*" >&2; exit 1; }

# ---- Parse args ----
AGENT_NAME=""
JSON_MODE=false
PROBE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) AGENT_NAME="$2"; shift 2 ;;
    --json) JSON_MODE=true; shift ;;
    --probe) PROBE=true; shift ;;
    --help|-h)
      echo "Usage: fleet-status [--name <agent>] [--json] [--probe]"
      echo ""
      echo "  --name    Show detailed status for a specific agent"
      echo "  --json    Output machine-readable JSON"
      echo "  --probe   Read each VM's INSTALLED corekit ref over SSH and compare it"
      echo "            against the ref the registry reports. Slower (one SSH per"
      echo "            agent) and the only way to answer 'what is actually running'."
      echo ""
      echo "Without --name, shows a summary of all fleet agents."
      echo ""
      echo "reportedRef is what the agent last TOLD the registry, written on upgrade."
      echo "It is not proof of what is installed: an agent upgraded by any path that"
      echo "does not report leaves it stale, and it reads exactly like fact. Use"
      echo "--probe when the answer matters."
      exit 0
      ;;
    *) die "Unknown arg: $1" ;;
  esac
done
export FLEET_STATUS_PROBE="$PROBE"

# ---- Resolve project + prime ID ----
PRIME_PROJECT="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || true)"
[[ -n "$PRIME_PROJECT" ]] || die "Cannot resolve project from metadata"

PRIME_ID="${PRIME_ID:-}"
if [[ -z "$PRIME_ID" ]]; then
  PRIME_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime_id' 2>/dev/null || true)"
fi
[[ -n "$PRIME_ID" ]] || die "Cannot resolve PRIME_ID"

FIRESTORE_URL="https://firestore.googleapis.com/v1/projects/${PRIME_PROJECT}/databases/(default)/documents"

# ---- Get auth token ----
TOKEN="$(curl -sH 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
  | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])")"

# ============================================================
# Single agent detail
# ============================================================
if [[ -n "$AGENT_NAME" ]]; then
  RESP="$(curl -s -H "Authorization: Bearer $TOKEN" \
    "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${AGENT_NAME}" 2>/dev/null)"

  # Check for error (document not found)
  if echo "$RESP" | python3 -c "import sys,json; d=json.load(sys.stdin); sys.exit(0 if 'fields' in d else 1)" 2>/dev/null; then
    python3 - <<'PYEOF' "$RESP" "$JSON_MODE" "$AGENT_NAME"
import sys, json
from datetime import datetime, timezone

resp = json.loads(sys.argv[1])
json_mode = sys.argv[2] == "True"
agent_name = sys.argv[3]
fields = resp.get("fields", {})

def fv(f):
    """Extract value from Firestore field."""
    if not f:
        return ""
    for vtype in ("stringValue", "booleanValue", "integerValue"):
        if vtype in f:
            return f[vtype]
    if "arrayValue" in f:
        vals = f["arrayValue"].get("values", [])
        result = []
        for v in vals:
            if "mapValue" in v:
                m = {}
                for k2, v2 in v["mapValue"].get("fields", {}).items():
                    m[k2] = fv(v2)
                result.append(m)
            else:
                result.append(fv(v))
        return result
    if "mapValue" in f:
        m = {}
        for k2, v2 in f["mapValue"].get("fields", {}).items():
            m[k2] = fv(v2)
        return m
    return ""

status = fv(fields.get("status"))
specialty = fv(fields.get("specialty"))
email = fv(fields.get("email"))
vm = fv(fields.get("vm"))
zone = fv(fields.get("zone"))
deployed_at = fv(fields.get("deployedAt"))
deploy_steps = fv(fields.get("deploySteps")) or []
action_required = fv(fields.get("actionRequired")) or None

# Health + liveness. The registry 'status' field is deploy-time and never
# reflects a crash-looping brain — so derive real liveness from the health
# record written by fleet-health-check (brain state + heartbeat freshness).
health = fv(fields.get("health")) or {}
last_heartbeat = fv(fields.get("lastHeartbeat"))
STALE_MIN = 45  # 3 health-check cycles (timer runs every 15 min)

def _heartbeat_age_min(hb):
    if not hb:
        return None
    try:
        t = datetime.fromisoformat(str(hb).replace("Z", "+00:00"))
        return (datetime.now(timezone.utc) - t).total_seconds() / 60.0
    except Exception:
        return None

hb_age = _heartbeat_age_min(last_heartbeat)
brain_state = health.get("brainState", "")
health_status = health.get("status", "")
degraded = health.get("degraded", "")

if not health_status:
    live, liveness = None, "no health data yet"
elif health_status == "healthy" and (hb_age is None or hb_age <= STALE_MIN):
    live, liveness = True, "healthy"
elif brain_state and brain_state != "active":
    live, liveness = False, "brain %s" % brain_state
elif hb_age is not None and hb_age > STALE_MIN:
    live, liveness = False, "no heartbeat for %dm" % int(hb_age)
else:
    live, liveness = False, (degraded or "unhealthy")

if json_mode:
    print(json.dumps({
        "agent": agent_name,
        "status": status,
        "live": live,
        "liveness": liveness,
        "health": health or None,
        "lastHeartbeat": last_heartbeat,
        "specialty": specialty,
        "email": email,
        "vm": vm,
        "zone": zone,
        "deployedAt": deployed_at,
        "deploySteps": deploy_steps,
        "actionRequired": action_required,
        "reportedRef": fv(fields.get("coreRef")) or None,
        "reportedRefAt": fv(fields.get("updatedAt")) or None,
    }, indent=2))
else:
    live_icon = {True: "🟢 LIVE", False: "🔴 DOWN", None: "⚪ UNKNOWN"}[live]
    print(f"\n{'='*50}")
    print(f"  FLEET AGENT: {agent_name}")
    print(f"{'='*50}")
    print(f"  Status     : {status}  (registry / deploy-time)")
    print(f"  Liveness   : {live_icon} — {liveness}")
    if health:
        hb = f"{int(hb_age)}m ago" if hb_age is not None else "never"
        print(f"  Services   : brain={brain_state or '?'}  gateway={health.get('gatewayHttp','?')}  ears={health.get('earsState','?')}  mouth={health.get('mouthState','?')}")
        print(f"  Heartbeat  : {hb}  (last healthy check)")
        if health.get("lastRecoveryMethod"):
            print(f"  Recovery   : {health.get('lastRecoveryMethod')} → {health.get('lastRecoveryResult','?')} @ {health.get('lastRecoveryAttempt','?')}")
    print(f"  Specialty  : {specialty}")
    print(f"  Email      : {email}")
    print(f"  VM         : {vm}")
    print(f"  Zone       : {zone}")
    print(f"  Deployed   : {deployed_at}")
    _rr = fv(fields.get("coreRef")) or ""
    _ra = fv(fields.get("updatedAt")) or "never"
    print(f"  Reported   : {(_rr[:12] or 'UNREPORTED')}  (told to the registry {_ra} — NOT proof of what is installed)")
    print(f"               run `fleet-status --probe` to read the VM's installed ref")

    if deploy_steps:
        print(f"\n  Deploy Progress:")
        for step in deploy_steps:
            if isinstance(step, dict):
                sid = step.get("id", "?")
                label = step.get("label", sid)
                sstatus = step.get("status", "?")
                ts = step.get("timestamp", "")
                detail = step.get("detail", "")
                icon = {"done": "✅", "active": "⏳", "failed": "❌", "pending": "⬜", "skipped": "⏭️"}.get(sstatus, "❓")
                line = f"    {icon}  {label}"
                if detail:
                    line += f" — {detail}"
                if ts:
                    line += f"  ({ts})"
                print(line)

    if action_required and isinstance(action_required, dict):
        title = action_required.get("title", "Action needed")
        instructions = action_required.get("instructions", [])
        print(f"\n  ⚠️  ACTION REQUIRED: {title}")
        if isinstance(instructions, list):
            for i, inst in enumerate(instructions, 1):
                print(f"    {i}. {inst}")
        elif isinstance(instructions, str):
            print(f"    {instructions}")

    print(f"{'='*50}\n")
PYEOF
  else
    if $JSON_MODE; then
      echo "{\"error\": \"Agent '${AGENT_NAME}' not found\"}"
    else
      echo "Agent '${AGENT_NAME}' not found in fleet registry."
    fi
    exit 1
  fi
  exit 0
fi

# ============================================================
# All agents summary
# ============================================================
RESP="$(curl -s -H "Authorization: Bearer $TOKEN" \
  "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet" 2>/dev/null)"

python3 - <<'PYEOF' "$RESP" "$JSON_MODE" "$PRIME_PROJECT"
import sys, json, os

resp = json.loads(sys.argv[1])
json_mode = sys.argv[2] == "True"
project = sys.argv[3]
docs = resp.get("documents", [])

def fv(f):
    if not f:
        return ""
    for vtype in ("stringValue", "booleanValue", "integerValue"):
        if vtype in f:
            return f[vtype]
    if "arrayValue" in f:
        vals = f["arrayValue"].get("values", [])
        result = []
        for v in vals:
            if "mapValue" in v:
                m = {}
                for k2, v2 in v["mapValue"].get("fields", {}).items():
                    m[k2] = fv(v2)
                result.append(m)
            else:
                result.append(fv(v))
        return result
    if "mapValue" in f:
        m = {}
        for k2, v2 in f["mapValue"].get("fields", {}).items():
            m[k2] = fv(v2)
        return m
    return ""

def derive_live(status, health):
    """Real liveness from the health record, not the deploy-time status field.
    Returns True (live), False (down), or None (no health data yet)."""
    hs = (health or {}).get("status", "")
    bs = (health or {}).get("brainState", "")
    if not hs:
        return None
    if hs == "healthy":
        return True
    return False

agents = []
for doc in docs:
    name = doc.get("name", "").split("/")[-1]
    fields = doc.get("fields", {})
    health = fv(fields.get("health")) or {}
    status = fv(fields.get("status"))
    agents.append({
        "name": name,
        "status": status,
        "live": derive_live(status, health),
        "brainState": health.get("brainState", ""),
        "degraded": health.get("degraded", ""),
        "health": health or None,
        "lastHeartbeat": fv(fields.get("lastHeartbeat")),
        "specialty": fv(fields.get("specialty")),
        "email": fv(fields.get("email")),
        "vm": fv(fields.get("vm")),
        "zone": fv(fields.get("zone")),
        "deployedAt": fv(fields.get("deployedAt")),
        "deploySteps": fv(fields.get("deploySteps")) or [],
        "actionRequired": fv(fields.get("actionRequired")) or None,
        # What the agent last TOLD the registry. Named `reportedRef`, not
        # `coreRef`, because the field is written on upgrade and by nothing else:
        # an agent upgraded by any path that does not report leaves it stale while
        # it still reads as fact. A fleet-health mission compared this value to
        # itself, found no disagreement, and reported "zero drift" across a fleet
        # where every agent had drifted. The name now says which question it answers.
        "reportedRef": fv(fields.get("coreRef")) or None,
        "reportedRefAt": fv(fields.get("updatedAt")) or None,
    })

# ---- --probe: ground truth, read from the VM itself ----
# The registry is a report; STATE.json is the install. Only this can tell them
# apart, and until it existed a Prime asked to compare them had no mechanism at
# all — motor said so, correctly, and was overruled by a synthesised answer.
if os.environ.get("FLEET_STATUS_PROBE") == "true":
    import subprocess
    for a in agents:
        vm, zone = a.get("vm"), a.get("zone")
        if not vm or not zone:
            a["installedRef"], a["refDrift"] = None, None
            a["probeError"] = "no vm/zone in registry"
            continue
        try:
            out = subprocess.run(
                ["gcloud", "compute", "ssh", vm, f"--zone={zone}", f"--project={project}",
                 "--tunnel-through-iap", "--ssh-flag=-oConnectTimeout=15", "--command",
                 "sudo sed -n 's/.*\"coreRef\": *\"\\([^\"]*\\)\".*/\\1/p' "
                 "/opt/corekit/corekit/STATE.json | head -1"],
                capture_output=True, text=True, timeout=90,
            )
            ref = (out.stdout or "").strip().splitlines()
            ref = ref[-1].strip() if ref else ""
            if not ref:
                a["installedRef"], a["refDrift"] = None, None
                a["probeError"] = (out.stderr or "no coreRef in STATE.json").strip()[:160]
            else:
                a["installedRef"] = ref
                rep = a.get("reportedRef") or ""
                # Unreported is drift too: "we do not know" is not "they agree".
                a["refDrift"] = (not rep) or (not ref.startswith(rep[:12]))
        except Exception as e:
            a["installedRef"], a["refDrift"] = None, None
            a["probeError"] = f"{type(e).__name__}: {e}"[:160]

if json_mode:
    print(json.dumps({"agents": agents, "count": len(agents)}, indent=2))
else:
    if not agents:
        print("\nNo fleet agents deployed.\n")
    else:
        print(f"\n{'='*60}")
        print(f"  FLEET STATUS — {len(agents)} agent(s)")
        print(f"{'='*60}")
        for a in agents:
            status_icon = {
                "online": "🟢", "offline": "🔴", "deploying": "🟡",
                "needs_action": "🟠", "tearing_down": "🔵", "error": "❌",
            }.get(a["status"], "❓")
            steps = a.get("deploySteps", [])
            done_count = sum(1 for s in steps if isinstance(s, dict) and s.get("status") == "done")
            total_count = len(steps)
            progress = f"  [{done_count}/{total_count}]" if total_count > 0 and a["status"] in ("deploying", "needs_action") else ""

            # Liveness marker — flags the registry-online-but-brain-dead case
            # that a deploy-time status alone hides.
            live = a.get("live")
            if live is False:
                reason = a.get("degraded") or (f"brain {a['brainState']}" if a.get("brainState") else "unhealthy")
                live_note = f"  🔴 DOWN ({reason})"
            elif live is None:
                live_note = "  ⚪ (no health data)"
            else:
                live_note = ""

            print(f"  {status_icon}  {a['name']:12s}  {a['specialty']:10s}  {a['status']}{progress}{live_note}")

            # Refs, always labelled by which question they answer. Never print a
            # single "version" column: that is the shape that let a comparison be
            # made against itself and reported as agreement.
            rep = (a.get("reportedRef") or "")[:12] or "UNREPORTED"
            if a.get("installedRef") or a.get("probeError"):
                inst = (a.get("installedRef") or "")[:12] or "?"
                if a.get("probeError"):
                    print(f"       ref: reported {rep} · installed UNKNOWN — probe failed: {a['probeError']}")
                elif a.get("refDrift"):
                    print(f"       ref: reported {rep} · installed {inst}  ⚠️  DRIFT")
                else:
                    print(f"       ref: reported {rep} · installed {inst}  ✅ match")
            else:
                print(f"       ref: reported {rep}  (unverified — use --probe)")

            # Show action required if any
            ar = a.get("actionRequired")
            if ar and isinstance(ar, dict):
                print(f"       ⚠️  {ar.get('title', 'Action needed')}")

        print(f"{'='*60}\n")
PYEOF
