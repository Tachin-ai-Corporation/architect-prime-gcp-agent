#!/usr/bin/env bash
# ============================================================
# fleet-health-check — Check fleet agent gateway health via SSH
#
# Usage:
#   fleet-health-check                  # check all online agents
#   fleet-health-check --name <agent>   # check one agent
#
# For each online fleet agent:
#   1. SSH into VM and curl the gateway health endpoint
#   2. Write health data to Firestore
#   3. If 3+ consecutive failures: auto-restart gateway
#
# Runs on Prime VM via systemd timer (every 15 minutes).
# ============================================================
set -euo pipefail

log() { echo "[$(date -Is)] [fleet-health-check] $*"; }
warn() { echo "[$(date -Is)] [fleet-health-check] [WARN] $*" >&2; }
die() { echo "[$(date -Is)] [fleet-health-check] [FATAL] $*" >&2; exit 1; }

AGENT_NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) AGENT_NAME="$2"; shift 2 ;;
    --help|-h) echo "Usage: fleet-health-check [--name <agent>]"; exit 0 ;;
    *) die "Unknown arg: $1" ;;
  esac
done

# ---- Resolve project + prime ID ----
PRIME_PROJECT="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || true)"
[[ -n "$PRIME_PROJECT" ]] || die "Cannot resolve project from metadata"

PRIME_ID="${PRIME_ID:-}"
if [[ -z "$PRIME_ID" ]]; then
  PRIME_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime_id' 2>/dev/null || true)"
fi
[[ -n "$PRIME_ID" ]] || die "Cannot resolve PRIME_ID"

FIRESTORE_URL="https://firestore.googleapis.com/v1/projects/${PRIME_PROJECT}/databases/(default)/documents"

# ---- Get auth token ----
get_token() {
  curl -sH 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
    | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])"
}

TOKEN="$(get_token)"

# ============================================================
# Get list of agents to check
# ============================================================
if [[ -n "$AGENT_NAME" ]]; then
  # Single agent mode
  AGENTS_JSON="[{\"name\":\"${AGENT_NAME}\",\"vm\":\"fleet-${AGENT_NAME}\",\"zone\":\"us-central1-a\"}]"
else
  # All agents — read from Firestore
  RESP="$(curl -s -H "Authorization: Bearer $TOKEN" \
    "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet" 2>/dev/null)"

  AGENTS_JSON="$(echo "$RESP" | python3 -c "
import json, sys
resp = json.loads(sys.stdin.read())
docs = resp.get('documents', [])
agents = []
for doc in docs:
    name = doc.get('name', '').split('/')[-1]
    fields = doc.get('fields', {})
    status = ''
    for k in ('stringValue',):
        if k in (fields.get('status') or {}):
            status = fields['status'][k]
    vm = ''
    for k in ('stringValue',):
        if k in (fields.get('vm') or {}):
            vm = fields['vm'][k]
    zone = ''
    for k in ('stringValue',):
        if k in (fields.get('zone') or {}):
            zone = fields['zone'][k]
    if status == 'online':
        agents.append({'name': name, 'vm': vm, 'zone': zone})
print(json.dumps(agents))
" 2>/dev/null || echo "[]")"
fi

AGENT_COUNT="$(echo "$AGENTS_JSON" | python3 -c "import json,sys; print(len(json.load(sys.stdin)))")"

if [[ "$AGENT_COUNT" == "0" ]]; then
  log "No online fleet agents to check."
  exit 0
fi

log "Checking ${AGENT_COUNT} fleet agent(s)..."

# ============================================================
# Check each agent
# ============================================================
echo "$AGENTS_JSON" | python3 -c "
import json, sys
for a in json.load(sys.stdin):
    print(f\"{a['name']}|{a.get('vm','')}|{a.get('zone','')}\")
" | while IFS='|' read -r NAME VM ZONE; do
  log "Checking: ${NAME} (VM: ${VM}, Zone: ${ZONE})"

  # If single-agent mode and we don't have VM/zone, fetch from Firestore
  if [[ -z "$VM" || -z "$ZONE" ]]; then
    AGENT_DOC="$(curl -s -H "Authorization: Bearer $TOKEN" \
      "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${NAME}" 2>/dev/null)"
    VM="$(echo "$AGENT_DOC" | python3 -c "
import json,sys
d=json.load(sys.stdin)
print(d.get('fields',{}).get('vm',{}).get('stringValue',''))" 2>/dev/null || true)"
    ZONE="$(echo "$AGENT_DOC" | python3 -c "
import json,sys
d=json.load(sys.stdin)
print(d.get('fields',{}).get('zone',{}).get('stringValue',''))" 2>/dev/null || true)"
  fi

  if [[ -z "$VM" || -z "$ZONE" ]]; then
    warn "Cannot resolve VM/zone for ${NAME} — skipping"
    continue
  fi

  # ---- SSH and probe ALL core services, not just the gateway ----
  # A fleet agent with a live gateway but a dead agent-brain is completely
  # incapacitated (it cannot process any work) yet the old gateway-only probe
  # reported it "healthy". We now check the brain (the loop owner) plus ears and
  # mouth. Health is "healthy" only when the gateway responds AND the brain is
  # active. One SSH call; no pipes/quotes in the remote command so it survives
  # gcloud arg handling. Remote $() is preserved (single-quoted at assignment)
  # and expands on the fleet VM.
  HEALTH_STATUS="unhealthy"
  LATENCY_MS=0
  START_MS=$(date +%s%N)

  REMOTE_PROBE='echo GW=$(curl -s -o /dev/null -w %{http_code} --max-time 10 http://localhost:18789/v1/models); echo BR=$(systemctl is-active agent-brain); echo EA=$(systemctl is-active agent-ears); echo MO=$(systemctl is-active agent-mouth)'
  PROBE="$(gcloud compute ssh "$VM" --zone="$ZONE" --project="$PRIME_PROJECT" --quiet \
    --command="$REMOTE_PROBE" 2>/dev/null)" || true

  # Parse each service token; default to unknown/000 on missing lines.
  HTTP_CODE="$(echo "$PROBE" | sed -n 's/^GW=//p' | grep -oE '[0-9]+' | tail -1)"; HTTP_CODE="${HTTP_CODE:-000}"
  BRAIN_STATE="$(echo "$PROBE" | sed -n 's/^BR=//p' | tr -d '[:space:]')"; BRAIN_STATE="${BRAIN_STATE:-unknown}"
  EARS_STATE="$(echo "$PROBE" | sed -n 's/^EA=//p' | tr -d '[:space:]')"; EARS_STATE="${EARS_STATE:-unknown}"
  MOUTH_STATE="$(echo "$PROBE" | sed -n 's/^MO=//p' | tr -d '[:space:]')"; MOUTH_STATE="${MOUTH_STATE:-unknown}"

  END_MS=$(date +%s%N)
  LATENCY_MS=$(( (END_MS - START_MS) / 1000000 ))

  GATEWAY_OK=false
  [[ "$HTTP_CODE" == "200" || "$HTTP_CODE" == "401" ]] && GATEWAY_OK=true
  BRAIN_OK=false
  [[ "$BRAIN_STATE" == "active" ]] && BRAIN_OK=true

  # Build a human-readable degraded reason for the dashboard + operator.
  DEGRADED=""
  $GATEWAY_OK || DEGRADED="${DEGRADED}gateway(${HTTP_CODE}) "
  $BRAIN_OK   || DEGRADED="${DEGRADED}brain(${BRAIN_STATE}) "
  [[ "$EARS_STATE"  == "active" ]] || DEGRADED="${DEGRADED}ears(${EARS_STATE}) "
  [[ "$MOUTH_STATE" == "active" ]] || DEGRADED="${DEGRADED}mouth(${MOUTH_STATE}) "
  DEGRADED="$(echo "$DEGRADED" | sed 's/[[:space:]]*$//')"

  # Healthy requires the loop owner (brain) AND the gateway it consults.
  if $GATEWAY_OK && $BRAIN_OK; then
    HEALTH_STATUS="healthy"
  fi

  # If the brain is down, grab its recent journal to distinguish a transient
  # crash (a restart fixes it) from version drift / a missing module (only a
  # redeploy fixes it). Grep runs locally on Prime to avoid remote quoting.
  NEEDS_REDEPLOY=false
  if ! $BRAIN_OK; then
    BRAIN_LOG="$(gcloud compute ssh "$VM" --zone="$ZONE" --project="$PRIME_PROJECT" --quiet \
      --command='journalctl -u agent-brain -n 40 --no-pager' 2>/dev/null)" || true
    if echo "$BRAIN_LOG" | grep -qE 'ERR_MODULE_NOT_FOUND|Cannot find module'; then
      NEEDS_REDEPLOY=true
    fi
  fi

  log "  Result: ${HEALTH_STATUS} (gateway ${HTTP_CODE}, brain ${BRAIN_STATE}, ears ${EARS_STATE}, mouth ${MOUTH_STATE}, ${LATENCY_MS}ms)${DEGRADED:+ — degraded: ${DEGRADED}}"

  # ---- Read current consecutive failures from Firestore ----
  CURRENT_FAILURES="$(curl -s -H "Authorization: Bearer $TOKEN" \
    "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${NAME}" 2>/dev/null | python3 -c "
import json,sys
d = json.load(sys.stdin)
health = d.get('fields',{}).get('health',{}).get('mapValue',{}).get('fields',{})
cf = health.get('consecutiveFailures',{}).get('integerValue','0')
print(cf)
" 2>/dev/null || echo "0")"

  # ---- Calculate new failure count ----
  if [[ "$HEALTH_STATUS" == "healthy" ]]; then
    NEW_FAILURES=0
  else
    NEW_FAILURES=$((CURRENT_FAILURES + 1))
  fi

  # ---- Write health data to Firestore ----
  NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  TOKEN="$(get_token)"  # refresh token

  # Per-service health fields — the dashboard and fleet-status render these so a
  # dead brain is visible even when the VM/gateway is up.
  HEALTH_INNER="\"lastCheck\": { \"stringValue\": \"${NOW}\" },
            \"status\": { \"stringValue\": \"${HEALTH_STATUS}\" },
            \"latencyMs\": { \"integerValue\": \"${LATENCY_MS}\" },
            \"consecutiveFailures\": { \"integerValue\": \"${NEW_FAILURES}\" },
            \"httpCode\": { \"stringValue\": \"${HTTP_CODE}\" },
            \"gatewayHttp\": { \"stringValue\": \"${HTTP_CODE}\" },
            \"brainState\": { \"stringValue\": \"${BRAIN_STATE}\" },
            \"earsState\": { \"stringValue\": \"${EARS_STATE}\" },
            \"mouthState\": { \"stringValue\": \"${MOUTH_STATE}\" },
            \"degraded\": { \"stringValue\": \"${DEGRADED}\" }"

  # lastHeartbeat advances only on a fully healthy check (brain + gateway), so
  # staleness is a true liveness signal for the brain, not just the VM.
  if [[ "$HEALTH_STATUS" == "healthy" ]]; then
    HEALTH_PATCH="{ \"fields\": { \"health\": { \"mapValue\": { \"fields\": { ${HEALTH_INNER} } } }, \"lastHeartbeat\": { \"stringValue\": \"${NOW}\" } } }"
    MASK="updateMask.fieldPaths=health&updateMask.fieldPaths=lastHeartbeat"
  else
    HEALTH_PATCH="{ \"fields\": { \"health\": { \"mapValue\": { \"fields\": { ${HEALTH_INNER} } } } } }"
    MASK="updateMask.fieldPaths=health"
  fi

  curl -s -X PATCH \
    -H "Authorization: Bearer $TOKEN" \
    -H "Content-Type: application/json" \
    -d "$HEALTH_PATCH" \
    "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${NAME}?${MASK}" \
    >/dev/null 2>&1

  # ---- Auto-recovery: Prime self-heals after 3+ consecutive failures ----
  # Prime is the factory operator (C-1, B-26): when a fleet agent is down, it
  # fixes it rather than merely reporting it. The recovery METHOD depends on the
  # cause — a restart cannot fix a missing module, only a redeploy can:
  #   * brain down + version drift (ERR_MODULE_NOT_FOUND) → fleet-upgrade (redeploy)
  #   * brain down (transient)                            → restart agent-brain
  #   * gateway down only                                 → restart gateway
  # We reset consecutiveFailures after any attempt so recovery (especially a
  # multi-minute redeploy) is not re-triggered every cycle (anti-flap).
  if [[ "$NEW_FAILURES" -ge 3 ]]; then
    RECOVERY_METHOD="none"
    RECOVERY_OK=false

    if ! $BRAIN_OK && $NEEDS_REDEPLOY; then
      RECOVERY_METHOD="redeploy"
      log "  ⚠️  ${NAME}: brain down with version drift (missing module) — redeploying via fleet-upgrade..."
      if [[ -x "${CORE_DIR}/bin/fleet-upgrade" ]]; then
        if PRIME_ID="$PRIME_ID" "${CORE_DIR}/bin/fleet-upgrade" --name "$NAME" >/dev/null 2>&1; then
          RECOVERY_OK=true
        fi
      else
        warn "  fleet-upgrade not found at ${CORE_DIR}/bin — cannot redeploy ${NAME}"
      fi
      $RECOVERY_OK && log "  ✅ ${NAME} redeployed via fleet-upgrade" || warn "  ❌ Redeploy of ${NAME} failed — escalating to operator"

    elif ! $BRAIN_OK; then
      RECOVERY_METHOD="restart_brain"
      log "  ⚠️  ${NAME}: brain down (transient) — restarting agent-brain..."
      if gcloud compute ssh "$VM" --zone="$ZONE" --project="$PRIME_PROJECT" --quiet \
          --command="sudo systemctl restart agent-brain 2>/dev/null && echo OK" 2>/dev/null | grep -q "OK"; then
        RECOVERY_OK=true
      fi
      $RECOVERY_OK && log "  ✅ agent-brain restarted for ${NAME}" || warn "  ❌ Failed to restart agent-brain for ${NAME}"

    else
      RECOVERY_METHOD="restart_gateway"
      log "  ⚠️  ${NAME}: gateway unhealthy — restarting agent-neural-gateway..."
      if gcloud compute ssh "$VM" --zone="$ZONE" --project="$PRIME_PROJECT" --quiet \
          --command="sudo systemctl restart agent-neural-gateway 2>/dev/null && echo OK" 2>/dev/null | grep -q "OK"; then
        RECOVERY_OK=true
      fi
      $RECOVERY_OK && log "  ✅ Gateway restarted for ${NAME}" || warn "  ❌ Failed to restart gateway for ${NAME}"
    fi

    # Reset the failure counter after an attempt so a slow redeploy isn't
    # hammered every cycle; the next check re-evaluates from a clean slate.
    RECOVERY_RESULT="$($RECOVERY_OK && echo success || echo failed)"
    NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    TOKEN="$(get_token)"
    RECOVERY_PATCH="{ \"fields\": { \"health\": { \"mapValue\": { \"fields\": {
              \"lastCheck\": { \"stringValue\": \"${NOW}\" },
              \"status\": { \"stringValue\": \"${HEALTH_STATUS}\" },
              \"consecutiveFailures\": { \"integerValue\": \"0\" },
              \"degraded\": { \"stringValue\": \"${DEGRADED}\" },
              \"brainState\": { \"stringValue\": \"${BRAIN_STATE}\" },
              \"lastRecoveryAttempt\": { \"stringValue\": \"${NOW}\" },
              \"lastRecoveryMethod\": { \"stringValue\": \"${RECOVERY_METHOD}\" },
              \"lastRecoveryResult\": { \"stringValue\": \"${RECOVERY_RESULT}\" }
    } } } } }"
    curl -s -X PATCH \
      -H "Authorization: Bearer $TOKEN" \
      -H "Content-Type: application/json" \
      -d "$RECOVERY_PATCH" \
      "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${NAME}?updateMask.fieldPaths=health" \
      >/dev/null 2>&1

    # Escalate to the operator only when self-healing failed — surfaced via the
    # fleet doc's actionRequired, which the dashboard already renders.
    if ! $RECOVERY_OK; then
      ACTION_PATCH="{ \"fields\": { \"actionRequired\": { \"mapValue\": { \"fields\": {
                \"title\": { \"stringValue\": \"${NAME} is down — auto-recovery failed\" },
                \"detail\": { \"stringValue\": \"degraded: ${DEGRADED}; tried ${RECOVERY_METHOD}\" },
                \"raisedAt\": { \"stringValue\": \"${NOW}\" }
      } } } } }"
      TOKEN="$(get_token)"
      curl -s -X PATCH \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json" \
        -d "$ACTION_PATCH" \
        "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${NAME}?updateMask.fieldPaths=actionRequired" \
        >/dev/null 2>&1
    fi
  fi

  # ---- OU Compliance Check ----
  # Check if agent is in the "AI Agents" OU (Drive sharing restricted)
  CORE_BIN="/opt/corekit/bin"
  if [[ -x "${CORE_BIN}/agent-ou-manage" ]]; then
    # Get agent email from Firestore doc
    AGENT_EMAIL="$(curl -s -H "Authorization: Bearer $TOKEN" \
      "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${NAME}" 2>/dev/null | python3 -c "
import json,sys
d=json.load(sys.stdin)
print(d.get('fields',{}).get('email',{}).get('stringValue',''))" 2>/dev/null || true)"

    if [[ -n "$AGENT_EMAIL" ]]; then
      AGENT_OU="$(CORE_ROOT="/opt/corekit" "${CORE_BIN}/agent-ou-manage" --check "$AGENT_EMAIL" 2>/dev/null || echo "UNKNOWN")"
      OU_COMPLIANT="false"
      if [[ "$AGENT_OU" == "/AI Agents" ]]; then
        OU_COMPLIANT="true"
      elif [[ "$AGENT_OU" != "UNKNOWN" && "$AGENT_OU" != "NOT_FOUND" ]]; then
        # Not in correct OU — attempt auto-move
        log "  ⚠️  ${NAME} (${AGENT_EMAIL}) not in AI Agents OU (currently: ${AGENT_OU}) — attempting move..."
        CORE_ROOT="/opt/corekit" "${CORE_BIN}/agent-ou-manage" --move "$AGENT_EMAIL" 2>/dev/null || true
        # Re-check
        AGENT_OU="$(CORE_ROOT="/opt/corekit" "${CORE_BIN}/agent-ou-manage" --check "$AGENT_EMAIL" 2>/dev/null || echo "UNKNOWN")"
        [[ "$AGENT_OU" == "/AI Agents" ]] && OU_COMPLIANT="true"
      fi

      # Write OU compliance to Firestore
      TOKEN="$(get_token)"
      OU_PATCH="{
        \"fields\": {
          \"ouCompliant\": { \"booleanValue\": ${OU_COMPLIANT} },
          \"ouPath\": { \"stringValue\": \"${AGENT_OU}\" },
          \"ouCheckedAt\": { \"stringValue\": \"${NOW}\" }
        }
      }"
      curl -s -X PATCH \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json" \
        -d "$OU_PATCH" \
        "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${NAME}?updateMask.fieldPaths=ouCompliant&updateMask.fieldPaths=ouPath&updateMask.fieldPaths=ouCheckedAt" \
        >/dev/null 2>&1

      if [[ "$OU_COMPLIANT" == "true" ]]; then
        log "  OU: ${AGENT_EMAIL} → AI Agents ✓"
      else
        warn "  OU: ${AGENT_EMAIL} → ${AGENT_OU} — ⚠️ NOT COMPLIANT (can share externally)"
      fi
    fi
  fi
done

log "Health check complete."
