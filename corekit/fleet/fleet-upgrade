#!/usr/bin/env bash
# ============================================================
# fleet-upgrade — Upgrade a fleet agent's CoreKit to a new ref
#
# Usage: fleet-upgrade --name <agent-name> [--ref <core-ref>]
#
# SSHs into the fleet agent's VM and runs upgrade-corekit,
# then restarts the gateway and ears/mouth services.
# ============================================================
set -euo pipefail

log() { echo "[$(date -Is)] [fleet-upgrade] $*"; }
warn() { echo "[$(date -Is)] [fleet-upgrade] [WARN] $*" >&2; }
die() { echo "[$(date -Is)] [fleet-upgrade] [FATAL] $*" >&2; exit 1; }

AGENT_NAME=""
TARGET_REF=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) AGENT_NAME="$2"; shift 2 ;;
    --ref) TARGET_REF="$2"; shift 2 ;;
    --help|-h) echo "Usage: fleet-upgrade --name <agent-name> [--ref <core-ref>]"; exit 0 ;;
    *) die "Unknown arg: $1" ;;
  esac
done

[[ -n "$AGENT_NAME" ]] || die "Missing --name"

CORE_DIR="${CORE_DIR:-/opt/corekit}"
REGISTRY_FILE="${CORE_DIR}/corekit/fleet-registry.json"
CHAT_SEND="${CORE_DIR}/bin/chat-send"

# Single-project mode: fleet VMs are in Prime's project
PRIME_PROJECT="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || true)"
[[ -n "$PRIME_PROJECT" ]] || die "Cannot resolve PRIME_PROJECT from metadata"

FLEET_PROJECT="${PRIME_PROJECT}"
FLEET_VM="fleet-${AGENT_NAME}"

# Prime ID for Firestore operations
PRIME_ID="${PRIME_ID:-}"
if [[ -z "$PRIME_ID" ]]; then
  PRIME_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime_id' 2>/dev/null || true)"
fi
FIRESTORE_URL="https://firestore.googleapis.com/v1/projects/${FLEET_PROJECT}/databases/(default)/documents"

# Resolve zone from registry or default
FLEET_ZONE="us-central1-a"
CURRENT_REF="unknown"
if [[ -f "$REGISTRY_FILE" ]]; then
  REG_ZONE="$(jq -r --arg name "$AGENT_NAME" '.agents[$name].zone // ""' "$REGISTRY_FILE" 2>/dev/null || true)"
  [[ -n "$REG_ZONE" ]] && FLEET_ZONE="$REG_ZONE"
  
  REG_REF="$(jq -r --arg name "$AGENT_NAME" '.agents[$name].coreRef // ""' "$REGISTRY_FILE" 2>/dev/null || true)"
  [[ -n "$REG_REF" ]] && CURRENT_REF="$REG_REF"
fi

# Default to Prime's current ref if not specified
if [[ -z "$TARGET_REF" ]]; then
  STATE_FILE="${CORE_DIR}/corekit/STATE.json"
  if [[ -f "$STATE_FILE" ]]; then
    TARGET_REF="$(jq -r '.coreRef // "main"' "$STATE_FILE" 2>/dev/null)"
  fi
  [[ -n "$TARGET_REF" ]] || TARGET_REF="main"
fi

log "Upgrading fleet agent: ${AGENT_NAME}"
log "  Project:     ${FLEET_PROJECT}"
log "  VM:          ${FLEET_VM}"
log "  Zone:        ${FLEET_ZONE}"
log "  Current ref: ${CURRENT_REF}"
log "  Target ref:  ${TARGET_REF}"

if [[ "$CURRENT_REF" == "$TARGET_REF" ]]; then
  log "Agent is already on ref '${TARGET_REF}' — upgrade anyway"
fi

# Resolve GH_OWNER and GH_REPO from env or GCE metadata (or fallback)
OWNER="${GH_OWNER:-}"
REPO="${GH_REPO:-}"
if [[ -z "$OWNER" || -z "$REPO" ]]; then
  # Fallback to local STATE.json or env
  STATE_FILE="${CORE_DIR}/corekit/STATE.json"
  if [[ -f "$STATE_FILE" ]]; then
    [[ -z "$OWNER" ]] && OWNER="$(jq -r '.owner // ""' "$STATE_FILE" 2>/dev/null)"
    [[ -z "$REPO" ]] && REPO="$(jq -r '.repo // ""' "$STATE_FILE" 2>/dev/null)"
  fi
fi

# ---- SSH and upgrade ----
log "SSHing into ${FLEET_VM} to run upgrade..."
UPGRADE_CMD="sudo curl -fsSL 'https://raw.githubusercontent.com/${OWNER}/${REPO}/${TARGET_REF}/corekit/system/upgrade-corekit' -o /opt/corekit/bin/upgrade-corekit && sudo chmod +x /opt/corekit/bin/upgrade-corekit && sudo GH_OWNER='${OWNER}' GH_REPO='${REPO}' CORE_REF='${TARGET_REF}' CORE_DIR=/opt/corekit /opt/corekit/bin/upgrade-corekit --apply '${TARGET_REF}' && echo 'UPGRADE_SUCCESS'"

RESULT="$(gcloud compute ssh "$FLEET_VM" \
  --zone="$FLEET_ZONE" \
  --project="$FLEET_PROJECT" \
  --command="$UPGRADE_CMD" \
  --quiet 2>&1)" || true

if echo "$RESULT" | grep -q "UPGRADE_SUCCESS"; then
  log "✅ Upgrade successful!"

  # Update local registry if it exists
  if [[ -f "$REGISTRY_FILE" ]]; then
    jq --arg name "$AGENT_NAME" --arg ref "$TARGET_REF" --arg ts "$(date -Is)" \
       '.agents[$name].coreRef = $ref | .agents[$name].upgradedAt = $ts | .lastUpdated = $ts' \
      "$REGISTRY_FILE" > "${REGISTRY_FILE}.tmp" && mv "${REGISTRY_FILE}.tmp" "$REGISTRY_FILE"
  fi

  # Update Firestore so dashboard sees the new version
  if [[ -n "$PRIME_ID" ]]; then
    TOKEN="$(curl -sH 'Metadata-Flavor: Google' \
      'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
      | python3 -c 'import sys,json; print(json.load(sys.stdin).get("access_token",""))' 2>/dev/null || true)"
    
    if [[ -n "$TOKEN" ]]; then
      UPDATE_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      curl -s -X PATCH \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json" \
        -d "{\"fields\":{\"coreRef\":{\"stringValue\":\"${TARGET_REF}\"},\"updatedAt\":{\"stringValue\":\"${UPDATE_TS}\"}}}" \
        "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${AGENT_NAME}?updateMask.fieldPaths=coreRef&updateMask.fieldPaths=updatedAt" > /dev/null 2>&1 || true
      log "Updated coreRef in Firestore to ${TARGET_REF}"
    fi
  fi

  echo
  echo "============================================================"
  echo "  ✅ UPGRADED: ${AGENT_NAME} → ${TARGET_REF}"
  echo "============================================================"

  # Notify via Chat
  CHAT_SPACE_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/chat_space_id' 2>/dev/null || true)"
  if [[ -n "$CHAT_SPACE_ID" && -x "$CHAT_SEND" ]]; then
    export CHAT_SPACE_ID CORE_DIR
    "$CHAT_SEND" "✅ Fleet agent *${AGENT_NAME}* upgraded: \`${CURRENT_REF}\` → \`${TARGET_REF}\`" || true
  fi
else
  warn "❌ Upgrade failed!"
  echo "$RESULT"
  echo
  echo "============================================================"
  echo "  ❌ UPGRADE FAILED: ${AGENT_NAME}"
  echo "============================================================"
  exit 1
fi
