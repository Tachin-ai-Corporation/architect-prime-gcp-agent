#!/usr/bin/env bash
# ============================================================
# fleet-deploy — Deploy a fleet agent into Prime's GCP project
#
# Usage: fleet-deploy --name <name> --specialty <desc> --agent-email <email>
#
# Creates: SA → IAM (DWD) → VM (with ears/mouth services) → Firestore entry
#
# Single-project model: all fleet agents run in the same project
# as Prime. Isolation is enforced at the VM/SA level:
#   - Each agent gets its own VM, SA, OpenClaw, workspace, and tools
#   - Agents cannot access each other's filesystems or processes
#   - Specialist toolsets mean fewer, verified tools per agent
#
# Runs on Prime's VM. No org-level permissions needed.
# ============================================================
set -euo pipefail

# ---- Logging ----
log() { echo "[$(date -Is)] [fleet-deploy] $*"; }
warn() { echo "[$(date -Is)] [fleet-deploy] [WARN] $*" >&2; }
die() { echo "[$(date -Is)] [fleet-deploy] [FATAL] $*" >&2; exit 1; }

# ---- Parse args ----
AGENT_NAME=""
SPECIALTY=""
AGENT_USER_EMAIL=""
CHAT_SPACE_OVERRIDE=""
MACHINE_TYPE="e2-medium"
BOOT_DISK_SIZE="50GB"

usage() {
  cat <<EOF
Usage: fleet-deploy --name <name> --specialty <desc> --agent-email <email> [options]

  --name         Agent name (lowercase, no spaces, e.g. 'stan')
  --specialty    Agent type ID from agent-types.json (e.g. 'devops', 'swe')
  --agent-email  Workspace email for the agent (e.g. devops-agent-stan@tachin.ai)
  --chat-space   Chat space ID override (default: Prime's space)
  --machine-type VM machine type (default: e2-medium)
  --disk         Boot disk size (default: 50GB)
  --help         Show this message
EOF
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) AGENT_NAME="$2"; shift 2 ;;
    --specialty) SPECIALTY="$2"; shift 2 ;;
    --agent-email) AGENT_USER_EMAIL="$2"; shift 2 ;;
    --chat-space) CHAT_SPACE_OVERRIDE="$2"; shift 2 ;;
    --machine-type) MACHINE_TYPE="$2"; shift 2 ;;
    --disk) BOOT_DISK_SIZE="$2"; shift 2 ;;
    --help|-h) usage ;;
    *) die "Unknown arg: $1" ;;
  esac
done

[[ -n "$AGENT_NAME" ]] || die "Missing --name"
[[ -n "$SPECIALTY" ]] || die "Missing --specialty"
[[ -n "$AGENT_USER_EMAIL" ]] || die "Missing --agent-email (Workspace user for DWD, e.g. devops-agent-stan@tachin.ai)"
[[ "$AGENT_NAME" =~ ^[a-z][a-z0-9-]*$ ]] || die "Name must be lowercase alphanumeric with hyphens"

# ---- Resolve Prime's project context ----
PRIME_PROJECT="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || true)"
[[ -n "$PRIME_PROJECT" ]] || die "Cannot resolve PRIME_PROJECT from metadata"

ZONE="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/zone' 2>/dev/null | awk -F/ '{print $NF}' || true)"
[[ -n "$ZONE" ]] || ZONE="us-central1-a"
REGION="${ZONE%-*}"

# Chat space: use override, or read from Prime's config, or metadata
CHAT_SPACE_ID="${CHAT_SPACE_OVERRIDE:-}"
if [[ -z "$CHAT_SPACE_ID" ]]; then
  CHAT_SPACE_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/chat_space_id' 2>/dev/null || true)"
fi

OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
REGISTRY_FILE="${OC_HOST_ROOT}/.openclaw/corekit/fleet-registry.json"
CHAT_SEND="${OC_HOST_ROOT}/.openclaw/bin/chat-send"

# Resolve Cloud Run URL for fleet-bootstrap status relay
DASHBOARD_URL="$(gcloud run services describe architect-prime \
  --region="${REGION}" --project="${PRIME_PROJECT}" \
  --format='value(status.url)' 2>/dev/null || true)"
[[ -n "$DASHBOARD_URL" ]] || warn "Could not resolve Cloud Run URL — fleet self-report will be skipped"

# ---- Fleet config (single-project: deploy into PRIME_PROJECT) ----
FLEET_PROJECT="${PRIME_PROJECT}"  # Same project as Prime
FLEET_SA_NAME="fleet-${AGENT_NAME}"
FLEET_SA_EMAIL="${FLEET_SA_NAME}@${FLEET_PROJECT}.iam.gserviceaccount.com"
FLEET_VM="fleet-${AGENT_NAME}"

# Derive display name from email local part (e.g. devops-agent-stan → Devops Agent Stan)
AGENT_DISPLAY_NAME="$(echo "${AGENT_USER_EMAIL%%@*}" | sed 's/-/ /g' | sed 's/\b\(.\)/\u\1/g')"

# Derive deterministic first/last name for Google Workspace account setup
# Convention: email local part split by last hyphen
#   devops-agent-stan@... → First: "Devops-Agent", Last: "Stan"
# This MUST match what the admin sets in Google Workspace for @-mention filtering to work
EMAIL_LOCAL="${AGENT_USER_EMAIL%%@*}"
AGENT_LAST_NAME="$(echo "$EMAIL_LOCAL" | awk -F- '{print $NF}' | sed 's/^./\u&/')"
AGENT_FIRST_NAME="$(echo "$EMAIL_LOCAL" | sed "s/-${EMAIL_LOCAL##*-}$//" | sed 's/-/ /g' | sed 's/\b\(.\)/\u\1/g' | sed 's/ /-/g')"
# The @-mention text in Chat is: "FirstName LastName" (e.g., "Devops-Agent Stan")
AGENT_MENTION="${AGENT_FIRST_NAME} ${AGENT_LAST_NAME}"

# Admin email — grant viewer on fleet SAs for human access
ADMIN_EMAIL="${ADMIN_EMAIL:-}"
if [[ -z "$ADMIN_EMAIL" ]]; then
  ADMIN_EMAIL="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/admin_email' 2>/dev/null || true)"
fi

# DWD Signer SA — shared SA in Prime's project for Chat API token signing
# Fleet agents sign JWTs with this SA so the Chat API recognizes the project
# (which has a configured Chat app). The signer SA has ZERO IAM roles.
DWD_SIGNER_SA="${DWD_SIGNER_SA:-}"
if [[ -z "$DWD_SIGNER_SA" ]]; then
  DWD_SIGNER_SA="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/dwd_signer_sa' 2>/dev/null || true)"
fi
# Fallback: construct from Prime project
if [[ -z "$DWD_SIGNER_SA" ]]; then
  DWD_SIGNER_SA="dwd-signer@${PRIME_PROJECT}.iam.gserviceaccount.com"
fi

# Resolve CoreKit ref from STATE.json
CORE_REF="main"
STATE_FILE="${OC_HOST_ROOT}/.openclaw/corekit/STATE.json"
if [[ -f "$STATE_FILE" ]]; then
  CORE_REF="$(jq -r '.coreRef // "main"' "$STATE_FILE" 2>/dev/null)"
fi
[[ -n "$CORE_REF" ]] || CORE_REF="main"
GH_OWNER="$(jq -r '.owner // "Tachin-ai-Corporation"' "$STATE_FILE" 2>/dev/null || echo "Tachin-ai-Corporation")"
GH_REPO="$(jq -r '.repo // "architect-prime-gcp-agent"' "$STATE_FILE" 2>/dev/null || echo "architect-prime-gcp-agent")"

DEPLOY_TS="$(date -Is)"

# Prime ID — needed for Firestore fleet status writes
PRIME_ID="${PRIME_ID:-}"
if [[ -z "$PRIME_ID" ]]; then
  PRIME_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/prime_id' 2>/dev/null || true)"
fi
FIRESTORE_URL="https://firestore.googleapis.com/v1/projects/${PRIME_PROJECT}/databases/(default)/documents"

log "Deploying fleet agent: ${AGENT_NAME}"
log "  Project:        ${FLEET_PROJECT} (single-project mode)"
log "  Zone:           ${ZONE}"
log "  VM:             ${FLEET_VM}"
log "  SA:             ${FLEET_SA_EMAIL}"
log "  Agent Email:    ${AGENT_USER_EMAIL}"
log "  Display Name:   ${AGENT_DISPLAY_NAME}"
log "  Chat Space:     ${CHAT_SPACE_ID:-<not set>}"
log "  Specialty:      ${SPECIALTY}"
log "  CoreRef:        ${CORE_REF}"
log "  Prime ID:       ${PRIME_ID:-<unknown>}"

# ============================================================
# 1. Guard: refuse to deploy if VM already exists
# ============================================================
if gcloud compute instances describe "$FLEET_VM" \
     --project="$FLEET_PROJECT" --zone="$ZONE" &>/dev/null 2>&1; then
  die "VM '${FLEET_VM}' already exists. Run fleet-teardown --name ${AGENT_NAME} first."
fi

# ---- Write deploy progress to Firestore ----
# Writes status + appends to deploySteps[] array atomically.
# Uses read-modify-write since Firestore REST API lacks arrayUnion.
write_deploy_step() {
  local step_id="$1"
  local step_label="$2"
  local step_status="${3:-done}"   # done | active | failed
  local step_detail="${4:-}"
  local new_status="${5:-}"
  local action_json="${6:-}"

  [[ -n "$PRIME_ID" ]] || return 0

  local token
  token="$(curl -sH 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
    | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])" 2>/dev/null)" || return 0

  python3 - <<PYEOF "$token" "$step_id" "$step_label" "$step_status" "$step_detail" "$new_status" "$action_json"
import sys, json, urllib.request, urllib.error
from datetime import datetime, timezone

token = sys.argv[1]
step_id = sys.argv[2]
step_label = sys.argv[3]
step_status = sys.argv[4]
step_detail = sys.argv[5]
new_status = sys.argv[6]
action_json = sys.argv[7]

fs_url = "${FIRESTORE_URL}/primes/${PRIME_ID}/fleet/${AGENT_NAME}"
now = datetime.now(timezone.utc).isoformat()

# Read current doc
try:
    req = urllib.request.Request(fs_url, headers={"Authorization": f"Bearer {token}"})
    with urllib.request.urlopen(req) as resp:
        doc = json.loads(resp.read())
except:
    doc = {}

# Extract existing deploySteps
existing_steps = []
if "fields" in doc and "deploySteps" in doc["fields"]:
    arr = doc["fields"]["deploySteps"].get("arrayValue", {}).get("values", [])
    existing_steps = arr

# Build new step
new_step = {
    "mapValue": {
        "fields": {
            "id": {"stringValue": step_id},
            "label": {"stringValue": step_label},
            "status": {"stringValue": step_status},
            "timestamp": {"stringValue": now},
        }
    }
}
if step_detail:
    new_step["mapValue"]["fields"]["detail"] = {"stringValue": step_detail}

existing_steps.append(new_step)

# Build update body
fields = {
    "status": {"stringValue": new_status if new_status else "${STATUS_OVERRIDE:-deploying}"},
    "specialty": {"stringValue": "${SPECIALTY}"},
    "email": {"stringValue": "${AGENT_USER_EMAIL}"},
    "vm": {"stringValue": "${FLEET_VM}"},
    "zone": {"stringValue": "${ZONE}"},
    "deployedAt": {"stringValue": "${DEPLOY_TS}"},
    "name": {"stringValue": "${AGENT_NAME}"},
    "deploySteps": {"arrayValue": {"values": existing_steps}},
}

mask = "updateMask.fieldPaths=status&updateMask.fieldPaths=specialty&updateMask.fieldPaths=email&updateMask.fieldPaths=vm&updateMask.fieldPaths=zone&updateMask.fieldPaths=deployedAt&updateMask.fieldPaths=name&updateMask.fieldPaths=deploySteps"

# Add actionRequired if provided
if action_json:
    try:
        ar = json.loads(action_json)
        ar_fields = {}
        for k, v in ar.items():
            if isinstance(v, list):
                ar_fields[k] = {"arrayValue": {"values": [{"stringValue": s} for s in v]}}
            elif isinstance(v, str):
                ar_fields[k] = {"stringValue": v}
        fields["actionRequired"] = {"mapValue": {"fields": ar_fields}}
        mask += "&updateMask.fieldPaths=actionRequired"
    except:
        pass

body = json.dumps({"fields": fields}).encode()
url = f"{fs_url}?{mask}"
req = urllib.request.Request(url, data=body, method="PATCH",
    headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
try:
    urllib.request.urlopen(req)
except Exception as e:
    print(f"[fleet-deploy] Firestore write failed: {e}", file=sys.stderr)
PYEOF
}

# Write initial deploying status with empty steps
write_deploy_step "deploy_started" "Deployment initiated" "done" "" "deploying"

# ============================================================
# 2. APIs already enabled on PRIME_PROJECT — skip
# ============================================================
log "APIs already enabled on ${FLEET_PROJECT} (single-project mode)"

# ============================================================
# 3. Create service account + grant roles
# ============================================================
log "Creating service account: ${FLEET_SA_NAME}"

# SA may already exist from a previous deploy (teardown preserves it)
SA_CREATE_OUT="$(gcloud iam service-accounts create "$FLEET_SA_NAME" \
  --display-name="Fleet Agent ${AGENT_NAME} (${SPECIALTY})" \
  --project="$FLEET_PROJECT" 2>&1)" || {
  if echo "$SA_CREATE_OUT" | grep -qi "already exists"; then
    log "SA already exists (reusing from previous deploy)"
  else
    log "SA creation output: ${SA_CREATE_OUT}"
    warn "SA creation may have failed — continuing anyway"
  fi
}

write_deploy_step "sa_created" "Service account created" "done" "${FLEET_SA_EMAIL}"

# Wait for SA to be fully queryable by IAM before granting roles
log "Waiting 30s for SA propagation..."
sleep 30

# Verify SA exists before granting roles
SA_CHECK="$(gcloud iam service-accounts describe "$FLEET_SA_EMAIL" \
  --project="$FLEET_PROJECT" --format="value(uniqueId)" 2>&1)" || true
if [[ -z "$SA_CHECK" || "$SA_CHECK" == *"NOT_FOUND"* ]]; then
  warn "SA not yet visible after 30s — waiting 30s more"
  sleep 30
fi
log "SA verified: uid=${SA_CHECK:-unknown}"

# Grant roles — log errors instead of swallowing them
IAM_OK=true
for role in roles/aiplatform.user roles/iam.serviceAccountTokenCreator roles/datastore.user; do
  log "Granting ${role} to ${FLEET_SA_EMAIL}"
  GRANT_OUT="$(gcloud projects add-iam-policy-binding "$FLEET_PROJECT" \
    --member="serviceAccount:${FLEET_SA_EMAIL}" \
    --role="$role" \
    --quiet 2>&1)" || {
    warn "IAM grant FAILED for ${role}: ${GRANT_OUT}"
    IAM_OK=false
  }
done

# Grant serviceAccountTokenCreator on the shared DWD-signer SA
log "Granting serviceAccountTokenCreator on DWD-signer SA"
gcloud iam service-accounts add-iam-policy-binding "$DWD_SIGNER_SA" \
  --project="$PRIME_PROJECT" \
  --member="serviceAccount:${FLEET_SA_EMAIL}" \
  --role="roles/iam.serviceAccountTokenCreator" \
  --quiet > /dev/null 2>&1 || log "DWD-signer IAM grant may already exist"

# Verify the critical aiplatform.user role actually landed
log "Verifying aiplatform.user grant..."
sleep 5
VERIFY_OUT="$(gcloud projects get-iam-policy "$FLEET_PROJECT" \
  --flatten='bindings[].members' \
  --filter="bindings.role:roles/aiplatform.user AND bindings.members:serviceAccount:${FLEET_SA_EMAIL}" \
  --format='value(bindings.members)' 2>&1)" || true

if echo "$VERIFY_OUT" | grep -q "serviceAccount:${FLEET_SA_EMAIL}"; then
  log "IAM verification PASSED: aiplatform.user bound to ${FLEET_SA_EMAIL}"
elif [[ "$IAM_OK" == "false" ]]; then
  warn "IAM grants failed — retrying after 30s..."
  sleep 30
  for role in roles/aiplatform.user roles/iam.serviceAccountTokenCreator roles/datastore.user; do
    gcloud projects add-iam-policy-binding "$FLEET_PROJECT" \
      --member="serviceAccount:${FLEET_SA_EMAIL}" \
      --role="$role" --quiet 2>&1 || warn "RETRY failed for ${role}"
  done
else
  warn "IAM verification could not confirm binding — may still be propagating"
fi

write_deploy_step "iam_granted" "IAM roles granted" "done" "aiplatform.user + serviceAccountTokenCreator + datastore.user"


# ============================================================
# 4. Build and create VM (with agent-ears + agent-mouth)
# ============================================================
log "Building startup script (boot stub → fleet-bootstrap.sh)"
STARTUP_TMPFILE="$(mktemp /tmp/fleet-startup-XXXXXX.sh)"
cat > "$STARTUP_TMPFILE" <<STARTUP_EOF
#!/usr/bin/env bash
# Boot stub for fleet agent — curls fleet-bootstrap.sh from GitHub
set -euo pipefail
LOG_FILE="/var/log/fleet-agent-setup.log"
exec > >(tee -a "\$LOG_FILE") 2>&1
echo "==> Fleet Agent Boot Stub: \$(date -Is)"
echo "Downloading fleet-bootstrap.sh from GitHub..."
CORE_BASE="https://raw.githubusercontent.com/${GH_OWNER}/${GH_REPO}/${CORE_REF}"
curl -sfL "\${CORE_BASE}/infra/bootstrap/fleet-bootstrap.sh" -o /tmp/fleet-bootstrap.sh
chmod +x /tmp/fleet-bootstrap.sh
bash /tmp/fleet-bootstrap.sh
STARTUP_EOF

log "Creating VM: ${FLEET_VM}"
gcloud compute instances create "$FLEET_VM" \
  --zone="$ZONE" \
  --project="$FLEET_PROJECT" \
  --image-family="ubuntu-2204-lts" \
  --image-project="ubuntu-os-cloud" \
  --machine-type="$MACHINE_TYPE" \
  --boot-disk-size="$BOOT_DISK_SIZE" \
  --service-account="$FLEET_SA_EMAIL" \
  --scopes="https://www.googleapis.com/auth/cloud-platform" \
  --tags="allow-https" \
  --labels="app=architect-prime,role=fleet,agent=${AGENT_NAME}" \
  --metadata="agent_id=${AGENT_NAME},specialty=${SPECIALTY},core_ref=${CORE_REF},gh_owner=${GH_OWNER},gh_repo=${GH_REPO},chat_space_id=${CHAT_SPACE_ID:-},agent_user_email=${AGENT_USER_EMAIL},agent_display_name=${AGENT_DISPLAY_NAME},agent_first_name=${AGENT_FIRST_NAME},agent_last_name=${AGENT_LAST_NAME},dwd_signer_sa=${DWD_SIGNER_SA},gemini_project=${PRIME_PROJECT},prime_id=${PRIME_ID:-},dashboard_url=${DASHBOARD_URL:-}" \
  --metadata-from-file="startup-script=${STARTUP_TMPFILE}" \
  --quiet

rm -f "$STARTUP_TMPFILE"

sleep 5
FLEET_IP="$(gcloud compute instances describe "$FLEET_VM" --zone="$ZONE" --project="$FLEET_PROJECT" \
  --format='value(networkInterfaces[0].accessConfigs[0].natIP)' 2>/dev/null || echo 'pending')"

write_deploy_step "vm_created" "VM created" "done" "${FLEET_VM} (${FLEET_IP})"

# ============================================================
# 5. Update fleet registry (local JSON + Firestore)
# ============================================================
log "Updating fleet registry"
if [[ ! -f "$REGISTRY_FILE" ]]; then
  echo '{"agents":{}}' > "$REGISTRY_FILE"
fi

jq --arg name "$AGENT_NAME" \
   --arg specialty "$SPECIALTY" \
   --arg project "$FLEET_PROJECT" \
   --arg vm "$FLEET_VM" \
   --arg sa "$FLEET_SA_EMAIL" \
   --arg ip "$FLEET_IP" \
   --arg zone "$ZONE" \
   --arg ref "$CORE_REF" \
   --arg email "$AGENT_USER_EMAIL" \
   --arg display "$AGENT_DISPLAY_NAME" \
   --arg space "${CHAT_SPACE_ID:-}" \
   --arg ts "$DEPLOY_TS" \
   '.agents[$name] = {
      "specialty": $specialty,
      "project": $project,
      "vm": $vm,
      "sa": $sa,
      "ip": $ip,
      "zone": $zone,
      "coreRef": $ref,
      "agentUserEmail": $email,
      "agentDisplayName": $display,
      "spaceId": $space,
      "deployedAt": $ts,
      "status": "deploying"
    } | .lastUpdated = $ts' \
  "$REGISTRY_FILE" > "${REGISTRY_FILE}.tmp" && mv "${REGISTRY_FILE}.tmp" "$REGISTRY_FILE"

# Write actionRequired with admin setup instructions
ACTION_JSON=$(python3 -c "
import json
print(json.dumps({
    'type': 'workspace_user',
    'title': 'Create Workspace user and add to Chat space',
    'instructions': [
        'Create Workspace user at https://admin.google.com/ac/users — First: ${AGENT_FIRST_NAME}, Last: ${AGENT_LAST_NAME}, Email: ${AGENT_USER_EMAIL}',
        'Add ${AGENT_USER_EMAIL} to the AI Fleet Command Chat space',
        'The agent will come online automatically once the user exists'
    ]
}))
")
write_deploy_step "prime_setup_done" "Prime-side setup complete (VM bootstrapping)" "done" "VM is now installing Docker + OpenClaw (~10 min)" "deploying" "$ACTION_JSON"

# ============================================================
# 6. Launch fleet-monitor (Prime-side bootstrap poller)
# ============================================================
# fleet-monitor polls the VM's serial console for bootstrap
# progress and runs a DWD healthcheck at the end. ALL Firestore
# writes happen from Prime's credentials (no IAM propagation race).
MONITOR_BIN="${OC_HOST_ROOT}/.openclaw/bin/fleet-monitor"
MONITOR_LOG="/tmp/fleet-monitor-${AGENT_NAME}.log"

if [[ -x "$MONITOR_BIN" ]]; then
  log "Launching fleet-monitor (background)"
  nohup "$MONITOR_BIN" \
    --name "$AGENT_NAME" \
    --vm "$FLEET_VM" \
    --zone "$ZONE" \
    --email "$AGENT_USER_EMAIL" \
    --prime-id "$PRIME_ID" \
    --first "$AGENT_FIRST_NAME" \
    --last "$AGENT_LAST_NAME" \
    --specialty "$SPECIALTY" \
    > "$MONITOR_LOG" 2>&1 &
  log "  Monitor PID: $! (log: $MONITOR_LOG)"
else
  warn "fleet-monitor not found at $MONITOR_BIN — bootstrap status tracking disabled"
fi

# ============================================================
# 7. Print results + admin setup instructions
# ============================================================
echo
echo "============================================================"
echo "  FLEET AGENT DEPLOYED: ${AGENT_NAME}"
echo "============================================================"
echo
echo "  Project        : ${FLEET_PROJECT} (single-project)"
echo "  VM             : ${FLEET_VM} (${FLEET_IP})"
echo "  SA             : ${FLEET_SA_EMAIL}"
echo "  DWD Signer     : ${DWD_SIGNER_SA}"
echo "  Zone           : ${ZONE}"
echo "  Agent Email    : ${AGENT_USER_EMAIL}"
echo "  Display Name   : ${AGENT_DISPLAY_NAME}"
echo "  Chat Space     : ${CHAT_SPACE_ID:-<not set>}"
echo "  Specialty      : ${SPECIALTY}"
echo "  CoreRef        : ${CORE_REF}"
echo
echo "============================================================"
echo "  ADMIN SETUP REQUIRED"
echo "============================================================"
echo
echo "  Step 1: Create Workspace User (if not already done)"
echo "    → https://admin.google.com/ac/users"
echo "    First Name : ${AGENT_FIRST_NAME}"
echo "    Last Name  : ${AGENT_LAST_NAME}"
echo "    Email      : ${AGENT_USER_EMAIL}"
echo "    ⚠️  Names MUST match exactly for @-mention filtering to work"
echo
echo "  Step 2: Add to Chat Space"
echo "    Open your Chat space → Add people → ${AGENT_USER_EMAIL}"
echo
echo "  Step 3: Verify"
echo "    In Chat, send: @${AGENT_MENTION} hello"
echo
echo "  No per-agent DWD setup needed — fleet agents use the shared"
echo "  DWD-signer SA (${DWD_SIGNER_SA})."
echo
echo "============================================================"

# Structured output for agent-ask async skill callback
echo
echo "DEPLOY_RESULT_JSON_START"
echo "{"
echo "  \"status\": \"success\","
echo "  \"agent_name\": \"${AGENT_NAME}\","
echo "  \"project\": \"${FLEET_PROJECT}\","
echo "  \"vm_ip\": \"${FLEET_IP}\","
echo "  \"sa_email\": \"${FLEET_SA_EMAIL}\","
echo "  \"dwd_signer_sa\": \"${DWD_SIGNER_SA}\","
echo "  \"agent_email\": \"${AGENT_USER_EMAIL}\","
echo "  \"specialty\": \"${SPECIALTY}\","
echo "  \"admin_steps\": ["
echo "    \"Create Workspace user: ${AGENT_USER_EMAIL} at https://admin.google.com/ac/users\","
echo "    \"Add ${AGENT_USER_EMAIL} to the Chat space\""
echo "  ]"
echo "}"
echo "DEPLOY_RESULT_JSON_END"

log "Done. fleet-monitor is tracking bootstrap progress in the background."

