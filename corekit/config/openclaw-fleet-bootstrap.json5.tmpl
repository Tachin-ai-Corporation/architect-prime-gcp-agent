{
  "env": {
    "GOOGLE_CLOUD_PROJECT": "${GCP_PROJECT_ID}",
    "GOOGLE_CLOUD_LOCATION": "global",
    "CLOUDSDK_CORE_PROJECT": "${GCP_PROJECT_ID}",
    "CLOUDSDK_ACTIVE_CONFIG_NAME": "openclaw"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "google-vertex/gemini-3.1-pro-preview"
      },
      "models": {
        "google-vertex/gemini-3.1-pro-preview": {
          "alias": "Gemini 3.1 Pro"
        },
        "google-vertex/gemini-2.5-flash": {
          "alias": "Gemini 2.5 Flash"
        },
        "google-vertex/gemini-2.5-pro": {
          "alias": "Gemini 2.5 Pro"
        }
      },
      "subagents": {
        "maxSpawnDepth": 1,
        "maxChildrenPerAgent": 4,
        "maxConcurrent": 4,
        "runTimeoutSeconds": 600,
        "archiveAfterMinutes": 30
      },
      "memorySearch": {
        "enabled": true,
        "provider": "google",
        "model": "text-embedding-005",
        "query": {
          "maxResults": 8,
          "hybrid": {
            "enabled": true,
            "vectorWeight": 0.7,
            "textWeight": 0.3,
            "mmr": { "enabled": true, "lambda": 0.7 },
            "temporalDecay": { "enabled": true, "halfLifeDays": 30 }
          }
        }
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "48h",
        "keepLastAssistants": 12,
        "softTrimRatio": 0.15
      },
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 150000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 600000,
          "systemPrompt": "CHECKPOINT REACHED for fleet agent ${AGENT_ID}. Write durable state to workspace/MEMORY.md. Summarize key decisions that were made and next actions. Then stop and wait for user direction."
        }
      },
      "maxConcurrent": 1,
      "heartbeat": {
        "every": "0m"
      }
    },
    "list": [
      {
        // Cortex — the specialty agent's user-facing persona.
        // Dispatches sub-agents via exec brain-exec.
        // SOUL.md is loaded automatically from the workspace directory.
        "id": "cortex",
        "default": true,
        "name": "${AGENT_DISPLAY_NAME}",
        "workspace": "~/.openclaw/workspace",
        "runTimeoutSeconds": 600,
        "sandbox": { "mode": "off" },
        "subagents": {
          "allowAgents": ["temporal-research", "temporal-memory", "prefrontal", "motor", "cerebellum"],
          "requireAgentId": true
        },
        "tools": {
          "allow": [
            "read",
            "write",
            "edit",
            "exec",
            "process",
            "sessions_spawn",
            "sessions_list",
            "sessions_history",
            "subagents"
          ],
          "deny": ["web-search", "browser"]
        }
      },
      {
        // Temporal Research — web search via Vertex AI grounding.
        // ONLY agent with web search capability. Uses exec agent-ask.
        "id": "temporal-research",
        "name": "Temporal (Web Research)",
        "workspace": "~/.openclaw/workspace-temporal-research",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": ["exec"],
          "deny": ["read", "write", "edit", "browser", "web-search"]
        }
      },
      {
        // Temporal Memory — context recall from workspace memory + Core Memory.
        "id": "temporal-memory",
        "name": "Temporal (Memory)",
        "workspace": "~/.openclaw/workspace-temporal-memory",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": ["read", "exec"],
          "deny": ["write", "edit", "browser", "web-search"]
        }
      },
      {
        // Prefrontal — strategic planner. Decomposes complex tasks.
        // Read-only. No execution capability.
        "id": "prefrontal",
        "name": "Prefrontal (Planning)",
        "workspace": "~/.openclaw/workspace-prefrontal",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": ["read"],
          "deny": ["write", "edit", "exec", "browser", "web-search"]
        }
      },
      {
        // Motor — executor. Writes code, runs commands, builds things.
        // Full access. Only dispatched for approved plan steps.
        "id": "motor",
        "name": "Motor (Execution)",
        "workspace": "~/.openclaw/workspace-motor",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": [
            "read",
            "write",
            "edit",
            "exec",
            "process"
          ],
          "deny": ["web-search", "browser"]
        }
      },
      {
        // Cerebellum — verifier. QA checks outputs before delivery.
        "id": "cerebellum",
        "name": "Cerebellum (Verification)",
        "workspace": "~/.openclaw/workspace-cerebellum",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": ["read", "exec"],
          "deny": ["write", "edit", "browser", "web-search"]
        }
      }
    ]
  },
  "tools": {
    "deny": ["web-search"],
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off",
      "pathPrepend": ["~/.openclaw/bin"]
    }
  },
  "messages": {
    "queue": { "mode": "collect", "debounceMs": 1000, "cap": 20, "drop": "summarize" },
    "inbound": { "debounceMs": 2000 },
    "ackReaction": "",
    "ackReactionScope": "group-mentions",
    "removeAckAfterReply": false
  },
  "commands": { "native": "auto", "nativeSkills": "auto" },
  "cron": {
    "enabled": true
    // NOTE: cron.jobs requires OpenClaw >= 2026.4.15. Currently on 2026.4.4.
    // When upgraded, re-enable:
    // "jobs": [{
    //   "name": "memory-consolidate",
    //   "cron": "0 2 * * *",
    //   "timezone": "America/Chicago",
    //   "agent": "temporal-memory",
    //   "message": "[SKILL:memory-consolidate] Execute nightly memory consolidation."
    // }]
  },
  "hooks": {
    "internal": {
      "entries": {
        "session-memory": { "enabled": true },
        "agent-status-preturn": {
          "enabled": true,
          "event": "PreTurn",
          "type": "shell",
          "command": "~/.openclaw/bin/agent-status set classifying '' '' 2>/dev/null || true"
        },
        "agent-status-postturn": {
          "enabled": true,
          "event": "PostTurn",
          "type": "shell",
          "command": "~/.openclaw/bin/agent-status set idle '' '' 2>/dev/null || true"
        }
      }
    }
  },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "remote": {
      "token": "${MY_TOKEN}"
    },
    "controlUi": { "enabled": true, "basePath": "/" },
    "http": {
      "endpoints": {
        "responses": { "enabled": true },
        "chatCompletions": { "enabled": true }
      }
    },
    "auth": {
      "mode": "token",
      "token": "${MY_TOKEN}",
      "allowTailscale": true,
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": true
      }
    },
    "tools": { "deny": ["browser"], "allow": ["gateway"] },
    "tailscale": { "mode": "off", "resetOnExit": false }
  }
}
