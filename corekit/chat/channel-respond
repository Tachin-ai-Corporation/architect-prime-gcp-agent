#!/usr/bin/env bash
# ============================================================
# channel-respond — Deliver agent response to the originating channel
#
# Universal response delivery: reads channel metadata from TASK.json,
# routes to the correct output (Dashboard/Firestore or Google Chat).
#
# Usage:
#   channel-respond "Your response text"
#   echo "response" | channel-respond --stdin
#
# Channel resolution (checked in order):
#   1. TASK_CHANNEL env var (set by daemon at submission)
#   2. workspace/TASK.json (written by daemon before gateway call)
#   3. Fallback: dashboard-respond (Prime default)
#
# TASK.json format:
#   { "channel": "dashboard"|"gchat", "channelMeta": { ... } }
#
# Environment (set by daemon, read from TASK.json if missing):
#   TASK_CHANNEL       — "dashboard" or "gchat"
#   PRIME_ID           — Prime instance ID (dashboard channel)
#   GCP_PROJECT_ID     — Firestore project (dashboard channel)
#   CHAT_SPACE_ID      — Google Chat space (gchat channel)
#   AGENT_USER_EMAIL   — Workspace email (gchat channel)
# ============================================================
set -euo pipefail

OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
WORKSPACE="${OC_HOST_ROOT}/.openclaw/workspace"
BIN_DIR="${OC_HOST_ROOT}/.openclaw/bin"
TASK_FILE="${WORKSPACE}/TASK.json"

log() { echo "[channel-respond] $*" >&2; }

# ---- Parse input ----
TEXT=""
case "${1:-}" in
  --stdin) TEXT="$(cat)" ;;
  --help|-h)
    echo "Usage: channel-respond \"<text>\""
    echo "       echo \"text\" | channel-respond --stdin"
    exit 0
    ;;
  "") echo "ERROR: No text provided" >&2; exit 1 ;;
  *) TEXT="$1" ;;
esac

[[ -n "$TEXT" ]] || { echo "ERROR: Empty text" >&2; exit 1; }

# ---- Resolve channel ----
CHANNEL="${TASK_CHANNEL:-}"

if [[ -z "$CHANNEL" && -f "$TASK_FILE" ]]; then
  CHANNEL="$(python3 -c "
import json
try:
    task = json.load(open('$TASK_FILE'))
    print(task.get('channel', 'dashboard'))
except:
    print('dashboard')
" 2>/dev/null)"

  # Also pull channelMeta into env if not already set
  if [[ -z "${CHAT_SPACE_ID:-}" || -z "${AGENT_USER_EMAIL:-}" ]]; then
    eval "$(python3 -c "
import json, os
try:
    task = json.load(open('$TASK_FILE'))
    meta = task.get('channelMeta', {})
    if meta.get('spaceId'):
        print(f'export CHAT_SPACE_ID=\"{meta[\"spaceId\"]}\"')
    if meta.get('agentEmail'):
        print(f'export AGENT_USER_EMAIL=\"{meta[\"agentEmail\"]}\"')
    if meta.get('primeId'):
        print(f'export PRIME_ID=\"{meta[\"primeId\"]}\"')
    if meta.get('projectId'):
        print(f'export GCP_PROJECT_ID=\"{meta[\"projectId\"]}\"')
except:
    pass
" 2>/dev/null)" || true
  fi
fi

# Fallback
CHANNEL="${CHANNEL:-dashboard}"

# ---- Deliver to channel ----
case "$CHANNEL" in
  dashboard)
    if [[ -x "${BIN_DIR}/dashboard-respond" ]]; then
      "${BIN_DIR}/dashboard-respond" "$TEXT"
    else
      log "WARN: dashboard-respond not found, logging response"
      log "RESPONSE: ${TEXT:0:200}"
    fi
    ;;

  gchat)
    if [[ -x "${BIN_DIR}/chat-send" ]]; then
      CHAT_SPACE_ID="${CHAT_SPACE_ID:-}" AGENT_USER_EMAIL="${AGENT_USER_EMAIL:-}" \
        "${BIN_DIR}/chat-send" "$TEXT"
    else
      log "WARN: chat-send not found, logging response"
      log "RESPONSE: ${TEXT:0:200}"
    fi
    ;;

  silent)
    # Silent channel: log but don't deliver (used by internal tasks)
    log "Silent delivery (${#TEXT} chars)"
    ;;

  *)
    log "WARN: Unknown channel '$CHANNEL', falling back to dashboard"
    "${BIN_DIR}/dashboard-respond" "$TEXT" 2>/dev/null || \
      log "RESPONSE: ${TEXT:0:200}"
    ;;
esac

# ---- Update task status ----
if [[ -f "$TASK_FILE" ]]; then
  python3 -c "
import json
try:
    with open('$TASK_FILE', 'r+') as f:
        task = json.load(f)
        task['status'] = 'complete'
        import datetime
        task['completedAt'] = datetime.datetime.utcnow().strftime('%Y-%m-%dT%H:%M:%SZ')
        f.seek(0)
        json.dump(task, f)
        f.truncate()
except:
    pass
" 2>/dev/null || true
fi
