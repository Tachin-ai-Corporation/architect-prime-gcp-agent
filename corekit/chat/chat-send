#!/usr/bin/env bash
# ============================================================
# chat-send — Send a message to a Google Chat space
#
# Uses Domain-Wide Delegation (DWD) to send messages as an
# impersonated Workspace user. Messages appear as that user,
# not as a bot.
#
# Usage:
#   chat-send "Hello from Prime!"
#   chat-send --card "Title" "Body text"
#   echo "message" | chat-send --stdin
#
# Environment:
#   CHAT_SPACE_ID     — Google Chat space ID (spaces/XXXX)
#   AGENT_USER_EMAIL  — Workspace user to impersonate
#   CORE_DIR          — CoreKit host root (default: /opt/corekit)
#
# Config is read from chat-config.json if env vars are not set.
# ============================================================
set -euo pipefail

# ---- CONFIG ----
CORE_DIR="${CORE_DIR:-/opt/corekit}"
CHAT_CONFIG="${CORE_DIR}/corekit/chat-config.json"
CHAT_API="https://chat.googleapis.com/v1"
DWD_TOKEN="${CORE_DIR}/bin/dwd-token"

# ---- Helpers ----
die() { echo "[chat-send] [ERROR] $*" >&2; exit 1; }

# ---- Resolve config from JSON file ----
resolve_config() {
  if [[ -f "$CHAT_CONFIG" ]]; then
    if [[ -z "${CHAT_SPACE_ID:-}" ]]; then
      CHAT_SPACE_ID="$(python3 -c "
import json
try:
    cfg = json.load(open('$CHAT_CONFIG'))
    print(cfg.get('spaceId', ''))
except: pass
" 2>/dev/null)"
    fi
    if [[ -z "${AGENT_USER_EMAIL:-}" ]]; then
      AGENT_USER_EMAIL="$(python3 -c "
import json
try:
    cfg = json.load(open('$CHAT_CONFIG'))
    print(cfg.get('agentUserEmail', ''))
except: pass
" 2>/dev/null)"
    fi
  fi
}

# ---- Get DWD access token ----
get_access_token() {
  local token
  if [[ -x "$DWD_TOKEN" ]]; then
    token="$("$DWD_TOKEN" --user "$AGENT_USER_EMAIL" 2>/dev/null)" \
      || die "dwd-token failed for user ${AGENT_USER_EMAIL}"
  else
    die "dwd-token not found at ${DWD_TOKEN}"
  fi
  [[ -n "$token" ]] || die "Empty access token"
  echo "$token"
}

# ---- Send a text message ----
send_text() {
  local space_id="$1"
  local text="$2"
  local token
  token="$(get_access_token)"

  local response
  response="$(curl -s -w "\n%{http_code}" \
    -X POST \
    -H "Authorization: Bearer ${token}" \
    -H "Content-Type: application/json" \
    "${CHAT_API}/${space_id}/messages" \
    -d "{\"text\": $(printf '%s' "$text" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')}")"

  local http_code
  http_code="$(echo "$response" | tail -1)"
  local body
  body="$(echo "$response" | sed '$d')"

  if [[ "$http_code" -ge 200 && "$http_code" -lt 300 ]]; then
    echo "[chat-send] Message sent to ${space_id} as ${AGENT_USER_EMAIL} (HTTP ${http_code})"
  else
    echo "[chat-send] Failed to send message (HTTP ${http_code})" >&2
    echo "$body" >&2
    return 1
  fi
}

# ---- Send a card message ----
send_card() {
  local space_id="$1"
  local title="$2"
  local body="$3"
  local token
  token="$(get_access_token)"

  local payload
  payload="{
    \"cardsV2\": [{
      \"cardId\": \"status-card\",
      \"card\": {
        \"header\": {
          \"title\": $(printf '%s' "$title" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))'),
          \"imageUrl\": \"https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/robot_2/default/48px.svg\",
          \"imageType\": \"CIRCLE\"
        },
        \"sections\": [{
          \"widgets\": [{
            \"textParagraph\": {
              \"text\": $(printf '%s' "$body" | python3 -c 'import sys,json; print(json.dumps(sys.stdin.read()))')
            }
          }]
        }]
      }
    }]
  }"

  local response
  response="$(curl -s -w "\n%{http_code}" \
    -X POST \
    -H "Authorization: Bearer ${token}" \
    -H "Content-Type: application/json" \
    "${CHAT_API}/${space_id}/messages" \
    -d "$payload")"

  local http_code
  http_code="$(echo "$response" | tail -1)"

  if [[ "$http_code" -ge 200 && "$http_code" -lt 300 ]]; then
    echo "[chat-send] Card sent to ${space_id} as ${AGENT_USER_EMAIL} (HTTP ${http_code})"
  else
    echo "[chat-send] Failed to send card (HTTP ${http_code})" >&2
    echo "$response" | sed '$d' >&2
    return 1
  fi
}

# ---- Main ----
resolve_config

[[ -n "${CHAT_SPACE_ID:-}" ]] || die "No Chat space ID. Set CHAT_SPACE_ID or configure chat-config.json"
[[ -n "${AGENT_USER_EMAIL:-}" ]] || die "No agent user email. Set AGENT_USER_EMAIL or configure agentUserEmail in chat-config.json"

case "${1:-}" in
  --card)
    [[ -n "${2:-}" ]] || die "Usage: chat-send --card <title> <body>"
    [[ -n "${3:-}" ]] || die "Usage: chat-send --card <title> <body>"
    send_card "$CHAT_SPACE_ID" "$2" "$3"
    ;;
  --stdin)
    text="$(cat)"
    [[ -n "$text" ]] || die "No input on stdin"
    send_text "$CHAT_SPACE_ID" "$text"
    ;;
  --help|-h)
    echo "Usage: chat-send <message>"
    echo "       chat-send --card <title> <body>"
    echo "       echo 'msg' | chat-send --stdin"
    echo ""
    echo "Sends as: \${AGENT_USER_EMAIL} (via DWD impersonation)"
    ;;
  "")
    die "Usage: chat-send <message>"
    ;;
  *)
    send_text "$CHAT_SPACE_ID" "$1"
    ;;
esac
