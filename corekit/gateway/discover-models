#!/usr/bin/env bash
# ============================================================
# discover-models — Discover + probe Vertex AI models
#
# Queries the Model Garden API to find all available MaaS LLMs,
# probes each for API availability, and returns results as JSON.
# No local catalog file — Firestore is the only cache.
#
# Usage:
#   discover-models --probe-only          # discover + probe → JSON (for dashboard)
#   discover-models                       # discover + probe → human table
#   discover-models --set MODEL --apply   # force a specific default model
#   discover-models --set-config FILE     # apply full assignment map from JSON
# ============================================================
set -euo pipefail

OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
OC_HOST_DIR="${OC_HOST_ROOT}/.openclaw"

log() { echo "[$(date -Is)] [discover-models] $*"; }
die() { echo "[$(date -Is)] [discover-models] [FATAL] $*" >&2; exit 1; }

# ---- Resolve GCP context ----
GCP_PROJECT_ID="${GCP_PROJECT_ID:-$(curl -sf -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/project/project-id 2>/dev/null || echo '')}"
[[ -n "$GCP_PROJECT_ID" ]] || GCP_PROJECT_ID="$(gcloud config get project 2>/dev/null || echo '')"
[[ -n "$GCP_PROJECT_ID" ]] || die "Cannot determine GCP project ID"

LOCATION="${GOOGLE_CLOUD_LOCATION:-us-central1}"

get_token() {
  local token
  token="$(curl -sf -H 'Metadata-Flavor: Google' \
    "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" 2>/dev/null \
    | python3 -c 'import sys,json; print(json.load(sys.stdin)["access_token"])' 2>/dev/null)" || true
  [[ -z "$token" ]] && token="$(gcloud auth print-access-token 2>/dev/null)" || true
  echo "$token"
}

# ---- Parse args ----
MODE="discover"
FORCE_MODEL=""
CONFIG_FILE=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --apply) MODE="apply"; shift ;;
    --probe-only) MODE="probe-only"; shift ;;
    --set) shift; FORCE_MODEL="${1:-}"; [[ -n "$FORCE_MODEL" ]] || die "--set requires a model ID"; shift ;;
    --set-config) shift; CONFIG_FILE="${1:-}"; [[ -n "$CONFIG_FILE" ]] || die "--set-config requires a JSON file path"; MODE="apply-config"; shift ;;
    --help|-h) echo "Usage: discover-models [--probe-only] [--set MODEL --apply] [--set-config FILE]"; exit 0 ;;
    *) die "Unknown arg: $1" ;;
  esac
done

# ---- set-config mode: apply assignment map ----
if [[ "$MODE" == "apply-config" ]]; then
  [[ -f "$CONFIG_FILE" ]] || die "Config file not found: $CONFIG_FILE"
  log "Applying model config from: $CONFIG_FILE"
  python3 <<PYEOF
import json, re, pathlib, sys
config = json.load(open('${CONFIG_FILE}'))
default_model = config.get('default', '')
overrides = config.get('overrides', {})
if not default_model:
    print('[discover-models] ERROR: no default model in config', file=sys.stderr)
    sys.exit(1)
for tmpl_name in ['openclaw-bootstrap.json5.tmpl', 'openclaw-fleet-bootstrap.json5.tmpl']:
    tmpl_path = pathlib.Path('${OC_HOST_DIR}/corekit') / tmpl_name
    if not tmpl_path.exists():
        continue
    t = tmpl_path.read_text()
    t = re.sub(r'"primary":\s*"(?:google-vertex|vertex_ai)/[^"]+?"', f'"primary": "{default_model}"', t, count=1)
    for agent_id, model_id in overrides.items():
        if not model_id:
            t = re.sub(rf'("id":\s*"{agent_id}"[^}}]*?)\s*"model":\s*\{{[^}}]*\}},?\s*', r'\1', t)
        else:
            pattern = rf'("id":\s*"{agent_id}"[^}}]*?)"model":\s*\{{[^}}]*\}}'
            if re.search(pattern, t):
                t = re.sub(pattern, rf'\1"model": {{"primary": "{model_id}"}}', t)
            else:
                t = re.sub(rf'("id":\s*"{agent_id}",)', rf'\1\n        "model": {{"primary": "{model_id}"}},', t)
    tmpl_path.write_text(t)
    print(f'  Updated: {tmpl_name}')
print('Model assignments applied.')
PYEOF
  RENDER="${OC_HOST_DIR}/bin/render-config"
  [[ -x "$RENDER" ]] && GCP_PROJECT_ID="${GCP_PROJECT_ID}" OC_HOST_ROOT="${OC_HOST_ROOT}" "$RENDER"
  exit 0
fi

# ---- Verify prereqs ----
[[ "$MODE" == "probe-only" ]] || log "Discovering models from Vertex AI Model Garden..."

TOKEN="$(get_token)"
[[ -n "$TOKEN" ]] || die "Cannot obtain access token"

# ---- Step 1: Query Model Garden ----
[[ "$MODE" == "probe-only" ]] || log "Querying Model Garden..."
GARDEN_TMP="/tmp/model-garden-catalog.json"
gcloud ai model-garden models list --format=json --project="${GCP_PROJECT_ID}" > "$GARDEN_TMP" 2>/dev/null || echo "[]" > "$GARDEN_TMP"

# ---- Step 2: Filter + probe + output (all in Python) ----
PY_TMP="/tmp/discover-models-probe.py"
cat > "$PY_TMP" <<'PYEOF'
import json, os, re, sys, pathlib, urllib.request, urllib.error

GARDEN_FILE = sys.argv[1]
TOKEN = sys.argv[2]
LOC = sys.argv[3]
PROJ = sys.argv[4]
MODE = sys.argv[5]
OC_HOST_DIR = sys.argv[6]

garden = json.load(open(GARDEN_FILE))

# --- Filter for MaaS text LLMs ---
EXCLUDE = ['image', 'video', 'veo', 'lyria', 'tts', 'try-on', 'embed',
           'segment', 'detect', 'vision', 'translate', 'shield', 'weather',
           'path-foundation', 'derm', 'hear', 'medasr', 'medsiglip', 'ocr',
           'computer-use', 'virtual', 'sam3', 'reward', 'guard', 'safety',
           'speech', 'cxr-foundation', 'prompt-optimizer', 'code-gecko',
           'code-bison', 'text-bison', 'chat-bison', 'text-unicorn']

def make_name(mid):
    """gemini-2.5-pro → Gemini 2.5 Pro, claude-opus-4-7 → Claude Opus 4.7"""
    # Strip -maas suffix for display
    display_id = re.sub(r'-maas$', '', mid)
    parts, out, i = display_id.split('-'), [], 0
    while i < len(parts):
        p = parts[i]
        if p.isdigit() and i+1 < len(parts) and parts[i+1].isdigit():
            out.append(f'{p}.{parts[i+1]}'); i += 2; continue
        out.append(p if re.match(r'^\d{3}$', p) else p.capitalize())
        i += 1
    name = ' '.join(out)
    # Brand name casing
    brands = ['Gemini','Claude','Flash','Pro','Opus','Sonnet','Haiku','Lite','Preview',
              'Llama','Mistral','Large','Medium','Small','Nemo','Codestral','Pixtral',
              'Instruct','Chat','Maverick','Scout','Jamba','Mini']
    for b in brands:
        name = re.sub(r'\b' + b.lower() + r'\b', b, name, flags=re.IGNORECASE)
    return name

candidates = {}
for m in garden:
    name = m.get('name', '')
    actions = m.get('supportedActions', {})
    # Accept models with AI Studio access OR Model-as-a-Service (MaaS) endpoints
    if 'openGenerationAiStudio' not in actions and 'openMaas' not in actions:
        continue
    parts = name.split('/')
    if len(parts) < 4:
        continue
    publisher, model_id = parts[1], parts[3]
    if any(kw in model_id.lower() for kw in EXCLUDE):
        continue
    # Deduplicate: if model-X-maas exists and we already have model-X (or vice versa), keep one
    base_id = re.sub(r'-maas$', '', model_id)
    if model_id != base_id and base_id in candidates:
        continue  # Already have the base model
    if model_id == base_id and (base_id + '-maas') in candidates:
        continue  # Already have the MaaS variant
    if model_id in candidates:
        continue
    launch = m.get('launchStage', 'PREVIEW').upper()
    candidates[model_id] = {
        'id': model_id,
        'name': make_name(model_id),
        'tier': 'ga' if launch == 'GA' else 'preview',
        'provider': publisher,
    }

# --- Filter out discontinued models ---
DISCONTINUED = {'gemini-3-pro-preview', 'gemini-3-flash-preview'}
candidates = {k: v for k, v in candidates.items() if k not in DISCONTINUED}

# --- Add curated third-party MaaS models ---
THIRD_PARTY_MAAS = [
    {'id': 'llama-4-scout-17b-16e-instruct-maas',      'provider': 'meta',      'tier': 'preview'},
    {'id': 'llama-4-maverick-17b-128e-instruct-maas',   'provider': 'meta',      'tier': 'preview'},
    {'id': 'llama-3.3-70b-instruct-maas',               'provider': 'meta',      'tier': 'ga'},
    {'id': 'llama-3.2-90b-vision-instruct-maas',        'provider': 'meta',      'tier': 'ga'},
    {'id': 'mistral-large-2411',                        'provider': 'mistralai', 'tier': 'ga'},
    {'id': 'codestral-2501',                            'provider': 'mistralai', 'tier': 'ga'},
    {'id': 'mistral-nemo-2407',                         'provider': 'mistralai', 'tier': 'ga'},
    {'id': 'mistral-small-2503',                        'provider': 'mistralai', 'tier': 'ga'},
]
for m in THIRD_PARTY_MAAS:
    mid = m['id']
    if mid not in candidates:
        candidates[mid] = {
            'id': mid,
            'name': make_name(mid),
            'tier': m['tier'],
            'provider': m['provider'],
            'maas_openai': True,
        }

# --- Probe each ---
def _do_probe(url, body):
    req = urllib.request.Request(url, data=body, method='POST',
        headers={'Authorization': f'Bearer {TOKEN}', 'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp: return resp.status
    except urllib.error.HTTPError as e: return e.code
    except: return 0

def probe(mid, info):
    provider = info['provider']
    tier = info.get('tier', 'ga')
    is_openai_maas = info.get('maas_openai', False)
    body_google = b'{"contents":[{"role":"user","parts":[{"text":"pong"}]}],"generationConfig":{"maxOutputTokens":5}}'
    body_anthropic = b'{"anthropic_version":"vertex-2023-10-16","max_tokens":5,"messages":[{"role":"user","content":"hi"}]}'
    body_generic = b'{"max_tokens":5,"messages":[{"role":"user","content":"hi"}]}'

    if is_openai_maas:
        body = json.dumps({"model": f"{provider}/{mid}", "messages": [{"role": "user", "content": "hi"}], "max_tokens": 5}).encode()
        url = f"https://{LOC}-aiplatform.googleapis.com/v1beta1/projects/{PROJ}/locations/{LOC}/endpoints/openapi/chat/completions"
        return _do_probe(url, body)

    if provider == 'google':
        regional_url = f"https://{LOC}-aiplatform.googleapis.com/v1beta1/projects/{PROJ}/locations/{LOC}/publishers/google/models/{mid}:generateContent"
        code = _do_probe(regional_url, body_google)
        if code in (200, 429): return code
        if tier == 'preview':
            global_url = f"https://aiplatform.googleapis.com/v1/projects/{PROJ}/locations/global/publishers/google/models/{mid}:generateContent"
            global_code = _do_probe(global_url, body_google)
            if global_code in (200, 429): return global_code
            return global_code if global_code != 0 else code
        return code

    body = body_anthropic if provider == 'anthropic' else body_generic
    url = f"https://{LOC}-aiplatform.googleapis.com/v1/projects/{PROJ}/locations/{LOC}/publishers/{provider}/models/{mid}:rawPredict"
    return _do_probe(url, body)

results, best = [], ''
current = ''
for tmpl in [f'{OC_HOST_DIR}/corekit/openclaw-bootstrap.json5.tmpl']:
    p = pathlib.Path(tmpl)
    if p.exists():
        hit = re.search(r'"primary":\s*"(?:google-vertex|vertex_ai)/([^"]+)"', p.read_text())
        if hit: current = hit.group(1)

if MODE != 'probe-only':
    print(f"\n  {'Model':<40} {'Provider':<12} Status")
    print(f"  {'─'*70}")

for mid, info in sorted(candidates.items()):
    code = probe(mid, info)
    if code in (200, 429):
        status, label = 'available', '✅ Available'
        if not best: best = mid
    elif code == 404: status, label = 'not_found', '❌ Not found'
    elif code in (401, 403): status, label = 'auth_error', '🔒 Needs enablement'
    elif code == 0: status, label = 'timeout', '⚠️  Timeout'
    else: status, label = 'unknown', f'⚠️  HTTP {code}'

    if MODE != 'probe-only':
        print(f"  {info['name']:<40} {info['provider']:<12} {label}")

    oc = f"google-vertex/{mid}" if info['provider'] == 'google' else f"vertex_ai/{mid}"
    clean_info = {k: v for k, v in info.items() if k != 'maas_openai'}
    results.append({**clean_info, 'status': status, 'httpCode': code, 'openclawId': oc})

if MODE != 'probe-only':
    avail = sum(1 for r in results if r['status'] == 'available')
    print(f"\n  Discovered {len(results)} models, {avail} available\n")

if MODE == 'probe-only':
    print(json.dumps({
        'models': results, 'bestModel': best,
        'currentModel': current, 'projectId': PROJ,
        'discovered': len(results),
    }))
PYEOF

python3 "$PY_TMP" "$GARDEN_TMP" "$TOKEN" "$LOCATION" "$GCP_PROJECT_ID" "$MODE" "$OC_HOST_DIR"

# Clean up
rm -f "$GARDEN_TMP" "$PY_TMP"

# ---- Apply mode ----
if [[ "$MODE" == "apply" && -n "$FORCE_MODEL" ]]; then
  log "Setting default model: ${FORCE_MODEL}"
  # Determine provider
  OC_ID="google-vertex/${FORCE_MODEL}"
  for tmpl in "${OC_HOST_DIR}/corekit/openclaw-bootstrap.json5.tmpl" \
              "${OC_HOST_DIR}/corekit/openclaw-fleet-bootstrap.json5.tmpl"; do
    [[ -f "$tmpl" ]] || continue
    python3 -c "
import pathlib, re
p = pathlib.Path('${tmpl}')
t = p.read_text()
t = re.sub(r'\"primary\":\s*\"(?:google-vertex|vertex_ai)/[^\"]+\"', '\"primary\": \"${OC_ID}\"', t, count=1)
p.write_text(t)
print(f'  Updated: {p.name}')
"
  done
  RENDER="${OC_HOST_DIR}/bin/render-config"
  [[ -x "$RENDER" ]] && GCP_PROJECT_ID="${GCP_PROJECT_ID}" OC_HOST_ROOT="${OC_HOST_ROOT}" "$RENDER"
  log "Config updated to use ${OC_ID}"
fi
