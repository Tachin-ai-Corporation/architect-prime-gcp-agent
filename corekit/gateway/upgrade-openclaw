#!/usr/bin/env bash
# ============================================================
# upgrade-openclaw — Upgrade the OpenClaw Docker image in-place
#
# Usage:
#   upgrade-openclaw                    # upgrade to the OC_PIN from bootstrap
#   upgrade-openclaw --pin <commit>     # upgrade to a specific commit
#   upgrade-openclaw --latest           # upgrade to latest HEAD (risky)
#   upgrade-openclaw --tag v2026.4.15   # upgrade to a release tag
#
# This tool upgrades the local OpenClaw Docker image without
# full re-bootstrapping. It preserves all config, workspace,
# and state files.
#
# Steps:
#   1. cd /root/openclaw && git fetch
#   2. git checkout <target>
#   3. docker build -t openclaw:local .
#   4. docker restart openclaw-gateway
#   5. Wait for gateway readiness
#   6. Report new version
# ============================================================
set -euo pipefail

log() { echo "[$(date -Is)] [upgrade-openclaw] $*"; }
die() { echo "[$(date -Is)] [upgrade-openclaw] [FATAL] $*" >&2; exit 1; }

# Default pin from current bootstrap
DEFAULT_PIN="041266a6699cac3baef8ef39db41fa26f29f9db3"

TARGET=""
MODE="pin"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --pin) TARGET="$2"; MODE="pin"; shift 2 ;;
    --tag) TARGET="$2"; MODE="tag"; shift 2 ;;
    --latest) MODE="latest"; shift ;;
    --help|-h)
      echo "Usage: upgrade-openclaw [--pin <commit>] [--tag <tag>] [--latest]"
      echo "  Default: upgrades to the pinned commit from bootstrap"
      exit 0
      ;;
    *) die "Unknown arg: $1" ;;
  esac
done

# ---- Resolve target ----
OC_DIR="/root/openclaw"
[[ -d "$OC_DIR/.git" ]] || die "OpenClaw repo not found at $OC_DIR"

cd "$OC_DIR"
log "Fetching latest from remote..."
git fetch --all --prune --tags

case "$MODE" in
  pin)
    TARGET="${TARGET:-$DEFAULT_PIN}"
    log "Target: commit ${TARGET}"
    git checkout "$TARGET"
    ;;
  tag)
    [[ -n "$TARGET" ]] || die "--tag requires a value"
    log "Target: tag ${TARGET}"
    git checkout "$TARGET"
    ;;
  latest)
    TARGET="$(git rev-parse origin/main)"
    log "Target: latest HEAD (${TARGET})"
    git checkout "$TARGET"
    ;;
esac

CURRENT_COMMIT="$(git rev-parse HEAD)"
log "Checked out: ${CURRENT_COMMIT}"

# ---- Build new Docker image ----
log "Building Docker image openclaw:local ..."
DOCKER_BUILDKIT=1 docker build -t openclaw:local .

# ---- Recreate container with new image ----
# docker restart doesn't pick up a rebuilt image — must stop+rm+run
log "Stopping old container..."
DOCKER_GID="$(getent group docker | cut -d: -f3)"
docker stop openclaw-gateway 2>/dev/null || true
docker rm openclaw-gateway 2>/dev/null || true

log "Starting new container..."

# Read gateway token from rendered config
OC_HOST_DIR="/opt/openclaw/.openclaw"
GW_TOKEN="$(cat "${OC_HOST_DIR}/.gateway-token" 2>/dev/null || echo 'no-token')"
GCP_PROJECT_ID="$(curl -sf -H 'Metadata-Flavor: Google' \
  http://metadata.google.internal/computeMetadata/v1/project/project-id 2>/dev/null \
  || gcloud config get project 2>/dev/null || echo 'unknown')"

docker run -d \
  --name openclaw-gateway \
  --network host \
  --restart always \
  -e "GATEWAY_BIND=loopback" \
  -e "GATEWAY_PORT=18789" \
  -e "OPENCLAW_GATEWAY_TOKEN=${GW_TOKEN}" \
  -e "OPENCLAW_CONFIG_DIR=/home/node/.openclaw" \
  -e "OPENCLAW_WORKSPACE_DIR=/home/node/.openclaw/workspace" \
  -e "OPENCLAW_CONFIG_PATH=/home/node/.openclaw/openclaw.json" \
  -e "GOOGLE_CLOUD_PROJECT=${GCP_PROJECT_ID}" \
  -e "GCLOUD_PROJECT=${GCP_PROJECT_ID}" \
  -e "CLOUDSDK_CORE_PROJECT=${GCP_PROJECT_ID}" \
  -e "GOOGLE_GENAI_USE_VERTEXAI=True" \
  -e "GOOGLE_CLOUD_LOCATION=global" \
  -v "${OC_HOST_DIR}:/home/node/.openclaw" \
  -v /var/run/docker.sock:/var/run/docker.sock \
  --group-add "${DOCKER_GID}" \
  openclaw:local

# ---- Apply ADC auth patch (required for GCE metadata auth) ----
# v2026.4.x had a built-in google-vertex special case; v2026.5.x removed it.
log "Applying ADC auth patch..."
sleep 3  # wait for container to initialize
AUTH_ENV_FILE="$(docker exec openclaw-gateway find /app/dist -name 'model-auth-env-*.js' -type f 2>/dev/null | head -1)"
if [[ -n "$AUTH_ENV_FILE" ]]; then
  cat > /tmp/patch-adc.py << 'PYEOF'
import sys
fpath = sys.argv[1]
with open(fpath) as f: code = f.read()
if 'gce metadata' in code or 'gce-adc' in code:
    print('  Already patched'); sys.exit(0)
patched = False
if 'if (!envKey) return null;' in code:
    code = code.replace('if (!envKey) return null;',
        'if (!envKey) return { apiKey: "<gce-adc>", source: "gce metadata" };', 1)
    patched = True; print('  Patched (v2026.4.x)')
elif '\treturn null;\n}\n//#endregion' in code:
    code = code.replace('\treturn null;\n}\n//#endregion',
        '\tif (normalized === "google-vertex") return { apiKey: "gcp-vertex-credentials", source: "gce metadata" };\n\treturn null;\n}\n//#endregion', 1)
    patched = True; print('  Patched (v2026.5.x)')
else:
    print('  WARN: sentinel not found'); sys.exit(0)
if patched:
    with open(fpath, 'w') as f: f.write(code)
PYEOF
  docker cp /tmp/patch-adc.py openclaw-gateway:/tmp/patch-adc.py
  docker exec -u 0 openclaw-gateway python3 /tmp/patch-adc.py "$AUTH_ENV_FILE"
  rm -f /tmp/patch-adc.py
  # Restart node process to pick up the patch
  docker exec openclaw-gateway kill 1 2>/dev/null || true
  sleep 5
else
  log "  ⚠️  Could not find model-auth-env file to patch"
fi

# ---- Wait for gateway readiness ----
log "Waiting for gateway readiness..."
MAX_WAIT=120
WAITED=0
READY=false
while [[ "$WAITED" -lt "$MAX_WAIT" ]]; do
  CODE="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
    http://localhost:18789/v1/models 2>/dev/null)" || CODE="000"
  if [[ "$CODE" == "401" || "$CODE" == "200" ]]; then
    READY=true
    break
  fi
  echo "  Not ready yet (HTTP ${CODE}, ${WAITED}s elapsed)..."
  sleep 5
  WAITED=$((WAITED + 5))
done

if $READY; then
  NEW_VERSION="$(docker exec openclaw-gateway openclaw --version 2>/dev/null || echo 'unknown')"
  log "✅ Upgrade complete! Gateway ready in ~${WAITED}s"
  log "   Version: ${NEW_VERSION}"
  log "   Commit:  ${CURRENT_COMMIT}"
  log "   Location: global (supports Gemini 3.1+ preview models)"
else
  log "⚠️  Gateway did not become ready within ${MAX_WAIT}s"
  log "   Check logs: docker logs openclaw-gateway --tail 30"
  exit 1
fi

