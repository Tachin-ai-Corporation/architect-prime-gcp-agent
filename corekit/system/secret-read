#!/usr/bin/env bash
# ============================================================
# secret-read — Read a secret value from GCP Secret Manager
#
# Usage:
#   secret-read --name <secret-id>
#   secret-read --help
#
# The secret is read from Secret Manager using the VM's default
# service account credentials (ADC via metadata server).
# Secret names are prefixed with 'aps-secret-' automatically.
#
# Output: secret value to stdout (for piping/command substitution)
# Exit codes: 0 = success, 1 = not found, 2 = permission denied
#
# SECURITY: Never log, echo, or persist secret values. Use via
# command substitution only: TOKEN=$(secret-read --name my-key)
# ============================================================
set -euo pipefail

die()  { echo "[secret-read] [ERROR] $*" >&2; exit 1; }
log()  { echo "[secret-read] $*" >&2; }

NAME=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) NAME="$2"; shift 2 ;;
    --help|-h)
      echo "Usage: secret-read --name <secret-id>"
      echo "  Reads a secret from GCP Secret Manager."
      echo "  The value is printed to stdout."
      exit 0
      ;;
    *) die "Unknown argument: $1" ;;
  esac
done

[[ -z "$NAME" ]] && die "--name is required"

# ---- Get project ID from metadata server ----
PROJECT_ID=$(curl -sf --max-time 3 -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/project/project-id" 2>/dev/null) \
  || die "Failed to get project ID from metadata server"

# ---- Get access token from metadata server ----
TOKEN=$(curl -sf --max-time 3 -H "Metadata-Flavor: Google" \
  "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
  | python3 -c "import json,sys; print(json.load(sys.stdin)['access_token'])" 2>/dev/null) \
  || die "Failed to get access token from metadata server"

# ---- Access the secret (prefixed with aps-secret-) ----
SECRET_ID="aps-secret-${NAME}"
URL="https://secretmanager.googleapis.com/v1/projects/${PROJECT_ID}/secrets/${SECRET_ID}/versions/latest:access"

HTTP_CODE=$(curl -sf -o /tmp/.secret-read-response -w '%{http_code}' --max-time 10 \
  -H "Authorization: Bearer ${TOKEN}" \
  "${URL}" 2>/dev/null) || HTTP_CODE="000"

case "$HTTP_CODE" in
  200)
    # Extract and decode the base64 payload
    python3 -c "
import json, sys, base64
data = json.load(open('/tmp/.secret-read-response'))
print(base64.b64decode(data['payload']['data']).decode('utf-8'), end='')
"
    rm -f /tmp/.secret-read-response
    ;;
  403)
    rm -f /tmp/.secret-read-response
    log "Permission denied for secret '${NAME}'. Request access via the dashboard."
    exit 2
    ;;
  404)
    rm -f /tmp/.secret-read-response
    log "Secret '${NAME}' not found."
    exit 1
    ;;
  *)
    rm -f /tmp/.secret-read-response
    die "Secret Manager API returned HTTP ${HTTP_CODE} for secret '${NAME}'"
    ;;
esac
