#!/usr/bin/env bash
# ============================================================
# upgrade-corekit -- Agent-facing CoreKit upgrade tool
#
# Usage:
#   upgrade-corekit --check           # Check for drift
#   upgrade-corekit --apply <ref>     # Upgrade to a new ref
#   upgrade-corekit --status          # Show current install info
#
# This is a thin wrapper around install.sh.
# ============================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OC_HOST_ROOT="${CORE_ROOT:-/opt/corekit}"
STATE_FILE="${OC_HOST_ROOT}/corekit/STATE.json"

# Simple JSON value reader
json_value() {
  grep -o "\"${1}\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$2" 2>/dev/null | head -1 | sed 's/.*: *"\([^"]*\)"/\1/'
}

case "${1:-}" in
  --check)
    # Check installed state
    if [[ ! -f "$STATE_FILE" ]]; then
      echo "No STATE.json found. CoreKit not installed."
      exit 1
    fi
    ref="$(json_value "coreRef" "$STATE_FILE")"
    at="$(json_value "installedAt" "$STATE_FILE")"
    echo "Installed: ${ref} (at ${at})"
    echo "Run 'install.sh --check' for full integrity check."
    ;;
  --apply)
    ref="${2:-}"
    if [[ -z "$ref" ]]; then
      echo "Usage: upgrade-corekit --apply <ref>"
      echo "  Example: upgrade-corekit --apply v0.3.0"
      exit 1
    fi
    echo "==> Upgrading CoreKit to ${ref}..."

    # Resolve branch name to commit SHA to bypass GitHub raw CDN cache
    RESOLVED_REF="$ref"
    if [[ ! "$ref" =~ ^[0-9a-f]{40}$ ]]; then
      RESOLVED_SHA=$(curl -fsSL -H "Accept: application/vnd.github.v3+json" \
        "https://api.github.com/repos/${GH_OWNER:-Tachin-ai-Corporation}/${GH_REPO:-architect-prime-gcp-agent}/commits/${ref}" \
        2>/dev/null | grep -o '"sha": "[^"]*"' | head -1 | cut -d'"' -f4)
      if [[ -n "$RESOLVED_SHA" ]]; then
        echo "  Resolved ${ref} -> ${RESOLVED_SHA:0:12}"
        RESOLVED_REF="$RESOLVED_SHA"
      else
        echo "  Warning: could not resolve SHA for ${ref}, using branch name"
      fi
    fi
    CORE_BASE="https://raw.githubusercontent.com/${GH_OWNER:-Tachin-ai-Corporation}/${GH_REPO:-architect-prime-gcp-agent}/${RESOLVED_REF}"

    # Read role/job from existing STATE.json so install.sh uses correct manifests
    EXISTING_ROLE=""
    EXISTING_JOB=""
    if [[ -f "$STATE_FILE" ]]; then
      EXISTING_ROLE="$(json_value "role" "$STATE_FILE")"
      EXISTING_JOB="$(json_value "job" "$STATE_FILE")"
    fi
    # Default job for fleet agents when job is missing from STATE.json
    if [[ "$EXISTING_ROLE" == "fleet" && -z "$EXISTING_JOB" ]]; then
      EXISTING_JOB="devops"
      echo "  Defaulting job to 'devops' for fleet role"
    fi
    INSTALL_ARGS="--upgrade $ref"
    [[ -n "$EXISTING_ROLE" ]] && INSTALL_ARGS="$INSTALL_ARGS --role $EXISTING_ROLE"
    [[ -n "$EXISTING_JOB" ]] && INSTALL_ARGS="$INSTALL_ARGS --job $EXISTING_JOB"
    echo "  Role: ${EXISTING_ROLE:-legacy} | Job: ${EXISTING_JOB:-none}"

    # Model snapshot logic removed (model configs are kept in agent workspaces)

    curl -fsSL "${CORE_BASE}/infra/install.sh" | \
      GH_OWNER="${GH_OWNER:-Tachin-ai-Corporation}" \
      GH_REPO="${GH_REPO:-architect-prime-gcp-agent}" \
      OC_HOST_ROOT="$OC_HOST_ROOT" \
      INSTALL_USE_SUDO="${INSTALL_USE_SUDO:-1}" \
      bash -s -- $INSTALL_ARGS

    # ---- Brain module: install/update npm dependencies ----
    BRAIN_DIR="${OC_HOST_ROOT}/corekit/brain"
    if [[ -f "${BRAIN_DIR}/package.json" ]]; then
      echo "==> Installing brain module dependencies..."

      # Ensure node/npm are available on the host
      if ! command -v npm >/dev/null 2>&1; then
        echo "  npm not found on host — installing Node.js..."
        if command -v apt-get >/dev/null 2>&1; then
          curl -fsSL https://deb.nodesource.com/setup_20.x | bash - >/dev/null 2>&1
          apt-get install -y -qq nodejs >/dev/null 2>&1
          echo "  Node.js $(node --version 2>/dev/null || echo '?') installed"
        else
          echo "  WARNING: cannot install Node.js (no apt-get). Skipping npm install."
        fi
      fi

      if command -v npm >/dev/null 2>&1; then
        (cd "${BRAIN_DIR}" && npm install --omit=dev 2>&1 | tail -5)
        chown -R 1000:1000 "${BRAIN_DIR}/node_modules" 2>/dev/null || true
        echo "  Brain npm dependencies installed"
      fi
    fi

    # Config template rendering and discovery-models restore removed

    # ---- Install/update systemd units from corekit config ----
    UNITS_CHANGED=0
    for unit_file in "${OC_HOST_ROOT}"/corekit/*.service "${OC_HOST_ROOT}"/corekit/*.timer; do
      [[ -f "$unit_file" ]] || continue
      UNIT_NAME="$(basename "$unit_file")"
      if ! diff -q "$unit_file" "/etc/systemd/system/${UNIT_NAME}" >/dev/null 2>&1; then
        cp "$unit_file" "/etc/systemd/system/${UNIT_NAME}"
        echo "  Installed: ${UNIT_NAME}"
        UNITS_CHANGED=1
      fi
    done
    if [[ "$UNITS_CHANGED" -eq 1 ]]; then
      systemctl daemon-reload
      # Enable and start any .timer units
      for timer_file in "${OC_HOST_ROOT}"/corekit/*.timer; do
        [[ -f "$timer_file" ]] || continue
        TIMER_NAME="$(basename "$timer_file")"
        systemctl enable --now "$TIMER_NAME" 2>/dev/null || true
        echo "  Enabled: ${TIMER_NAME}"
      done
    fi

    # ---- Fleet agent workspace re-overlay ----
    # install.sh always installs main workspace to workspace/.
    # For fleet agents, re-apply the specialty workspace on top.
    CHAT_CFG="${OC_HOST_ROOT}/corekit/chat-config.json"
    if [[ -f "$CHAT_CFG" ]]; then
      # Read agent identity from chat-config (only fleet agents have this)
      AGENT_NAME="$(jq -r '.agentDisplayName // empty' "$CHAT_CFG" 2>/dev/null || true)"
      SPECIALTY_DIR=""
      # Try to find a specialty workspace
      for d in "${OC_HOST_ROOT}"/workspace-*/; do
        [[ -d "$d" ]] || continue
        # Use first non-fleet, non-brain specialty found
        bn="$(basename "$d")"
        [[ "$bn" == "workspace-fleet" ]] && continue
        [[ "$bn" == "workspace-_brain" ]] && continue
        [[ "$bn" =~ ^workspace-(temporal|prefrontal|motor|cerebellum) ]] && continue
        SPECIALTY_DIR="$d"
        break
      done
      # Fallback to fleet template
      [[ -n "$SPECIALTY_DIR" ]] || SPECIALTY_DIR="${OC_HOST_ROOT}/workspace-fleet"
      if [[ -d "$SPECIALTY_DIR" && -n "$AGENT_NAME" ]]; then
        echo "==> Re-applying fleet workspace from ${SPECIALTY_DIR}"

        # Preserve agent-generated files that should survive upgrades
        PRESERVE_DIR="/tmp/upgrade-preserve-$$"
        mkdir -p "$PRESERVE_DIR"
        for preserve_file in MEMORY.md TASK.json; do
          if [[ -f "${OC_HOST_ROOT}/workspace/${preserve_file}" ]]; then
            cp "${OC_HOST_ROOT}/workspace/${preserve_file}" "$PRESERVE_DIR/"
            echo "  Preserved: ${preserve_file}"
          fi
        done

        rm -f "${OC_HOST_ROOT}/workspace/"*.md 2>/dev/null || true
        MENTION="$(jq -r '.agentMention // empty' "$CHAT_CFG" 2>/dev/null || true)"
        PROJECT="$(jq -r '.projectId // empty' "$CHAT_CFG" 2>/dev/null || true)"
        AGENT_EMAIL="$(jq -r '.agentUserEmail // empty' "$CHAT_CFG" 2>/dev/null || true)"
        SPECIALTY="$(basename "$SPECIALTY_DIR" | sed 's/workspace-//')"
        for f in "${SPECIALTY_DIR}"/*.md; do
          [[ -f "$f" ]] || continue
          sed -e "s|{{AGENT_NAME}}|${AGENT_NAME}|g" \
              -e "s|{{SPECIALTY}}|${SPECIALTY}|g" \
              -e "s|{{PROJECT_ID}}|${PROJECT}|g" \
              -e "s|{{AGENT_USER_EMAIL}}|${AGENT_EMAIL}|g" \
              -e "s|{{DEPLOY_TIMESTAMP}}|$(date -Is)|g" \
              "$f" > "${OC_HOST_ROOT}/workspace/$(basename "$f")"
        done

        # Restore preserved files
        for preserve_file in MEMORY.md TASK.json; do
          if [[ -f "$PRESERVE_DIR/${preserve_file}" ]]; then
            cp "$PRESERVE_DIR/${preserve_file}" "${OC_HOST_ROOT}/workspace/${preserve_file}"
            echo "  Restored: ${preserve_file}"
          fi
        done
        rm -rf "$PRESERVE_DIR" 2>/dev/null || true

        echo "  Fleet workspace restored for: ${AGENT_NAME}"

        # ---- Sync custom skills from Firestore ----
        # Query per-agent custom skill state and download skill packages
        CUSTOM_SKILLS_DIR="${OC_HOST_ROOT}/workspace/custom-skills"
        GCP_PROJECT="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || echo "")"
        PRIME_ID=""
        # Read prime ID from chat-config (fleet agents store their prime's ID)
        if [[ -f "$CHAT_CFG" ]]; then
          PRIME_ID="$(jq -r '.primeId // empty' "$CHAT_CFG" 2>/dev/null || true)"
        fi
        # For prime agents, read from STATE.json
        if [[ -z "$PRIME_ID" && -f "$STATE_FILE" ]]; then
          PRIME_ID="$(json_value "primeId" "$STATE_FILE" 2>/dev/null || true)"
        fi
        # Fleet agent name for Firestore path
        FLEET_AGENT_ID="$AGENT_NAME"
        # Prime agents use "prime-{id}" as their fleet doc key
        if [[ "$EXISTING_ROLE" == "prime" ]]; then
          FLEET_AGENT_ID="prime-${PRIME_ID}"
        fi

        if [[ -n "$GCP_PROJECT" && -n "$PRIME_ID" && -n "$FLEET_AGENT_ID" ]]; then
          echo "==> Syncing custom skills from Firestore..."
          # Get access token from metadata server
          ACCESS_TOKEN="$(curl -sf -H 'Metadata-Flavor: Google' \
            'http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token' \
            2>/dev/null | grep -o '"access_token":"[^"]*"' | cut -d'"' -f4 || echo "")"

          if [[ -n "$ACCESS_TOKEN" ]]; then
            FS_BASE="https://firestore.googleapis.com/v1/projects/${GCP_PROJECT}/databases/(default)/documents"
            SKILLS_PATH="primes/${PRIME_ID}/fleet/${FLEET_AGENT_ID}/skills"

            # Query custom skills collection
            SKILLS_RESPONSE="$(curl -sf \
              -H "Authorization: Bearer ${ACCESS_TOKEN}" \
              "${FS_BASE}/${SKILLS_PATH}" 2>/dev/null || echo "")"

            if [[ -n "$SKILLS_RESPONSE" ]]; then
              # Parse skill IDs from Firestore response
              SKILL_IDS="$(echo "$SKILLS_RESPONSE" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    docs = data.get('documents', [])
    for doc in docs:
        name = doc.get('name', '')
        skill_id = name.split('/')[-1] if name else ''
        if skill_id:
            print(skill_id)
except:
    pass
" 2>/dev/null || echo "")"

              if [[ -n "$SKILL_IDS" ]]; then
                # Clean and recreate custom skills dir
                rm -rf "$CUSTOM_SKILLS_DIR" 2>/dev/null || true
                mkdir -p "$CUSTOM_SKILLS_DIR"

                CUSTOM_COUNT=0
                while IFS= read -r skill_id; do
                  [[ -z "$skill_id" ]] && continue
                  SKILL_TARGET="${CUSTOM_SKILLS_DIR}/${skill_id}"
                  mkdir -p "$SKILL_TARGET"

                  # Try to download from repo (core or learned skills)
                  SKILL_JSON_URL="${CORE_BASE}/skills/${skill_id}/skill.json"
                  SKILL_MD_URL="${CORE_BASE}/skills/${skill_id}/SKILL.md"

                  # Download skill.json
                  if curl -fsSL "$SKILL_JSON_URL" -o "${SKILL_TARGET}/skill.json" 2>/dev/null; then
                    # Download SKILL.md
                    curl -fsSL "$SKILL_MD_URL" -o "${SKILL_TARGET}/SKILL.md" 2>/dev/null || true
                    CUSTOM_COUNT=$((CUSTOM_COUNT + 1))
                    echo "    Installed custom skill: ${skill_id}"
                  else
                    # Skill not in repo — check if Firestore doc has embedded content
                    SKILL_DOC="$(curl -sf \
                      -H "Authorization: Bearer ${ACCESS_TOKEN}" \
                      "${FS_BASE}/${SKILLS_PATH}/${skill_id}" 2>/dev/null || echo "")"

                    if [[ -n "$SKILL_DOC" ]]; then
                      # Extract skill_md from Firestore document if present
                      echo "$SKILL_DOC" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    fields = data.get('fields', {})
    skill_md = fields.get('skill_md', {}).get('stringValue', '')
    skill_json_str = fields.get('skill_json', {}).get('stringValue', '')
    if skill_md:
        with open('${SKILL_TARGET}/SKILL.md', 'w') as f:
            f.write(skill_md)
    if skill_json_str:
        with open('${SKILL_TARGET}/skill.json', 'w') as f:
            f.write(skill_json_str)
except:
    pass
" 2>/dev/null || true
                      if [[ -f "${SKILL_TARGET}/SKILL.md" ]]; then
                        CUSTOM_COUNT=$((CUSTOM_COUNT + 1))
                        echo "    Installed custom skill (from Firestore): ${skill_id}"
                      else
                        rm -rf "$SKILL_TARGET" 2>/dev/null || true
                        echo "    Skipped: ${skill_id} (no content found)"
                      fi
                    else
                      rm -rf "$SKILL_TARGET" 2>/dev/null || true
                    fi
                  fi
                done <<< "$SKILL_IDS"

                echo "  Custom skills synced: ${CUSTOM_COUNT}"
              else
                echo "  No custom skills configured for this agent"
              fi
            else
              echo "  No Firestore response for skills (agent may not have custom skills)"
            fi
          else
            echo "  Warning: could not get access token, skipping custom skills sync"
          fi
        else
          echo "  Skipping custom skills sync (missing GCP_PROJECT or PRIME_ID)"
        fi

        # Also re-overlay brain sub-agent workspaces
        BRAIN_SRC="${OC_HOST_ROOT}/workspace-_brain"
        if [[ -d "$BRAIN_SRC" ]]; then
          echo "==> Re-applying brain sub-agent workspaces"
          for brain_dir in cortex temporal-research temporal-memory prefrontal motor cerebellum; do
            src="${BRAIN_SRC}/${brain_dir}"
            dest="${OC_HOST_ROOT}/workspace-${brain_dir}"
            if [[ -d "$src" ]]; then
              mkdir -p "$dest"
              # Preserve brain sub-agent MEMORY.md
              if [[ -f "${dest}/MEMORY.md" ]]; then
                cp "${dest}/MEMORY.md" "/tmp/preserve-${brain_dir}-memory.md"
              fi
              rm -f "${dest}/"*.md 2>/dev/null || true
              for f in "${src}"/*.md; do
                [[ -f "$f" ]] || continue
                sed -e "s|{{AGENT_NAME}}|${AGENT_NAME}|g" \
                    -e "s|{{SPECIALTY}}|${SPECIALTY}|g" \
                    -e "s|{{PROJECT_ID}}|${PROJECT}|g" \
                    -e "s|{{AGENT_USER_EMAIL}}|${AGENT_EMAIL}|g" \
                    -e "s|{{DEPLOY_TIMESTAMP}}|$(date -Is)|g" \
                    "$f" > "${dest}/$(basename "$f")"
              done
              # Restore brain sub-agent MEMORY.md
              if [[ -f "/tmp/preserve-${brain_dir}-memory.md" ]]; then
                cp "/tmp/preserve-${brain_dir}-memory.md" "${dest}/MEMORY.md"
                rm -f "/tmp/preserve-${brain_dir}-memory.md"
                echo "    Restored: ${brain_dir}/MEMORY.md"
              fi
            fi
          done
          echo "  Brain workspaces restored"
        fi

        # Write identity lockfile if not present
        IDENTITY_LOCK="${OC_HOST_ROOT}/.identity-lock"
        if [[ -n "$AGENT_EMAIL" && ! -f "$IDENTITY_LOCK" ]]; then
          echo "$AGENT_EMAIL" > "$IDENTITY_LOCK"
          chmod 444 "$IDENTITY_LOCK"
          echo "  Identity lock written: ${AGENT_EMAIL}"
        fi

        # Run assemble-tools to generate per-agent TOOLS.md
        ASSEMBLE="${OC_HOST_ROOT}/bin/assemble-tools"
        if [[ -x "$ASSEMBLE" ]]; then
          # Determine agent type from chat-config or STATE.json
          AGENT_JOB="$(jq -r '.agentType // empty' "$CHAT_CFG" 2>/dev/null || true)"
          [[ -n "$AGENT_JOB" ]] || AGENT_JOB="$(json_value "job" "$STATE_FILE" 2>/dev/null || true)"
          [[ -n "$AGENT_JOB" ]] || AGENT_JOB="devops"
          echo "==> Assembling TOOLS.md (agent type: ${AGENT_JOB})"
          CORE_ROOT="$OC_HOST_ROOT" "$ASSEMBLE" "$AGENT_JOB" 2>&1 || echo "  (assemble-tools failed)"
        fi
      fi
    fi

    # ---- Shared workspace architecture ----
    # ADR: Agents have isolated workspaces to load distinct SOUL/TOOLS.
    # We create a central shared directory and symlink it into every workspace
    # so agents can read/write collaborative files (sandbox mode must be off).
    echo "==> Setting up shared workspace architecture..."
    SHARED_DIR="${OC_HOST_ROOT}/shared"
    mkdir -p "$SHARED_DIR"
    for dir in "${OC_HOST_ROOT}"/workspace*; do
      if [[ -d "$dir" ]]; then
        ln -snf "$SHARED_DIR" "$dir/shared"
      fi
    done

    # ---- Run contract validation ----
    VALIDATE="${OC_HOST_ROOT}/bin/validate-contracts"
    if [[ -x "$VALIDATE" ]]; then
      echo "==> Running contract validation..."
      if CORE_ROOT="$OC_HOST_ROOT" "$VALIDATE" --runtime 2>&1; then
        echo "  ✅ Contracts validated"
      else
        echo "  ⚠️  Contract validation found issues"
      fi
    fi

    # ---- Restart services ----
    echo "==> Managing services..."

    # Stop and disable legacy daemons (replaced by ears + mouth)
    for old_svc in message-daemon control-daemon inbox-daemon; do
      if systemctl is-enabled --quiet "$old_svc" 2>/dev/null; then
        systemctl stop "$old_svc" 2>/dev/null || true
        systemctl disable "$old_svc" 2>/dev/null || true
        echo "  Retired: ${old_svc}"
      fi
    done

    # Flush filesystem before restart -- docker bind-mount may cache old file
    sync
    sleep 1

    # Restart brain gateway service
    echo "==> Restarting brain gateway service..."
    systemctl restart agent-brain-gateway 2>/dev/null || true

    # Kill ALL orphaned daemon/ears/mouth node processes on the host.
    pkill -f 'message-daemon.mjs' 2>/dev/null || true
    pkill -f 'agent-ears.mjs' 2>/dev/null || true
    pkill -f 'agent-mouth.mjs' 2>/dev/null || true
    pkill -f 'agent-introspect.mjs' 2>/dev/null || true
    pkill -f 'agent-brain.mjs' 2>/dev/null || true
    sleep 1

    # Install ears + mouth + brain + introspect services
    EARS_SVC_SRC="${OC_HOST_ROOT}/corekit/agent-ears.service"
    MOUTH_SVC_SRC="${OC_HOST_ROOT}/corekit/agent-mouth.service"
    BRAIN_SVC_SRC="${OC_HOST_ROOT}/corekit/agent-brain.service"
    INTROSPECT_SVC_SRC="${OC_HOST_ROOT}/corekit/agent-introspect.service"
    if [[ -f "$EARS_SVC_SRC" ]]; then
      cp "$EARS_SVC_SRC" /etc/systemd/system/agent-ears.service
    fi
    if [[ -f "$MOUTH_SVC_SRC" ]]; then
      cp "$MOUTH_SVC_SRC" /etc/systemd/system/agent-mouth.service
    fi
    if [[ -f "$BRAIN_SVC_SRC" ]]; then
      cp "$BRAIN_SVC_SRC" /etc/systemd/system/agent-brain.service
    fi
    if [[ -f "$INTROSPECT_SVC_SRC" ]]; then
      cp "$INTROSPECT_SVC_SRC" /etc/systemd/system/agent-introspect.service
    fi
    systemctl daemon-reload

    # Enable and start ears + mouth + brain + introspect
    systemctl enable agent-ears agent-mouth agent-brain agent-introspect 2>/dev/null || true
    systemctl restart agent-ears agent-mouth agent-brain agent-introspect
    echo "  Started: agent-ears + agent-mouth + agent-brain + agent-introspect"
    ;;
  --status)
    if [[ ! -f "$STATE_FILE" ]]; then
      echo "CoreKit: NOT INSTALLED"
      exit 1
    fi
    ref="$(json_value "coreRef" "$STATE_FILE")"
    at="$(json_value "installedAt" "$STATE_FILE")"
    owner="$(json_value "owner" "$STATE_FILE")"
    repo="$(json_value "repo" "$STATE_FILE")"
    role="$(json_value "role" "$STATE_FILE")"
    job="$(json_value "job" "$STATE_FILE")"
    echo "CoreKit Status"
    echo "  Ref       : ${ref}"
    echo "  Installed : ${at}"
    echo "  Source    : ${owner}/${repo}"
    echo "  Role      : ${role:-legacy}"
    echo "  Job       : ${job:-none}"
    echo "  State     : ${STATE_FILE}"
    ;;
  *)
    echo "upgrade-corekit -- Architect Prime CoreKit upgrade tool"
    echo ""
    echo "Usage:"
    echo "  upgrade-corekit --check           Check for file drift"
    echo "  upgrade-corekit --apply <ref>     Upgrade to a new checkpoint"
    echo "  upgrade-corekit --status          Show current install info"
    exit 0
    ;;
esac
