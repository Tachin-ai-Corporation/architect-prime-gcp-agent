#!/usr/bin/env bash
# ============================================================
# upgrade-corekit -- Agent-facing CoreKit upgrade tool
#
# Usage:
#   upgrade-corekit --check           # Check for drift
#   upgrade-corekit --apply <ref>     # Upgrade to a new ref
#   upgrade-corekit --status          # Show current install info
#
# This is a thin wrapper around install.sh.
# ============================================================
set -euo pipefail

# Prevent shell self-overwrite syntax offset corruption during git pulls/upgrades by running from /tmp
if [[ "$(readlink -f "${BASH_SOURCE[0]}")" != "/tmp/upgrade-corekit" ]]; then
  cp "$(readlink -f "${BASH_SOURCE[0]}")" /tmp/upgrade-corekit
  chmod +x /tmp/upgrade-corekit
  exec /tmp/upgrade-corekit "$@"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CORE_ROOT="${CORE_ROOT:-/opt/corekit}"
STATE_FILE="${CORE_ROOT}/corekit/STATE.json"

# Simple JSON value reader
json_value() {
  grep -o "\"${1}\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" "$2" 2>/dev/null | head -1 | sed 's/.*: *"\([^"]*\)"/\1/'
}

case "${1:-}" in
  --check)
    # Check installed state
    if [[ ! -f "$STATE_FILE" ]]; then
      echo "No STATE.json found. CoreKit not installed."
      exit 1
    fi
    ref="$(json_value "coreRef" "$STATE_FILE")"
    at="$(json_value "installedAt" "$STATE_FILE")"
    echo "Installed: ${ref} (at ${at})"
    echo "Run 'install.sh --check' for full integrity check."
    ;;
  --apply)
    ref="${2:-}"
    if [[ -z "$ref" ]]; then
      echo "Usage: upgrade-corekit --apply <ref>"
      echo "  Example: upgrade-corekit --apply v0.3.0"
      exit 1
    fi
    echo "==> Upgrading CoreKit to ${ref}..."

    # Resolve owner and repo from environment, STATE.json, VM metadata, or defaults
    GH_OWNER="${GH_OWNER:-}"
    if [[ -z "$GH_OWNER" ]]; then
      if [[ -f "$STATE_FILE" ]]; then
        GH_OWNER="$(json_value "owner" "$STATE_FILE")"
      fi
    fi
    if [[ -z "$GH_OWNER" ]]; then
      GH_OWNER="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/attributes/gh_owner' 2>/dev/null || true)"
    fi
    GH_OWNER="${GH_OWNER:-YOUR_GITHUB_ORG}"

    GH_REPO="${GH_REPO:-}"
    if [[ -z "$GH_REPO" ]]; then
      if [[ -f "$STATE_FILE" ]]; then
        GH_REPO="$(json_value "repo" "$STATE_FILE")"
      fi
    fi
    if [[ -z "$GH_REPO" ]]; then
      GH_REPO="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/attributes/gh_repo' 2>/dev/null || true)"
    fi
    GH_REPO="${GH_REPO:-architect-prime-gcp-agent}"

    # ---- C-35: resolve to an immutable commit, or abort ----
    # Resolving also bypasses the GitHub raw CDN cache, but that is the lesser
    # reason. Falling back to the branch name on a resolution failure — the old
    # behavior — activated a moving target at exactly the moment we had evidence
    # something was wrong with the source. install.sh now refuses a non-SHA ref,
    # so this abort is the honest error rather than a confusing downstream one.
    RESOLVED_REF="$ref"
    if [[ ! "$ref" =~ ^[0-9a-f]{40}$ ]]; then
      RESOLVED_SHA=$(curl -fsSL -H "Accept: application/vnd.github.v3+json" \
        "https://api.github.com/repos/${GH_OWNER}/${GH_REPO}/commits/${ref}" \
        2>/dev/null | grep -o '"sha": "[^"]*"' | head -1 | cut -d'"' -f4 || echo "")
      if [[ "$RESOLVED_SHA" =~ ^[0-9a-f]{40}$ ]]; then
        echo "  Resolved ${ref} -> ${RESOLVED_SHA:0:12}"
        RESOLVED_REF="$RESOLVED_SHA"
      else
        echo "ERROR: could not resolve '${ref}' to a commit in ${GH_OWNER}/${GH_REPO}." >&2
        echo "       Refusing to upgrade from a mutable ref (C-35). Nothing was changed." >&2
        exit 1
      fi
    fi
    CORE_BASE="https://raw.githubusercontent.com/${GH_OWNER}/${GH_REPO}/${RESOLVED_REF}"

    # Read role/job from existing STATE.json so install.sh uses correct manifests
    EXISTING_ROLE=""
    EXISTING_JOB=""
    if [[ -f "$STATE_FILE" ]]; then
      EXISTING_ROLE="$(json_value "role" "$STATE_FILE")"
      EXISTING_JOB="$(json_value "job" "$STATE_FILE")"
    fi
    # Read agentType from chat-config.json as a source
    CHAT_CFG_UPGRADE="${CORE_ROOT}/corekit/chat-config.json"
    if [[ "$EXISTING_ROLE" == "fleet" && -z "$EXISTING_JOB" ]]; then
      EXISTING_JOB="$(jq -r '.agentType // .specialty // empty' "$CHAT_CFG_UPGRADE" 2>/dev/null || true)"
    fi
    # ---- Resolve the specialty from its AUTHORITATIVE source ----
    # VM metadata `specialty` is set once at fleet-deploy and is the bootstrap
    # input; STATE.json `job` is merely DERIVED from it by the previous install.
    # Treating the derived copy as truth let one bad invocation stick forever: an
    # agent deployed as `assistant` was upgraded once with `--job pm`, and every
    # upgrade after that re-read `pm` from STATE.json and reinstalled the wrong
    # specialty — wrong skills, wrong responsibilities, indefinitely. Metadata
    # wins; STATE.json and chat-config are fallbacks for pre-metadata VMs.
    META_SPECIALTY="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/attributes/specialty' 2>/dev/null || true)"
    RESOLVED_JOB=""
    if [[ "$EXISTING_ROLE" == "fleet" ]]; then
      if [[ -n "$META_SPECIALTY" ]]; then
        RESOLVED_JOB="$META_SPECIALTY"
        # Announce a correction rather than silently overwriting.
        FIRST_EXISTING="${EXISTING_JOB%% *}"
        if [[ -n "$FIRST_EXISTING" && "$FIRST_EXISTING" != "$META_SPECIALTY" ]]; then
          echo "  NOTE: STATE.json job '${FIRST_EXISTING}' disagrees with VM metadata specialty '${META_SPECIALTY}' — using metadata."
        fi
      else
        RESOLVED_JOB="${EXISTING_JOB%% *}"
      fi
      # Fail closed only after every source has been consulted — metadata last
      # was previously unreachable, because the fatal check ran before this block.
      if [[ -z "$RESOLVED_JOB" ]]; then
        echo 'ERROR: Cannot determine agent job/specialty. Checked VM metadata specialty, STATE.json job, chat-config.json agentType.' >&2
        exit 1
      fi
    fi

    INSTALL_ARGS="--upgrade $RESOLVED_REF"
    [[ -n "$EXISTING_ROLE" ]] && INSTALL_ARGS="$INSTALL_ARGS --role $EXISTING_ROLE"

    # ---- Compose the job list, deduped ----
    # Previously the whole space-joined STATE.json `job` string was re-expanded
    # into --job flags AND operator_jobs metadata was appended again — so every
    # upgrade added one more copy of each operator job, and install.sh wrote the
    # grown list straight back to STATE.json. Observed in production at 53 copies
    # of one operator job on a single agent. The specialty leads; operator layers
    # follow in metadata order; duplicates are dropped.
    OPERATOR_JOBS="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/instance/attributes/operator_jobs' 2>/dev/null || true)"
    JOB_LIST=()
    [[ -n "$RESOLVED_JOB" ]] && JOB_LIST+=("$RESOLVED_JOB")
    if [[ -n "$OPERATOR_JOBS" ]]; then
      IFS=',' read -ra OJ_ARRAY <<< "$OPERATOR_JOBS"
      for oj in "${OJ_ARRAY[@]}"; do
        oj="$(echo "$oj" | xargs)"
        [[ -n "$oj" ]] && JOB_LIST+=("$oj")
      done
    fi
    SEEN_JOBS=" "
    for j in ${JOB_LIST[@]+"${JOB_LIST[@]}"}; do
      case "$SEEN_JOBS" in *" $j "*) continue ;; esac
      SEEN_JOBS="${SEEN_JOBS}${j} "
      INSTALL_ARGS="$INSTALL_ARGS --job $j"
    done
    echo "  Role: ${EXISTING_ROLE:-legacy} | Job: ${RESOLVED_JOB:-none} | Operator: ${OPERATOR_JOBS:-none}"

    # ---- Legacy migration: remove stale workspace-{specialty}/ dirs ----
    # Allowlist: only dirs in contracts.workspaces survive
    if [[ -f "${CORE_ROOT}/corekit/contracts.json" ]]; then
      ALLOWED_WS=$(node -e "
const c = JSON.parse(require('fs').readFileSync('${CORE_ROOT}/corekit/contracts.json','utf8'));
const ws = c.workspaces || {};
for (const [k,v] of Object.entries(ws)) { if (k !== '_comment') console.log(v); }
" 2>/dev/null)
      if [[ -n "$ALLOWED_WS" ]]; then
        for d in "${CORE_ROOT}"/workspace-*/; do
          [[ -d "$d" ]] || continue
          bn=$(basename "$d")
          if ! echo "$ALLOWED_WS" | grep -qx "$bn"; then
            echo "  Removing legacy workspace dir: $bn"
            rm -rf "$d"
          fi
        done
      fi
    fi

    # ---- Legacy migration: purge pre-prune orphans (not in STATE.json) ----
    # The STATE.json-keyed prune in install.sh removes files that LEAVE a manifest
    # going forward; it cannot catch orphans that fell out BEFORE that prune
    # existed. workspace-chat was deleted from the repo/manifests long ago, but its
    # stale SKILL.md/skill.json linger on deployed VMs and misled agents into a
    # broken direct chat-send (the archie "--text" incident). One-time explicit
    # removal; idempotent (no-op once gone). C-27 / C-9.
    if [[ -d "${CORE_ROOT}/skills/workspace-chat" ]]; then
      echo "  Removing decommissioned orphan skill: skills/workspace-chat"
      rm -rf "${CORE_ROOT}/skills/workspace-chat"
    fi

    # Model snapshot logic removed (model configs are kept in agent workspaces)

    curl -fsSL "${CORE_BASE}/infra/install.sh" | \
      GH_OWNER="${GH_OWNER}" \
      GH_REPO="${GH_REPO}" \
      CORE_ROOT="$CORE_ROOT" \
      INSTALL_USE_SUDO="${INSTALL_USE_SUDO:-1}" \
      bash -s -- $INSTALL_ARGS

    # ---- Brain module: install/update npm dependencies ----
    BRAIN_DIR="${CORE_ROOT}/corekit/brain"
    if [[ -f "${BRAIN_DIR}/package.json" ]]; then
      echo "==> Installing brain module dependencies..."

      # Ensure node/npm are available on the host
      if ! command -v npm >/dev/null 2>&1; then
        echo "  npm not found on host — installing Node.js..."
        if command -v apt-get >/dev/null 2>&1; then
          curl -fsSL https://deb.nodesource.com/setup_20.x | bash - >/dev/null 2>&1
          apt-get install -y -qq nodejs >/dev/null 2>&1
          echo "  Node.js $(node --version 2>/dev/null || echo '?') installed"
        else
          echo "  WARNING: cannot install Node.js (no apt-get). Skipping npm install."
        fi
      fi

      if command -v npm >/dev/null 2>&1; then
        # `npm ci` pins the exact reviewed dependency tree (falls back for a
        # pre-lockfile ref).
        if [[ -f "${BRAIN_DIR}/package-lock.json" ]]; then
          (cd "${BRAIN_DIR}" && npm ci --omit=dev 2>&1 | tail -5)
        else
          echo "  WARNING: no package-lock.json — dependency tree is not reproducible"
          (cd "${BRAIN_DIR}" && npm install --omit=dev 2>&1 | tail -5)
        fi
        chown -R 1000:1000 "${BRAIN_DIR}/node_modules" 2>/dev/null || true
        echo "  Brain npm dependencies installed"
      fi
    fi

    # Config template rendering and discovery-models restore removed

    # ---- Install/update systemd units from corekit config ----
    UNITS_CHANGED=0
    for unit_file in "${CORE_ROOT}"/corekit/*.service "${CORE_ROOT}"/corekit/*.timer; do
      [[ -f "$unit_file" ]] || continue
      UNIT_NAME="$(basename "$unit_file")"
      
      # Determine if we need to update/re-install the unit
      NEEDS_INSTALL=0
      if ! diff -q "$unit_file" "/etc/systemd/system/${UNIT_NAME}" >/dev/null 2>&1; then
        NEEDS_INSTALL=1
      elif [[ "$UNIT_NAME" == "command-runner.service" ]]; then
        # If it is command-runner.service, also check if it lacks GCP_PROJECT_ID/PRIME_ID
        if ! grep -q "GCP_PROJECT_ID" "/etc/systemd/system/${UNIT_NAME}" 2>/dev/null || ! grep -q "PRIME_ID" "/etc/systemd/system/${UNIT_NAME}" 2>/dev/null; then
          NEEDS_INSTALL=1
        fi
      fi

      if [[ "$NEEDS_INSTALL" -eq 1 ]]; then
        # For command-runner.service, resolve and inject GCP_PROJECT_ID and PRIME_ID
        if [[ "$UNIT_NAME" == "command-runner.service" ]]; then
          OLD_PROJECT_ID=""
          OLD_PRIME_ID=""
          OLD_CORE_ROOT=""
          OLD_AGENT_ID=""
          if [[ -f "/etc/systemd/system/${UNIT_NAME}" ]]; then
            OLD_PROJECT_ID=$(grep "GCP_PROJECT_ID=" "/etc/systemd/system/${UNIT_NAME}" | cut -d= -f3 | tr -d '"' || echo "")
            OLD_PRIME_ID=$(grep "PRIME_ID=" "/etc/systemd/system/${UNIT_NAME}" | cut -d= -f3 | tr -d '"' || echo "")
            OLD_CORE_ROOT=$(grep "CORE_ROOT=" "/etc/systemd/system/${UNIT_NAME}" | cut -d= -f3 | tr -d '"' || echo "")
            OLD_AGENT_ID=$(grep "AGENT_ID=" "/etc/systemd/system/${UNIT_NAME}" | cut -d= -f3 | tr -d '"' || echo "")
          fi

          if [[ -z "$OLD_PROJECT_ID" ]]; then
            OLD_PROJECT_ID="$(curl -sf -H 'Metadata-Flavor: Google' 'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || echo "")"
          fi
          if [[ -z "$OLD_PRIME_ID" ]]; then
            if [[ -f "$STATE_FILE" ]]; then
              OLD_PRIME_ID="$(json_value "primeId" "$STATE_FILE" 2>/dev/null || true)"
            fi
          fi
          if [[ -z "$OLD_CORE_ROOT" ]]; then
            OLD_CORE_ROOT="$CORE_ROOT"
          fi

          cp "$unit_file" "/etc/systemd/system/${UNIT_NAME}"
          
          # Inject preserved/resolved env vars right under [Service]
          if [[ -n "$OLD_PROJECT_ID" ]]; then
            sed -i "/\[Service\]/a Environment=GCP_PROJECT_ID=${OLD_PROJECT_ID}" "/etc/systemd/system/${UNIT_NAME}"
          fi
          if [[ -n "$OLD_PRIME_ID" ]]; then
            sed -i "/\[Service\]/a Environment=PRIME_ID=${OLD_PRIME_ID}" "/etc/systemd/system/${UNIT_NAME}"
          fi
          if [[ -n "$OLD_CORE_ROOT" ]]; then
            sed -i "/\[Service\]/a Environment=CORE_ROOT=${OLD_CORE_ROOT}" "/etc/systemd/system/${UNIT_NAME}"
          fi
          if [[ -n "$OLD_AGENT_ID" ]]; then
            sed -i "/\[Service\]/a Environment=AGENT_ID=${OLD_AGENT_ID}" "/etc/systemd/system/${UNIT_NAME}"
          fi
        else
          cp "$unit_file" "/etc/systemd/system/${UNIT_NAME}"
        fi
        
        echo "  Installed: ${UNIT_NAME}"
        UNITS_CHANGED=1
      fi
    done
    if [[ "$UNITS_CHANGED" -eq 1 ]]; then
      systemctl daemon-reload
      # Enable and start any .timer units
      for timer_file in "${CORE_ROOT}"/corekit/*.timer; do
        [[ -f "$timer_file" ]] || continue
        TIMER_NAME="$(basename "$timer_file")"
        systemctl enable --now "$TIMER_NAME" 2>/dev/null || true
        echo "  Enabled: ${TIMER_NAME}"
      done
    fi

    # ---- Render workspace templates ----
    CHAT_CFG="${CORE_ROOT}/corekit/chat-config.json"
    if [[ -f "$CHAT_CFG" ]]; then
      TPL_NAME="$(jq -r '.agentDisplayName // .agentFirstName // empty' "$CHAT_CFG" 2>/dev/null)"
      TPL_SPECIALTY="$(jq -r '.agentType // empty' "$CHAT_CFG" 2>/dev/null)"
      TPL_SPECIALTY="${TPL_SPECIALTY:-$EXISTING_JOB}"
      TPL_EMAIL="$(jq -r '.agentUserEmail // empty' "$CHAT_CFG" 2>/dev/null)"
      TPL_PROJECT="$(jq -r '.projectId // empty' "$CHAT_CFG" 2>/dev/null)"
      TPL_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      if [[ -n "$TPL_NAME" ]]; then
        echo "==> Rendering workspace templates (agent: ${TPL_NAME}, specialty: ${TPL_SPECIALTY})"
        # Escape sed-special chars in values
        TPL_NAME_ESC="${TPL_NAME//&/\\&}"
        TPL_SPECIALTY_ESC="${TPL_SPECIALTY//&/\\&}"
        TPL_EMAIL_ESC="${TPL_EMAIL//&/\\&}"
        TPL_PROJECT_ESC="${TPL_PROJECT//&/\\&}"
        for f in "${CORE_ROOT}"/workspace*/*.md; do
          [[ -f "$f" ]] || continue
          sed -i \
            -e "s|{{AGENT_NAME}}|${TPL_NAME_ESC}|g" \
            -e "s|{{SPECIALTY}}|${TPL_SPECIALTY_ESC}|g" \
            -e "s|{{PROJECT_ID}}|${TPL_PROJECT_ESC}|g" \
            -e "s|{{AGENT_USER_EMAIL}}|${TPL_EMAIL_ESC}|g" \
            -e "s|{{DEPLOY_TIMESTAMP}}|${TPL_TS}|g" \
            "$f"
        done
      fi

      # Backfill agentType and specialty into chat-config if missing
      if [[ -n "$TPL_SPECIALTY" ]] && [[ -f "$CHAT_CFG" ]]; then
        EXISTING_TYPE=$(jq -r '.agentType // empty' "$CHAT_CFG" 2>/dev/null)
        EXISTING_SPEC=$(jq -r '.specialty // empty' "$CHAT_CFG" 2>/dev/null)
        if [[ -z "$EXISTING_TYPE" ]]; then
          jq --arg t "$TPL_SPECIALTY" '.agentType = $t' "$CHAT_CFG" > "${CHAT_CFG}.tmp" && mv "${CHAT_CFG}.tmp" "$CHAT_CFG"
          echo "  Backfilled agentType=${TPL_SPECIALTY} into chat-config.json"
        fi
        if [[ -z "$EXISTING_SPEC" ]]; then
          jq --arg t "$TPL_SPECIALTY" '.specialty = $t' "$CHAT_CFG" > "${CHAT_CFG}.tmp" && mv "${CHAT_CFG}.tmp" "$CHAT_CFG"
          echo "  Backfilled specialty=${TPL_SPECIALTY} into chat-config.json"
        fi
      fi

      # Read agent identity for downstream blocks
      AGENT_NAME="$(jq -r '.agentDisplayName // empty' "$CHAT_CFG" 2>/dev/null || true)"
      AGENT_EMAIL="$(jq -r '.agentUserEmail // empty' "$CHAT_CFG" 2>/dev/null || true)"
      if [[ -n "$AGENT_NAME" ]]; then

        # ---- Custom skills: NOT handled here (C-36) ----
        #
        # A block here used to download per-agent skill packages from Firestore
        # during a platform upgrade. Two things were wrong with that:
        #
        #   * it tied content rollout to a platform upgrade, so a deployment could
        #     not change what its agents know without changing the machinery —
        #     exactly the conflation C-36 forbids;
        #   * it derived its lookup key from `agentDisplayName` while the writer
        #     used the agent id, so a skill stored under `millie` was searched for
        #     under `Assistant Agent Millie` and never found. A pending install
        #     could not resolve, ever.
        #
        # Content now arrives through agent-content-sync, on its own timer, from
        # an assigned Fleet release — verified by digest and applied at an idle
        # mission boundary.


        # Write identity lockfile if not present
        # Skip if email is a template variable (contains $ or lacks @)
        IDENTITY_LOCK="${CORE_ROOT}/.identity-lock"
        if [[ -n "$AGENT_EMAIL" && ! -f "$IDENTITY_LOCK" && "$AGENT_EMAIL" == *@* && "$AGENT_EMAIL" != *'$'* ]]; then
          echo "$AGENT_EMAIL" > "$IDENTITY_LOCK"
          chmod 444 "$IDENTITY_LOCK"
          echo "  Identity lock written: ${AGENT_EMAIL}"
        fi

        # Run assemble-tools to generate per-agent TOOLS.md
        ASSEMBLE="${CORE_ROOT}/bin/assemble-tools"
        if [[ -x "$ASSEMBLE" ]]; then
          # Determine agent type from chat-config or STATE.json
          AGENT_JOB="$(jq -r '.agentType // empty' "$CHAT_CFG" 2>/dev/null || true)"
          [[ -n "$AGENT_JOB" ]] || AGENT_JOB="$(json_value "job" "$STATE_FILE" 2>/dev/null || true)"
          if [[ -z "$AGENT_JOB" ]]; then
            echo 'ERROR: Cannot determine agent job/specialty. Check STATE.json or chat-config.json.' >&2
            exit 1
          fi
          echo "==> Assembling TOOLS.md (agent type: ${AGENT_JOB})"
          CORE_ROOT="$CORE_ROOT" "$ASSEMBLE" "$AGENT_JOB" 2>&1 || echo "  (assemble-tools failed)"
        fi
      fi
    fi

    # ---- Assemble specialty persona (SOUL appends) ----
    # Re-apply specialty-specific SOUL_APPEND.md files to brain organ workspaces.
    # Must run AFTER template rendering (which writes base workspace SOULs).
    PERSONA_BIN="${CORE_ROOT}/bin/assemble-persona"
    if [[ -x "$PERSONA_BIN" ]]; then
      PERSONA_TYPE="${TPL_SPECIALTY:-$EXISTING_JOB}"
      if [[ -n "$PERSONA_TYPE" ]]; then
        for pt in $PERSONA_TYPE; do
          echo "==> Assembling persona (specialty: ${pt})"
          CORE_DIR="$CORE_ROOT" "$PERSONA_BIN" "$pt" 2>&1 || echo "  (assemble-persona failed for $pt)"
        done
      fi
    fi

    # ---- Shared workspace architecture ----
    # ADR: Agents have isolated workspaces to load distinct SOUL/TOOLS.
    # We create a central shared directory and symlink it into every workspace
    # so agents can read/write collaborative files (sandbox mode must be off).
    echo "==> Setting up shared workspace architecture..."
    SHARED_DIR="${CORE_ROOT}/shared"
    mkdir -p "$SHARED_DIR"
    for dir in "${CORE_ROOT}"/workspace*; do
      if [[ -d "$dir" ]]; then
        ln -snf "$SHARED_DIR" "$dir/shared"
      fi
    done

    # ---- Run contract validation (C-19: fatal, before services restart) ----
    # This ran as a warning and then restarted the daemons anyway, so an upgrade
    # that broke its own contracts still went live and still reported success.
    # Aborting here leaves the previous services running on the previous code.
    VALIDATE="${CORE_ROOT}/bin/validate-contracts"
    if [[ -x "$VALIDATE" ]]; then
      echo "==> Running contract validation..."
      if CORE_ROOT="$CORE_ROOT" "$VALIDATE" --runtime 2>&1; then
        echo "  ✅ Contracts validated"
      else
        echo "ERROR: contract validation failed after installing ${RESOLVED_REF:0:12}." >&2
        echo "       Services were NOT restarted — the previous runtime is still serving." >&2
        exit 1
      fi
    else
      echo "ERROR: validate-contracts missing at ${VALIDATE} — cannot verify this upgrade (C-19)." >&2
      echo "       Services were NOT restarted." >&2
      exit 1
    fi

    # ---- Run skill setup ----
    SKILL_SETUP="${CORE_ROOT}/bin/skill-setup"
    if [[ -x "$SKILL_SETUP" ]]; then
      echo "==> Running skill dependency setup..."
      "$SKILL_SETUP" --all || echo "  ⚠️  Skill setup had errors"
    fi

    # ---- Restart services ----
    echo "==> Managing services..."

    # Stop and disable legacy daemons (replaced by ears + mouth)
    for old_svc in message-daemon control-daemon inbox-daemon; do
      if systemctl is-enabled --quiet "$old_svc" 2>/dev/null; then
        systemctl stop "$old_svc" 2>/dev/null || true
        systemctl disable "$old_svc" 2>/dev/null || true
        echo "  Retired: ${old_svc}"
      fi
    done

    # Flush filesystem before restart -- docker bind-mount may cache old file
    sync
    sleep 1

    # Restart neural gateway service
    echo "==> Restarting neural gateway service..."
    systemctl restart agent-neural-gateway 2>/dev/null || true

    # Kill ALL orphaned daemon/ears/mouth node processes on the host.
    pkill -f 'message-daemon.mjs' 2>/dev/null || true
    pkill -f 'agent-ears.mjs' 2>/dev/null || true
    pkill -f 'agent-mouth.mjs' 2>/dev/null || true
    pkill -f 'agent-introspect.mjs' 2>/dev/null || true
    pkill -f 'agent-brain.mjs' 2>/dev/null || true
    sleep 1

    # Install ears + mouth + brain + introspect services
    EARS_SVC_SRC="${CORE_ROOT}/corekit/agent-ears.service"
    MOUTH_SVC_SRC="${CORE_ROOT}/corekit/agent-mouth.service"
    BRAIN_SVC_SRC="${CORE_ROOT}/corekit/agent-brain.service"
    INTROSPECT_SVC_SRC="${CORE_ROOT}/corekit/agent-introspect.service"
    if [[ -f "$EARS_SVC_SRC" ]]; then
      cp "$EARS_SVC_SRC" /etc/systemd/system/agent-ears.service
    fi
    if [[ -f "$MOUTH_SVC_SRC" ]]; then
      cp "$MOUTH_SVC_SRC" /etc/systemd/system/agent-mouth.service
    fi
    if [[ -f "$BRAIN_SVC_SRC" ]]; then
      cp "$BRAIN_SVC_SRC" /etc/systemd/system/agent-brain.service
    fi
    if [[ -f "$INTROSPECT_SVC_SRC" ]]; then
      cp "$INTROSPECT_SVC_SRC" /etc/systemd/system/agent-introspect.service
    fi

    # Inject AGENT_ID into brain + gateway services (fleet agents need this for core-memory-read etc.)
    CHAT_CFG="${CORE_ROOT}/corekit/chat-config.json"
    if [[ -f "$CHAT_CFG" ]]; then
      _AID="$(python3 -c "import json; print(json.load(open('${CHAT_CFG}')).get('agentId',''))" 2>/dev/null || true)"
      if [[ -n "$_AID" ]]; then
        for _svc in agent-brain agent-neural-gateway; do
          _svc_file="/etc/systemd/system/${_svc}.service"
          if [[ -f "$_svc_file" ]] && ! grep -q "AGENT_ID=" "$_svc_file"; then
            sed -i "/\[Service\]/a Environment=AGENT_ID=${_AID}" "$_svc_file"
          fi
        done
      fi
    fi

    systemctl daemon-reload

    # Enable and start ears + mouth + brain + introspect
    systemctl enable agent-ears agent-mouth agent-brain agent-introspect 2>/dev/null || true
    systemctl restart agent-ears agent-mouth agent-brain agent-introspect
    echo "  Started: agent-ears + agent-mouth + agent-brain + agent-introspect"
    ;;
  --status)
    if [[ ! -f "$STATE_FILE" ]]; then
      echo "CoreKit: NOT INSTALLED"
      exit 1
    fi
    ref="$(json_value "coreRef" "$STATE_FILE")"
    at="$(json_value "installedAt" "$STATE_FILE")"
    owner="$(json_value "owner" "$STATE_FILE")"
    repo="$(json_value "repo" "$STATE_FILE")"
    role="$(json_value "role" "$STATE_FILE")"
    job="$(json_value "job" "$STATE_FILE")"
    echo "CoreKit Status"
    echo "  Ref       : ${ref}"
    echo "  Installed : ${at}"
    echo "  Source    : ${owner}/${repo}"
    echo "  Role      : ${role:-legacy}"
    echo "  Job       : ${job:-none}"
    echo "  State     : ${STATE_FILE}"
    ;;
  *)
    echo "upgrade-corekit -- Architect Prime CoreKit upgrade tool"
    echo ""
    echo "Usage:"
    echo "  upgrade-corekit --check           Check for file drift"
    echo "  upgrade-corekit --apply <ref>     Upgrade to a new checkpoint"
    echo "  upgrade-corekit --status          Show current install info"
    exit 0
    ;;
esac
