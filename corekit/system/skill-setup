#!/usr/bin/env bash
# ============================================================
# skill-setup — Install VM dependencies declared in skill.json
#
# Reads skill.json `requires` fields and installs missing deps.
# Handles: apt, npm, pip packages and bin existence checks.
# Runs optional setup.sh in skill directory.
#
# Usage:
#   skill-setup <skill-name>   Install deps for one skill
#   skill-setup --all          Install deps for all installed skills
#
# Idempotent. Runs as root.
# ============================================================
set -euo pipefail

CORE_DIR="${CORE_DIR:-/opt/corekit}"
SKILLS_DIR="${CORE_DIR}/skills"
COREKIT_DIR="${CORE_DIR}/corekit"
SPECIALTIES_DIR="${COREKIT_DIR}/specialties"

info()  { echo "[skill-setup] $*"; }
warn()  { echo "[skill-setup] WARN: $*" >&2; }
error() { echo "[skill-setup] ERROR: $*" >&2; }

# ---- Determine specialty from chat-config.json ----
SPECIALTY=""
CHAT_CFG="${COREKIT_DIR}/chat-config.json"
if [[ -f "$CHAT_CFG" ]]; then
  SPECIALTY="$(python3 -c "import json; cfg=json.load(open('$CHAT_CFG')); print(cfg.get('specialty','') or cfg.get('agentType',''))" 2>/dev/null || true)"
fi

# ---- Setup a single skill ----
setup_skill() {
  local skill_id="$1"
  local skill_dir="$2"
  local skill_json="${skill_dir}/skill.json"

  if [[ ! -f "$skill_json" ]]; then
    return 0
  fi

  local has_requires
  has_requires="$(python3 -c "
import json, sys
d = json.load(open('$skill_json'))
sys.exit(0 if 'requires' in d else 1)
" 2>/dev/null && echo "yes" || echo "no")"

  if [[ "$has_requires" != "yes" ]]; then
    # Check for setup.sh even without requires
    if [[ -x "${skill_dir}/setup.sh" ]]; then
      info "${skill_id}: running setup.sh"
      (cd "$skill_dir" && ./setup.sh) || warn "${skill_id}: setup.sh failed"
    fi
    return 0
  fi

  info "${skill_id}: checking dependencies..."

  # ---- apt packages ----
  local apt_pkgs
  apt_pkgs="$(python3 -c "
import json
d = json.load(open('$skill_json'))
pkgs = d.get('requires',{}).get('apt',[])
print(' '.join(pkgs) if pkgs else '')
" 2>/dev/null || true)"

  if [[ -n "$apt_pkgs" ]]; then
    local missing_apt=""
    for pkg in $apt_pkgs; do
      if ! dpkg -s "$pkg" &>/dev/null; then
        missing_apt="${missing_apt} ${pkg}"
      fi
    done
    if [[ -n "$missing_apt" ]]; then
      info "${skill_id}: installing apt packages:${missing_apt}"
      apt-get update -qq 2>/dev/null || true
      apt-get install -y -qq $missing_apt || warn "${skill_id}: apt install failed for:${missing_apt}"
    fi
  fi

  # ---- npm packages ----
  local npm_pkgs
  npm_pkgs="$(python3 -c "
import json
d = json.load(open('$skill_json'))
pkgs = d.get('requires',{}).get('npm',[])
print(' '.join(pkgs) if pkgs else '')
" 2>/dev/null || true)"

  if [[ -n "$npm_pkgs" ]]; then
    for pkg in $npm_pkgs; do
      # Check if already installed globally
      if ! npm list -g "$pkg" &>/dev/null; then
        info "${skill_id}: installing npm package: ${pkg}"
        npm install -g "$pkg" 2>&1 | tail -3 || warn "${skill_id}: npm install failed for: ${pkg}"
      fi
    done
  fi

  # ---- pip packages ----
  local pip_pkgs
  pip_pkgs="$(python3 -c "
import json
d = json.load(open('$skill_json'))
pkgs = d.get('requires',{}).get('pip',[])
print(' '.join(pkgs) if pkgs else '')
" 2>/dev/null || true)"

  if [[ -n "$pip_pkgs" ]]; then
    for pkg in $pip_pkgs; do
      if ! python3 -c "import importlib; importlib.import_module('${pkg%%[>=<]*}')" &>/dev/null; then
        info "${skill_id}: installing pip package: ${pkg}"
        pip3 install --quiet "$pkg" || warn "${skill_id}: pip install failed for: ${pkg}"
      fi
    done
  fi

  # ---- bin checks (verify only) ----
  local bin_checks
  bin_checks="$(python3 -c "
import json
d = json.load(open('$skill_json'))
bins = d.get('requires',{}).get('bin',[])
print(' '.join(bins) if bins else '')
" 2>/dev/null || true)"

  if [[ -n "$bin_checks" ]]; then
    for bin in $bin_checks; do
      if ! command -v "$bin" &>/dev/null; then
        warn "${skill_id}: required binary not found: ${bin}"
      fi
    done
  fi

  # ---- Optional setup.sh ----
  if [[ -x "${skill_dir}/setup.sh" ]]; then
    info "${skill_id}: running setup.sh"
    (cd "$skill_dir" && ./setup.sh) || warn "${skill_id}: setup.sh failed"
  fi
}

# ---- Collect all skill directories ----
setup_all() {
  local count=0

  # Base skills
  # Prune dangling skill symlinks. Specialty/custom skills are symlinked into SKILLS_DIR
  # (below). When a skill is de-manifested, install.sh's reconcile removes its real dir — but
  # that sweep is `find -type f` and never touches the now-dangling symlink, so it lingers and
  # the skill stays "visible" (a de-manifested git-ops persisted on the engineer this way).
  # Remove any max-depth-1 symlink whose target no longer exists, before re-linking the current set.
  if [[ -d "$SKILLS_DIR" ]]; then
    while IFS= read -r stale; do
      [[ -n "$stale" ]] || continue
      rm -f "$stale"
      info "pruned dangling skill link: $(basename "$stale")"
    done < <(find "$SKILLS_DIR" -maxdepth 1 -type l ! -exec test -e {} \; -print 2>/dev/null)
  fi

  if [[ -d "$SKILLS_DIR" ]]; then
    for skill_dir in "$SKILLS_DIR"/*/; do
      [[ -d "$skill_dir" ]] || continue
      local skill_id
      skill_id="$(basename "$skill_dir")"
      setup_skill "$skill_id" "$skill_dir"
      count=$((count + 1))
    done
  fi

  # Specialty skills
  if [[ -n "$SPECIALTY" ]]; then
    local spec_skills_dir="${SPECIALTIES_DIR}/${SPECIALTY}/skills"
    if [[ -d "$spec_skills_dir" ]]; then
      for skill_dir in "$spec_skills_dir"/*/; do
        [[ -d "$skill_dir" ]] || continue
        local skill_id
        skill_id="$(basename "$skill_dir")"
        setup_skill "$skill_id" "$skill_dir"
        count=$((count + 1))
        # Create symlink under SKILLS_DIR so standard path /opt/corekit/skills/id works
        if [[ -d "$SKILLS_DIR" ]]; then
          ln -snf "$skill_dir" "${SKILLS_DIR}/${skill_id}"
        fi
      done
    fi
  fi

  # Custom per-agent skills
  local custom_dir="${CORE_DIR}/workspace/custom-skills"
  if [[ -d "$custom_dir" ]]; then
    for skill_dir in "$custom_dir"/*/; do
      [[ -d "$skill_dir" ]] || continue
      local skill_id
      skill_id="$(basename "$skill_dir")"
      setup_skill "$skill_id" "$skill_dir"
      count=$((count + 1))
      # Create symlink under SKILLS_DIR so standard path /opt/corekit/skills/id works
      if [[ -d "$SKILLS_DIR" ]]; then
        ln -snf "$skill_dir" "${SKILLS_DIR}/${skill_id}"
      fi
    done
  fi

  info "Checked ${count} skill directories"
}

# ---- Retire the generated capability map ----
# This used to BUILD ${CORE_DIR}/skill-capability-map.md, and agent-brain preferred
# that file over deriving the map from its live skill index. So the map that decides
# what work is even possible refreshed only on a PLATFORM UPGRADE: a skill added by a
# Fleet release stayed invisible to planning until an unrelated platform event, and a
# brain restart did not help because it re-read the same stale file.
#
# The generator was also less correct than the derivation that replaced it. It globbed
# skills/*/skill.json only — missing specialty skills and workspace/custom-skills — and
# ignored skill.json `roles`, so it could advertise a capability the agent's role
# excludes. Deleting it removes a second authority over one answer, not just some code.
#
# Removal, not just non-generation: dropping the writer leaves the stale file on every
# deployed VM, and a file headed "auto-generated on deploy — do not hand-edit" that
# nothing generates and nothing reads is a trap for whoever inspects a VM next.
# Idempotent (C-18); disposal belongs to the code that created the mess.
retire_capability_map() {
  local stale="${CORE_DIR}/skill-capability-map.md"
  if [[ -f "$stale" ]]; then
    rm -f "$stale"
    echo "[skill-setup] removed ${stale} — the brain now derives this from its live skill index"
  fi
}

# ---- Main ----
if [[ "${1:-}" == "--all" ]]; then
  setup_all
  retire_capability_map
elif [[ -n "${1:-}" ]]; then
  SKILL_ID="$1"
  # Search for skill directory
  FOUND=""
  for search_dir in "$SKILLS_DIR" "${SPECIALTIES_DIR}/${SPECIALTY}/skills" "${CORE_DIR}/workspace/custom-skills"; do
    if [[ -d "${search_dir}/${SKILL_ID}" ]]; then
      FOUND="${search_dir}/${SKILL_ID}"
      break
    fi
  done
  if [[ -z "$FOUND" ]]; then
    error "Skill not found: ${SKILL_ID}"
    exit 1
  fi
  setup_skill "$SKILL_ID" "$FOUND"
else
  echo "Usage: skill-setup <skill-name> | skill-setup --all"
  exit 1
fi
