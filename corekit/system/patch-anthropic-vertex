#!/usr/bin/env bash
# ============================================================
# patch-anthropic-vertex — Fix two bugs in the bundled
# anthropic-vertex provider in OpenClaw v2026.4.15
#
# Bug A (#65715): openclaw.plugin.json references .ts extension
#   but dist builds only emit .js. Fix: sed .ts → .js
#
# Bug B (#65715): ADC env identity check fails on GCE metadata.
#   resolveAnthropicVertexAdcCredentialsPathCandidate checks
#   env !== process.env which always true for config-derived env.
#   Fix: patch the check to always proceed.
#
# Called from bootstrap after OpenClaw install, before first run.
# ============================================================
set -euo pipefail

OC_DIR="${1:-/home/node/.openclaw}"
log() { echo "[$(date -Is)] [patch-anthropic-vertex] $*"; }

# Locate the anthropic-vertex provider directory
AV_DIR=""
for candidate in \
  "$OC_DIR/node_modules/@anthropic-ai/vertex-sdk" \
  "$OC_DIR/node_modules/@openclaw/anthropic-vertex-provider" \
  "$(find "$OC_DIR" -path '*/anthropic-vertex' -type d 2>/dev/null | head -1)"; do
  [[ -d "$candidate" ]] && AV_DIR="$candidate" && break
done

if [[ -z "$AV_DIR" ]]; then
  log "anthropic-vertex provider directory not found — skipping"
  exit 0
fi
log "Found anthropic-vertex at: $AV_DIR"

# Bug A: Fix .ts → .js in plugin manifest
PLUGIN_JSON=""
for pj in "$AV_DIR/openclaw.plugin.json" \
           "$(find "$OC_DIR" -name 'openclaw.plugin.json' -path '*anthropic*' 2>/dev/null | head -1)"; do
  [[ -f "$pj" ]] && PLUGIN_JSON="$pj" && break
done

if [[ -n "$PLUGIN_JSON" ]] && grep -q 'provider-discovery\.ts' "$PLUGIN_JSON" 2>/dev/null; then
  sed -i 's/provider-discovery\.ts/provider-discovery.js/g' "$PLUGIN_JSON"
  log "Bug A fixed: .ts → .js in $(basename "$PLUGIN_JSON")"
else
  log "Bug A: plugin manifest already patched or not found"
fi

# Bug B: Fix ADC env identity check
# The check `env !== process.env` prevents GCE metadata auth from working.
# Patch it to `false` so the ADC path resolution always proceeds.
PATCHED_B=0
for jsfile in $(find "$OC_DIR" -path '*anthropic*' -name '*.js' -type f 2>/dev/null); do
  if grep -q 'env !== process\.env' "$jsfile" 2>/dev/null; then
    sed -i 's/env !== process\.env/false/g' "$jsfile"
    log "Bug B fixed: ADC env check in $(basename "$jsfile")"
    PATCHED_B=1
  fi
done
[[ $PATCHED_B -eq 0 ]] && log "Bug B: ADC env check not found or already patched"

log "Done"
