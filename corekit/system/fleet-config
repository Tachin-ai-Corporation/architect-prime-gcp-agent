#!/usr/bin/env node
// fleet-config — the Fleet Definition lifecycle, as one command.
//
// This is the single entry point for the mutable plane (C-29). Prime's authoring
// tools and the dashboard's control-plane routes are both clients of it, so
// there is exactly one implementation of "what happens when a definition
// changes" rather than one per surface — the condition that let a dashboard
// write become invisible to the runtime in the first place.
//
//   fleet-config import [--dry-run]        one-time: seed the registry from the bundled catalog
//   fleet-config list [kind]               what this deployment currently defines
//   fleet-config get <kind> <id>           one definition, with its provenance
//   fleet-config diff <changeId>           what a draft changes, in domain terms
//   fleet-config validate <changeId>       run every validator and record the verdict
//   fleet-config release <changeId...>     form an immutable release from validated changes
//   fleet-config assign <releaseId> --agents a,b [--pin]
//   fleet-config rollback <releaseId> --reason "..."
//   fleet-config compile <agentId>         the Effective Agent Spec, with its digest
//   fleet-config status                    releases, assignments, drift
//   fleet-config evaluate <agentId> --suite <path> [--save]   grade a candidate before it ships
//   fleet-config observe <releaseId> [--apply]   judge a release on the work it produced
//   fleet-config finding create --title … --class provider --invariant … --why-not … --missions …
//   fleet-config finding list [--status open]
//   fleet-config finding status <id>
//
// Output is JSON on stdout, human notes on stderr — so an agent can parse it and
// an operator can read it, without either getting the other's stream.

import { readFileSync, readdirSync, existsSync, statSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

import { createRegistry } from '../../platform/deployment/registry.mjs';
import {
  importRole, importPersona, importSkill, importProcess, importResponsibility,
} from '../../platform/deployment/importer.mjs';
import { compileAgentSpec } from '../../platform/deployment/compiler.mjs';
import { validateSet, VALIDATOR_NAMES } from '../../platform/deployment/validators.mjs';
import { diffSets, diffRevision, renderDiff, impactedAgents } from '../../platform/deployment/diff.mjs';
import { deriveMetrics, groupBySpec } from '../../platform/deployment/metrics.mjs';
import { evaluateRollout, renderDecision } from '../../platform/deployment/rollout.mjs';
import { runSuite, compareRuns, regressions, evaluationRecord, renderEvaluation } from '../../platform/deployment/evals.mjs';
import { DEFINITION_KINDS, sealRevision, assertValid, contentDigest } from '../../platform/contracts/index.mjs';
import { PLATFORM_FINDING_SCHEMA } from '../../platform/contracts/schemas/lifecycle.mjs';
import { pathFor } from '../../platform/contracts/ids.mjs';

const CORE_DIR = process.env.CORE_DIR || '/opt/corekit';
const note = (...a) => console.error('[fleet-config]', ...a);
const emit = (o) => console.log(JSON.stringify(o, null, 2));

function die(message, code = 1) {
  note('ERROR:', message);
  process.exit(code);
}

async function resolveProject() {
  if (process.env.GCP_PROJECT_ID) return process.env.GCP_PROJECT_ID;
  try {
    const r = await fetch('http://metadata.google.internal/computeMetadata/v1/project/project-id', {
      headers: { 'Metadata-Flavor': 'Google' },
    });
    if (r.ok) return (await r.text()).trim();
  } catch { /* not on GCE */ }
  die('cannot resolve the GCP project — set GCP_PROJECT_ID');
}

function actorId() {
  return process.env.FLEET_CONFIG_ACTOR || process.env.AGENT_ID || 'prime';
}

function platformVersion() {
  // The deployed CoreKit ref is the platform coordinate a definition is
  // validated against (C-32).
  try {
    const state = JSON.parse(readFileSync(join(CORE_DIR, 'corekit', 'STATE.json'), 'utf8'));
    // STATE.json's `version` is a schema counter (a number), not the platform
    // coordinate. The commit the VM actually installed is `coreRef`, and that is
    // what a definition's compatibility range and a mission's stamp must name.
    return String(state.coreRef || state.version || 'unknown');
  } catch {
    return process.env.PLATFORM_VERSION || 'unknown';
  }
}

// ── Catalog reading (import only) ──────────────────────────────────────

/**
 * Locate the bundled catalog to import from.
 *
 * The full catalog exists only in a platform release checkout — a VM installs
 * its own role's slice, not all twelve, which is correct: a fleet agent has no
 * business carrying every other specialty's files. So the one-time import runs
 * where the release does, against tenant credentials.
 *
 * `--from <path>` for an explicit checkout; `GCP_TOKEN` supplies credentials
 * when running off-VM (see platform/security/gce-auth.mjs).
 */
function catalogRoot(args = []) {
  const explicit = argValue(args, '--from');
  if (explicit) {
    if (!existsSync(join(explicit, 'specialties'))) die(`no catalog at ${explicit} (expected a specialties/ directory)`);
    return explicit;
  }
  const repo = join(dirname(fileURLToPath(import.meta.url)), '..', '..');
  if (existsSync(join(repo, 'specialties'))) return repo;
  if (existsSync(join(CORE_DIR, 'specialties'))) return CORE_DIR;
  die(
    'cannot find the bundled catalog to import from.\n' +
    '  The full catalog lives in a platform release checkout — a VM installs only its own\n' +
    '  role\'s slice. Run this from a checkout, or pass --from <path>.'
  );
}

function readCatalog(root) {
  const skillJsons = new Map();
  const skillDocs = new Map();

  const addSkillDir = (dir, id) => {
    const meta = join(dir, 'skill.json');
    if (!existsSync(meta)) return;
    skillJsons.set(id, JSON.parse(readFileSync(meta, 'utf8')));
    const doc = join(dir, 'SKILL.md');
    if (existsSync(doc)) skillDocs.set(id, readFileSync(doc, 'utf8'));
  };

  const coreDir = join(root, 'skills');
  if (existsSync(coreDir)) for (const d of readdirSync(coreDir)) addSkillDir(join(coreDir, d), d);

  const specialties = existsSync(join(root, 'specialties'))
    ? readdirSync(join(root, 'specialties')).filter((d) => statSync(join(root, 'specialties', d)).isDirectory())
    : [];

  for (const spec of specialties) {
    const sd = join(root, 'specialties', spec, 'skills');
    if (existsSync(sd)) for (const d of readdirSync(sd)) addSkillDir(join(sd, d), d);
  }

  let agentTypes = {};
  const atPath = join(root, 'corekit', 'config', 'agent-types.json');
  if (existsSync(atPath)) agentTypes = JSON.parse(readFileSync(atPath, 'utf8')).types || {};

  return { specialties, skillJsons, skillDocs, agentTypes };
}

// ── Commands ───────────────────────────────────────────────────────────

async function cmdImport(registry, args) {
  const dryRun = args.includes('--dry-run');
  const root = catalogRoot(args);
  const { specialties, skillJsons, skillDocs, agentTypes } = readCatalog(root);
  const typeFor = (id) => Object.values(agentTypes).find((t) => t.id === id) || null;

  const edits = [];
  const notes = [];

  for (const id of specialties) {
    const kitPath = join(root, 'specialties', id, 'kit.json');
    const kit = existsSync(kitPath) ? JSON.parse(readFileSync(kitPath, 'utf8')) : null;
    const { role, notes: roleNotes } = importRole({ id, agentType: typeFor(id), kit, skillJsons });
    edits.push({ kind: 'role', draft: role });
    notes.push(...roleNotes.map((n) => `role/${id}: ${n}`));

    const brainDir = join(root, 'specialties', id, 'brain');
    if (existsSync(brainDir)) {
      for (const organ of readdirSync(brainDir)) {
        const p = join(brainDir, organ, 'SOUL_APPEND.md');
        if (!existsSync(p)) continue;
        edits.push({ kind: 'persona', draft: importPersona({ roleId: id, organ, body: readFileSync(p, 'utf8') }) });
      }
    }

    const respPath = join(root, 'specialties', id, `responsibilities-${id}.json`);
    if (existsSync(respPath)) {
      const parsed = JSON.parse(readFileSync(respPath, 'utf8'));
      for (const r of parsed.responsibilities || []) {
        edits.push({ kind: 'responsibility', draft: importResponsibility(r, id) });
      }
    }
  }

  for (const [id, meta] of skillJsons) {
    const doc = skillDocs.get(id);
    if (!doc) { notes.push(`skill/${id}: no SKILL.md — skipped`); continue; }
    edits.push({ kind: 'skill', draft: importSkill({ meta, doc }) });
  }

  const procDir = join(root, 'corekit', 'config', 'processes');
  if (existsSync(procDir)) {
    for (const f of readdirSync(procDir).filter((x) => x.endsWith('.json'))) {
      edits.push({ kind: 'process', draft: importProcess(JSON.parse(readFileSync(join(procDir, f), 'utf8'))) });
    }
  }

  const byKind = edits.reduce((acc, e) => { acc[e.kind] = (acc[e.kind] || 0) + 1; return acc; }, {});
  for (const n of notes) note(n);

  if (dryRun) {
    emit({ dryRun: true, root, counts: byKind, total: edits.length, notes });
    return;
  }

  // Seal everything first so a schema failure aborts before anything is written.
  for (const e of edits) sealRevision(e.kind, e.draft, { actor: actorId() });

  const result = await registry.createChange({
    title: 'Import the bundled catalog',
    rationale:
      'One-time seed of the tenant Fleet Definition registry from the catalog shipped with this ' +
      'platform release. After this the registry is the authority and the catalog is seed content.',
    edits,
    risk: 'low',
  });
  if (!result.ok) die(`import failed:\n${JSON.stringify(result.conflicts, null, 2)}`);

  emit({ change: result.change.id, counts: byKind, total: edits.length, notes });
}

/**
 * Author a definition — the verb this system exists for and did not have.
 *
 * Prime could `release`, `assign`, `evaluate` and `rollback` content it had no
 * way to WRITE. Every definition in the registry got there through `import`, a
 * one-time seed of the catalog shipped with the platform, so "Prime improves the
 * fleet" bottomed out in a human editing repo files.
 *
 * **Prime's shell never writes a definition.** The body arrives on stdin as JSON;
 * this command resolves the base revision, and registry.createChange() seals,
 * validates and commits it. That is the whole point of routing authorship through
 * a verb rather than a file write: an agent with a shell could otherwise put
 * anything in the registry, unsealed and unattributed.
 *
 * Almost nothing here is new. createChange already does the hard part — CAS on
 * baseRevision, revision sealing, schema validation, conflict detection, refusing
 * a no-op — and diff.mjs already computes the field-level diff. The gap was a
 * caller.
 *
 * Usage:
 *   fleet-config change create <kind>      --title T [--rationale R] [--risk r]
 *   fleet-config change update <kind>      --title T [--rationale R] [--risk r]
 *   fleet-config change deprecate <kind>/<id> --title T [--rationale R]
 *
 * The definition body is read from stdin (or --file <path>) and may be one
 * object or an array of them. deprecate needs no body.
 */
async function cmdChange(registry, args) {
  const OPS = ['create', 'update', 'deprecate'];
  const positional = args.filter((a) => !a.startsWith('--'));
  const [op, target] = positional;
  if (!OPS.includes(op) || !target) {
    die('usage: fleet-config change create|update <kind> --title T   |   change deprecate <kind>/<id> --title T');
  }

  const title = argValue(args, '--title');
  if (!title) die('--title is required: a change nobody can describe is a change nobody can review');
  const rationale = argValue(args, '--rationale') || '';
  const risk = argValue(args, '--risk') || 'medium';

  const { definitions } = await registry.readDefinitions();
  const edits = [];
  const diff = [];

  if (op === 'deprecate') {
    const [kind, id] = target.split('/');
    if (!kind || !id) die('usage: fleet-config change deprecate <kind>/<id> --title T');
    const existing = definitions.get(`${kind}/${id}`);
    if (!existing) die(`no such definition '${kind}/${id}' — nothing to deprecate`);
    if (existing.status === 'deprecated') die(`'${kind}/${id}' is already deprecated`);

    // Deprecation is an ordinary edit that sets one field. It is NOT a delete:
    // the schema keeps a deprecated definition so a rollback still has something
    // to roll back to, and the compiler is what stops shipping it.
    const { digest, revision, ...body } = existing;
    const draft = { ...body, status: 'deprecated' };
    edits.push({ kind, draft, baseRevision: revision });
    // diffRevision returns ONE entry or null, not a list. The Change schema
    // wants the diffSets() shape, so the kind/id/op/revisions are added here.
    const d = diffRevision(kind, existing, draft);
    if (d) diff.push({ kind, id, op: 'deprecate', from_revision: revision, to_revision: null, summary: d.summary, fields: d.fields });
  } else {
    const kind = target;
    const raw = argValue(args, '--file')
      ? readFileSync(argValue(args, '--file'), 'utf8')
      : readFileSync(0, 'utf8');
    if (!raw.trim()) die('no definition body on stdin (or pass --file <path>)');

    let parsed;
    try { parsed = JSON.parse(raw); }
    catch (e) { die(`the definition body is not valid JSON: ${e.message}`); }
    const drafts = Array.isArray(parsed) ? parsed : [parsed];
    if (!drafts.length) die('the definition body is an empty array');

    for (const draft of drafts) {
      if (!draft?.id) die('every definition needs an id');
      const existing = definitions.get(`${kind}/${draft.id}`);

      // create and update differ ONLY in which precondition they assert. Both
      // then take the same path, so there is no second way to write a definition.
      if (op === 'create' && existing) {
        die(`${kind}/${draft.id} already exists at revision ${existing.revision} — use "change update"`);
      }
      if (op === 'update' && !existing) {
        die(`no such definition '${kind}/${draft.id}' — use \`change create\``);
      }

      edits.push({ kind, draft, baseRevision: existing?.revision ?? null });
      const d = diffRevision(kind, existing || null, draft);
      if (d) {
        diff.push({
          kind, id: draft.id,
          op: existing ? 'update' : 'add',
          from_revision: existing?.revision ?? null,
          to_revision: null,   // sealed by createChange; unknown until it returns
          summary: d.summary, fields: d.fields,
        });
      }
    }
  }

  // Seal locally first so a schema failure aborts before anything is pushed —
  // the same discipline `import` uses. The sealed value is DISCARDED: its
  // revision would differ from the one createChange computes (a different
  // created_at digests differently), and publishing a revision id that is not
  // the one on the branch would be worse than publishing none.
  for (const e of edits) sealRevision(e.kind, e.draft, { actor: actorId() });

  const result = await registry.createChange({ title, rationale, edits, diff, risk });
  if (!result.ok) {
    emit({ ok: false, conflicts: result.conflicts });
    process.exit(3);
  }
  emit({ change: result.change.id, branch: result.branch, revisions: result.change.revisions, diff: result.change.diff, rendered: renderDiff(diff) });
}

async function cmdList(registry, args) {
  const kind = args[0];
  const { definitions, corrupt } = await registry.readDefinitions();
  const rows = [];
  for (const [key, def] of definitions) {
    const [k, id] = [key.split('/')[0], key.split('/').slice(1).join('/')];
    if (kind && k !== kind) continue;
    rows.push({ kind: k, id, revision: def.revision, status: def.status, name: def.name || null });
  }
  emit({ definitions: rows.sort((a, b) => `${a.kind}/${a.id}`.localeCompare(`${b.kind}/${b.id}`)), corrupt });
}

async function cmdGet(registry, args) {
  const [kind, id] = args;
  if (!kind || !id) die('usage: fleet-config get <kind> <id>');
  const { definitions } = await registry.readDefinitions();
  const def = definitions.get(`${kind}/${id}`);
  if (!def) die(`no such definition: ${kind}/${id}`);
  emit(def);
}

async function cmdValidate(registry, args) {
  const [changeId] = args;
  if (!changeId) die('usage: fleet-config validate <changeId>');

  const change = await registry._db.read(`fleet_changes/${changeId}`, { strict: true });
  if (!change) die(`unknown change '${changeId}'`);

  const { definitions } = await registry.readDefinitions({ branch: `change/${changeId}` });
  const list = [...definitions.entries()].map(([key, def]) => ({ kind: key.split('/')[0], def }));

  const available = {};
  for (const k of DEFINITION_KINDS) available[k] = new Set();
  for (const [key] of definitions) {
    const [k, ...rest] = key.split('/');
    available[k]?.add(rest.join('/'));
  }

  const result = validateSet({ definitions: list, available, platformVersion: platformVersion() });
  await registry.recordValidation(changeId, {
    passed: result.ok,
    errors: result.errors.map((e) => `${e.code}: ${e.message}`),
    checks: VALIDATOR_NAMES,
  });

  emit({ change: changeId, ok: result.ok, errors: result.errors, warnings: result.warnings, checks: VALIDATOR_NAMES });
  if (!result.ok) process.exit(2);
}

async function cmdDiff(registry, args) {
  const [changeId] = args;
  if (!changeId) die('usage: fleet-config diff <changeId>');

  const before = (await registry.readDefinitions()).definitions;
  const after = (await registry.readDefinitions({ branch: `change/${changeId}` })).definitions;
  const entries = diffSets(before, after);

  const roles = new Map();
  for (const [key, def] of after) if (key.startsWith('role/')) roles.set(def.id, def);
  const assignments = (await registry.listAssignments()).map((a) => ({ agent_id: a.id, role_id: a.role_id }));

  emit({ change: changeId, diff: entries, rendered: renderDiff(entries), impacted: impactedAgents(entries, roles, assignments) });
}

async function cmdRelease(registry, args) {
  const changeIds = args.filter((a) => !a.startsWith('--'));
  if (!changeIds.length) die('usage: fleet-config release <changeId...>');
  const approvedBy = argValue(args, '--approved-by');
  try {
    emit(await registry.createRelease({ changeIds, platformVersion: platformVersion(), approvedBy }));
  } catch (e) {
    if (e.code === 'CONFLICT') { emit({ ok: false, conflicts: e.conflicts }); process.exit(3); }
    throw e;
  }
}

async function cmdAssign(registry, args) {
  const [releaseId] = args.filter((a) => !a.startsWith('--'));
  if (!releaseId) die('usage: fleet-config assign <releaseId> --agents a,b [--role <id>] [--pin]');
  const agents = (argValue(args, '--agents') || '').split(',').map((s) => s.trim()).filter(Boolean);
  if (!agents.length) die('--agents is required');

  // An assignment without a role compiles to nothing. Rather than storing
  // `role_id: "unknown"` and discovering that at apply time, resolve it now:
  // an explicit --role, else the agent's existing assignment, else refuse.
  const explicitRole = argValue(args, '--role');
  const specDigests = {};
  for (const agentId of agents) {
    const existing = await registry._db.read(`fleet_assignments/${agentId}`, { strict: true });
    const roleId = explicitRole || existing?.role_id;
    if (!roleId || roleId === 'unknown') {
      die(`no role for agent '${agentId}' — pass --role <id>`);
    }
    specDigests[agentId] = { roleId };
  }

  emit(await registry.assign({ releaseId, agents, specDigests, pinned: args.includes('--pin') }));
}

async function cmdRollback(registry, args) {
  const [releaseId] = args.filter((a) => !a.startsWith('--'));
  if (!releaseId) die('usage: fleet-config rollback <releaseId> --reason "..."');
  const reason = argValue(args, '--reason') || 'unspecified';
  emit(await registry.rollback({ releaseId, reason }));
}

/**
 * Read each organ's BASE firmware, the way the sync daemon does.
 *
 * Two bugs lived in the three lines this replaces. It read
 * `workspace-<organ>/SOUL.md` — the RENDERED soul, i.e. the previous
 * composition's output, so compiling composed the overlay onto itself exactly
 * as the daemon once did. And it used `workspace-cortex/` for cortex, whose
 * workspace is historically `workspace/`, so on a real VM the path never
 * existed and cortex silently compiled from a `# cortex` stub — a spec digest
 * computed over firmware the agent has never run.
 *
 * `firmwarePath` is the one place that knows the layout, and a missing base is
 * an error rather than a stub, because a plausible-looking wrong answer here
 * propagates into a digest that gets pinned and attested.
 */
function readFirmware(personas) {
  const firmware = {};
  for (const organ of new Set(personas.map((p) => p.organ))) {
    const rel = firmwarePath(organ);
    const abs = join(CORE_DIR, rel);
    if (!existsSync(abs)) {
      die(`no base firmware at ${rel} for organ '${organ}'. ` +
        `Compiling from the rendered SOUL.md would duplicate the overlay, and compiling from a ` +
        `stub would produce a digest for firmware no agent runs.`);
    }
    firmware[organ] = readFileSync(abs, 'utf8');
  }
  return firmware;
}

async function cmdCompile(registry, args) {
  const [agentId] = args.filter((a) => !a.startsWith('--'));
  if (!agentId) die('usage: fleet-config compile <agentId>');

  const assignment = await registry._db.read(`fleet_assignments/${agentId}`, { strict: true });
  const roleId = argValue(args, '--role') || assignment?.role_id;
  if (!roleId) die(`no role for agent '${agentId}' — pass --role`);

  const { definitions } = await registry.readDefinitions();
  const role = definitions.get(`role/${roleId}`);
  if (!role) die(`no such role '${roleId}'`);

  const personas = [...definitions.values()].filter((d) => d.kind === 'persona' && d.role_id === roleId);
  const skills = (role.default_skills || [])
    .map((id) => definitions.get(`skill/${id}`))
    .filter(Boolean);
  const responsibilities = (role.responsibilities || [])
    .map((id) => definitions.get(`responsibility/${id}`))
    .filter(Boolean);

  const firmware = readFirmware(personas);

  const { spec, files, closure, warnings } = compileAgentSpec({
    agentId,
    platformVersion: platformVersion(),
    fleetRelease: assignment?.desired_release || 'fr-uncommitted',
    role, personas, skills, responsibilities, firmware,
    compiledAt: new Date().toISOString(),
  });

  for (const w of warnings) note('WARN:', w);
  emit({ spec, closure, files: Object.keys(files).sort(), warnings });
}

/**
 * Evaluate a candidate against a baseline, before any agent runs on it.
 *
 * `observe` is honest and late — something has to go wrong in production before
 * it has anything to read. This asks the same question of the compiled spec, so
 * a regression can be caught while it is still a proposal.
 *
 * The graders are deterministic (C-4). A model judging a model disagrees with
 * itself between runs, which makes a regression and a bad mood indistinguishable.
 *
 * Usage:
 *   fleet-config evaluate <agentId> --suite <path>
 *                        [--baseline <releaseId>] [--candidate <releaseId>]
 *
 * Both sides are RESOLVED RELEASES, read at their pinned content commit. The
 * baseline defaults to what the agent is running (`actual_release`) and the
 * candidate to what it has been assigned (`desired_release`).
 *
 * `--baseline` was advertised in this usage string and never read — the flag
 * existed only as documentation of an intention.
 */
async function cmdEvaluate(registry, args) {
  const [agentId] = args.filter((a) => !a.startsWith('--'));
  const suitePath = argValue(args, '--suite');
  if (!agentId || !suitePath) {
    die('usage: fleet-config evaluate <agentId> --suite <path> [--baseline <releaseId>] [--candidate <releaseId>]');
  }
  if (!existsSync(suitePath)) die(`no such suite file: ${suitePath}`);

  let suite;
  try { suite = JSON.parse(readFileSync(suitePath, 'utf8')); }
  catch (e) { die(`suite is not valid JSON: ${e.message}`); }

  const assignment = await registry._db.read(`fleet_assignments/${agentId}`, { strict: true });
  const roleId = argValue(args, '--role') || assignment?.role_id;
  if (!roleId) die(`no role for agent '${agentId}' — pass --role`);

  /** Compile the spec for one definition set. */
  const compileFrom = (definitions, fleetRelease) => {
    const role = definitions.get(`role/${roleId}`);
    if (!role) die(`no such role '${roleId}'`);
    const personas = [...definitions.values()].filter((d) => d.kind === 'persona' && d.role_id === roleId);
    return compileAgentSpec({
      agentId,
      platformVersion: platformVersion(),
      fleetRelease,
      role, personas,
      skills: (role.default_skills || []).map((id) => definitions.get(`skill/${id}`)).filter(Boolean),
      responsibilities: (role.responsibilities || []).map((id) => definitions.get(`responsibility/${id}`)).filter(Boolean),
      firmware: readFirmware(personas),
      compiledAt: new Date().toISOString(),
    });
  };

  // Resolve BOTH sides to a pinned release before compiling either.
  //
  // This used to call readDefinitions(), which reads the mutable branch tip, and
  // then compare the result to ITSELF:
  //
  //     compareRuns(candidateRun.results, candidateRun.results)
  //
  // Every case therefore came back `unchanged`, `regressions()` was always empty,
  // and the `process.exit(4)` gate below could not fire. The evaluation was not
  // weak — it was incapable, and it reported PASS while being so. A planted
  // regression must fail this gate; that is the whole point of running it.
  const candidateId = argValue(args, '--candidate') || assignment?.desired_release;
  const baselineId = argValue(args, '--baseline') || assignment?.actual_release || null;
  if (!candidateId) {
    die(`no candidate release for '${agentId}' — assign one, or pass --candidate <releaseId>`);
  }

  const candidateDefs = (await registry.readReleaseDefinitions(candidateId)).definitions;
  const candidate = compileFrom(candidateDefs, candidateId);
  const candidateRun = runSuite(suite, { spec: candidate.spec, files: candidate.files });
  if (!candidateRun.ok) die(candidateRun.reason);

  // The baseline is what the agent is RUNNING. With nothing applied yet there is
  // nothing to regress from, and the run is reported on its own rather than
  // compared against a fiction — but that branch is now the exception it always
  // claimed to be, not the only path.
  let baseline = null;
  let results;
  if (baselineId && baselineId !== candidateId) {
    const baselineDefs = (await registry.readReleaseDefinitions(baselineId)).definitions;
    baseline = compileFrom(baselineDefs, baselineId);
    const baselineRun = runSuite(suite, { spec: baseline.spec, files: baseline.files });
    if (!baselineRun.ok) die(`baseline ${baselineId}: ${baselineRun.reason}`);
    results = compareRuns(baselineRun.results, candidateRun.results);
  } else {
    results = candidateRun.results.map((r) => ({
      case_id: r.case_id, baseline_pass: false, candidate_pass: r.pass,
      verdict: r.pass ? 'improved' : 'regressed',
      notes: `${r.notes} (${baselineId ? `baseline ${baselineId} is the candidate` : 'no applied baseline'} — nothing to compare against)`,
    }));
  }

  const record = evaluationRecord({
    id: `fe-${contentDigest({ suite: suite.id, digest: candidate.spec.digest }).slice(7, 19)}`,
    suiteId: suite.id || 'unnamed',
    baseline: {
      // The release that was compiled and run, not the one the assignment
      // happened to mention. When there is no baseline the candidate digest is
      // recorded so the record still identifies what produced these results.
      release: baseline ? baselineId : null,
      agent_spec_digest: baseline ? baseline.spec.digest : candidate.spec.digest,
      platform_version: platformVersion(),
      model: suite.model || 'unspecified',
    },
    candidate: {
      change_id: argValue(args, '--change') ?? null,
      release: candidateId,
      agent_spec_digest: candidate.spec.digest,
      platform_version: platformVersion(),
      model: suite.model || 'unspecified',
    },
    results,
    createdAt: new Date().toISOString(),
  });

  note(renderEvaluation(record));
  if (args.includes('--save')) {
    await registry._db.write(pathFor('fleetEvaluation', record.id), record, { strict: true });
    note(`saved ${record.id}`);
  }
  emit(record);
  if (regressions(results).length) process.exit(4);
}

/**
 * Observe a release in flight and act on what it did.
 *
 * This is what makes a canary a canary rather than a hopeful assignment: it reads
 * the work the release actually produced — grouped by the spec digest stamped on
 * each envelope (C-32) — compares it against what the previous release did, and
 * applies the gate.
 *
 * A critical breach rolls back automatically. Everything else reports and waits,
 * because a gate that acts on ambiguity gets switched off after its first false
 * alarm.
 */
async function cmdObserve(registry, args) {
  const [releaseId] = args.filter((a) => !a.startsWith('--'));
  if (!releaseId) die('usage: fleet-config observe <releaseId> [--apply] [--stage canary|partial|fleet]');

  const release = await registry._db.read(pathFor('fleetRelease', releaseId), { strict: true });
  if (!release) die(`unknown release '${releaseId}'`);

  /** The release's own work, reporting anything the read did not cover. */
  async function workForRelease(id, digests) {
    const { work, truncated, unstamped } = await registry.readReleaseWork(id, digests);
    if (truncated) note(`NOTE: ${id} hit the mission read cap — metrics cover a sample, not a census`);
    if (unstamped) note(`NOTE: ${unstamped} mission(s) on ${id} carry no spec digest and are excluded`);
    return work;
  }

  // Which agents are on this release, and which digests they attested.
  const assignments = await registry.listAssignments();
  const onRelease = assignments.filter((a) => a.actual_release === releaseId && a.actual_spec_digest);
  if (!onRelease.length) {
    emit({ release: releaseId, action: 'hold', reason: 'no agent has applied this release yet', agents: [] });
    return;
  }

  const digests = new Set(onRelease.map((a) => a.actual_spec_digest));
  const priorId = release.parent_release;
  const prior = priorId ? await registry._db.read(pathFor('fleetRelease', priorId), { strict: true }) : null;

  // Work is deployment-rooted (C-1), so one read per release covers every agent
  // on it; the digest stamp then separates the groups.
  //
  // Ask for the release's OWN work rather than reading the collection and
  // filtering locally. `work` holds every mission the deployment has ever run,
  // so an unfiltered read returns an arbitrary slice that almost certainly
  // excludes the release being judged — and a gate that says "0 missions" when
  // it means "I looked somewhere else" is worse than no gate.
  const candidate = deriveMetrics(await workForRelease(releaseId, digests));

  let baseline = null;
  if (prior) {
    const priorDigests = new Set(assignments
      .map((a) => (a.actual_release === priorId ? a.actual_spec_digest : null))
      .filter(Boolean));
    const baselineWork = await workForRelease(priorId, priorDigests);
    if (baselineWork.length) baseline = deriveMetrics(baselineWork);
  }

  const decision = evaluateRollout({
    candidate, baseline,
    stage: argValue(args, '--stage') || (onRelease.some((a) => a.pinned) ? 'canary' : 'fleet'),
    approved: Boolean(release.evidence?.approved_by),
  });

  note(renderDecision(decision, { release: releaseId, rollbackTarget: priorId }));

  // Acting is opt-in. An automated rollback is right, but it should be a thing
  // the operator switched on rather than a surprise.
  let acted = null;
  if (decision.action === 'rollback' && args.includes('--apply')) {
    if (!priorId) {
      note('WARN: rollback indicated, but this release has no predecessor — pausing instead');
      acted = { action: 'pause', reason: 'no rollback target' };
    } else {
      acted = await registry.rollback({ releaseId, reason: decision.reason });
      note(`rolled back to ${priorId} for ${acted.agents.length} agent(s)`);
    }
  }

  emit({
    release: releaseId,
    agents: onRelease.map((a) => a.id),
    decision,
    candidate,
    baseline,
    acted,
  });

  if (decision.action === 'rollback' && !args.includes('--apply')) process.exit(4);
}

async function cmdStatus(registry) {
  const assignments = await registry.listAssignments();
  const active = await registry.activeReleaseId();
  emit({
    active_release: active,
    platform_version: platformVersion(),
    agents: assignments.map((a) => ({
      agent: a.id, role: a.role_id, desired: a.desired_release, actual: a.actual_release,
      drift: a.drift, pinned: a.pinned, error: a.last_error,
    })),
  });
}

/**
 * Platform Findings — the only bridge out of this plane (C-34).
 *
 * A finding is filed when a need genuinely cannot be met by any definition: a
 * new provider, permission class, schema, state transition or runtime mechanism.
 * The required fields are the ones a maintainer needs to act without a
 * conversation — version coordinates, mission evidence, the desired *invariant*
 * rather than a demanded implementation, and an explicit account of why no
 * Definition-plane answer exists.
 *
 * That last field is the one that keeps this honest. A finding that could have
 * been a definition is drift with paperwork, and asking the author to write down
 * why it is not makes the question unavoidable.
 */
async function cmdFinding(registry, args) {
  const [sub] = args.filter((a) => !a.startsWith('--'));

  if (sub === 'list') {
    const status = argValue(args, '--status');
    const filters = status ? [{ field: 'status', op: 'EQUAL', value: { stringValue: status } }] : [];
    const docs = await registry._db.query('', 'platform_findings', filters, { strict: true, noOrderBy: true, limit: 100 });
    emit({
      findings: (docs || []).map((f) => ({
        id: f.id, title: f.title, severity: f.severity, class: f.required_class,
        status: f.status, created_at: f.created_at, resolution: f.resolution || null,
      })),
    });
    return;
  }

  if (sub === 'status') {
    const id = args.filter((a) => !a.startsWith('--'))[1];
    if (!id) die('usage: fleet-config finding status <id>');
    const f = await registry._db.read(pathFor('platformFinding', id), { strict: true });
    if (!f) die(`no such finding '${id}'`);
    emit(f);
    return;
  }

  if (sub !== 'create') die('usage: fleet-config finding create|list|status');

  const title = argValue(args, '--title');
  const requiredClass = argValue(args, '--class');
  const invariant = argValue(args, '--invariant');
  const whyNot = argValue(args, '--why-not');
  const missions = (argValue(args, '--missions') || '').split(',').map((s) => s.trim()).filter(Boolean);

  const missing = [];
  if (!title) missing.push('--title');
  if (!requiredClass) missing.push('--class');
  if (!invariant) missing.push('--invariant');
  if (!whyNot) missing.push('--why-not');
  if (!missions.length) missing.push('--missions');
  if (missing.length) {
    die(
      `a Platform Finding requires ${missing.join(', ')}.
` +
      `  A finding a maintainer cannot reproduce is a complaint, not a report (C-34).`
    );
  }

  const logs = argValue(args, '--logs') || '';
  const scan = scanForSecrets(`${title}
${invariant}
${whyNot}
${logs}`);
  if (scan.secrets_found || scan.pii_found) {
    die(
      `refusing to file: the finding text contains ${scan.secrets_found} secret-shaped and ` +
      `${scan.pii_found} PII-shaped value(s). A finding leaves the deployment; it does not leave ` +
      `unsanitized (C-8).`
    );
  }

  const now = new Date().toISOString();
  // Best-effort, and deliberately NOT strict. These coordinates stamp a FINDING,
  // which is a note for a human — and a finding may well be ABOUT the storage
  // being degraded. Refusing to file one because the store is unreachable would
  // suppress the report exactly when it matters most. Every other _db call in
  // this file drives a lifecycle decision and fails closed.
  const assignment = await registry._db.read(`fleet_assignments/${actorId()}`).catch(() => null);

  const finding = {
    schema_version: PLATFORM_FINDING_SCHEMA.version,
    created_at: now,
    created_by: actorId(),
    title,
    severity: argValue(args, '--severity') || 'medium',
    frequency: argValue(args, '--frequency') || 'observed at least once; see the mission evidence',
    affected_scope: argValue(args, '--scope') || 'this deployment',
    platform_version: platformVersion(),
    fleet_release: assignment?.desired_release || null,
    agent_spec_digest: assignment?.desired_spec_digest || null,
    evidence: {
      mission_ids: missions,
      ...(logs ? { logs: logs.slice(0, 20000) } : {}),
      ...(argValue(args, '--repro') ? { reproduction: argValue(args, '--repro') } : {}),
    },
    desired_invariant: invariant,
    why_not_definition: whyNot,
    required_class: requiredClass,
    ...(argValue(args, '--workaround')
      ? { workaround: { description: argValue(args, '--workaround'), limitations: argValue(args, '--workaround-limits') || 'not stated' } }
      : {}),
    privacy_scan: { scanned_at: now, secrets_found: 0, pii_found: 0 },
    status: 'open',
  };

  const id = `pf-${contentDigest(finding).slice(7, 19)}`;
  const record = { id, ...finding };
  assertValid(PLATFORM_FINDING_SCHEMA, record, `platformFinding/${id}`);

  await registry._db.write(pathFor('platformFinding', id), record, { strict: true });
  note(`filed ${id} — a maintainer reviews it; nothing in this deployment changed`);
  emit(record);
}

/** Conservative scan over text that is about to leave the deployment (C-8). */
function scanForSecrets(text) {
  const secretPatterns = [
    /\bgh[pousr]_[A-Za-z0-9]{16,}\b/, /\bAIza[0-9A-Za-z_-]{20,}\b/, /\bAKIA[0-9A-Z]{16}\b/,
    /-----BEGIN [A-Z ]*PRIVATE KEY-----/, /\bxox[baprs]-[A-Za-z0-9-]{10,}\b/,
  ];
  const piiPatterns = [/\b\d{3}-\d{2}-\d{4}\b/, /\b(?:\d[ -]*?){13,16}\b/];
  return {
    secrets_found: secretPatterns.filter((re) => re.test(text)).length,
    pii_found: piiPatterns.filter((re) => re.test(text)).length,
  };
}


function argValue(args, flag) {
  const i = args.indexOf(flag);
  return i === -1 ? null : args[i + 1];
}

// ── Entry ──────────────────────────────────────────────────────────────

const [command, ...rest] = process.argv.slice(2);
if (!command || command === '--help' || command === '-h') {
  note(readFileSync(fileURLToPath(import.meta.url), 'utf8').split('\n').slice(2, 22).map((l) => l.replace(/^\/\/ ?/, '')).join('\n'));
  process.exit(command ? 0 : 1);
}

// git-store resolves its bucket and Firestore base from the ENVIRONMENT and
// caches that on first use, so passing projectId to createRegistry is not enough
// — the store never sees it. Without the variable it builds a `projects//` URL
// and Firestore answers 400 "Invalid resource field value in the request",
// which reads like a malformed query rather than a missing variable.
//
// That is every fleet-config command failing, `rollback` included, whenever the
// variable is absent — which is the normal case: /opt/corekit is root-owned, so
// this is run under sudo, and sudo does not pass it through. agent-content-sync
// hit exactly this and fixed it for itself; this caller was left behind, and
// nothing checked. Set it before anything touches the store.
const PROJECT_ID = await resolveProject();
process.env.GCP_PROJECT_ID = process.env.GCP_PROJECT_ID || PROJECT_ID;
const registry = createRegistry({ projectId: PROJECT_ID, actor: actorId(), logger: (lvl, m) => note(`${lvl}: ${m}`) });

const COMMANDS = {
  change: cmdChange,
  import: cmdImport, list: cmdList, get: cmdGet, diff: cmdDiff, validate: cmdValidate,
  release: cmdRelease, assign: cmdAssign, rollback: cmdRollback, compile: cmdCompile, status: cmdStatus,
  observe: cmdObserve, evaluate: cmdEvaluate, finding: cmdFinding,
};

const handler = COMMANDS[command];
if (!handler) die(`unknown command '${command}' (try --help)`);

try {
  await handler(registry, rest);
} catch (e) {
  die(e.message);
}
