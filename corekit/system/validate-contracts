#!/usr/bin/env bash
# ============================================================
# validate-contracts — Pre-flight contract validation
#
# Checks that all cross-cutting values in the codebase are
# consistent with contracts.json.
# ============================================================
set -uo pipefail

log()  { echo "[validate-contracts] $*"; }
fail() { echo "[validate-contracts] ❌ FAIL: $*" >&2; FAILURES=$((FAILURES + 1)); }
pass() { echo "[validate-contracts]  ✅ $*"; }

FAILURES=0
MODE="repo"
CONFIG_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --runtime) MODE="runtime"; shift ;;
    --file) CONFIG_FILE="$2"; shift 2 ;;
    --help|-h) echo "Usage: validate-contracts [--runtime] [--file <config.json>]"; exit 0 ;;
    *) echo "Unknown arg: $1"; exit 1 ;;
  esac
done

# ---- Locate contracts.json ----
if [[ "$MODE" == "runtime" ]]; then
  CORE_DIR="${CORE_DIR:-/opt/corekit}"
  CONTRACTS="${CORE_DIR}/corekit/contracts.json"
  REPO_ROOT=""
else
  # Find repo root (walk up from script location looking for .git)
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  REPO_ROOT="$(cd "$SCRIPT_DIR" && while [[ ! -d .git ]] && [[ "$PWD" != "/" ]]; do cd ..; done; pwd)"
  CONTRACTS="${REPO_ROOT}/infra/contracts.json"
fi

if [[ ! -f "$CONTRACTS" ]]; then
  echo "[validate-contracts] contracts.json not found at: $CONTRACTS"
  exit 1
fi

log "Mode: ${MODE}"
log "Contracts: ${CONTRACTS}"

# ---- Read contracts ----
read_contract() {
  python3 -c "
import json, sys
c = json.load(open('$CONTRACTS'))
keys = '$1'.split('.')
v = c
for k in keys:
    v = v[k]
print(v)
" 2>/dev/null
}

C_LOCATION="$(read_contract 'vertex.location')"
C_PRIMARY_MODEL="$(read_contract 'vertex.models.cortex')"
C_DEFAULT_AGENT="$(read_contract 'agents.defaultId')"
C_GATEWAY_PORT="$(read_contract 'gateway.port')"
C_TIMEOUT="$(read_contract 'gateway.timeoutSeconds')"

log "Contracts loaded: location=${C_LOCATION} model=${C_PRIMARY_MODEL} agent=${C_DEFAULT_AGENT}"

# ============================================================
# REPO MODE: Check source files for consistency
# ============================================================
if [[ "$MODE" == "repo" && -n "$REPO_ROOT" ]]; then
  log "Checking repo files..."

  # ---- Check 1: fleet-bootstrap.sh .env GOOGLE_CLOUD_LOCATION ----
  FLEET_BS="${REPO_ROOT}/infra/bootstrap/fleet-bootstrap.sh"
  if [[ -f "$FLEET_BS" ]]; then
    # Accept either the literal value OR the contract variable reference
    if grep -q 'GOOGLE_CLOUD_LOCATION=${C_LOCATION}' "$FLEET_BS"; then
      pass "fleet-bootstrap.sh .env location = contract-driven"
    elif grep -q "GOOGLE_CLOUD_LOCATION=${C_LOCATION}" "$FLEET_BS"; then
      pass "fleet-bootstrap.sh .env location = ${C_LOCATION}"
    else
      LOC="$(grep 'GOOGLE_CLOUD_LOCATION=' "$FLEET_BS" | head -1 | grep -oP '=\K.*' || echo 'NOT_FOUND')"
      fail "fleet-bootstrap.sh .env location = '${LOC}' (expected contract-driven or '${C_LOCATION}')"
    fi
  fi

  # ---- Check 2: prime-bootstrap.sh reads location from contracts ----
  PRIME_BS="${REPO_ROOT}/infra/bootstrap/prime-bootstrap.sh"
  if [[ -f "$PRIME_BS" ]]; then
    # Accept either the literal value OR the contract variable reference
    if grep -q 'GOOGLE_CLOUD_LOCATION=${C_LOCATION}' "$PRIME_BS"; then
      pass "prime-bootstrap.sh .env location = contract-driven"
    elif grep -q "GOOGLE_CLOUD_LOCATION=${C_LOCATION}" "$PRIME_BS"; then
      pass "prime-bootstrap.sh .env location = ${C_LOCATION}"
    else
      LOC="$(grep 'GOOGLE_CLOUD_LOCATION=' "$PRIME_BS" | head -1 | grep -oP '=\K.*' || echo 'NOT_FOUND')"
      fail "prime-bootstrap.sh .env location = '${LOC}' (expected contract-driven or '${C_LOCATION}')"
    fi
  fi

  # ---- Check 4: fleet-bootstrap.sh smoke test model route ----
  if [[ -f "$FLEET_BS" ]]; then
    if grep -q "\"model\":\"brain/cortex\"" "$FLEET_BS"; then
      pass "fleet-bootstrap.sh smoke test route = brain/cortex"
    else
      ROUTE="$(grep -oP '"model":"[^"]*"' "$FLEET_BS" | head -1 || echo 'NOT_FOUND')"
      fail "fleet-bootstrap.sh smoke test route = '${ROUTE}' (expected 'brain/cortex')"
    fi
  fi

  # ---- Check 5: agent-ears.mjs model route ----
  EARS_SCRIPT="${REPO_ROOT}/corekit/daemon/agent-ears.mjs"
  if [[ -f "$EARS_SCRIPT" ]]; then
    if grep -q "'brain/cortex'" "$EARS_SCRIPT"; then
      pass "agent-ears.mjs route = brain/cortex"
    else
      ROUTE="$(grep -oP "'[^']*cortex[^']*'" "$EARS_SCRIPT" | head -1 || echo 'NOT_FOUND')"
      fail "agent-ears.mjs route = '${ROUTE}' (expected 'brain/cortex')"
    fi
  fi

  # ---- Check 10: mouth config fields ----
  C_MOUTH_SOURCE="$(read_contract 'mouth.source' 2>/dev/null || echo '')"
  if [[ -n "$C_MOUTH_SOURCE" ]]; then
    if [[ "$C_MOUTH_SOURCE" == "jsonl" || "$C_MOUTH_SOURCE" == "log" ]]; then
      pass "mouth.source = ${C_MOUTH_SOURCE}"
    else
      fail "mouth.source = '${C_MOUTH_SOURCE}' (expected 'jsonl' or 'log')"
    fi
  fi

  # ---- Check 11: dispatch config fields ----
  C_BRAIN_POLL="$(read_contract 'dispatch.poll_interval_ms' 2>/dev/null || echo '')"
  if [[ -n "$C_BRAIN_POLL" ]]; then
    if [[ "$C_BRAIN_POLL" -ge 1000 && "$C_BRAIN_POLL" -le 30000 ]]; then
      pass "dispatch.poll_interval_ms = ${C_BRAIN_POLL}"
    else
      fail "dispatch.poll_interval_ms = ${C_BRAIN_POLL} (expected 1000-30000)"
    fi
  else
    fail "dispatch.poll_interval_ms missing from contracts.json"
  fi

  C_BRAIN_MAX="$(read_contract 'dispatch.max_iterations' 2>/dev/null || echo '')"
  if [[ -n "$C_BRAIN_MAX" ]]; then
    if [[ "$C_BRAIN_MAX" -ge 3 && "$C_BRAIN_MAX" -le 50 ]]; then
      pass "dispatch.max_iterations = ${C_BRAIN_MAX}"
    else
      fail "dispatch.max_iterations = ${C_BRAIN_MAX} (expected 3-50)"
    fi
  else
    fail "dispatch.max_iterations missing from contracts.json"
  fi

  C_BRAIN_TIMEOUT="$(read_contract 'dispatch.gateway_timeout_ms' 2>/dev/null || echo '')"
  if [[ -n "$C_BRAIN_TIMEOUT" ]]; then
    pass "dispatch.gateway_timeout_ms = ${C_BRAIN_TIMEOUT}"
  else
    fail "dispatch.gateway_timeout_ms missing from contracts.json"
  fi

  C_BRAIN_CTX="$(read_contract 'dispatch.context_token_budget' 2>/dev/null || echo '')"
  if [[ -n "$C_BRAIN_CTX" ]]; then
    pass "dispatch.context_token_budget = ${C_BRAIN_CTX}"
  else
    fail "dispatch.context_token_budget missing from contracts.json"
  fi

  # ---- Check 12: projects config fields ----
  C_PROJ_CTX_MAX="$(read_contract 'projects.context_max_tokens' 2>/dev/null || echo '')"
  if [[ -n "$C_PROJ_CTX_MAX" ]]; then
    if [[ "$C_PROJ_CTX_MAX" -gt 0 ]]; then
      pass "projects.context_max_tokens = ${C_PROJ_CTX_MAX}"
    else
      fail "projects.context_max_tokens = ${C_PROJ_CTX_MAX} (expected positive number)"
    fi
  else
    fail "projects.context_max_tokens missing from contracts.json"
  fi

  C_PROJ_PROMO="$(read_contract 'projects.promotion_auto' 2>/dev/null || echo '')"
  if [[ -n "$C_PROJ_PROMO" ]]; then
    if [[ "$C_PROJ_PROMO" == "True" || "$C_PROJ_PROMO" == "False" ]]; then
      pass "projects.promotion_auto = ${C_PROJ_PROMO}"
    else
      fail "projects.promotion_auto = '${C_PROJ_PROMO}' (expected boolean)"
    fi
  else
    fail "projects.promotion_auto missing from contracts.json"
  fi

  C_PROJ_ARCHIVE="$(read_contract 'projects.archive_completed_after_days' 2>/dev/null || echo '')"
  if [[ -n "$C_PROJ_ARCHIVE" ]]; then
    if [[ "$C_PROJ_ARCHIVE" -ge 0 ]]; then
      pass "projects.archive_completed_after_days = ${C_PROJ_ARCHIVE}"
    else
      fail "projects.archive_completed_after_days = ${C_PROJ_ARCHIVE} (expected non-negative number)"
    fi
  else
    fail "projects.archive_completed_after_days missing from contracts.json"
  fi
fi

# ============================================================
# RUNTIME MODE: Check live VM state
# ============================================================
if [[ "$MODE" == "runtime" ]]; then
  log "Checking runtime state..."

  # ---- Check 1: Gateway service active ----
  if systemctl is-active --quiet agent-brain-gateway 2>/dev/null; then
    pass "agent-brain-gateway service active"
  else
    fail "agent-brain-gateway service not active"
  fi

  # ---- Check 2: Gateway health ----
  HTTP="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://localhost:${C_GATEWAY_PORT}/v1/models 2>/dev/null)" || HTTP="000"
  if [[ "$HTTP" == "200" || "$HTTP" == "401" ]]; then
    pass "Gateway healthy (HTTP ${HTTP})"
  else
    fail "Gateway unhealthy (HTTP ${HTTP})"
  fi

  # ---- Check 3: Auth-profiles emptied for all agents ----
  BAD_AP=""
  for f in "${CORE_DIR}"/agents/*/agent/auth-profiles.json; do
    [ -f "$f" ] || continue
    profiles=$(python3 -c "import json; print(len(json.load(open(\"$f\")).get(\"profiles\",{})))" 2>/dev/null || echo "ERR")
    [ "$profiles" != "0" ] && BAD_AP="${BAD_AP} $f"
  done
  if [[ -z "$BAD_AP" ]]; then
    pass "Auth-profiles empty for all agents"
  else
    fail "Non-empty auth-profiles: ${BAD_AP}"
  fi

  # ---- Check 4: agent-ears.mjs route ----
  EARS_SCRIPT="${CORE_DIR}/bin/agent-ears.mjs"
  if [[ -f "$EARS_SCRIPT" ]]; then
    if grep -q "'brain/cortex'" "$EARS_SCRIPT"; then
      pass "agent-ears.mjs route = brain/cortex"
    else
      fail "agent-ears.mjs route mismatch"
    fi
  fi

  # ---- Check 5: Daemons active ----
  for svc in agent-ears agent-mouth agent-brain agent-introspect; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      pass "${svc} service active"
    else
      fail "${svc} service not active"
    fi
  done

  # ---- Check 6: Host permissions — bin dir must be 755 (not 700) ----
  BIN_DIR="${CORE_DIR}/bin"
  if [[ -d "$BIN_DIR" ]]; then
    BIN_PERMS="$(stat -c '%a' "$BIN_DIR" 2>/dev/null || echo 'UNKNOWN')"
    if [[ "$BIN_PERMS" == "755" ]]; then
      pass "bin/ dir permissions = 755"
    else
      fail "bin/ dir permissions = ${BIN_PERMS} (expected 755 — root umask bug?)"
    fi
  fi
fi

# ============================================================
# Check: Workspace SOUL.md sizes (runtime only)
# ============================================================
if [[ "$MODE" == "runtime" ]]; then
  BOOTSTRAP_LIMIT=40000
  SOUL_OVER=0
  for soul in "${CORE_DIR}"/workspace*/SOUL.md; do
    [ -f "$soul" ] || continue
    size=$(wc -c < "$soul" 2>/dev/null || echo 0)
    if [ "$size" -gt "$BOOTSTRAP_LIMIT" ]; then
      fail "$(basename $(dirname $soul))/SOUL.md is ${size} chars (limit: ${BOOTSTRAP_LIMIT})"
      SOUL_OVER=1
    fi
  done
  if [ "$SOUL_OVER" -eq 0 ]; then
    pass "All SOUL.md files within ${BOOTSTRAP_LIMIT} char limit"
  fi
fi

# ============================================================
# Summary
# ============================================================
echo ""
if [[ $FAILURES -eq 0 ]]; then
  log "✅ All contracts satisfied."
  exit 0
else
  log "❌ ${FAILURES} contract violation(s) found."
  exit 1
fi
