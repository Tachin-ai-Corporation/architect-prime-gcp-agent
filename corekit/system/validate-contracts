#!/usr/bin/env bash
# ============================================================
# validate-contracts — Pre-flight contract validation
#
# Checks that all cross-cutting values in the codebase are
# consistent with contracts.json.
# ============================================================
set -uo pipefail

log()  { echo "[validate-contracts] $*"; }
fail() { echo "[validate-contracts] ❌ FAIL: $*" >&2; FAILURES=$((FAILURES + 1)); }
pass() { echo "[validate-contracts]  ✅ $*"; }

FAILURES=0
MODE="repo"
CONFIG_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) MODE="repo"; shift ;;
    --runtime) MODE="runtime"; shift ;;
    --file) CONFIG_FILE="$2"; shift 2 ;;
    --help|-h) echo "Usage: validate-contracts [--repo|--runtime] [--file <config.json>]"; exit 0 ;;
    *) echo "Unknown arg: $1"; exit 1 ;;
  esac
done

# ---- Locate contracts.json ----
if [[ "$MODE" == "runtime" ]]; then
  CORE_DIR="${CORE_DIR:-/opt/corekit}"
  CONTRACTS="${CORE_DIR}/corekit/contracts.json"
  REPO_ROOT=""
else
  # Find repo root (walk up from script location looking for .git)
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  REPO_ROOT="$(cd "$SCRIPT_DIR" && while [[ ! -d .git ]] && [[ "$PWD" != "/" ]]; do cd ..; done; pwd)"
  CONTRACTS="${REPO_ROOT}/infra/contracts.json"
fi

if [[ ! -f "$CONTRACTS" ]]; then
  echo "[validate-contracts] contracts.json not found at: $CONTRACTS"
  exit 1
fi

log "Mode: ${MODE}"
log "Contracts: ${CONTRACTS}"

# ---- Read contracts ----
read_contract() {
  node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const keys = '$1'.split('.');
let v = c;
for (const k of keys) v = v[k];
console.log(String(v));
" 2>/dev/null
}

C_LOCATION="$(read_contract 'vertex.location')"
C_PRIMARY_MODEL="$(read_contract 'vertex.models.cortex')"
C_DEFAULT_AGENT="$(read_contract 'agents.defaultId')"
C_GATEWAY_PORT="$(read_contract 'gateway.port')"
C_TIMEOUT="$(read_contract 'gateway.timeoutSeconds')"

log "Contracts loaded: location=${C_LOCATION} model=${C_PRIMARY_MODEL} agent=${C_DEFAULT_AGENT}"

# ============================================================
# REPO MODE: Check source files for consistency
# ============================================================
if [[ "$MODE" == "repo" && -n "$REPO_ROOT" ]]; then
  log "Checking repo files..."

  # ---- Check 1: fleet-bootstrap.sh .env GOOGLE_CLOUD_LOCATION ----
  FLEET_BS="${REPO_ROOT}/infra/bootstrap/fleet-bootstrap.sh"
  if [[ -f "$FLEET_BS" ]]; then
    if grep -q 'GOOGLE_CLOUD_LOCATION=${C_LOCATION}' "$FLEET_BS"; then
      pass "fleet-bootstrap.sh .env location = contract-driven"
    elif grep -q "GOOGLE_CLOUD_LOCATION=${C_LOCATION}" "$FLEET_BS"; then
      pass "fleet-bootstrap.sh .env location = ${C_LOCATION}"
    else
      LOC="$(grep 'GOOGLE_CLOUD_LOCATION=' "$FLEET_BS" | head -1 | grep -oP '=\K.*' || echo 'NOT_FOUND')"
      fail "fleet-bootstrap.sh .env location = '${LOC}' (expected contract-driven or '${C_LOCATION}')"
    fi
  fi

  # ---- Check 2: prime-bootstrap.sh reads location from contracts ----
  PRIME_BS="${REPO_ROOT}/infra/bootstrap/prime-bootstrap.sh"
  if [[ -f "$PRIME_BS" ]]; then
    if grep -q 'GOOGLE_CLOUD_LOCATION=${C_LOCATION}' "$PRIME_BS"; then
      pass "prime-bootstrap.sh .env location = contract-driven"
    elif grep -q "GOOGLE_CLOUD_LOCATION=${C_LOCATION}" "$PRIME_BS"; then
      pass "prime-bootstrap.sh .env location = ${C_LOCATION}"
    else
      LOC="$(grep 'GOOGLE_CLOUD_LOCATION=' "$PRIME_BS" | head -1 | grep -oP '=\K.*' || echo 'NOT_FOUND')"
      fail "prime-bootstrap.sh .env location = '${LOC}' (expected contract-driven or '${C_LOCATION}')"
    fi
  fi

  # ---- Check 3: fleet-bootstrap.sh smoke test model route ----
  if [[ -f "$FLEET_BS" ]]; then
    if grep -q "\"model\":\"brain/cortex\"" "$FLEET_BS"; then
      pass "fleet-bootstrap.sh smoke test route = brain/cortex"
    else
      ROUTE="$(grep -oP '"model":"[^"]*"' "$FLEET_BS" | head -1 || echo 'NOT_FOUND')"
      fail "fleet-bootstrap.sh smoke test route = '${ROUTE}' (expected 'brain/cortex')"
    fi
  fi

  # ---- Check 4: agent-ears.mjs model route ----
  EARS_SCRIPT="${REPO_ROOT}/corekit/daemon/agent-ears.mjs"
  if [[ -f "$EARS_SCRIPT" ]]; then
    if grep -q "'brain/cortex'" "$EARS_SCRIPT"; then
      pass "agent-ears.mjs route = brain/cortex"
    else
      ROUTE="$(grep -oP "'[^']*cortex[^']*'" "$EARS_SCRIPT" | head -1 || echo 'NOT_FOUND')"
      fail "agent-ears.mjs route = '${ROUTE}' (expected 'brain/cortex')"
    fi
  fi

  # ---- Check 5: Skill SKILL.md/skill.json pairing in manifests ----
  MANIFEST_DIR="${REPO_ROOT}/infra/manifests"
  SKILL_PAIR_FAIL=0
  if [[ -d "$MANIFEST_DIR" ]]; then
    for manifest in "$MANIFEST_DIR"/*.txt; do
      [[ -f "$manifest" ]] || continue
      MNAME="$(basename "$manifest")"
      while IFS= read -r line; do
        [[ "$line" =~ ^#|^$ ]] && continue
        DEST="$(echo "$line" | awk '{print $2}')"
        [[ "$DEST" == *"/SKILL.md" ]] || continue
        SKILL_DIR="$(dirname "$DEST")"
        JSON_DEST="${SKILL_DIR}/skill.json"
        if ! grep -q "$JSON_DEST" "$manifest"; then
          fail "Skill pairing: ${MNAME} installs ${DEST} without matching skill.json"
          SKILL_PAIR_FAIL=$((SKILL_PAIR_FAIL + 1))
        fi
      done < "$manifest"
    done
    [[ $SKILL_PAIR_FAIL -eq 0 ]] && pass "All manifest SKILL.md entries have matching skill.json"
  fi

  # ---- Check 6: Manifest workspace destinations are canonical paths ----
  LIVE_PATHS="$(node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const ws = c.workspaces || {};
const paths = new Set();
for (const [k, v] of Object.entries(ws)) {
  if (k === '_comment') continue;
  paths.add(v);
}
console.log(JSON.stringify([...paths]));
" 2>/dev/null || echo '[]')"
  DEST_FAIL=0
  if [[ "$LIVE_PATHS" != "[]" && -d "$MANIFEST_DIR" ]]; then
    for manifest in "$MANIFEST_DIR"/*.txt; do
      [[ -f "$manifest" ]] || continue
      MNAME="$(basename "$manifest")"
      while IFS= read -r line; do
        [[ "$line" =~ ^#|^$ ]] && continue
        DEST="$(echo "$line" | awk '{print $2}')"
        [[ "$DEST" == workspace* ]] || continue
        WS_DIR="$(echo "$DEST" | cut -d/ -f1)"
        FOUND="$(node -e "
const paths = $LIVE_PATHS;
const ws = '$WS_DIR';
console.log(paths.includes(ws) ? 'yes' : 'no');
" 2>/dev/null || echo 'no')"
        if [[ "$FOUND" != "yes" ]]; then
          fail "Dead destination: ${MNAME} installs to ${WS_DIR}/ (not in contracts.workspaces)"
          DEST_FAIL=$((DEST_FAIL + 1))
        fi
      done < "$manifest"
    done
    [[ $DEST_FAIL -eq 0 ]] && pass "All manifest workspace destinations are canonical"
  fi

  # ---- Check 7: Specialty-id mapping ----
  TYPES_FILE="${REPO_ROOT}/corekit/config/agent-types.json"
  if [[ -f "$TYPES_FILE" ]]; then
    ID_FAIL=0
    while IFS= read -r TYPE_ID; do
      [[ -z "$TYPE_ID" ]] && continue
      if [[ ! -d "${REPO_ROOT}/specialties/${TYPE_ID}" ]]; then
        fail "Specialty-id: '${TYPE_ID}' has no specialties/${TYPE_ID}/ directory"
        ID_FAIL=$((ID_FAIL + 1))
      fi
      if [[ ! -f "${MANIFEST_DIR}/job-${TYPE_ID}.txt" ]]; then
        fail "Specialty-id: '${TYPE_ID}' has no job-${TYPE_ID}.txt manifest"
        ID_FAIL=$((ID_FAIL + 1))
      fi
    done < <(node -e "
const t = JSON.parse(require('fs').readFileSync('$TYPES_FILE','utf8'));
for (const x of t.types) console.log(x.id);
" 2>/dev/null)
    [[ $ID_FAIL -eq 0 ]] && pass "All agent-types ids have matching specialties/ and job manifest"
  fi

  # ---- Check 8: Ears gateway URL from contracts ----
  if [[ -f "$EARS_SCRIPT" ]]; then
    if grep -qP 'CONTRACTS|contracts' "$EARS_SCRIPT" && grep -qP 'gateway.*port|port.*gateway' "$EARS_SCRIPT"; then
      pass "agent-ears.mjs gateway URL reads from contracts"
    elif grep -qP '127\.0\.0\.1:\d+' "$EARS_SCRIPT"; then
      fail "agent-ears.mjs hardcodes gateway port (should read from contracts.gateway.port)"
    else
      pass "agent-ears.mjs gateway URL OK"
    fi
  fi

  # ---- Check 9: mouth config fields ----
  C_MOUTH_SOURCE="$(read_contract 'mouth.source' 2>/dev/null || echo '')"
  if [[ -n "$C_MOUTH_SOURCE" ]]; then
    if [[ "$C_MOUTH_SOURCE" == "jsonl" || "$C_MOUTH_SOURCE" == "log" ]]; then
      pass "mouth.source = ${C_MOUTH_SOURCE}"
    else
      fail "mouth.source = '${C_MOUTH_SOURCE}' (expected 'jsonl' or 'log')"
    fi
  fi

  # ---- Check 10: dispatch config fields ----
  for field in poll_interval_ms max_iterations gateway_timeout_ms context_token_budget; do
    VAL="$(read_contract "dispatch.${field}" 2>/dev/null || echo '')"
    if [[ -n "$VAL" ]]; then
      pass "dispatch.${field} = ${VAL}"
    else
      fail "dispatch.${field} missing from contracts.json"
    fi
  done

  # ---- Check 10b: idempotency config fields (fail closed) ----
  for field in step_ledger_enabled checkpoint_resume_enabled; do
    VAL="$(read_contract "dispatch.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" == "true" || "$VAL" == "false" ]]; then
      pass "dispatch.${field} = ${VAL} (boolean)"
    else
      fail "dispatch.${field} = '${VAL}' (expected boolean: true/false)"
    fi
  done

  # claim_stale_ms: must be number ≥ 60000
  CSM="$(read_contract 'dispatch.claim_stale_ms' 2>/dev/null || echo '')"
  if [[ "$CSM" =~ ^[0-9]+$ ]] && [[ "$CSM" -ge 60000 ]]; then
    pass "dispatch.claim_stale_ms = ${CSM} (≥ 60000)"
  else
    fail "dispatch.claim_stale_ms = '${CSM}' (expected number ≥ 60000)"
  fi

  # prior_results_max: optional number ≥ 10
  PRM="$(read_contract 'dispatch.prior_results_max' 2>/dev/null || echo '')"
  if [[ -z "$PRM" ]]; then
    pass "dispatch.prior_results_max not set (optional, default 25)"
  elif [[ "$PRM" =~ ^[0-9]+$ ]] && [[ "$PRM" -ge 10 ]]; then
    pass "dispatch.prior_results_max = ${PRM} (≥ 10)"
  else
    fail "dispatch.prior_results_max = '${PRM}' (expected number ≥ 10)"
  fi

  # evidence_floor_exclude_skills: must be array
  EFES="$(node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const v = c.dispatch?.evidence_floor_exclude_skills;
if (!Array.isArray(v)) { console.log('NOT_ARRAY'); process.exit(1); }
console.log(v.length);
" 2>/dev/null || echo 'NOT_ARRAY')"
  if [[ "$EFES" != "NOT_ARRAY" ]]; then
    pass "dispatch.evidence_floor_exclude_skills is array (${EFES} entries)"
  else
    fail "dispatch.evidence_floor_exclude_skills missing or not an array"
  fi

  # ---- Check 10c: utility enforce_schema tunables ----
  ESTO="$(read_contract 'utility.enforce_schema_timeout_ms' 2>/dev/null || echo '')"
  if [[ "$ESTO" =~ ^[0-9]+$ ]] && [[ "$ESTO" -ge 1000 ]]; then
    pass "utility.enforce_schema_timeout_ms = ${ESTO}"
  else
    fail "utility.enforce_schema_timeout_ms = '${ESTO}' (expected number ≥ 1000)"
  fi

  # ---- Check 11: projects config fields ----
  for field in context_max_tokens promotion_auto archive_completed_after_days; do
    VAL="$(read_contract "projects.${field}" 2>/dev/null || echo '')"
    if [[ -n "$VAL" ]]; then
      pass "projects.${field} = ${VAL}"
    else
      fail "projects.${field} missing from contracts.json"
    fi
  done

  # ---- Check 12: github block non-empty ----
  C_GH_OWNER="$(read_contract 'github.owner' 2>/dev/null || echo '')"
  C_GH_REPO="$(read_contract 'github.repo' 2>/dev/null || echo '')"
  if [[ -n "$C_GH_OWNER" && -n "$C_GH_REPO" ]]; then
    pass "github.owner = ${C_GH_OWNER}, github.repo = ${C_GH_REPO}"
  else
    fail "github.owner or github.repo is empty in contracts.json"
  fi

  # ---- Check 13: Process specialty values ∈ agent-types ids ----
  PROCESS_DIR="${REPO_ROOT}/corekit/config/processes"
  if [[ -d "$PROCESS_DIR" && -f "$TYPES_FILE" ]]; then
    PROC_FAIL=0
    VALID_IDS=$(node -e "
const t = JSON.parse(require('fs').readFileSync('$TYPES_FILE','utf8'));
const ids = t.types.map(x => x.id);
console.log(JSON.stringify(ids));
" 2>/dev/null || echo '[]')
    for pfile in "$PROCESS_DIR"/*.json; do
      [[ -f "$pfile" ]] || continue
      PNAME="$(basename "$pfile")"
      while IFS= read -r spec_val; do
        [[ -z "$spec_val" ]] && continue
        FOUND=$(node -e "
const ids = $VALID_IDS;
console.log(ids.includes('$spec_val') ? 'yes' : 'no');
" 2>/dev/null || echo 'no')
        if [[ "$FOUND" != "yes" ]]; then
          fail "Process specialty: ${PNAME} references specialty '${spec_val}' not in agent-types ids"
          PROC_FAIL=$((PROC_FAIL + 1))
        fi
      done < <(node -e "
const d = JSON.parse(require('fs').readFileSync('$pfile','utf8'));
function findSpecialties(obj) {
  if (!obj || typeof obj !== 'object') return;
  if (obj.specialty) console.log(obj.specialty);
  for (const v of Object.values(obj)) findSpecialties(v);
}
findSpecialties(d);
" 2>/dev/null)
    done
    [[ $PROC_FAIL -eq 0 ]] && pass "All process specialty values are valid agent-types ids"
  fi

  # ---- Check 14: Tri-source skill consistency ----
  # Verify: agent-types skills[] ↔ specialty dir ↔ manifest install lines
  if [[ -f "$TYPES_FILE" ]]; then
    TRI_FAIL=0
    MANIFEST_DIR="${REPO_ROOT}/infra/manifests"
    SPEC_DIR="${REPO_ROOT}/specialties"
    while IFS= read -r type_id; do
      [[ -z "$type_id" ]] && continue
      JOB_MANIFEST="${MANIFEST_DIR}/job-${type_id}.txt"
      TYPE_SPEC_DIR="${SPEC_DIR}/${type_id}/skills"

      # 14a: Every specialty skill dir must have a manifest install line
      if [[ -d "$TYPE_SPEC_DIR" ]]; then
        for skill_dir in "$TYPE_SPEC_DIR"/*/; do
          [[ -d "$skill_dir" ]] || continue
          SKILL_ID="$(basename "$skill_dir")"
          if [[ -f "$JOB_MANIFEST" ]]; then
            if ! grep -q "skills/${SKILL_ID}/skill.json" "$JOB_MANIFEST" 2>/dev/null; then
              fail "Tri-source: specialty skill ${type_id}/${SKILL_ID} has no skill.json install in job-${type_id}.txt"
              TRI_FAIL=$((TRI_FAIL + 1))
            fi
          fi
        done
      fi

      # 14b: Every non-base skill in agent-types skills[] must be installable
      BASE_SKILLS="web-search skill-introspect memory-consolidate"
      ROLE_MANIFEST="${MANIFEST_DIR}/role-fleet.txt"
      AT_SKILLS=$(node -e "
const t = JSON.parse(require('fs').readFileSync('$TYPES_FILE','utf8'));
const typ = t.types.find(x => x.id === '$type_id');
if (typ && typ.skills) typ.skills.forEach(s => console.log(s));
" 2>/dev/null)
      while IFS= read -r skill_name; do
        [[ -z "$skill_name" ]] && continue
        echo "$BASE_SKILLS" | grep -qw "$skill_name" && continue
        FOUND_IN_MANIFEST=0
        for mf in "$ROLE_MANIFEST" "$JOB_MANIFEST"; do
          [[ -f "$mf" ]] || continue
          if grep -q "skills/${skill_name}/" "$mf" 2>/dev/null; then
            FOUND_IN_MANIFEST=1
            break
          fi
        done
        if [[ $FOUND_IN_MANIFEST -eq 0 ]]; then
          fail "Tri-source: agent-types ${type_id} lists skill '${skill_name}' but no manifest installs it"
          TRI_FAIL=$((TRI_FAIL + 1))
        fi
      done <<< "$AT_SKILLS"
    done < <(node -e "
const t = JSON.parse(require('fs').readFileSync('$TYPES_FILE','utf8'));
t.types.forEach(x => console.log(x.id));
" 2>/dev/null)
    [[ $TRI_FAIL -eq 0 ]] && pass "Tri-source skill consistency verified across all agent types"
  fi
fi

# ============================================================
# RUNTIME MODE: Check live VM state
# ============================================================
if [[ "$MODE" == "runtime" ]]; then
  log "Checking runtime state..."

  # ---- Check 1: Gateway service active ----
  if systemctl is-active --quiet agent-neural-gateway 2>/dev/null; then
    pass "agent-neural-gateway service active"
  else
    fail "agent-neural-gateway service not active"
  fi

  # ---- Check 2: Gateway health ----
  HTTP="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://localhost:${C_GATEWAY_PORT}/v1/models 2>/dev/null)" || HTTP="000"
  if [[ "$HTTP" == "200" || "$HTTP" == "401" ]]; then
    pass "Gateway healthy (HTTP ${HTTP})"
  else
    fail "Gateway unhealthy (HTTP ${HTTP})"
  fi

  # ---- Check 3: Auth-profiles emptied for all agents ----
  BAD_AP=""
  for f in "${CORE_DIR}"/agents/*/agent/auth-profiles.json; do
    [ -f "$f" ] || continue
    profiles=$(node -e "const d=JSON.parse(require('fs').readFileSync('$f','utf8'));console.log(Object.keys(d.profiles||{}).length)" 2>/dev/null || echo "ERR")
    [ "$profiles" != "0" ] && BAD_AP="${BAD_AP} $f"
  done
  if [[ -z "$BAD_AP" ]]; then
    pass "Auth-profiles empty for all agents"
  else
    fail "Non-empty auth-profiles: ${BAD_AP}"
  fi

  # ---- Check 4: agent-ears.mjs route ----
  EARS_SCRIPT="${CORE_DIR}/bin/agent-ears.mjs"
  if [[ -f "$EARS_SCRIPT" ]]; then
    if grep -q "'brain/cortex'" "$EARS_SCRIPT"; then
      pass "agent-ears.mjs route = brain/cortex"
    else
      fail "agent-ears.mjs route mismatch"
    fi
  fi

  # ---- Check 5: Daemons active ----
  for svc in agent-ears agent-mouth agent-brain agent-introspect; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      pass "${svc} service active"
    else
      fail "${svc} service not active"
    fi
  done

  # ---- Check 6: Host permissions — bin dir must be 755 (not 700) ----
  BIN_DIR="${CORE_DIR}/bin"
  if [[ -d "$BIN_DIR" ]]; then
    BIN_PERMS="$(stat -c '%a' "$BIN_DIR" 2>/dev/null || echo 'UNKNOWN')"
    if [[ "$BIN_PERMS" == "755" ]]; then
      pass "bin/ dir permissions = 755"
    else
      fail "bin/ dir permissions = ${BIN_PERMS} (expected 755 — root umask bug?)"
    fi
  fi

  # ---- Check 7: No unrendered {{}} placeholders in workspace (fleet only) ----
  if [[ -f "${CORE_DIR}/corekit/chat-config.json" ]]; then
    PLACEHOLDER_FAIL=0
    for f in "${CORE_DIR}"/workspace*/*.md; do
      [[ -f "$f" ]] || continue
      if grep -qP '\{\{[A-Z_]+\}\}' "$f"; then
        BDIR=$(basename "$(dirname "$f")")
        fail "Unrendered placeholder in ${BDIR}/$(basename $f)"
        PLACEHOLDER_FAIL=$((PLACEHOLDER_FAIL + 1))
      fi
    done
    [[ $PLACEHOLDER_FAIL -eq 0 ]] && pass "All workspace .md files have rendered templates"
  fi
fi

# ============================================================
# Check: Workspace SOUL.md sizes (runtime only)
# ============================================================
if [[ "$MODE" == "runtime" ]]; then
  BOOTSTRAP_LIMIT=40000
  SOUL_OVER=0
  for soul in "${CORE_DIR}"/workspace*/SOUL.md; do
    [ -f "$soul" ] || continue
    size=$(wc -c < "$soul" 2>/dev/null || echo 0)
    if [ "$size" -gt "$BOOTSTRAP_LIMIT" ]; then
      fail "$(basename $(dirname $soul))/SOUL.md is ${size} chars (limit: ${BOOTSTRAP_LIMIT})"
      SOUL_OVER=1
    fi
  done
  if [ "$SOUL_OVER" -eq 0 ]; then
    pass "All SOUL.md files within ${BOOTSTRAP_LIMIT} char limit"
  fi
fi

# ============================================================
# Summary
# ============================================================
echo ""
if [[ $FAILURES -eq 0 ]]; then
  log "✅ All contracts satisfied."
  exit 0
else
  log "❌ ${FAILURES} contract violation(s) found."
  exit 1
fi
