#!/usr/bin/env bash
# ============================================================
# validate-contracts — Pre-flight contract validation
#
# Checks that all cross-cutting values in the codebase are
# consistent with contracts.json.
# ============================================================
set -uo pipefail

log()  { echo "[validate-contracts] $*"; }
fail() { echo "[validate-contracts] ❌ FAIL: $*" >&2; FAILURES=$((FAILURES + 1)); }
pass() { echo "[validate-contracts]  ✅ $*"; }
# Visible but non-fatal: a state that is expected right now and would be a
# defect later. Used where a deploy is legitimately incomplete rather than wrong.
warn_only() { echo "[validate-contracts]  ⚠️  $*"; }

FAILURES=0
MODE="repo"
CONFIG_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) MODE="repo"; shift ;;
    --runtime) MODE="runtime"; shift ;;
    --file) CONFIG_FILE="$2"; shift 2 ;;
    --help|-h) echo "Usage: validate-contracts [--repo|--runtime] [--file <config.json>]"; exit 0 ;;
    *) echo "Unknown arg: $1"; exit 1 ;;
  esac
done

# ---- Locate contracts.json ----
if [[ "$MODE" == "runtime" ]]; then
  CORE_DIR="${CORE_DIR:-/opt/corekit}"
  CONTRACTS="${CORE_DIR}/corekit/contracts.json"
  REPO_ROOT=""
else
  # Find repo root (walk up from script location looking for .git)
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  REPO_ROOT="$(cd "$SCRIPT_DIR" && while [[ ! -d .git ]] && [[ "$PWD" != "/" ]]; do cd ..; done; pwd)"
  cd "$REPO_ROOT"
  CONTRACTS="infra/contracts.json"
fi

if [[ ! -f "$CONTRACTS" ]]; then
  echo "[validate-contracts] contracts.json not found at: $CONTRACTS"
  exit 1
fi

log "Mode: ${MODE}"
log "Contracts: ${CONTRACTS}"

# ---- Read contracts ----
read_contract() {
  node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const keys = '$1'.split('.');
let v = c;
for (const k of keys) {
  if (v === undefined || v === null) { v = undefined; break; }
  v = v[k];
}
if (v !== undefined && v !== null) console.log(String(v));
" 2>/dev/null
}

C_LOCATION="$(read_contract 'vertex.location')"
C_PRIMARY_MODEL="$(read_contract 'vertex.models.cortex')"
C_DEFAULT_AGENT="$(read_contract 'agents.defaultId')"
C_GATEWAY_PORT="$(read_contract 'gateway.port')"
C_TIMEOUT="$(read_contract 'gateway.timeoutSeconds')"

log "Contracts loaded: location=${C_LOCATION} model=${C_PRIMARY_MODEL} agent=${C_DEFAULT_AGENT}"

# ============================================================
# REPO MODE: Check source files for consistency
# ============================================================
if [[ "$MODE" == "repo" && -n "$REPO_ROOT" ]]; then
  log "Checking repo files..."

  # ---- Check 1: fleet-bootstrap.sh .env GOOGLE_CLOUD_LOCATION ----
  FLEET_BS="infra/bootstrap/fleet-bootstrap.sh"
  if [[ -f "$FLEET_BS" ]]; then
    if grep -q 'GOOGLE_CLOUD_LOCATION=${C_LOCATION}' "$FLEET_BS"; then
      pass "fleet-bootstrap.sh .env location = contract-driven"
    elif grep -q "GOOGLE_CLOUD_LOCATION=${C_LOCATION}" "$FLEET_BS"; then
      pass "fleet-bootstrap.sh .env location = ${C_LOCATION}"
    else
      LOC="$(grep 'GOOGLE_CLOUD_LOCATION=' "$FLEET_BS" | head -1 | grep -oP '=\K.*' || echo 'NOT_FOUND')"
      fail "fleet-bootstrap.sh .env location = '${LOC}' (expected contract-driven or '${C_LOCATION}')"
    fi
  fi

  # ---- Check 2: prime-bootstrap.sh reads location from contracts ----
  PRIME_BS="infra/bootstrap/prime-bootstrap.sh"
  if [[ -f "$PRIME_BS" ]]; then
    if grep -q 'GOOGLE_CLOUD_LOCATION=${C_LOCATION}' "$PRIME_BS"; then
      pass "prime-bootstrap.sh .env location = contract-driven"
    elif grep -q "GOOGLE_CLOUD_LOCATION=${C_LOCATION}" "$PRIME_BS"; then
      pass "prime-bootstrap.sh .env location = ${C_LOCATION}"
    else
      LOC="$(grep 'GOOGLE_CLOUD_LOCATION=' "$PRIME_BS" | head -1 | grep -oP '=\K.*' || echo 'NOT_FOUND')"
      fail "prime-bootstrap.sh .env location = '${LOC}' (expected contract-driven or '${C_LOCATION}')"
    fi
  fi

  # ---- Check 3: fleet-bootstrap.sh smoke test model route ----
  if [[ -f "$FLEET_BS" ]]; then
    if grep -q "\"model\":\"brain/cortex\"" "$FLEET_BS"; then
      pass "fleet-bootstrap.sh smoke test route = brain/cortex"
    else
      ROUTE="$(grep -oP '"model":"[^"]*"' "$FLEET_BS" | head -1 || echo 'NOT_FOUND')"
      fail "fleet-bootstrap.sh smoke test route = '${ROUTE}' (expected 'brain/cortex')"
    fi
  fi

  # ---- Check 4: agent-ears.mjs model route ----
  EARS_SCRIPT="platform/runtime/agent-ears.mjs"
  if [[ -f "$EARS_SCRIPT" ]]; then
    if grep -q "'brain/cortex'" "$EARS_SCRIPT"; then
      pass "agent-ears.mjs route = brain/cortex"
    else
      ROUTE="$(grep -oP "'[^']*cortex[^']*'" "$EARS_SCRIPT" | head -1 || echo 'NOT_FOUND')"
      fail "agent-ears.mjs route = '${ROUTE}' (expected 'brain/cortex')"
    fi
  fi

  # ---- Check 5: Skill SKILL.md/skill.json pairing in manifests ----
  MANIFEST_DIR="infra/manifests"
  SKILL_PAIR_FAIL=0
  if [[ -d "$MANIFEST_DIR" ]]; then
    for manifest in "$MANIFEST_DIR"/*.txt; do
      [[ -f "$manifest" ]] || continue
      MNAME="$(basename "$manifest")"
      while IFS= read -r line; do
        [[ "$line" =~ ^#|^$ ]] && continue
        DEST="$(echo "$line" | awk '{print $2}')"
        [[ "$DEST" == *"/SKILL.md" ]] || continue
        SKILL_DIR="$(dirname "$DEST")"
        JSON_DEST="${SKILL_DIR}/skill.json"
        if ! grep -q "$JSON_DEST" "$manifest"; then
          fail "Skill pairing: ${MNAME} installs ${DEST} without matching skill.json"
          SKILL_PAIR_FAIL=$((SKILL_PAIR_FAIL + 1))
        fi
      done < "$manifest"
    done
    [[ $SKILL_PAIR_FAIL -eq 0 ]] && pass "All manifest SKILL.md entries have matching skill.json"
  fi

  # ---- Check 6: Manifest workspace destinations are canonical paths ----
  LIVE_PATHS="$(node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const ws = c.workspaces || {};
const paths = new Set();
for (const [k, v] of Object.entries(ws)) {
  if (k === '_comment') continue;
  paths.add(v);
}
console.log(JSON.stringify([...paths]));
" 2>/dev/null || echo '[]')"
  DEST_FAIL=0
  if [[ "$LIVE_PATHS" != "[]" && -d "$MANIFEST_DIR" ]]; then
    for manifest in "$MANIFEST_DIR"/*.txt; do
      [[ -f "$manifest" ]] || continue
      MNAME="$(basename "$manifest")"
      while IFS= read -r line; do
        [[ "$line" =~ ^#|^$ ]] && continue
        DEST="$(echo "$line" | awk '{print $2}')"
        [[ "$DEST" == workspace* ]] || continue
        WS_DIR="$(echo "$DEST" | cut -d/ -f1)"
        FOUND="$(node -e "
const paths = $LIVE_PATHS;
const ws = '$WS_DIR';
console.log(paths.includes(ws) ? 'yes' : 'no');
" 2>/dev/null || echo 'no')"
        if [[ "$FOUND" != "yes" ]]; then
          fail "Dead destination: ${MNAME} installs to ${WS_DIR}/ (not in contracts.workspaces)"
          DEST_FAIL=$((DEST_FAIL + 1))
        fi
      done < "$manifest"
    done
    [[ $DEST_FAIL -eq 0 ]] && pass "All manifest workspace destinations are canonical"
  fi

  # ---- Check 7: Specialty-id mapping ----
  TYPES_FILE="corekit/config/agent-types.json"
  if [[ -f "$TYPES_FILE" ]]; then
    ID_FAIL=0
    while IFS= read -r TYPE_ID; do
      [[ -z "$TYPE_ID" ]] && continue
      if [[ ! -d "specialties/${TYPE_ID}" ]]; then
        fail "Specialty-id: '${TYPE_ID}' has no specialties/${TYPE_ID}/ directory"
        ID_FAIL=$((ID_FAIL + 1))
      fi
      if [[ ! -f "${MANIFEST_DIR}/job-${TYPE_ID}.txt" ]]; then
        fail "Specialty-id: '${TYPE_ID}' has no job-${TYPE_ID}.txt manifest"
        ID_FAIL=$((ID_FAIL + 1))
      fi
    done < <(node -e "
const t = JSON.parse(require('fs').readFileSync('$TYPES_FILE','utf8'));
for (const x of t.types) console.log(x.id);
" 2>/dev/null)
    [[ $ID_FAIL -eq 0 ]] && pass "All agent-types ids have matching specialties/ and job manifest"
  fi

  # ---- Check 8: Ears gateway URL from contracts ----
  if [[ -f "$EARS_SCRIPT" ]]; then
    if grep -qP 'CONTRACTS|contracts' "$EARS_SCRIPT" && grep -qP 'gateway.*port|port.*gateway' "$EARS_SCRIPT"; then
      pass "agent-ears.mjs gateway URL reads from contracts"
    elif grep -qP '127\.0\.0\.1:\d+' "$EARS_SCRIPT"; then
      fail "agent-ears.mjs hardcodes gateway port (should read from contracts.gateway.port)"
    else
      pass "agent-ears.mjs gateway URL OK"
    fi
  fi

  # ---- Check 9: mouth config fields ----
  C_MOUTH_SOURCE="$(read_contract 'mouth.source' 2>/dev/null || echo '')"
  if [[ -n "$C_MOUTH_SOURCE" ]]; then
    if [[ "$C_MOUTH_SOURCE" == "jsonl" || "$C_MOUTH_SOURCE" == "log" ]]; then
      pass "mouth.source = ${C_MOUTH_SOURCE}"
    else
      fail "mouth.source = '${C_MOUTH_SOURCE}' (expected 'jsonl' or 'log')"
    fi
  fi

  # ---- Check 10: dispatch config fields ----
  for field in poll_interval_ms max_iterations gateway_timeout_ms context_token_budget; do
    VAL="$(read_contract "dispatch.${field}" 2>/dev/null || echo '')"
    if [[ -n "$VAL" ]]; then
      pass "dispatch.${field} = ${VAL}"
    else
      fail "dispatch.${field} missing from contracts.json"
    fi
  done

  # ---- Check 10c: brain per-task execution budget ----
  # config.mjs maxSteps for execution agents (motor/cerebellum/temporal-research). Absent →
  # code falls back to 12 (too tight for a full coding task). Must be a sane integer.
  BMI="$(read_contract 'brain.max_iterations' 2>/dev/null || echo '')"
  if [[ "$BMI" =~ ^[0-9]+$ ]] && [[ "$BMI" -ge 8 ]]; then
    pass "brain.max_iterations = ${BMI} (per-task execution-agent budget)"
  else
    fail "brain.max_iterations = '${BMI}' (expected integer >= 8)"
  fi

  # ---- Check 10b: idempotency config fields (fail closed) ----
  for field in step_ledger_enabled checkpoint_resume_enabled pass_synthesize_nudge_enabled reject_full_replan_when_passing recovered_tool_error_soft_fail blocked_requires_real_blocker delegation_capability_guard; do
    VAL="$(read_contract "dispatch.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" == "true" || "$VAL" == "false" ]]; then
      pass "dispatch.${field} = ${VAL} (boolean)"
    else
      fail "dispatch.${field} = '${VAL}' (expected boolean: true/false)"
    fi
  done

  # SESSION_CONTEXT_PLAN Phase 0b: context_token_budget must stay Firestore-safe.
  # _accumulated_context persists on the work doc (1MiB limit); budget × 4 chars
  # must leave headroom for output (800K guard) and other fields.
  CTB="$(read_contract 'dispatch.context_token_budget' 2>/dev/null || echo '')"
  if [[ "$CTB" =~ ^[0-9]+$ ]] && [[ "$CTB" -le 125000 ]]; then
    pass "dispatch.context_token_budget = ${CTB} (≤ 125000, Firestore-safe)"
  else
    fail "dispatch.context_token_budget = '${CTB}' (expected number ≤ 125000 — ×4 chars must stay under Firestore doc limits)"
  fi

  # SESSION_CONTEXT_PLAN Phase 0b: vertex.context_windows must cover every
  # model referenced in vertex.models (compaction thresholds key off these).
  CW_CHECK="$(node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const windows = c.vertex?.context_windows || {};
const models = Object.values(c.vertex?.models || {}).map(m => m.split('/').pop());
const missing = models.filter(m => !(windows[m] > 0));
console.log(missing.length === 0 ? 'OK' : 'MISSING:' + missing.join(','));
" 2>/dev/null || echo 'ERROR')"
  if [[ "$CW_CHECK" == "OK" ]]; then
    pass "vertex.context_windows covers all vertex.models entries"
  else
    fail "vertex.context_windows incomplete (${CW_CHECK})"
  fi

  # Phase E (CR-9): strong_model_agents must be an array of valid subagent ids, and if it is
  # non-empty a vertex.models.subagentStrong must exist for them to route to.
  SMA_CHECK="$(node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const list = c.vertex?.strong_model_agents;
if (list === undefined) { console.log('OK:absent'); process.exit(0); }
if (!Array.isArray(list)) { console.log('NOT-ARRAY'); process.exit(0); }
const valid = new Set(c.agents?.subagentIds || []);
const bad = list.filter(a => !valid.has(a));
if (bad.length) { console.log('INVALID:' + bad.join(',')); process.exit(0); }
if (list.length && !c.vertex?.models?.subagentStrong) { console.log('NO-STRONG-MODEL'); process.exit(0); }
console.log('OK:' + list.length);
" 2>/dev/null || echo 'ERROR')"
  if [[ "$SMA_CHECK" == OK* ]]; then
    pass "vertex.strong_model_agents valid (${SMA_CHECK#OK:} → subagentStrong)"
  else
    fail "vertex.strong_model_agents invalid (${SMA_CHECK})"
  fi

  # SESSION_CONTEXT_PLAN Phase 2: prompt-caching knobs
  for field in anthropic_cache_ttl_stable anthropic_cache_ttl_mission; do
    TTL="$(read_contract "vertex.${field}" 2>/dev/null || echo '')"
    if [[ "$TTL" == "5m" || "$TTL" == "1h" ]]; then
      pass "vertex.${field} = ${TTL}"
    else
      fail "vertex.${field} = '${TTL}' (expected '5m' or '1h')"
    fi
  done
  for field in anthropic_cache_message_breakpoints anthropic_session_affinity gemini_explicit_cache; do
    VAL="$(read_contract "vertex.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" == "true" || "$VAL" == "false" ]]; then
      pass "vertex.${field} = ${VAL} (boolean)"
    else
      fail "vertex.${field} = '${VAL}' (expected boolean)"
    fi
  done
  GECT="$(read_contract 'vertex.gemini_explicit_cache_ttl_seconds' 2>/dev/null || echo '')"
  if [[ "$GECT" =~ ^[0-9]+$ ]] && [[ "$GECT" -ge 300 ]]; then
    pass "vertex.gemini_explicit_cache_ttl_seconds = ${GECT} (≥ 300)"
  else
    fail "vertex.gemini_explicit_cache_ttl_seconds = '${GECT}' (expected number ≥ 300)"
  fi

  # SESSION_CONTEXT_PLAN Phase 1: checkpoint digest budget
  CDC="$(read_contract 'compaction.checkpoint_digest_chars' 2>/dev/null || echo '')"
  if [[ "$CDC" =~ ^[0-9]+$ ]] && [[ "$CDC" -ge 500 ]]; then
    pass "compaction.checkpoint_digest_chars = ${CDC} (≥ 500)"
  else
    fail "compaction.checkpoint_digest_chars = '${CDC}' (expected number ≥ 500)"
  fi

  # SESSION_CONTEXT_PLAN Phase 4: thread-ledger knobs
  for field in thread_ledger_enabled voicing_ledger_enabled; do
    VAL="$(read_contract "conversation.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" == "true" || "$VAL" == "false" ]]; then
      pass "conversation.${field} = ${VAL} (boolean)"
    else
      fail "conversation.${field} = '${VAL}' (expected boolean)"
    fi
  done
  for field in turn_store_chars compact_after_turns summary_max_chars turn_retention_days; do
    VAL="$(read_contract "conversation.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" =~ ^[0-9]+$ ]] && [[ "$VAL" -ge 1 ]]; then
      pass "conversation.${field} = ${VAL}"
    else
      fail "conversation.${field} = '${VAL}' (expected positive number)"
    fi
  done

  # SESSION_CONTEXT_PLAN Phase 5: gateway session knobs
  SE="$(read_contract 'session.enabled' 2>/dev/null || echo '')"
  if [[ "$SE" == "true" || "$SE" == "false" ]]; then
    pass "session.enabled = ${SE} (boolean)"
  else
    fail "session.enabled = '${SE}' (expected boolean)"
  fi
  for field in idle_ttl_minutes max_sessions miss_circuit_breaker; do
    VAL="$(read_contract "session.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" =~ ^[0-9]+$ ]] && [[ "$VAL" -ge 1 ]]; then
      pass "session.${field} = ${VAL}"
    else
      fail "session.${field} = '${VAL}' (expected positive number)"
    fi
  done
  # B-28: cerebellum must be session-excluded, structurally
  SEA="$(node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const v = c.session?.excluded_agents;
console.log(Array.isArray(v) && v.includes('cerebellum') ? 'OK' : 'MISSING');
" 2>/dev/null || echo 'ERROR')"
  if [[ "$SEA" == "OK" ]]; then
    pass "session.excluded_agents includes cerebellum (B-28)"
  else
    fail "session.excluded_agents must be an array including 'cerebellum' (B-28 verification isolation)"
  fi

  # SESSION_CONTEXT_PLAN Phase 5: sessions REQUIRE provider caching + affinity +
  # compaction. Without caching the replayed transcript is billed full price
  # every turn (re-introducing the quadratic the session removes); without
  # compaction nothing bounds the growing in-memory transcript.
  if [[ "$SE" == "true" ]]; then
    DEP_CHECK="$(node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const miss = [];
if (c.vertex?.anthropic_prompt_caching !== true) miss.push('vertex.anthropic_prompt_caching');
if (c.vertex?.anthropic_session_affinity !== true) miss.push('vertex.anthropic_session_affinity');
if (c.compaction?.enabled !== true) miss.push('compaction.enabled');
console.log(miss.length ? 'MISSING:'+miss.join(',') : 'OK');
" 2>/dev/null || echo 'ERROR')"
    if [[ "$DEP_CHECK" == "OK" ]]; then
      pass "session.enabled=true prerequisites satisfied (caching + affinity + compaction)"
    else
      fail "session.enabled=true requires: ${DEP_CHECK} (else replayed transcript is unbounded and billed full price)"
    fi
  fi

  # ORGAN_CONTEXT_SHARING_PLAN: inter-organ resource-packet + hydration + blackboard knobs
  for flag in result_store_enabled hydrate_enabled verifier_full_evidence loop_guard_synthesize blackboard_enabled; do
    VAL="$(read_contract "organ_context.${flag}" 2>/dev/null || echo '')"
    if [[ "$VAL" == "true" || "$VAL" == "false" ]]; then
      pass "organ_context.${flag} = ${VAL} (boolean)"
    else
      fail "organ_context.${flag} = '${VAL}' (expected boolean)"
    fi
  done
  for field in packet_summary_chars list_summary_top_k hydrate_max_chars hydrate_max_refs_per_mission blackboard_max_chars tool_answer_min_prose_chars; do
    VAL="$(read_contract "organ_context.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" =~ ^[0-9]+$ ]] && [[ "$VAL" -ge 1 ]]; then
      pass "organ_context.${field} = ${VAL}"
    else
      fail "organ_context.${field} = '${VAL}' (expected positive number)"
    fi
  done

  # Delivery retry discipline: bounded retries keep undeliverable envelopes
  # from retrying every poll cycle forever
  for field in max_attempts retry_backoff_base_seconds retry_backoff_max_seconds; do
    VAL="$(read_contract "delivery.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" =~ ^[0-9]+$ ]] && [[ "$VAL" -ge 1 ]]; then
      pass "delivery.${field} = ${VAL}"
    else
      fail "delivery.${field} = '${VAL}' (expected positive number)"
    fi
  done

  # SESSION_CONTEXT_PLAN Phase 3: mission compaction knobs
  for field in enabled session_log_to_git; do
    VAL="$(read_contract "compaction.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" == "true" || "$VAL" == "false" ]]; then
      pass "compaction.${field} = ${VAL} (boolean)"
    else
      fail "compaction.${field} = '${VAL}' (expected boolean)"
    fi
  done
  CWB="$(read_contract 'compaction.working_budget_tokens' 2>/dev/null || echo '')"
  CTB2="$(read_contract 'dispatch.context_token_budget' 2>/dev/null || echo '0')"
  if [[ "$CWB" =~ ^[0-9]+$ ]] && [[ "$CWB" -ge 10000 ]] && [[ "$CWB" -le "$CTB2" ]]; then
    pass "compaction.working_budget_tokens = ${CWB} (10000..dispatch.context_token_budget)"
  else
    fail "compaction.working_budget_tokens = '${CWB}' (expected 10000 ≤ n ≤ dispatch.context_token_budget=${CTB2})"
  fi
  for field in min_compactable_tokens keep_recent_iterations max_compactions_per_mission digest_max_chars learnings_max_entries; do
    VAL="$(read_contract "compaction.${field}" 2>/dev/null || echo '')"
    if [[ "$VAL" =~ ^[0-9]+$ ]] && [[ "$VAL" -ge 1 ]]; then
      pass "compaction.${field} = ${VAL}"
    else
      fail "compaction.${field} = '${VAL}' (expected positive number)"
    fi
  done

  # claim_stale_ms: must be number ≥ 60000
  CSM="$(read_contract 'dispatch.claim_stale_ms' 2>/dev/null || echo '')"
  if [[ "$CSM" =~ ^[0-9]+$ ]] && [[ "$CSM" -ge 60000 ]]; then
    pass "dispatch.claim_stale_ms = ${CSM} (≥ 60000)"
  else
    fail "dispatch.claim_stale_ms = '${CSM}' (expected number ≥ 60000)"
  fi

  # synth_verification_enabled: must be boolean
  SVE="$(read_contract 'dispatch.synth_verification_enabled' 2>/dev/null || echo '')"
  if [[ "$SVE" == "true" ]] || [[ "$SVE" == "false" ]]; then
    pass "dispatch.synth_verification_enabled = ${SVE}"
  else
    fail "dispatch.synth_verification_enabled = '${SVE}' (expected boolean)"
  fi

  # synth_verify_min_chars: must be number >= 100
  SVMC="$(read_contract 'dispatch.synth_verify_min_chars' 2>/dev/null || echo '')"
  if [[ "$SVMC" =~ ^[0-9]+$ ]] && [[ "$SVMC" -ge 100 ]]; then
    pass "dispatch.synth_verify_min_chars = ${SVMC} (>= 100)"
  else
    fail "dispatch.synth_verify_min_chars = '${SVMC}' (expected number >= 100)"
  fi

  # prior_results_max: optional number ≥ 10
  PRM="$(read_contract 'dispatch.prior_results_max' 2>/dev/null || echo '')"
  if [[ -z "$PRM" ]]; then
    pass "dispatch.prior_results_max not set (optional, default 25)"
  elif [[ "$PRM" =~ ^[0-9]+$ ]] && [[ "$PRM" -ge 10 ]]; then
    pass "dispatch.prior_results_max = ${PRM} (≥ 10)"
  else
    fail "dispatch.prior_results_max = '${PRM}' (expected number ≥ 10)"
  fi

  # evidence_floor_exclude_skills: must be array
  EFES="$(node -e "
const c = JSON.parse(require('fs').readFileSync('$CONTRACTS','utf8'));
const v = c.dispatch?.evidence_floor_exclude_skills;
if (!Array.isArray(v)) { console.log('NOT_ARRAY'); process.exit(1); }
console.log(v.length);
" 2>/dev/null || echo 'NOT_ARRAY')"
  if [[ "$EFES" != "NOT_ARRAY" ]]; then
    pass "dispatch.evidence_floor_exclude_skills is array (${EFES} entries)"
  else
    fail "dispatch.evidence_floor_exclude_skills missing or not an array"
  fi

  # result_preview_chars: must be number >= 100
  RPC="$(read_contract 'dispatch.result_preview_chars' 2>/dev/null || echo '')"
  if [[ "$RPC" =~ ^[0-9]+$ ]] && [[ "$RPC" -ge 100 ]]; then
    pass "dispatch.result_preview_chars = ${RPC} (>= 100)"
  else
    fail "dispatch.result_preview_chars = '${RPC}' (expected number >= 100)"
  fi

  # context_slice_chars: must be number >= 100
  CSC="$(read_contract 'dispatch.context_slice_chars' 2>/dev/null || echo '')"
  if [[ "$CSC" =~ ^[0-9]+$ ]] && [[ "$CSC" -ge 100 ]]; then
    pass "dispatch.context_slice_chars = ${CSC} (>= 100)"
  else
    fail "dispatch.context_slice_chars = '${CSC}' (expected number >= 100)"
  fi

  # criteria_pinning_enabled: must be boolean
  CPE="$(read_contract 'dispatch.criteria_pinning_enabled' 2>/dev/null || echo '')"
  if [[ "$CPE" == "true" ]] || [[ "$CPE" == "false" ]]; then
    pass "dispatch.criteria_pinning_enabled = ${CPE}"
  else
    fail "dispatch.criteria_pinning_enabled = '${CPE}' (expected boolean)"
  fi

  # goal_state_enabled: must be boolean
  GSE="$(read_contract 'dispatch.goal_state_enabled' 2>/dev/null || echo '')"
  if [[ "$GSE" == "true" ]] || [[ "$GSE" == "false" ]]; then
    pass "dispatch.goal_state_enabled = ${GSE}"
  else
    fail "dispatch.goal_state_enabled = '${GSE}' (expected boolean)"
  fi

  # goal_check_required: must be boolean
  GCR="$(read_contract 'dispatch.goal_check_required' 2>/dev/null || echo '')"
  if [[ "$GCR" == "true" ]] || [[ "$GCR" == "false" ]]; then
    pass "dispatch.goal_check_required = ${GCR}"
  else
    fail "dispatch.goal_check_required = '${GCR}' (expected boolean)"
  fi

  # wait_min_minutes: must be number >= 1
  WMIN="$(read_contract 'dispatch.wait_min_minutes' 2>/dev/null || echo '')"
  if [[ "$WMIN" =~ ^[0-9]+$ ]] && [[ "$WMIN" -ge 1 ]]; then
    pass "dispatch.wait_min_minutes = ${WMIN} (>= 1)"
  else
    fail "dispatch.wait_min_minutes = '${WMIN}' (expected number >= 1)"
  fi

  # wait_max_minutes: must be number >= wait_min_minutes
  WMAX="$(read_contract 'dispatch.wait_max_minutes' 2>/dev/null || echo '')"
  if [[ "$WMAX" =~ ^[0-9]+$ ]] && [[ "$WMAX" -ge "$WMIN" ]]; then
    pass "dispatch.wait_max_minutes = ${WMAX} (>= ${WMIN})"
  else
    fail "dispatch.wait_max_minutes = '${WMAX}' (expected number >= ${WMIN})"
  fi

  # wait_default_minutes: must be between min and max
  WDEF="$(read_contract 'dispatch.wait_default_minutes' 2>/dev/null || echo '')"
  if [[ "$WDEF" =~ ^[0-9]+$ ]] && [[ "$WDEF" -ge "$WMIN" ]] && [[ "$WDEF" -le "$WMAX" ]]; then
    pass "dispatch.wait_default_minutes = ${WDEF} (within [${WMIN}, ${WMAX}])"
  else
    fail "dispatch.wait_default_minutes = '${WDEF}' (expected number within [${WMIN}, ${WMAX}])"
  fi

  # ---- Check 10c: utility enforce_schema tunables ----
  ESTO="$(read_contract 'utility.enforce_schema_timeout_ms' 2>/dev/null || echo '')"
  if [[ "$ESTO" =~ ^[0-9]+$ ]] && [[ "$ESTO" -ge 1000 ]]; then
    pass "utility.enforce_schema_timeout_ms = ${ESTO}"
  else
    fail "utility.enforce_schema_timeout_ms = '${ESTO}' (expected number ≥ 1000)"
  fi

  # ---- Check 11: projects config fields ----
  for field in context_max_tokens promotion_auto archive_completed_after_days; do
    VAL="$(read_contract "projects.${field}" 2>/dev/null || echo '')"
    if [[ -n "$VAL" ]]; then
      pass "projects.${field} = ${VAL}"
    else
      fail "projects.${field} missing from contracts.json"
    fi
  done

  # ---- Check 12: github block non-empty ----
  C_GH_OWNER="$(read_contract 'github.owner' 2>/dev/null || echo '')"
  C_GH_REPO="$(read_contract 'github.repo' 2>/dev/null || echo '')"
  if [[ -n "$C_GH_OWNER" && -n "$C_GH_REPO" ]]; then
    pass "github.owner = ${C_GH_OWNER}, github.repo = ${C_GH_REPO}"
  else
    fail "github.owner or github.repo is empty in contracts.json"
  fi

  # ---- Check 12b: git block (tenant-internal artifact substrate) ----
  C_GIT_BUCKET="$(read_contract 'git.bucket' 2>/dev/null || echo '')"
  C_GIT_PREFIX="$(read_contract 'git.prefix' 2>/dev/null || echo '')"
  C_GIT_BRANCH="$(read_contract 'git.defaultBranch' 2>/dev/null || echo '')"
  C_GIT_RETRIES="$(read_contract 'git.maxPushRetries' 2>/dev/null || echo '')"
  C_GIT_GC="$(read_contract 'git.gcBundleThreshold' 2>/dev/null || echo '')"

  if [[ -n "$C_GIT_BUCKET" && -n "$C_GIT_PREFIX" && -n "$C_GIT_BRANCH" ]]; then
    pass "git.bucket = ${C_GIT_BUCKET}, git.prefix = ${C_GIT_PREFIX}, git.defaultBranch = ${C_GIT_BRANCH}"
  else
    fail "git block: bucket, prefix, or defaultBranch is missing or empty in contracts.json"
  fi

  if [[ "$C_GIT_RETRIES" =~ ^[0-9]+$ ]] && [[ "$C_GIT_RETRIES" -ge 1 ]]; then
    pass "git.maxPushRetries = ${C_GIT_RETRIES} (≥ 1)"
  else
    fail "git.maxPushRetries = '${C_GIT_RETRIES}' (expected number ≥ 1)"
  fi

  if [[ "$C_GIT_GC" =~ ^[0-9]+$ ]] && [[ "$C_GIT_GC" -ge 5 ]]; then
    pass "git.gcBundleThreshold = ${C_GIT_GC} (≥ 5)"
  else
    fail "git.gcBundleThreshold = '${C_GIT_GC}' (expected number ≥ 5)"
  fi

  # ---- Check 13: Process specialty values ∈ agent-types ids ----
  PROCESS_DIR="corekit/config/processes"
  if [[ -d "$PROCESS_DIR" && -f "$TYPES_FILE" ]]; then
    PROC_FAIL=0
    VALID_IDS=$(node -e "
const t = JSON.parse(require('fs').readFileSync('$TYPES_FILE','utf8'));
const ids = t.types.map(x => x.id);
console.log(JSON.stringify(ids));
" 2>/dev/null || echo '[]')
    for pfile in "$PROCESS_DIR"/*.json; do
      [[ -f "$pfile" ]] || continue
      PNAME="$(basename "$pfile")"
      while IFS= read -r spec_val; do
        [[ -z "$spec_val" ]] && continue
        FOUND=$(node -e "
const ids = $VALID_IDS;
console.log(ids.includes('$spec_val') ? 'yes' : 'no');
" 2>/dev/null || echo 'no')
        if [[ "$FOUND" != "yes" ]]; then
          fail "Process specialty: ${PNAME} references specialty '${spec_val}' not in agent-types ids"
          PROC_FAIL=$((PROC_FAIL + 1))
        fi
      done < <(node -e "
const d = JSON.parse(require('fs').readFileSync('$pfile','utf8'));
function findSpecialties(obj) {
  if (!obj || typeof obj !== 'object') return;
  if (obj.specialty) console.log(obj.specialty);
  for (const v of Object.values(obj)) findSpecialties(v);
}
findSpecialties(d);
" 2>/dev/null)
    done
    [[ $PROC_FAIL -eq 0 ]] && pass "All process specialty values are valid agent-types ids"
  fi

  # ---- Check 14: Tri-source skill consistency ----
  # Verify: agent-types skills[] ↔ specialty dir ↔ manifest install lines
  if [[ -f "$TYPES_FILE" ]]; then
    TRI_FAIL=0
    MANIFEST_DIR="infra/manifests"
    SPEC_DIR="specialties"
    while IFS= read -r type_id; do
      [[ -z "$type_id" ]] && continue
      JOB_MANIFEST="${MANIFEST_DIR}/job-${type_id}.txt"
      TYPE_SPEC_DIR="${SPEC_DIR}/${type_id}/skills"

      # 14a: Every specialty skill dir must have a manifest install line
      if [[ -d "$TYPE_SPEC_DIR" ]]; then
        for skill_dir in "$TYPE_SPEC_DIR"/*/; do
          [[ -d "$skill_dir" ]] || continue
          SKILL_ID="$(basename "$skill_dir")"
          if [[ -f "$JOB_MANIFEST" ]]; then
            if ! grep -q "skills/${SKILL_ID}/skill.json" "$JOB_MANIFEST" 2>/dev/null; then
              fail "Tri-source: specialty skill ${type_id}/${SKILL_ID} has no skill.json install in job-${type_id}.txt"
              TRI_FAIL=$((TRI_FAIL + 1))
            fi
          fi
        done
      fi

      # 14b: Every non-base skill in agent-types skills[] must be installable
      BASE_SKILLS="web-search skill-introspect memory-consolidate"
      ROLE_MANIFEST="${MANIFEST_DIR}/role-fleet.txt"
      AT_SKILLS=$(node -e "
const t = JSON.parse(require('fs').readFileSync('$TYPES_FILE','utf8'));
const typ = t.types.find(x => x.id === '$type_id');
if (typ && typ.skills) typ.skills.forEach(s => console.log(s));
" 2>/dev/null)
      while IFS= read -r skill_name; do
        [[ -z "$skill_name" ]] && continue
        echo "$BASE_SKILLS" | grep -qw "$skill_name" && continue
        FOUND_IN_MANIFEST=0
        for mf in "$ROLE_MANIFEST" "$JOB_MANIFEST"; do
          [[ -f "$mf" ]] || continue
          if grep -q "skills/${skill_name}/" "$mf" 2>/dev/null; then
            FOUND_IN_MANIFEST=1
            break
          fi
        done
        if [[ $FOUND_IN_MANIFEST -eq 0 ]]; then
          fail "Tri-source: agent-types ${type_id} lists skill '${skill_name}' but no manifest installs it"
          TRI_FAIL=$((TRI_FAIL + 1))
        fi
      done <<< "$AT_SKILLS"
    done < <(node -e "
const t = JSON.parse(require('fs').readFileSync('$TYPES_FILE','utf8'));
t.types.forEach(x => console.log(x.id));
" 2>/dev/null)
    [[ $TRI_FAIL -eq 0 ]] && pass "Tri-source skill consistency verified across all agent types"
  fi

  # ---- Check 14b: Skill-doc coverage (B-17) ----
  # Every command an agent is DECLARED to have must be described in its SKILL.md.
  # B-17 enforces skill use where a skill exists — but an organ cannot follow a doc
  # that never mentions the tool, so it guesses. A real mission burned six invented
  # invocations (`drive-copy --src/--dst/--name`, `docs-create --from-doc`) trying to
  # copy a Doc, because `drive-copy` and `docs-clone-template` were installed and
  # declared yet documented nowhere. Same discipline as C-9's file+manifest rule,
  # applied to file+documentation.
  #
  # `scripts[]` is the AGENT-FACING declaration, not the install list (manifests
  # install; only the dashboard reads this). Daemon-internal tools therefore belong
  # in neither scripts[] nor SKILL.md — see the _scripts_note keys.
  DOC_FAIL=0
  for SKILL_JSON in skills/*/skill.json; do
    [[ -f "$SKILL_JSON" ]] || continue
    SKILL_MD="$(dirname "$SKILL_JSON")/SKILL.md"
    [[ -f "$SKILL_MD" ]] || { fail "Skill-doc coverage: $(dirname "$SKILL_JSON") has skill.json but no SKILL.md"; DOC_FAIL=$((DOC_FAIL + 1)); continue; }
    UNDOC=$(python3 -c "
import json, sys, io
try:
    scripts = json.load(io.open('$SKILL_JSON', encoding='utf-8')).get('scripts') or []
except Exception as e:
    print('PARSE_ERROR', e); sys.exit()
md = io.open('$SKILL_MD', encoding='utf-8', errors='replace').read()
# '_'-prefixed entries are libraries (e.g. _docslib.py), not agent commands.
print(' '.join(s for s in scripts if not s.startswith('_') and s not in md))
" 2>/dev/null)
    if [[ -n "$UNDOC" ]]; then
      fail "Skill-doc coverage (B-17): $(basename "$(dirname "$SKILL_JSON")") declares undocumented command(s): ${UNDOC}"
      DOC_FAIL=$((DOC_FAIL + 1))
    fi
  done
  [[ $DOC_FAIL -eq 0 ]] && pass "Skill-doc coverage — every declared command appears in its SKILL.md (B-17)"

  # ---- Check 14c: Phantom capability — SKILL.md installed without its tools ----
  # Check 14b proves the DOC describes the tools. This proves the tools are
  # actually INSTALLED wherever the doc is. B-17 enforces skill use where a skill
  # exists, so a cortex that discovers a SKILL.md will follow it and dispatch the
  # commands inside — and if the manifest shipped only the doc, every one of them
  # is "command not found". Not a guess that might work; a guaranteed failure.
  #
  # Found in production: role-prime.txt installed SKILL.md + skill.json for
  # workspace-drive/docs/sheets/slides/gmail/calendar and none of the ~60 tools
  # they describe — not even ws-token, which all six need to authenticate.
  #
  # Composition mirrors install.sh: a role manifest is concatenated with base.txt
  # (and, for fleet, each job manifest), so a tool installed by any layer in the
  # same composition satisfies the doc shipped by another.
  # Implemented with node, not python3: this repo is maintained from a Windows
  # shell where `python3` resolves to the Microsoft Store stub, which exits 0 and
  # prints nothing. A python3-based check would report PASS while testing nothing —
  # a silent hole in exactly the guard meant to close a silent hole. Caught by
  # negative-testing this check against a deliberately reintroduced phantom.
  PHANTOM_FAIL=0
  check_composition() {
    local label="$1"; shift
    local out
    out=$(node -e '
const fs = require("fs");
const [label, ...manifests] = process.argv.slice(1);
const composed = manifests
  .filter(m => fs.existsSync(m))
  .map(m => fs.readFileSync(m, "utf8"))
  .join("\n");
if (!composed.trim()) process.exit(0);

// Parse into (source, dest) pairs. What matters is the DEST: a command exists on
// the VM iff something lands it at bin/<tool>, whatever the source. Sources vary
// by skill family — workspace-* ship tools from skills/<id>/, while fleet-* ship
// theirs from corekit/fleet/ — so a source-path check would false-positive on
// every fleet skill.
const sources = new Set();
const dests = new Set();
for (let line of composed.split(/\r?\n/)) {
  line = line.replace(/#.*$/, "").trim();
  if (!line) continue;
  const [src, dst] = line.split(/\s+/);
  if (!src) continue;
  sources.add(src);
  if (dst) dests.add(dst.replace(/\?$/, ""));   // strip no-clobber marker
}

// Skills whose SKILL.md this composition ships.
const shipped = [...sources]
  .map(p => /^skills\/([a-z0-9-]+)\/SKILL\.md$/.exec(p))
  .filter(Boolean)
  .map(m => m[1]);

for (const id of [...new Set(shipped)].sort()) {
  const sj = `skills/${id}/skill.json`;
  if (!fs.existsSync(sj)) continue;
  let meta;
  try { meta = JSON.parse(fs.readFileSync(sj, "utf8")); }
  catch { continue; }
  // Gateway-native skills declare tool CALLS (registered in corekit/brain/tools.mjs),
  // not shell binaries — there is correctly no bin/ entry to find.
  if (meta._scripts_kind === "gateway") continue;
  const scripts = meta.scripts || [];
  // "_"-prefixed entries are libraries (_docslib.py), not agent commands.
  const missing = scripts.filter(s => !s.startsWith("_") && !dests.has(`bin/${s}`));
  if (missing.length) console.log(`${id}\t${missing.join(" ")}`);
}
' "$label" "$@" 2>/dev/null)
    [[ -z "$out" ]] && return 0
    while IFS=$'\t' read -r skill_id missing; do
      [[ -z "$skill_id" ]] && continue
      fail "Phantom capability (B-17): ${label} installs skills/${skill_id}/SKILL.md but not its tool(s): ${missing}"
      PHANTOM_FAIL=$((PHANTOM_FAIL + 1))
    done <<< "$out"
  }
  check_composition "role prime" infra/manifests/base.txt infra/manifests/role-prime.txt
  for JM in infra/manifests/job-*.txt; do
    [[ -f "$JM" ]] || continue
    check_composition "role fleet + $(basename "$JM" .txt)" \
      infra/manifests/base.txt infra/manifests/role-fleet.txt "$JM"
  done
  [[ $PHANTOM_FAIL -eq 0 ]] && pass "No phantom capability — every installed SKILL.md has its tools (B-17)"

  # ---- Check 15: Organ layer purity (C-28) ----
  # Organ SOULs carry character, not tool syntax or process ids. Flag backtick-wrapped
  # command-with-flag invocations and backtick process ids. Skill NAMES are allowed.
  ORGAN_FILES=$(ls brain/fleet/_brain/*/SOUL.md brain/prime/*/SOUL.md specialties/*/brain/*/SOUL_APPEND.md 2>/dev/null || true)
  if [[ -n "$ORGAN_FILES" ]]; then
    ORGAN_HITS=$(grep -rEn '`p-[a-z][a-z-]*`|`[a-z][a-z0-9]*(-[a-z0-9]+)* +--[a-z]' $ORGAN_FILES 2>/dev/null || true)
    if [[ -n "$ORGAN_HITS" ]]; then
      fail "Organ purity (C-28): tool syntax / process id in an organ SOUL — move it to the governing skill/process:"
      echo "$ORGAN_HITS" | head -8 | sed 's/^/    /'
    else
      pass "Organ layer purity — no tool syntax or process ids in organ SOULs (C-28)"
    fi
  fi

  # ---- Check 16: Organ soft-lock (C-28) ----
  # Every organ file's content hash must match brain/ORGAN_LOCK.json. Any drift is an
  # un-acknowledged organ change: re-pin with corekit/system/update-organ-lock and include
  # an 'organ-change: intended' commit trailer. Deep-truths region is excluded from the hash.
  # Implemented in node, not python3. This repo is maintained from a Windows shell
  # where `python3` is the Microsoft Store stub: it prints an install hint to stderr
  # and exits non-zero, so this check reported a bare "ERROR" on every local run.
  # A tripwire that always fires is a tripwire that gets ignored — it was effectively
  # disabled on the one machine that edits organ files. node is already this script's
  # interpreter of choice (Checks 14/14c) and is present in both environments.
  if [[ -f "brain/ORGAN_LOCK.json" ]]; then
    LOCK_RESULT=$(node -e '
const fs = require("fs"), path = require("path"), crypto = require("crypto");
const MARKER = "<!-- Managed by update-deep-truths";
const lock = JSON.parse(fs.readFileSync("brain/ORGAN_LOCK.json", "utf8")).files;

// Expand the same globs the pinner uses, without a glob dependency.
const globs = [
  ["brain/fleet/_brain", "*", "SOUL.md"],
  ["brain/fleet/_brain", "*", "IDENTITY.md"],
  ["brain/fleet/_base", null, "IDENTITY.md"],
  ["brain/prime", "*", "SOUL.md"],
  ["brain/prime", "*", "IDENTITY.md"],
  ["specialties", "*/brain/*", "SOUL_APPEND.md"],
];
const found = new Set();
for (const [root, mid, leaf] of globs) {
  if (!fs.existsSync(root)) continue;
  if (mid === null) {
    const p = `${root}/${leaf}`;
    if (fs.existsSync(p)) found.add(p);
  } else if (mid === "*") {
    for (const d of fs.readdirSync(root)) {
      const p = `${root}/${d}/${leaf}`;
      if (fs.existsSync(p)) found.add(p);
    }
  } else {
    // specialties/<spec>/brain/<organ>/SOUL_APPEND.md
    for (const spec of fs.readdirSync(root)) {
      const bdir = `${root}/${spec}/brain`;
      if (!fs.existsSync(bdir) || !fs.statSync(bdir).isDirectory()) continue;
      for (const organ of fs.readdirSync(bdir)) {
        const p = `${bdir}/${organ}/${leaf}`;
        if (fs.existsSync(p)) found.add(p);
      }
    }
  }
}
const files = [...found].sort();
const drift = [];
for (const f of files) {
  // MUST match update-organ-lock byte for byte. That pinner reads with Python
  // text mode (`open(f, encoding="utf-8")`), whose universal-newline translation
  // collapses \r\n and lone \r to \n before hashing — so the pinned hashes are of
  // LF-normalized content. readFileSync in node does no such translation, and
  // without this normalize every CRLF organ file reports a false CHANGED. One
  // does: brain/prime/cortex/SOUL.md is 273 CRLF lines and flagged immediately.
  // (No apostrophes in this block — it lives inside a single-quoted bash string.)
  const t = fs.readFileSync(f, "utf8").replace(/\r\n/g, "\n").replace(/\r/g, "\n");
  const i = t.indexOf(MARKER);
  const body = i >= 0 ? t.slice(0, i) : t;
  const h = "sha256:" + crypto.createHash("sha256").update(body, "utf8").digest("hex");
  if (!(f in lock)) drift.push(`NEW (unpinned): ${f}`);
  else if (lock[f] !== h) drift.push(`CHANGED: ${f}`);
}
for (const f of Object.keys(lock)) if (!found.has(f)) drift.push(`REMOVED: ${f}`);
console.log(drift.length ? drift.join("\n") : "OK");
' 2>/dev/null || echo "ERROR")
    if [[ "$LOCK_RESULT" == "OK" ]]; then
      pass "Organ soft-lock — all organ files match ORGAN_LOCK.json (C-28)"
    else
      fail "Organ soft-lock (C-28): organ files changed without re-pinning. Run corekit/system/update-organ-lock + add an 'organ-change: intended' trailer if this is intended:"
      echo "$LOCK_RESULT" | head -8 | sed 's/^/    /'
    fi
  fi

  # ---- Check 17: Platform process purity (C-28) ----
  # A process step describes an outcome and names skills; it never embeds tool syntax.
  # Flag bash fences and raw command invocations in platform process definitions.
  PROC_FILES=$(ls corekit/config/processes/*.json 2>/dev/null || true)
  if [[ -n "$PROC_FILES" ]]; then
    PROC_HITS=$(grep -rEn '```bash|firebase deploy|gcloud [a-z]|gsutil |curl -X|bq query' $PROC_FILES 2>/dev/null || true)
    if [[ -n "$PROC_HITS" ]]; then
      fail "Process purity (C-28): tool syntax in a platform process step — name the governing skill instead:"
      echo "$PROC_HITS" | head -8 | sed 's/^/    /'
    else
      pass "Platform process purity — no tool syntax in corekit/config/processes (C-28)"
    fi
  fi

  # ---- Check 18: Template cleanliness — no real project id baked into platform files ----
  # This repo is a PUBLIC template: anyone forks it and bootstraps their own GCP
  # project. A concrete project id in a platform file ships one deployment's
  # identity to every fork. app/src/lib/firebase.ts carried
  # `process.env.NEXT_PUBLIC_FIREBASE_PROJECT || '<a real project id>'` as a
  # hardcoded fallback in LIVE client code, plus three usage comments naming the
  # same project — while every API route already read the env var with no default.
  #
  # Stated as a POSITIVE rule so the check itself leaks nothing: a project-shaped
  # literal in these positions must be one of the sanctioned placeholders.
  # operator/ is exempt by charter — it is explicitly operator-specific content.
  # Scope is `git ls-files` — TRACKED files only. Walking the filesystem instead
  # picked up a gitignored .claude/ worktree holding a pre-fix copy of the repo and
  # reported it as a live violation. Tracked-only is also exactly the invariant:
  # the rule is about what the repo SHIPS, not what sits in the working directory.
  TPL_RESULT=$(git ls-files 2>/dev/null | node -e '
const fs = require("fs");
const OK = new Set(["your-gcp-project", "your-project", "your-project-id", "example-project"]);
const EXT = /\.(ts|tsx|js|mjs|cjs|sh|json|md|txt)$/;
const files = fs.readFileSync(0, "utf8").split("\n").filter(Boolean)
  .filter(f => EXT.test(f))
  .filter(f => !f.startsWith("operator/"));   // charter-exempt: operator-specific by design

// Never pass vacuously: an empty file list means the scope broke, not that the
// repo is clean. (The python3-stub lesson — a check that tests nothing is worse
// than no check, because it reads as proof.)
if (files.length === 0) { console.log("ERROR: no tracked files matched — scope broken"); process.exit(0); }

// A project fallback: env var whose name mentions PROJECT, defaulted to a literal.
const FALLBACK = /process\.env\.[A-Za-z_]*PROJECT[A-Za-z_]*\s*\|\|\s*["`\x27]([A-Za-z0-9][A-Za-z0-9-]{4,})["`\x27]/g;
// A project assignment in a usage example: GCP_PROJECT_ID=<literal>
const ASSIGN = /\b[A-Z_]*PROJECT[A-Z_]*=([A-Za-z0-9][A-Za-z0-9-]{4,})\b/g;

const hits = [];
for (const f of files) {
  let t; try { t = fs.readFileSync(f, "utf8"); } catch { continue; }
  for (const re of [FALLBACK, ASSIGN]) {
    re.lastIndex = 0;
    let m;
    while ((m = re.exec(t))) {
      const v = m[1];
      if (OK.has(v)) continue;
      if (/^(true|false|null|undefined)$/i.test(v)) continue;
      const line = t.slice(0, m.index).split("\n").length;
      hits.push(`${f}:${line}  ${v}`);
    }
  }
}
console.log(hits.length ? hits.slice(0, 8).join("\n") : "OK");
' 2>/dev/null || echo "ERROR")
  if [[ "$TPL_RESULT" == "OK" ]]; then
    pass "Template cleanliness — no concrete project id in platform files"
  else
    fail "Template cleanliness: a real project id is baked into a platform file. Use a placeholder (your-gcp-project) or read the env var with no default:"
    echo "$TPL_RESULT" | head -8 | sed 's/^/    /'
  fi

  # ---- Check 19: Template cleanliness — no operator identity in shipped files ----
  # The sibling of Check 18, for people rather than projects. A concrete address
  # in a file every fork receives ships one operator's contact details to
  # strangers, and it arrived exactly the way these things do: inside a long
  # explanatory comment in fleet-policy.json, which compiles into contracts.json
  # and installs onto every VM.
  #
  # The detector lives in corekit/system/identity-scan.mjs so a test can import
  # it and prove it fires — repo-only tooling, like compile-contracts, never
  # installed onto a VM. `.github/CODEOWNERS` is exempt TEMPORARILY and the
  # reason is written down at the exemption itself.
  ID_RESULT=$(git ls-files 2>/dev/null | node "${REPO_ROOT}/corekit/system/identity-scan.mjs" 2>/dev/null || echo "ERROR: identity-scan did not run")
  if [[ "$ID_RESULT" == "OK" ]]; then
    pass "Template cleanliness — no operator identity in shipped platform files"
  else
    fail "Template cleanliness: a real address is shipped in a platform file. Use a placeholder domain (example.com):"
    echo "$ID_RESULT" | head -8 | sed 's/^/    /'
  fi
fi

# ============================================================
# RUNTIME MODE: Check live VM state
# ============================================================
if [[ "$MODE" == "runtime" ]]; then
  log "Checking runtime state..."

  # ---- Check 1: Gateway service active ----
  if systemctl is-active --quiet agent-neural-gateway 2>/dev/null; then
    pass "agent-neural-gateway service active"
  else
    fail "agent-neural-gateway service not active"
  fi

  # ---- Check 2: Gateway health ----
  HTTP="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://localhost:${C_GATEWAY_PORT}/v1/models 2>/dev/null)" || HTTP="000"
  if [[ "$HTTP" == "200" || "$HTTP" == "401" ]]; then
    pass "Gateway healthy (HTTP ${HTTP})"
  else
    fail "Gateway unhealthy (HTTP ${HTTP})"
  fi

  # ---- Check 3: Auth-profiles emptied for all agents ----
  BAD_AP=""
  for f in "${CORE_DIR}"/agents/*/agent/auth-profiles.json; do
    [ -f "$f" ] || continue
    profiles=$(node -e "const d=JSON.parse(require('fs').readFileSync('$f','utf8'));console.log(Object.keys(d.profiles||{}).length)" 2>/dev/null || echo "ERR")
    [ "$profiles" != "0" ] && BAD_AP="${BAD_AP} $f"
  done
  if [[ -z "$BAD_AP" ]]; then
    pass "Auth-profiles empty for all agents"
  else
    fail "Non-empty auth-profiles: ${BAD_AP}"
  fi

  # ---- Check 4: agent-ears.mjs route ----
  EARS_SCRIPT="${CORE_DIR}/platform/runtime/agent-ears.mjs"
  if [[ -f "$EARS_SCRIPT" ]]; then
    if grep -q "'brain/cortex'" "$EARS_SCRIPT"; then
      pass "agent-ears.mjs route = brain/cortex"
    else
      fail "agent-ears.mjs route mismatch"
    fi
  fi

  # ---- Check 5: Daemons active ----
  #
  # agent-ears and agent-mouth speak to Google Chat through domain-wide
  # delegation, so they cannot start until a Workspace user exists for this
  # agent. Hiring deliberately runs BEFORE that account is created — the deploy
  # prints the admin steps and the agent "comes online automatically once the
  # user exists". Treating that designed intermediate state as a contract
  # violation makes a correct deploy indistinguishable from a broken one.
  #
  # So the two identity-bound daemons are required only once an identity is
  # configured. brain and introspect have no such dependency and are always
  # required: an agent without them is not waiting for anything, it is inert.
  DWD_READY=0
  if [[ -n "${AGENT_USER_EMAIL:-}" ]]; then
    DWD_READY=1
  elif [[ -f "${CORE_DIR}/corekit/chat-config.json" ]] \
    && grep -q '"agentUserEmail" *: *"[^"]\+"' "${CORE_DIR}/corekit/chat-config.json" 2>/dev/null; then
    DWD_READY=1
  fi

  # `is-active` is true during the brief window between a crash and the next
  # restart, so a service looping every four seconds answers "active" about as
  # often as a healthy one. This gate reported agent-ears active while it was on
  # its 106th restart. A restart count is the difference between running and
  # merely being started repeatedly.
  RESTART_CEILING="${VALIDATE_RESTART_CEILING:-5}"
  svc_restarts() { systemctl show "$1" -p NRestarts --value 2>/dev/null || echo 0; }

  for svc in agent-brain agent-introspect; do
    if ! systemctl is-active --quiet "$svc" 2>/dev/null; then
      fail "${svc} service not active"
    elif [[ "$(svc_restarts "$svc")" -gt "$RESTART_CEILING" ]]; then
      fail "${svc} is crash-looping ($(svc_restarts "$svc") restarts) — active is not healthy"
    else
      pass "${svc} service active"
    fi
  done

  for svc in agent-ears agent-mouth; do
    restarts="$(svc_restarts "$svc")"
    if [[ "$restarts" -gt "$RESTART_CEILING" ]]; then
      # Looping is a distinct state from not-started, and its usual cause here is
      # a Workspace user that does not exist yet — the daemon starts, fails the
      # DWD healthcheck, and systemd tries again forever.
      if [[ "$DWD_READY" == "1" ]]; then
        fail "${svc} is crash-looping (${restarts} restarts) — check the DWD healthcheck"
      else
        warn_only "${svc} restarting (${restarts}×) — no Workspace user yet; it will settle once the account exists"
      fi
    elif systemctl is-active --quiet "$svc" 2>/dev/null; then
      pass "${svc} service active"
    elif [[ "$DWD_READY" == "1" ]]; then
      fail "${svc} service not active (a Workspace identity is configured, so it should be)"
    else
      pass "${svc} not started — no Workspace identity yet (expected before the user is created)"
    fi
  done

  # ---- Check 6: Host permissions — bin dir must be 755 (not 700) ----
  BIN_DIR="${CORE_DIR}/bin"
  if [[ -d "$BIN_DIR" ]]; then
    BIN_PERMS="$(stat -c '%a' "$BIN_DIR" 2>/dev/null || echo 'UNKNOWN')"
    if [[ "$BIN_PERMS" == "755" ]]; then
      pass "bin/ dir permissions = 755"
    else
      fail "bin/ dir permissions = ${BIN_PERMS} (expected 755 — root umask bug?)"
    fi
  fi

  # ---- Check 7: No unrendered {{}} placeholders in workspace (fleet only) ----
  if [[ -f "${CORE_DIR}/corekit/chat-config.json" ]]; then
    PLACEHOLDER_FAIL=0
    for f in "${CORE_DIR}"/workspace*/*.md; do
      [[ -f "$f" ]] || continue
      if grep -qP '\{\{[A-Z_]+\}\}' "$f"; then
        BDIR=$(basename "$(dirname "$f")")
        fail "Unrendered placeholder in ${BDIR}/$(basename $f)"
        PLACEHOLDER_FAIL=$((PLACEHOLDER_FAIL + 1))
      fi
    done
    [[ $PLACEHOLDER_FAIL -eq 0 ]] && pass "All workspace .md files have rendered templates"
  fi
fi

# ============================================================
# Check: Workspace SOUL.md sizes (runtime only)
# ============================================================
if [[ "$MODE" == "runtime" ]]; then
  BOOTSTRAP_LIMIT=40000
  SOUL_OVER=0
  for soul in "${CORE_DIR}"/workspace*/SOUL.md; do
    [ -f "$soul" ] || continue
    size=$(wc -c < "$soul" 2>/dev/null || echo 0)
    if [ "$size" -gt "$BOOTSTRAP_LIMIT" ]; then
      fail "$(basename $(dirname $soul))/SOUL.md is ${size} chars (limit: ${BOOTSTRAP_LIMIT})"
      SOUL_OVER=1
    fi
  done
  if [ "$SOUL_OVER" -eq 0 ]; then
    pass "All SOUL.md files within ${BOOTSTRAP_LIMIT} char limit"
  fi
fi

# ============================================================
# Summary
# ============================================================
echo ""
if [[ $FAILURES -eq 0 ]]; then
  log "✅ All contracts satisfied."
  exit 0
else
  log "❌ ${FAILURES} contract violation(s) found."
  exit 1
fi
