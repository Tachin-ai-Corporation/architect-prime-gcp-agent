# Copy to your environment before running (DO NOT COMMIT real values)

# Required — your GCP project ID
PROJECT_ID="your-project-id"

# Required for fleet-deploy — billing account for fleet agent projects
# Find it: gcloud billing accounts list
BILLING_ACCOUNT="your-billing-account-id"

# Required for fleet-deploy — GCP organization ID
# Find it: gcloud organizations list
GCP_ORG_ID="your-gcp-org-id"

# Optional overrides (defaults shown)
ZONE="us-central1-a"
VM="architect-prime"
PRIME_SA_NAME="architect-prime"

# Pin to a tag for reliability:
CORE_REF="main"

# Phase 2 optional overrides:
GH_OWNER="Tachin-ai-Corporation"
GH_REPO="architect-prime-gcp-agent"
# MY_TOKEN="(optional) pre-set your UI token"

# OpenClaw version pin (commit SHA from openclaw/openclaw repo).
# Obtain with: git ls-remote https://github.com/openclaw/openclaw.git HEAD
# Leave empty to use the latest commit on origin/main at install time.
# OPENCLAW_PIN_SHA=""
