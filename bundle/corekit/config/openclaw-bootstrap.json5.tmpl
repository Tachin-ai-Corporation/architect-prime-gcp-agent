{
  "env": {
    "GOOGLE_CLOUD_PROJECT": "${GCP_PROJECT_ID}",
    "GOOGLE_CLOUD_LOCATION": "us-central1",
    "CLOUDSDK_CORE_PROJECT": "${GCP_PROJECT_ID}",
    "CLOUDSDK_ACTIVE_CONFIG_NAME": "openclaw"
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "google-vertex/gemini-3.1-flash"
      },
      "models": {
        "google-vertex/gemini-3.1-flash": {
          "alias": "Gemini 3.1 Flash"
        },
        "google-vertex/gemini-3.1-pro": {
          "alias": "Gemini 3.1 Pro"
        }
      },
      "memorySearch": {
        "enabled": true,
        "provider": "google",
        "model": "text-embedding-005",
        "query": {
          "maxResults": 8,
          "hybrid": {
            "enabled": true,
            "vectorWeight": 0.7,
            "textWeight": 0.3,
            "mmr": { "enabled": true, "lambda": 0.7 },
            "temporalDecay": { "enabled": true, "halfLifeDays": 30 }
          }
        }
      },
      "contextPruning": {
        "mode": "cache-ttl",
        "ttl": "48h",
        "keepLastAssistants": 12,
        "softTrimRatio": 0.15
      },
      "compaction": {
        "mode": "safeguard",
        "reserveTokensFloor": 150000,
        "memoryFlush": {
          "enabled": true,
          "softThresholdTokens": 600000,
          "systemPrompt": "CHECKPOINT REACHED for Architect Prime. Write durable state to workspace/MEMORY.md. Summarize fleet state, key decisions, and next actions. Then stop and wait for user direction."
        }
      },
      "maxConcurrent": 1,
      "heartbeat": {
        "every": "0m"
      }
    },
    "list": [
      {
        // Cortex — router + synthesizer. What the user talks to.
        "id": "cortex",
        "default": true,
        "name": "Architect Prime",
        "model": {
          "primary": "google-vertex/gemini-3.1-flash"
        },
        "workspace": "~/.openclaw/workspace",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": [
            "read",
            "write",
            "edit",
            "exec",
            "process",
            "coding"
          ],
          "deny": ["web-search", "browser"]
        }
      },
      {
        // Temporal — memory manager + researcher. Invoked every turn.
        "id": "temporal",
        "name": "Temporal (Memory + Research)",
        "model": {
          "primary": "google-vertex/gemini-3.1-flash"
        },
        "workspace": "~/.openclaw/workspace-temporal",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": ["read", "exec"],
          "deny": ["write", "edit", "browser"]
        }
      },
      {
        // Prefrontal — strategic planner. Decomposes complex tasks.
        "id": "prefrontal",
        "name": "Prefrontal (Planning)",
        "model": {
          "primary": "google-vertex/gemini-3.1-pro"
        },
        "workspace": "~/.openclaw/workspace-prefrontal",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": ["read"],
          "deny": ["write", "edit", "exec", "browser", "web-search"]
        }
      },
      {
        // Motor — executor. Writes code, runs commands, builds things.
        "id": "motor",
        "name": "Motor (Execution)",
        "model": {
          "primary": "google-vertex/gemini-3.1-pro"
        },
        "workspace": "~/.openclaw/workspace-motor",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": [
            "read",
            "write",
            "edit",
            "exec",
            "process",
            "coding"
          ],
          "deny": ["web-search", "browser"]
        }
      },
      {
        // Cerebellum — verifier. QA checks outputs before delivery.
        "id": "cerebellum",
        "name": "Cerebellum (Verification)",
        "model": {
          "primary": "google-vertex/gemini-3.1-flash"
        },
        "workspace": "~/.openclaw/workspace-cerebellum",
        "sandbox": { "mode": "off" },
        "tools": {
          "allow": ["read", "exec"],
          "deny": ["write", "edit", "browser"]
        }
      }
    ]
  },
  "tools": {
    "deny": ["web-search"],
    "exec": {
      "host": "gateway",
      "security": "full",
      "ask": "off",
      "pathPrepend": ["~/.openclaw/bin"]
    }
  },
  "messages": {
    "queue": { "mode": "collect", "debounceMs": 1000, "cap": 20, "drop": "summarize" },
    "inbound": { "debounceMs": 2000 },
    "ackReaction": "",
    "ackReactionScope": "group-mentions",
    "removeAckAfterReply": false
  },
  "commands": { "native": "auto", "nativeSkills": "auto" },
  "cron": { "enabled": true },
  "hooks": { "internal": { "entries": { "session-memory": { "enabled": true } } } },
  "gateway": {
    "port": 18789,
    "mode": "local",
    "bind": "loopback",
    "controlUi": { "enabled": true, "basePath": "/" },
    "http": {
      "endpoints": {
        "responses": { "enabled": true },
        "chatCompletions": { "enabled": true }
      }
    },
    "auth": {
      "mode": "token",
      "token": "${MY_TOKEN}",
      "allowTailscale": true,
      "rateLimit": {
        "maxAttempts": 10,
        "windowMs": 60000,
        "lockoutMs": 300000,
        "exemptLoopback": true
      }
    },
    "tools": { "deny": ["browser"], "allow": ["gateway"] },
    "tailscale": { "mode": "off", "resetOnExit": false }
  }
}
