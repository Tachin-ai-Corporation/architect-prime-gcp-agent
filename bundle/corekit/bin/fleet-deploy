#!/usr/bin/env bash
# ============================================================
# fleet-deploy — Deploy a fleet agent in its OWN GCP project
#
# Usage: fleet-deploy --name <agent-name> --specialty <description>
#
# Creates: GCP project → billing link → APIs → SA → GCS bucket →
#          Cloud Function → VM → registry entry
#
# Each fleet agent is a fully independent GCP project with its
# own Chat app, so users can @-mention it directly in Chat.
#
# Runs on Prime's VM. Requires Prime SA with org-level permissions:
#   - roles/resourcemanager.projectCreator
#   - roles/billing.admin
# ============================================================
set -euo pipefail

# ---- Logging ----
log() { echo "[$(date -Is)] [fleet-deploy] $*"; }
warn() { echo "[$(date -Is)] [fleet-deploy] [WARN] $*" >&2; }
die() { echo "[$(date -Is)] [fleet-deploy] [FATAL] $*" >&2; exit 1; }

# ---- Parse args ----
AGENT_NAME=""
SPECIALTY=""
MACHINE_TYPE="e2-small"
BOOT_DISK_SIZE="50GB"

usage() {
  cat <<EOF
Usage: fleet-deploy --name <name> --specialty <desc> [options]

  --name         Agent name (lowercase, no spaces, e.g. 'alpha')
  --specialty    Agent specialty description
  --machine-type VM machine type (default: e2-small)
  --disk         Boot disk size (default: 50GB)
  --help         Show this message
EOF
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) AGENT_NAME="$2"; shift 2 ;;
    --specialty) SPECIALTY="$2"; shift 2 ;;
    --machine-type) MACHINE_TYPE="$2"; shift 2 ;;
    --disk) BOOT_DISK_SIZE="$2"; shift 2 ;;
    --help|-h) usage ;;
    *) die "Unknown arg: $1" ;;
  esac
done

[[ -n "$AGENT_NAME" ]] || die "Missing --name"
[[ -n "$SPECIALTY" ]] || die "Missing --specialty"
[[ "$AGENT_NAME" =~ ^[a-z][a-z0-9-]*$ ]] || die "Name must be lowercase alphanumeric with hyphens"

# ---- Resolve Prime's project context ----
PRIME_PROJECT="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || true)"
[[ -n "$PRIME_PROJECT" ]] || die "Cannot resolve PRIME_PROJECT from metadata"

ZONE="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/zone' 2>/dev/null | awk -F/ '{print $NF}' || true)"
[[ -n "$ZONE" ]] || ZONE="us-central1-a"
REGION="${ZONE%-*}"

CHAT_SPACE_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/attributes/chat_space_id' 2>/dev/null || true)"

OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
REGISTRY_FILE="${OC_HOST_ROOT}/.openclaw/corekit/fleet-registry.json"
CHAT_SEND="${OC_HOST_ROOT}/.openclaw/bin/chat-send"

# ---- Fleet project config ----
FLEET_PROJECT="fleet-${AGENT_NAME}"
FLEET_SA_NAME="${FLEET_PROJECT}"
FLEET_SA_EMAIL="${FLEET_SA_NAME}@${FLEET_PROJECT}.iam.gserviceaccount.com"
FLEET_BUCKET="${FLEET_PROJECT}-chat-inbox"
FLEET_VM="fleet-${AGENT_NAME}"

# Billing account — resolve from metadata or env (never hardcoded)
BILLING_ACCOUNT="${BILLING_ACCOUNT:-}"
if [[ -z "$BILLING_ACCOUNT" ]]; then
  BILLING_ACCOUNT="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/billing_account' 2>/dev/null || true)"
fi
[[ -n "$BILLING_ACCOUNT" ]] || die "Missing BILLING_ACCOUNT. Set via env or VM metadata 'billing_account'"

# GCP Org ID — required for project creation under an org
GCP_ORG_ID="${GCP_ORG_ID:-}"
if [[ -z "$GCP_ORG_ID" ]]; then
  GCP_ORG_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
    'http://metadata.google.internal/computeMetadata/v1/instance/attributes/gcp_org_id' 2>/dev/null || true)"
fi
[[ -n "$GCP_ORG_ID" ]] || die "Missing GCP_ORG_ID. Set via env or VM metadata 'gcp_org_id'"

# Resolve CoreKit ref from STATE.json
CORE_REF="main"
STATE_FILE="${OC_HOST_ROOT}/.openclaw/corekit/STATE.json"
if [[ -f "$STATE_FILE" ]]; then
  CORE_REF="$(jq -r '.coreRef // "main"' "$STATE_FILE")"
fi
GH_OWNER="$(jq -r '.owner // "Tachin-ai-Corporation"' "$STATE_FILE" 2>/dev/null || echo "Tachin-ai-Corporation")"
GH_REPO="$(jq -r '.repo // "architect-prime-gcp-agent"' "$STATE_FILE" 2>/dev/null || echo "architect-prime-gcp-agent")"

DEPLOY_TS="$(date -Is)"

log "Deploying fleet agent: ${AGENT_NAME}"
log "  Fleet Project: ${FLEET_PROJECT}"
log "  Prime Project: ${PRIME_PROJECT}"
log "  Zone:          ${ZONE}"
log "  VM:            ${FLEET_VM}"
log "  SA:            ${FLEET_SA_EMAIL}"
log "  Specialty:     ${SPECIALTY}"
log "  CoreRef:       ${CORE_REF}"
log "  Billing:       ${BILLING_ACCOUNT}"
log "  Org ID:        ${GCP_ORG_ID}"

# ============================================================
# 1. Create GCP project
# ============================================================
log "Creating GCP project: ${FLEET_PROJECT}"
if gcloud projects describe "$FLEET_PROJECT" &>/dev/null; then
  log "Project ${FLEET_PROJECT} already exists"
else
  gcloud projects create "$FLEET_PROJECT" \
    --name="Fleet Agent ${AGENT_NAME}" \
    --organization="$GCP_ORG_ID" \
    --labels="app=architect-prime,role=fleet,agent=${AGENT_NAME}" \
    --quiet
fi

# ============================================================
# 2. Link billing account
# ============================================================
log "Linking billing account"
gcloud billing projects link "$FLEET_PROJECT" \
  --billing-account="$BILLING_ACCOUNT" \
  --quiet 2>/dev/null || log "Billing already linked"

# ============================================================
# 3. Enable APIs
# ============================================================
log "Enabling APIs"
gcloud services enable \
  compute.googleapis.com \
  chat.googleapis.com \
  cloudfunctions.googleapis.com \
  cloudbuild.googleapis.com \
  run.googleapis.com \
  storage.googleapis.com \
  iam.googleapis.com \
  serviceusage.googleapis.com \
  --project="$FLEET_PROJECT" \
  --quiet

# ============================================================
# 4. Create service account
# ============================================================
log "Creating service account: ${FLEET_SA_NAME}"
gcloud iam service-accounts create "$FLEET_SA_NAME" \
  --display-name="Fleet Agent ${AGENT_NAME}" \
  --project="$FLEET_PROJECT" 2>/dev/null || log "SA already exists"

for role in roles/compute.admin roles/aiplatform.user roles/chat.owner \
            roles/storage.objectAdmin roles/iam.serviceAccountUser; do
  gcloud projects add-iam-policy-binding "$FLEET_PROJECT" \
    --member="serviceAccount:${FLEET_SA_EMAIL}" \
    --role="$role" \
    --quiet 2>/dev/null || true
done

# Grant Cloud Build role to default compute SA
PROJECT_NUMBER="$(gcloud projects describe "$FLEET_PROJECT" --format='value(projectNumber)')"
DEFAULT_COMPUTE_SA="${PROJECT_NUMBER}-compute@developer.gserviceaccount.com"
gcloud projects add-iam-policy-binding "$FLEET_PROJECT" \
  --member="serviceAccount:${DEFAULT_COMPUTE_SA}" \
  --role="roles/cloudbuild.builds.builder" \
  --quiet 2>/dev/null || true

# ============================================================
# 5. Create GCS inbox bucket
# ============================================================
log "Creating inbox bucket: gs://${FLEET_BUCKET}"
gsutil mb -p "$FLEET_PROJECT" -l "$REGION" "gs://${FLEET_BUCKET}" 2>/dev/null || log "Bucket already exists"
gsutil iam ch "serviceAccount:${FLEET_SA_EMAIL}:roles/storage.objectAdmin" "gs://${FLEET_BUCKET}" 2>/dev/null || true

# ============================================================
# 6. Deploy Cloud Function
# ============================================================
log "Deploying Cloud Function"
# Write CF source to temp dir
CF_TMPDIR="$(mktemp -d /tmp/fleet-cf-XXXXXX)"
cat > "${CF_TMPDIR}/main.py" <<'CFEOF'
import functions_framework
from google.cloud import storage
import json, time, os

BUCKET_NAME = os.environ.get("INBOX_BUCKET", "")
AGENT_ID = os.environ.get("AGENT_ID", "prime")
storage_client = storage.Client()

def generate_ulid():
    ts = int(time.time() * 1000)
    return f"{ts:013d}-{os.urandom(4).hex()}"

def write_to_inbox(message_data):
    bucket = storage_client.bucket(BUCKET_NAME)
    msg_id = generate_ulid()
    blob = bucket.blob(f"{AGENT_ID}/pending/{msg_id}.json")
    blob.upload_from_string(json.dumps(message_data, indent=2), content_type="application/json")
    return msg_id

@functions_framework.http
def handle_chat_event(request):
    event = request.get_json(silent=True)
    if not event:
        return json.dumps({"text": "No event data received."}), 200

    event_type = event.get("type", "")
    space = event.get("space", {})
    space_name = space.get("name", "")
    user = event.get("user", {})
    user_name = user.get("displayName", "Unknown")

    if event_type == "ADDED_TO_SPACE":
        write_to_inbox({"type": "ADDED_TO_SPACE", "space": space_name, "user": user_name, "timestamp": time.time()})
        return json.dumps({"text": f"👋 Hello! I'm *{AGENT_ID}*. Commands: `help`, `status`, `whoami`"})

    if event_type == "MESSAGE":
        message = event.get("message", {})
        text = message.get("argumentText", message.get("text", "")).strip()
        msg_name = message.get("name", "")
        thread_name = message.get("thread", {}).get("name", "")
        msg_data = {
            "type": "MESSAGE", "text": text, "sender": user_name,
            "senderEmail": user.get("email", ""), "space": space_name,
            "messageName": msg_name, "threadName": thread_name, "timestamp": time.time()
        }
        msg_id = write_to_inbox(msg_data)
        return json.dumps({"text": f"⏳ Processing: _{text}_\n`msg:{msg_id}`"})

    if event_type == "REMOVED_FROM_SPACE":
        write_to_inbox({"type": "REMOVED_FROM_SPACE", "space": space_name, "timestamp": time.time()})
        return json.dumps({})

    return json.dumps({"text": f"Unknown event type: {event_type}"}), 200
CFEOF

cat > "${CF_TMPDIR}/requirements.txt" <<'REQEOF'
functions-framework==3.*
google-cloud-storage==2.*
REQEOF

gcloud functions deploy chat-handler \
  --gen2 \
  --runtime=python312 \
  --region="$REGION" \
  --source="$CF_TMPDIR" \
  --entry-point=handle_chat_event \
  --trigger-http \
  --allow-unauthenticated \
  --set-env-vars="INBOX_BUCKET=${FLEET_BUCKET},AGENT_ID=${AGENT_NAME}" \
  --memory=256MB \
  --timeout=30s \
  --project="$FLEET_PROJECT" \
  --quiet

CF_URL="$(gcloud functions describe chat-handler \
  --region="$REGION" --project="$FLEET_PROJECT" \
  --format='value(serviceConfig.uri)' 2>/dev/null || echo 'unknown')"

# Ensure Cloud Run service is publicly accessible (gen2 CF requirement)
log "Granting public access to Cloud Function"
gcloud run services add-iam-policy-binding chat-handler \
  --member="allUsers" \
  --role="roles/run.invoker" \
  --region="$REGION" \
  --project="$FLEET_PROJECT" \
  --quiet 2>/dev/null || true

rm -rf "$CF_TMPDIR"
log "Cloud Function URL: ${CF_URL}"

# ============================================================
# 7. Build and create VM
# ============================================================
log "Building startup script"
STARTUP_TMPFILE="$(mktemp /tmp/fleet-startup-XXXXXX.sh)"
cat > "$STARTUP_TMPFILE" <<'STARTUP_EOF'
#!/usr/bin/env bash
set -euo pipefail
LOG_FILE="/var/log/fleet-agent-phase2.log"
exec > >(tee -a "$LOG_FILE") 2>&1

echo "===> Fleet Agent Phase 2: $(date -Is)"

AGENT_ID="$(curl -sf -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/attributes/agent_id || echo 'unknown')"
SPECIALTY="$(curl -sf -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/attributes/specialty || echo 'general')"
CORE_REF="$(curl -sf -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/attributes/core_ref || echo 'main')"
GH_OWNER="$(curl -sf -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/attributes/gh_owner || echo 'Tachin-ai-Corporation')"
GH_REPO="$(curl -sf -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/attributes/gh_repo || echo 'architect-prime-gcp-agent')"
PROJECT_ID="$(curl -sf -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/project/project-id)"
CHAT_SPACE_ID="$(curl -sf -H 'Metadata-Flavor: Google' http://metadata.google.internal/computeMetadata/v1/instance/attributes/chat_space_id || true)"

echo "Agent: ${AGENT_ID} | Specialty: ${SPECIALTY} | CoreRef: ${CORE_REF}"

export DEBIAN_FRONTEND=noninteractive
apt-get update -qq
apt-get install -y -qq jq curl

OC_HOST_ROOT="/opt/openclaw"
mkdir -p "${OC_HOST_ROOT}/.openclaw"

CORE_BASE="https://raw.githubusercontent.com/${GH_OWNER}/${GH_REPO}/${CORE_REF}"
curl -sfL "${CORE_BASE}/install.sh" -o /tmp/install.sh
chmod +x /tmp/install.sh
CORE_REF="$CORE_REF" GH_OWNER="$GH_OWNER" GH_REPO="$GH_REPO" OC_HOST_ROOT="$OC_HOST_ROOT" \
  bash /tmp/install.sh

if [[ -n "${CHAT_SPACE_ID}" ]]; then
  cat > "${OC_HOST_ROOT}/.openclaw/corekit/chat-config.json" <<CHATCFG
{
  "spaceId": "${CHAT_SPACE_ID}",
  "botDisplayName": "Fleet: ${AGENT_ID}",
  "projectId": "${PROJECT_ID}"
}
CHATCFG
fi

INBOX_DAEMON_SVC="${OC_HOST_ROOT}/.openclaw/corekit/inbox-daemon.service"
if [[ -f "$INBOX_DAEMON_SVC" ]]; then
  INBOX_BUCKET="${PROJECT_ID}-chat-inbox"
  sed -i "s|Environment=AGENT_ID=prime|Environment=AGENT_ID=${AGENT_ID}|g" "$INBOX_DAEMON_SVC"
  sed -i "s|__INBOX_BUCKET__|${INBOX_BUCKET}|g" "$INBOX_DAEMON_SVC"
  cp "$INBOX_DAEMON_SVC" /etc/systemd/system/inbox-daemon.service
  systemctl daemon-reload
  systemctl enable inbox-daemon.service
  systemctl start inbox-daemon.service || echo "[WARN] inbox-daemon start failed"
fi

if [[ -n "${CHAT_SPACE_ID}" ]]; then
  export CHAT_SPACE_ID OC_HOST_ROOT
  "${OC_HOST_ROOT}/.openclaw/bin/chat-send" \
    "🤖 Fleet agent *${AGENT_ID}* is online.
Specialty: ${SPECIALTY}
Project: \`${PROJECT_ID}\`
CoreKit: \`${CORE_REF}\`" || echo "[WARN] Chat announce failed"
fi

echo "✅ FLEET AGENT PHASE 2 COMPLETE"
STARTUP_EOF

log "Creating VM: ${FLEET_VM}"
gcloud compute instances create "$FLEET_VM" \
  --zone="$ZONE" \
  --project="$FLEET_PROJECT" \
  --image-family="ubuntu-2204-lts" \
  --image-project="ubuntu-os-cloud" \
  --machine-type="$MACHINE_TYPE" \
  --boot-disk-size="$BOOT_DISK_SIZE" \
  --service-account="$FLEET_SA_EMAIL" \
  --scopes="https://www.googleapis.com/auth/cloud-platform" \
  --tags="allow-https" \
  --labels="app=architect-prime,role=fleet,agent=${AGENT_NAME}" \
  --metadata="agent_id=${AGENT_NAME},specialty=${SPECIALTY},core_ref=${CORE_REF},gh_owner=${GH_OWNER},gh_repo=${GH_REPO},chat_space_id=${CHAT_SPACE_ID:-}" \
  --metadata-from-file="startup-script=${STARTUP_TMPFILE}" \
  --quiet

rm -f "$STARTUP_TMPFILE"

sleep 5
FLEET_IP="$(gcloud compute instances describe "$FLEET_VM" --zone="$ZONE" --project="$FLEET_PROJECT" \
  --format='value(networkInterfaces[0].accessConfigs[0].natIP)' 2>/dev/null || echo 'pending')"

# ============================================================
# 8. Update Prime's fleet registry
# ============================================================
log "Updating fleet registry"
if [[ ! -f "$REGISTRY_FILE" ]]; then
  echo '{"agents":{}}' > "$REGISTRY_FILE"
fi

jq --arg name "$AGENT_NAME" \
   --arg specialty "$SPECIALTY" \
   --arg project "$FLEET_PROJECT" \
   --arg vm "$FLEET_VM" \
   --arg sa "$FLEET_SA_EMAIL" \
   --arg ip "$FLEET_IP" \
   --arg zone "$ZONE" \
   --arg ref "$CORE_REF" \
   --arg cf "$CF_URL" \
   --arg ts "$DEPLOY_TS" \
   '.agents[$name] = {
      "specialty": $specialty,
      "project": $project,
      "vm": $vm,
      "sa": $sa,
      "ip": $ip,
      "zone": $zone,
      "coreRef": $ref,
      "cfUrl": $cf,
      "deployedAt": $ts,
      "status": "deploying"
    } | .lastUpdated = $ts' \
  "$REGISTRY_FILE" > "${REGISTRY_FILE}.tmp" && mv "${REGISTRY_FILE}.tmp" "$REGISTRY_FILE"

# ============================================================
# 9. Print results + Chat setup instructions
# ============================================================
echo
echo "============================================================"
echo "  FLEET AGENT DEPLOYED: ${AGENT_NAME}"
echo "============================================================"
echo
echo "  Project        : ${FLEET_PROJECT}"
echo "  VM             : ${FLEET_VM} (${FLEET_IP})"
echo "  SA             : ${FLEET_SA_EMAIL}"
echo "  Zone           : ${ZONE}"
echo "  Cloud Function : ${CF_URL}"
echo "  Inbox Bucket   : gs://${FLEET_BUCKET}"
echo "  Specialty      : ${SPECIALTY}"
echo "  CoreRef        : ${CORE_REF}"
echo
echo "============================================================"
echo "  CHAT SETUP (one-time manual step)"
echo "============================================================"
echo
echo "  Step 1: Configure the Chat app"
echo "    Go to: https://console.cloud.google.com/apis/api/chat.googleapis.com/hangouts-chat?project=${FLEET_PROJECT}"
echo "    - App name: Fleet ${AGENT_NAME}"
echo "    - Avatar URL: https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/smart_toy/default/48px.svg"
echo "    - Description: Fleet agent — ${SPECIALTY}"
echo "    - Enable interactive features"
echo "    - Connection settings → HTTP endpoint URL"
echo "    - Paste: ${CF_URL}"
echo "    - Visibility: your domain or users"
echo "    - Save"
echo
echo "  Step 2: Add to Chat space"
echo "    - Open your Chat space → Add people & apps → Fleet ${AGENT_NAME}"
echo
echo "  Step 3: Test"
echo "    Message '@Fleet ${AGENT_NAME} help' in Chat."
echo
echo "============================================================"

# Notify via Prime's Chat
if [[ -n "$CHAT_SPACE_ID" && -x "$CHAT_SEND" ]]; then
  export CHAT_SPACE_ID OC_HOST_ROOT
  "$CHAT_SEND" "🚀 Fleet agent *${AGENT_NAME}* deployed to project \`${FLEET_PROJECT}\`
• IP: ${FLEET_IP}
• CF: ${CF_URL}
• Specialty: ${SPECIALTY}

⚠️ *Manual step required:* Configure Chat app at:
https://console.cloud.google.com/apis/api/chat.googleapis.com/hangouts-chat?project=${FLEET_PROJECT}" || true
fi

log "Done. Phase 2 will complete on VM in ~1-2 minutes."
log "Monitor: gcloud compute instances get-serial-port-output ${FLEET_VM} --zone ${ZONE} --project ${FLEET_PROJECT}"
