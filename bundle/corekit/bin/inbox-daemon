#!/usr/bin/env bash
# ============================================================
# inbox-daemon — Chat message processor (DWD polling)
#
# Polls Google Chat via chat-read for @-mentions of the agent's
# Workspace user account and processes them one at a time.
#
# Replaces the old GCS-based inbox-daemon. No Cloud Function or
# GCS inbox bucket required — uses DWD user impersonation.
#
# Runs as a systemd service. ONE instance per agent.
# No parallel processing = no spawn explosion.
#
# Environment:
#   AGENT_ID          — Agent identifier (default: prime)
#   AGENT_USER_EMAIL  — Workspace user email (or read from chat-config.json)
#   OC_HOST_ROOT      — OpenClaw host root (default: /opt/openclaw)
#   POLL_INTERVAL     — Seconds between polls (default: 10)
#   PROCESS_TIMEOUT   — Max seconds per message (default: 120)
# ============================================================
set -euo pipefail

# ---- CONFIG ----
AGENT_ID="${AGENT_ID:-prime}"
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"
POLL_INTERVAL="${POLL_INTERVAL:-10}"
PROCESS_TIMEOUT="${PROCESS_TIMEOUT:-120}"
CHAT_SEND="${OC_HOST_ROOT}/.openclaw/bin/chat-send"
CHAT_READ="${OC_HOST_ROOT}/.openclaw/bin/chat-read"
PROCESSED_FILE="/tmp/inbox-daemon-processed.json"

# ---- Logging ----
log() { echo "[$(date -Is)] [inbox-daemon] $*"; }
warn() { echo "[$(date -Is)] [inbox-daemon] [WARN] $*" >&2; }
die() { echo "[$(date -Is)] [inbox-daemon] [FATAL] $*" >&2; exit 1; }

# ---- Verify deps ----
command -v python3 >/dev/null 2>&1 || die "python3 not found"
command -v jq >/dev/null 2>&1 || die "jq not found (apt install jq)"
[[ -x "$CHAT_READ" ]] || die "chat-read not found at $CHAT_READ"
[[ -x "$CHAT_SEND" ]] || warn "chat-send not found at $CHAT_SEND"

# ---- Initialize processed messages tracker ----
if [[ ! -f "$PROCESSED_FILE" ]]; then
  echo '[]' > "$PROCESSED_FILE"
fi

log "Starting inbox-daemon for agent=${AGENT_ID} (DWD Chat polling mode)"
log "Poll interval: ${POLL_INTERVAL}s"

# ---- Helper: check if message was already processed ----
is_processed() {
  local msg_name="$1"
  python3 -c "
import json, sys
processed = json.load(open('$PROCESSED_FILE'))
sys.exit(0 if '$msg_name' in processed else 1)
" 2>/dev/null
}

# ---- Helper: mark message as processed ----
mark_processed() {
  local msg_name="$1"
  python3 -c "
import json
processed = json.load(open('$PROCESSED_FILE'))
processed.append('$msg_name')
# Keep only last 500 to avoid unbounded growth
processed = processed[-500:]
json.dump(processed, open('$PROCESSED_FILE', 'w'))
" 2>/dev/null
}

# ---- Helper: process a single message ----
process_message() {
  local msg_text="$1"
  local sender_name="$2"
  local sender_email="$3"

  log "Processing: sender=${sender_name} text=${msg_text:0:80}"

  # Strip leading @-mention of self from text (Chat includes it)
  local clean_text
  clean_text="$(echo "$msg_text" | sed -E 's/^@[^ ]+ *//' | xargs)"
  [[ -n "$clean_text" ]] || clean_text="$msg_text"

  # Parse first word as command
  local cmd="${clean_text%% *}"
  cmd="${cmd,,}" # lowercase

  local response=""
  case "$cmd" in
    help|/help)
      response="👋 Hello! I'm **${AGENT_ID}**. Commands: \`help\`, \`status\`, \`whoami\`, \`fleet\`"
      ;;
    status|/status)
      local core_ref="unknown"
      local state_file="${OC_HOST_ROOT}/.openclaw/corekit/STATE.json"
      if [[ -f "$state_file" ]]; then
        core_ref="$(jq -r '.coreRef // "unknown"' "$state_file" 2>/dev/null)"
      fi
      local uptime_str
      uptime_str="$(uptime -p 2>/dev/null || echo 'unknown')"

      response="📊 *Agent ${AGENT_ID} Status*
• CoreKit: \`${core_ref}\`
• Agent ID: \`${AGENT_ID}\`
• Uptime: ${uptime_str}
• Mode: DWD Chat polling"
      ;;
    whoami|/whoami)
      response="👤 *Your Info*
• Name: ${sender_name}
• Email: ${sender_email}"
      ;;
    fleet|/fleet)
      local registry="${OC_HOST_ROOT}/.openclaw/corekit/fleet-registry.json"
      if [[ -f "$registry" ]]; then
        local agent_count
        agent_count="$(jq '.agents | length' "$registry" 2>/dev/null || echo 0)"
        if [[ "$agent_count" -gt 0 ]]; then
          local agent_list
          agent_list="$(jq -r '.agents | to_entries[] | "• \(.key) — \(.value.specialty) (\(.value.status))"' "$registry" 2>/dev/null)"
          response="🤖 *Fleet Status* (${agent_count} agents)
${agent_list}"
        else
          response="🤖 *Fleet Status*
No fleet agents deployed."
        fi
      else
        response="🤖 *Fleet Status*
No fleet registry found."
      fi
      ;;
    *)
      # Route to AI — answer the question
      local agent_ask="${OC_HOST_ROOT}/.openclaw/bin/agent-ask"
      if [[ -x "$agent_ask" ]]; then
        log "Routing to agent-ask: ${clean_text:0:60}"
        response="$(AGENT_ID="$AGENT_ID" OC_HOST_ROOT="$OC_HOST_ROOT" \
          timeout "$PROCESS_TIMEOUT" "$agent_ask" "$clean_text" 2>/dev/null)" \
          || response="⚠️ AI unavailable right now. Try again later or use \`help\` for built-in commands."
      else
        response="❓ Unknown command: \`${cmd}\`
Try \`help\` for available commands."
      fi
      ;;
  esac

  # Send response via chat-send (DWD)
  "$CHAT_SEND" "$response" || warn "chat-send failed"
}

# ---- Main loop ----
log "Entering polling loop (interval: ${POLL_INTERVAL}s)"

while true; do
  # Read recent messages where this user was @-mentioned
  MESSAGES="$("$CHAT_READ" --since "$((POLL_INTERVAL + 5))" --filter-mentions 2>/dev/null || echo '[]')"

  # Count messages
  MSG_COUNT="$(echo "$MESSAGES" | python3 -c "import json,sys; print(len(json.load(sys.stdin)))" 2>/dev/null || echo 0)"

  if [[ "$MSG_COUNT" -gt 0 ]]; then
    # Process each message (oldest first — reverse the list since chat-read returns newest first)
    echo "$MESSAGES" | python3 -c "
import json, sys
msgs = json.load(sys.stdin)
msgs.reverse()
for msg in msgs:
    print(json.dumps(msg))
" 2>/dev/null | while IFS= read -r msg_json; do
      # Extract fields
      msg_name="$(echo "$msg_json" | jq -r '.name' 2>/dev/null)"
      msg_text="$(echo "$msg_json" | jq -r '.text' 2>/dev/null)"
      sender_name="$(echo "$msg_json" | jq -r '.senderDisplayName' 2>/dev/null)"
      sender_email="$(echo "$msg_json" | jq -r '.senderEmail' 2>/dev/null)"

      # Skip if already processed
      if is_processed "$msg_name"; then
        continue
      fi

      # Skip messages from self (avoid infinite loops)
      if [[ -n "${AGENT_USER_EMAIL:-}" && "$sender_email" == "$AGENT_USER_EMAIL" ]]; then
        mark_processed "$msg_name"
        continue
      fi

      # Process
      log "New message: ${msg_name}"
      if process_message "$msg_text" "$sender_name" "$sender_email"; then
        log "Completed: ${msg_name}"
      else
        warn "Error processing: ${msg_name}"
      fi

      mark_processed "$msg_name"

      # Brief pause between messages
      sleep 1
    done
  fi

  sleep "$POLL_INTERVAL"
done
