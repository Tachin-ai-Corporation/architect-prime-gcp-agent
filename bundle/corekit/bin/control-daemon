#!/usr/bin/env bash
# ============================================================
# control-daemon — Firestore-polling message bridge for Prime
#
# Polls Firestore messages collection for unprocessed admin
# messages and routes them to the OpenClaw gateway API.
# OpenClaw handles conversation memory, tool execution, and
# the full agent loop.
#
# Requires:
#   - gcloud CLI authenticated (VM SA)
#   - PRIME_ID: the Prime instance ID in Firestore
#   - GCP_PROJECT_ID: the Firestore project
#   - OC_HOST_ROOT: OpenClaw root path
#   - OpenClaw gateway running on port 18789
#
# Env from VM metadata:
#   PRIME_ID, GCP_PROJECT_ID
# ============================================================
set -euo pipefail

POLL_INTERVAL="${POLL_INTERVAL:-5}"
OC_GATEWAY="http://localhost:18789"
OC_TOKEN="$(cat /root/.openclaw/.gateway-token 2>/dev/null || echo 'no-token')"
FIRESTORE_URL="https://firestore.googleapis.com/v1/projects/${GCP_PROJECT_ID:?}/databases/(default)/documents"
PRIME_ID="${PRIME_ID:?}"
AGENT_ID="${AGENT_ID:-prime}"

log() { echo "[$(date -Iseconds)] [control-daemon] $*"; }

# ---- Get access token from VM metadata ----
get_token() {
  curl -sH "Metadata-Flavor: Google" \
    "http://metadata.google.internal/computeMetadata/v1/instance/service-accounts/default/token" \
    | python3 -c "import sys,json; print(json.load(sys.stdin)['access_token'])"
}

# ---- Query unprocessed admin messages ----
poll_messages() {
  local token
  token="$(get_token)"

  # Firestore REST: structured query for unprocessed admin messages
  local query_body
  query_body=$(cat <<'QUERY'
{
  "structuredQuery": {
    "from": [{"collectionId": "messages"}],
    "where": {
      "fieldFilter": {
        "field": {"fieldPath": "processed"},
        "op": "EQUAL",
        "value": {"booleanValue": false}
      }
    },
    "limit": 50
  }
}
QUERY
)

  curl -s -X POST \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d "$query_body" \
    "${FIRESTORE_URL}/primes/${PRIME_ID}:runQuery"
}

# ---- Write a response message to Firestore ----
write_response() {
  local text="$1"
  local token
  token="$(get_token)"

  local msg_id
  msg_id="msg-$(date +%s%N)"

  local body
  body=$(python3 -c "
import json, sys
text = sys.stdin.read()
doc = {
    'fields': {
        'sender': {'stringValue': 'prime'},
        'text': {'stringValue': text},
        'timestamp': {'timestampValue': '$(date -u +%Y-%m-%dT%H:%M:%SZ)'},
        'processed': {'booleanValue': True}
    }
}
print(json.dumps(doc))
" <<< "$text")

  curl -s -X PATCH \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d "$body" \
    "${FIRESTORE_URL}/primes/${PRIME_ID}/messages/${msg_id}" > /dev/null
}

# ---- Mark a message as processed ----
mark_processed() {
  local doc_path="$1"
  local token
  token="$(get_token)"

  curl -s -X PATCH \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d '{"fields":{"processed":{"booleanValue":true}}}' \
    "https://firestore.googleapis.com/v1/${doc_path}?updateMask.fieldPaths=processed" > /dev/null
}

# ---- Update Prime status in Firestore ----
update_status() {
  local status="$1"
  local token
  token="$(get_token)"

  curl -s -X PATCH \
    -H "Authorization: Bearer $token" \
    -H "Content-Type: application/json" \
    -d "{\"fields\":{\"status\":{\"stringValue\":\"${status}\"}}}" \
    "${FIRESTORE_URL}/primes/${PRIME_ID}?updateMask.fieldPaths=status" > /dev/null
}

# ---- Main loop ----
log "Starting control-daemon for Prime: ${PRIME_ID}"
log "Project: ${GCP_PROJECT_ID}"
log "Poll interval: ${POLL_INTERVAL}s"

# Report online
update_status "online"
log "Status: ONLINE"

# Heartbeat: update status every 60s
(
  while true; do
    sleep 60
    update_status "online" 2>/dev/null || true
  done
) &
HEARTBEAT_PID=$!
trap "kill $HEARTBEAT_PID 2>/dev/null; update_status 'offline'; exit" INT TERM

log "Entering polling loop..."

while true; do
  RESPONSE="$(poll_messages 2>/dev/null || echo '[]')"

  # Parse messages from Firestore REST response
  MESSAGES="$(echo "$RESPONSE" | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
    if not isinstance(data, list):
        data = [data]
        
    valid_msgs = []
    for item in data:
        doc = item.get('document', {})
        if not doc:
            continue
        fields = doc.get('fields', {})
        text = fields.get('text', {}).get('stringValue', '')
        sender = fields.get('sender', {}).get('stringValue', '')
        timestamp = fields.get('timestamp', {}).get('timestampValue', '')
        name = doc.get('name', '')
        if text and name and sender == 'admin':
            valid_msgs.append({'text': text, 'path': name, 'timestamp': timestamp})
            
    # Sort by timestamp
    valid_msgs.sort(key=lambda x: x['timestamp'])
    
    for v in valid_msgs:
        print(json.dumps({'text': v['text'], 'path': v['path']}))
except Exception as e:
    pass
" 2>/dev/null || true)"

  if [[ -n "$MESSAGES" ]]; then
    while IFS= read -r msg_json; do
      TEXT="$(echo "$msg_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['text'])")"
      DOC_PATH="$(echo "$msg_json" | python3 -c "import json,sys; print(json.load(sys.stdin)['path'])")"

      log "Received: $TEXT"

      # Route to OpenClaw gateway (OpenAI-compatible endpoint)
      OC_RESPONSE="$(curl -s --max-time 120 \
        -X POST "${OC_GATEWAY}/v1/chat/completions" \
        -H "Authorization: Bearer ${OC_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "$(python3 -c "
import json, sys
text = sys.stdin.read().strip()
print(json.dumps({
    'model': 'openclaw/main',
    'messages': [{'role': 'user', 'content': text}]
}))
" <<< "$TEXT")" 2>/dev/null)" || OC_RESPONSE=''

      # Parse response from OpenClaw (OpenAI chat completions format)
      REPLY="$(python3 -c "
import json, sys
raw = sys.stdin.read().strip()
if not raw:
    print('⚠ Empty response from OpenClaw gateway.')
    sys.exit(0)
try:
    data = json.loads(raw)
    r = ''
    if isinstance(data, dict):
        # OpenAI chat completions format: choices[0].message.content
        choices = data.get('choices', [])
        if choices and isinstance(choices, list):
            msg = choices[0].get('message', {}) if isinstance(choices[0], dict) else {}
            r = msg.get('content', '')
        # Fallback formats
        if not r:
            r = (data.get('content', '')
                 or data.get('response', '')
                 or data.get('message', ''))
    if r:
        print(r)
    else:
        # Fallback: dump the full response for debugging
        print(json.dumps(data, indent=2)[:2000])
except Exception as e:
    print(f'Error parsing OpenClaw response: {e}. Raw: {raw[:200]}')
" <<< "$OC_RESPONSE" 2>/dev/null)" || REPLY="⚠ OpenClaw gateway unavailable."

      log "Reply: $(echo "$REPLY" | head -1)..."

      # Write response to Firestore
      write_response "$REPLY"

      # Mark original message as processed
      mark_processed "$DOC_PATH"

      log "Completed: $DOC_PATH"
    done <<< "$MESSAGES"
  fi

  sleep "$POLL_INTERVAL"
done
