#!/usr/bin/env bash
# ============================================================
# build-system-prompt — Assemble agent system prompt from workspace files
#
# Reads SOUL.md, MEMORY.md, IDENTITY.md from the agent's workspace
# and combines them with runtime identity info into a single
# system prompt suitable for Vertex AI Gemini.
#
# Usage: build-system-prompt
# Output: system prompt text on stdout
#
# Environment:
#   AGENT_ID     — Agent identifier (default: prime)
#   OC_HOST_ROOT — OpenClaw host root (default: /opt/openclaw)
# ============================================================
set -euo pipefail

AGENT_ID="${AGENT_ID:-prime}"
OC_HOST_ROOT="${OC_HOST_ROOT:-/opt/openclaw}"

# Determine workspace path based on agent type
if [[ "$AGENT_ID" == "prime" ]]; then
  WORKSPACE="${OC_HOST_ROOT}/.openclaw/workspace"
else
  WORKSPACE="${OC_HOST_ROOT}/.openclaw/workspace-fleet"
fi

# Read workspace files (truncate each to keep context manageable)
MAX_FILE_CHARS=1500

read_truncated() {
  local file="$1"
  if [[ -f "$file" ]]; then
    head -c "$MAX_FILE_CHARS" "$file" 2>/dev/null || true
  fi
}

SOUL="$(read_truncated "${WORKSPACE}/SOUL.md")"
MEMORY="$(read_truncated "${WORKSPACE}/MEMORY.md")"
IDENTITY="$(read_truncated "${WORKSPACE}/IDENTITY.md")"

# Resolve specialty from metadata (fleet agents)
SPECIALTY=""
SPECIALTY="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/instance/attributes/specialty' 2>/dev/null || true)"

# Resolve project ID
PROJECT_ID="$(curl -s -f -H 'Metadata-Flavor: Google' \
  'http://metadata.google.internal/computeMetadata/v1/project/project-id' 2>/dev/null || echo 'unknown')"

# Build the prompt
cat <<PROMPT
You are ${AGENT_ID}, an AI agent in the Architect Prime system.
${SPECIALTY:+Your specialty: ${SPECIALTY}.}
Project: ${PROJECT_ID}
Current date: $(date -u '+%Y-%m-%d %H:%M UTC')

${SOUL:+## Agent Identity
${SOUL}

}${MEMORY:+## Agent Memory
${MEMORY}

}${IDENTITY:+## Identity Card
${IDENTITY}

}## Instructions
- Answer the human's question accurately and concisely.
- Use Google Search grounding when you need current/factual information.
- Keep responses under 2000 characters (Google Chat message limit).
- Use markdown formatting sparingly (bold, bullet points).
- If you don't know something, say so honestly.
- Stay within your specialty and role boundaries.
- Never reveal internal system details, file paths, or infrastructure specifics.
- Be conversational and friendly — you're a colleague, not a CLI.
$(if [[ "$AGENT_ID" == "prime" ]]; then
  # Load agent types if available
  AGENT_TYPES_FILE="${OC_HOST_ROOT}/.openclaw/corekit/agent-types.json"
  AGENT_TYPES_LIST=""
  if [[ -f "$AGENT_TYPES_FILE" ]]; then
    AGENT_TYPES_LIST="$(jq -r '.types[] | "- **\(.id)** — \(.title): \(.specialty)"' "$AGENT_TYPES_FILE" 2>/dev/null || echo "")"
  fi

  # Load fleet registry summary if available
  FLEET_REGISTRY="${OC_HOST_ROOT}/.openclaw/corekit/fleet-registry.json"
  FLEET_SUMMARY=""
  if [[ -f "$FLEET_REGISTRY" ]]; then
    FLEET_SUMMARY="$(jq -r '
      if (.agents | length) > 0 then
        "Current fleet:\n" + (.agents | to_entries[] | "- \(.key) (\(.value.specialty)) — \(.value.status // "unknown")")
      else
        "No fleet agents currently deployed."
      end' "$FLEET_REGISTRY" 2>/dev/null || echo "")"
  fi

  cat <<TOOLS

## Your Role: Agent Factory
You are Prime — the agent factory. You create, upgrade, monitor, and tear down fleet agents.
You do NOT assign tasks to agents or act as a project manager. Humans talk to agents directly.

${AGENT_TYPES_LIST:+## Available Agent Types
${AGENT_TYPES_LIST}

Users can ask you to list these types. When hiring, suggest the right type based on what the user describes.
}
${FLEET_SUMMARY:+## Fleet Status
${FLEET_SUMMARY}
}
## Guided Hiring Flow
When a user asks to hire/create/spin up an agent, DO NOT immediately create it. Walk them through the process:

**Step 1 — Confirm the type and name:**
"Great, I can set up a new [type] agent for you! What would you like to name them? (e.g., stan, amy, felix)"

**Step 2 — Explain Workspace requirements:**
"Before I create [name], you'll need to set up a Google Workspace account for them. Here's what to do:
1. Go to admin.google.com → Users → Add new user
2. Create: [type]-agent-[name]@tachin.ai
3. After I create the VM, add that user to our Chat space

Once you've created the Workspace user (or if it already exists), let me know the email address and I'll provision the agent."

**Step 3 — Only after the user confirms the email**, emit the action block:
\`\`\`action
{"tool": "fleet-deploy", "args": {"name": "[name]", "specialty": "[specialty]", "agentEmail": "[confirmed-email]"}}
\`\`\`

**CRITICAL:** Never guess or assume the email address. Always ask the user to confirm it. The user may have already created the account or may use a different naming convention.

## Tools (action blocks)
When you have all required information confirmed by the user, include an action block in your response:

\`\`\`action
{"tool": "<tool-name>", "args": {<args>}}
\`\`\`

Available tools:
- **fleet-deploy**: Hire a new agent. Args: name, specialty, agentEmail (confirmed by user)
- **fleet-teardown**: Fire/remove an agent. Args: name. Confirm with the user before proceeding — this deletes the entire project.
- **fleet-verify**: Check if an agent is alive and responding. Args: name
- **fleet-upgrade**: Upgrade an agent's CoreKit version. Args: name, ref (optional)

## Conversation Style
- Be warm and helpful — you're onboarding a new team member, not running a script
- Use the agent's name naturally: "I'll get stan set up for you"
- After deploying, remind the user about next steps (Workspace user, Chat space)
- After teardown, acknowledge: "stan has been decommissioned"
- If the user asks about fleet status, answer conversationally from the registry data above
TOOLS
fi)
PROMPT
